+    // STEPS off): as before.
+    const auto usable = [&is_free, size, steps = StagingSteps()](const StagingBuffer& entry) {
+        return is_free(entry) && !entry.kept && (!steps || entry.capacity >= size);
+    };
     auto& entries = cache_level.entries;
     const auto hint_it = entries.begin() + cache_level.iterate_index;
-    auto it = std::find_if(entries.begin() + cache_level.iterate_index, entries.end(), is_free);
+    auto it = std::find_if(entries.begin() + cache_level.iterate_index, entries.end(), usable);
     if (it == entries.end()) {
-        it = std::find_if(entries.begin(), hint_it, is_free);
+        it = std::find_if(entries.begin(), hint_it, usable);
         if (it == hint_it) {
-            return std::nullopt;
+            return TakeKeptUpload(size, usage, deferred);
         }
     }
     cache_level.iterate_index = std::distance(entries.begin(), it) + 1;
@@ -376,6 +495,44 @@ std::optional<StagingBufferRef> StagingBufferPool::TryGetReservedBuffer(size_t s
     return it->Ref();
 }
 
+std::optional<StagingBufferRef> StagingBufferPool::TakeKeptUpload(size_t size, MemoryUsage usage,
+                                                                  bool deferred) {
+    // The only way the kept buffer is handed out, also for an upload of its own level, after the
+    // other free buffers of the request's level. Only a large upload: over a ring region and over
+    // a quarter of the kept buffer. A smaller one would hold it while the next large upload makes
+    // a buffer of its own anyway. Never deferred: that holds a buffer until it is given back.
+    // Unset (kept_size 0): nothing, as before.
+    if (kept_size == 0 || usage != MemoryUsage::Upload || deferred || size > kept_size ||
+        size <= region_size || size <= kept_size / 4) {
+        return std::nullopt;
+    }
+    auto& entries = upload_cache[kept_level].entries;
+    const auto it = std::find_if(entries.begin(), entries.end(), [this](const StagingBuffer& entry) {
+        return entry.index == kept_index;
+    });
+    if (it == entries.end()) {
+        // On the console the pool lets go of every idle buffer when the memory it shares with
+        // the GPU runs short or a buffer is refused. It is not made again.
+        LOG_WARNING(Render_Vulkan,
+                    "EDEN_UP_STAGING_KEEP: the kept {} MiB upload buffer was let go (memory short); "
+                    "large uploads make their own buffers again",
+                    kept_size >> 20);
+        kept_size = 0;
+        return std::nullopt;
+    }
+    if (it->deferred || !scheduler.IsFree(it->tick)) {
+        return std::nullopt;
+    }
+    it->tick = scheduler.CurrentTick();
+    static u64 times = 0;
+    if (++times; (times & (times - 1)) == 0) { // the 1st, 2nd, 4th, 8th ... time
+        LOG_INFO(Render_Vulkan,
+                 "EDEN_UP_STAGING_KEEP: kept {} MiB upload buffer used for {} bytes, {} times so far",
+                 kept_size >> 20, size, times);
+    }
+    return it->Ref();
+}
+
