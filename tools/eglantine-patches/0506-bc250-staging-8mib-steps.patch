+    // EDEN_UP_STAGING_STEPS=1: over 8 MiB, the transfer rounded up to 8 MiB (136 MiB, not 256),
+    // after the idle buffers over 8 MiB of this kind are let go. Never more than the size above,
+    // which on the console is already the transfer in 16 MiB steps for a buffer the CPU maps.
+    if (StagingSteps() && log2_size > LargeStagingLog2) {
+        const VkDeviceSize stepped =
+            Common::AlignUp(static_cast<VkDeviceSize>(size), LargeStagingStep);
+        if (stepped < buffer_ci.size) {
+            static u64 smaller = 0;
+            if (++smaller; (smaller & (smaller - 1)) == 0) { // the 1st, 2nd, 4th, 8th ... time
+                LOG_INFO(Render_Vulkan,
+                         "EDEN_UP_STAGING_STEPS: {} MiB staging buffer for {} bytes, not {} MiB "
+                         "({} so far)",
+                         stepped >> 20, size, buffer_ci.size >> 20, smaller);
+            }
+            buffer_ci.size = stepped;
+        }
+        ReleaseIdleLarge(GetCache(usage), 0);
+    }
     if (device.IsExtTransformFeedbackSupported()) {
         buffer_ci.usage |= VK_BUFFER_USAGE_TRANSFORM_FEEDBACK_BUFFER_BIT_EXT;
     }
@@ -415,6 +590,7 @@ StagingBufferRef StagingBufferPool::CreateStagingBuffer(size_t size, MemoryUsage
         .usage = usage,
         .log2_level = log2_size,
         .index = unique_ids++,
+        .capacity = buffer_ci.size,
         .tick = deferred ? (std::numeric_limits<u64>::max)() : scheduler.CurrentTick(),
         .deferred = deferred,
     });
@@ -457,7 +633,8 @@ void StagingBufferPool::ReleaseLevel(StagingBuffersCache& cache, size_t log2) {
         // nothing; it states that a handed-out deferred buffer is never counted or freed here.
         size_t idle = 0;
         std::erase_if(entries, [this, &idle](const StagingBuffer& entry) {
-            return !entry.deferred && scheduler.IsFree(entry.tick) && ++idle > KeepPerLevel;
+            return !entry.kept && !entry.deferred && scheduler.IsFree(entry.tick) &&
+                   ++idle > KeepPerLevel;
         });
         staging.delete_index = 0;
         if (staging.iterate_index > entries.size()) {
@@ -467,7 +644,7 @@ void StagingBufferPool::ReleaseLevel(StagingBuffersCache& cache, size_t log2) {
     }
 
     const auto is_deletable = [this](const StagingBuffer& entry) {
-        return scheduler.IsFree(entry.tick);
+        return !entry.kept && scheduler.IsFree(entry.tick);
     };
     const size_t begin_offset = staging.delete_index;
     const size_t end_offset = (std::min)(begin_offset + deletions_per_tick, old_size);
