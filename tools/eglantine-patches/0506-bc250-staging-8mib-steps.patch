     return ring;
 }
+
+// EDEN_UP_STAGING_STEPS=1 (lethevimlet/oot-bc250 eeea507): staging buffers over 8 MiB are made
+// in 8 MiB steps, not the next power of two, and idle ones over 8 MiB go each frame beyond 64 MiB
+// of each kind. A Kokiri Forest load on the BC-250 held 1.1 GiB of them; with this, ~70 MiB.
+bool StagingSteps() {
+    static const bool enabled = Common::PeSwitch("EDEN_UP_STAGING_STEPS");
+    return enabled;
+}
+
+// EDEN_UP_STAGING_KEEP=1: one upload staging buffer made at the start and kept, for the large
+// buffer uploads of a new area (Ocarina, the village after Link's door: 128 MiB, then 64 MiB, each
+// a fresh allocation and mapping in the ~1 s frame). EDEN_UP_STAGING_KEEP_MIB=<16..1024> sets its
+// size, 128 MiB when unset. It is rounded up to a power of two: it then holds every transfer of
+// its size level, and the console's 16 MiB sizing (staging_buffers.h), which lets go of a kept
+// buffer too small for a transfer of its level, never lets it go for that. It serves uploads over
+// a quarter of its size (TakeKeptUpload): 128 MiB covers both door uploads, 256 MiB or more no
+// longer takes the 64 MiB one, 64 MiB or less never the 128 MiB one.
+VkDeviceSize KeptUploadBytes() {
+    const char* const mib_value = std::getenv("EDEN_UP_STAGING_KEEP_MIB");
+    if (!Common::PeSwitch("EDEN_UP_STAGING_KEEP")) {
+        if (mib_value != nullptr) {
+            LOG_WARNING(Render_Vulkan,
+                        "EDEN_UP_STAGING_KEEP_MIB={} is set without EDEN_UP_STAGING_KEEP=1: no "
+                        "upload buffer is kept",
+                        mib_value);
+        }
+        return 0;
+    }
+    constexpr unsigned long long DefaultMiB = 128;
+    constexpr unsigned long long MinMiB = 16;
+    constexpr unsigned long long MaxMiB = 1024;
+    unsigned long long mib = DefaultMiB;
+    if (mib_value != nullptr) {
+        const unsigned long long asked = std::strtoull(mib_value, nullptr, 10);
+        if (asked < MinMiB || asked > MaxMiB) {
+            LOG_WARNING(Render_Vulkan, "EDEN_UP_STAGING_KEEP_MIB={} is not {} to {}: {} MiB",
+                        mib_value, MinMiB, MaxMiB, DefaultMiB);
+        } else {
+            mib = asked;
+        }
+    }
+    return VkDeviceSize{1} << Common::Log2Ceil<u64>(static_cast<u64>(mib) << 20);
+}
 } // Anonymous namespace
 
 StagingBufferPool::StagingBufferPool(const Device& device_, MemoryAllocator& memory_allocator_,
@@ -152,6 +196,37 @@ StagingBufferPool::StagingBufferPool(const Device& device_, MemoryAllocator& mem
     reserved_ci.size = 4_MiB;
     reserved_ci.usage = VK_BUFFER_USAGE_TRANSFER_DST_BIT;
     reserved_download = memory_allocator.CreateBuffer(reserved_ci, MemoryUsage::Download);
+
+    // EDEN_UP_STAGING_KEEP=1: the kept upload buffer, written once now so that its pages are
+    // there before the first large upload. Refused, the session goes on without it.
+    if (const VkDeviceSize keep = KeptUploadBytes(); keep != 0) {
+        try {
+            const StagingBufferRef ref =
+                CreateStagingBuffer(static_cast<size_t>(keep), MemoryUsage::Upload, false);
+            auto& entries = upload_cache[ref.log2_level].entries;
+            const auto it = std::find_if(entries.begin(), entries.end(),
+                                         [&ref](const StagingBuffer& entry) {
+                                             return entry.index == ref.index;
+                                         });
+            ASSERT(it != entries.end());
+            it->kept = true;
+            it->tick = 0;
+            if (!ref.mapped_span.empty()) {
+                std::memset(ref.mapped_span.data(), 0, ref.mapped_span.size());
+            }
+            kept_level = ref.log2_level;
+            kept_index = ref.index;
+            kept_size = it->capacity;
+            LOG_INFO(Render_Vulkan,
+                     "EDEN_UP_STAGING_KEEP: {} MiB upload staging buffer made at the start and kept",
+                     kept_size >> 20);
+        } catch (const vk::Exception& refused) {
+            LOG_WARNING(Render_Vulkan,
+                        "EDEN_UP_STAGING_KEEP: no {} MiB upload staging buffer at the start ({}): "
+                        "none kept",
+                        keep >> 20, refused.what());
+        }
+    }
 }
 
 StagingBufferPool::~StagingBufferPool() = default;
@@ -243,6 +318,40 @@ void StagingBufferPool::TickFrame() {
         ReleaseCache(MemoryUsage::Upload);
         ReleaseCache(MemoryUsage::Download);
     }
+    // EDEN_UP_STAGING_STEPS: idle buffers over 8 MiB beyond 64 MiB of each kind go now, not when
+    // the sweep above reaches their level (one level a frame, up to 4 with EDEN_NX2_CLEAN_BY_TIME,
+    // 16 buffers at most).
+    if (StagingSteps()) {
+        for (StagingBuffersCache* const cache : {&device_local_cache, &upload_cache, &download_cache}) {
+            ReleaseIdleLarge(*cache, LargeStagingReserve);
+        }
+    }
+}
+
+void StagingBufferPool::ReleaseIdleLarge(StagingBuffersCache& cache, VkDeviceSize keep) {
+    // Largest levels first: what stays is the largest idle buffers, the likeliest to fit again.
+    // A deferred buffer, one the GPU still reads and the kept upload buffer always stay.
+    VkDeviceSize kept_bytes = 0;
+    for (size_t log2 = NUM_LEVELS; log2-- > LargeStagingLog2 + 1;) {
+        StagingBuffers& staging = cache[log2];
+        auto& entries = staging.entries;
+        const auto end =
+            std::remove_if(entries.begin(), entries.end(), [&](const StagingBuffer& entry) {
+                if (entry.kept || entry.deferred || !scheduler.IsFree(entry.tick)) {
+                    return false;
+                }
+                if (kept_bytes + entry.capacity <= keep) {
+                    kept_bytes += entry.capacity;
+                    return false;
+                }
+                return true;
+            });
+        if (end != entries.end()) {
+            entries.erase(end, entries.end());
+            staging.delete_index = 0;
+            staging.iterate_index = 0;
+        }
+    }
 }
 
