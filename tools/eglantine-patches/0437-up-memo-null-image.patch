Subject: [PATCH] Lichii #910 (c2e293ec88) for 0435: a texture memo hit no longer prepares the null image view (Ocarina hit UNREACHABLE()); only reached with EDEN_UP_FAST_DRAW=1

diff --git a/src/video_core/texture_cache/texture_cache.h b/src/video_core/texture_cache/texture_cache.h
--- a/src/video_core/texture_cache/texture_cache.h
+++ b/src/video_core/texture_cache/texture_cache.h
@@ -1337,7 +1337,11 @@
         const SampledTextureMemo::Entry& entry = memo.entries[i];
         views[i] = ImageViewInOut{.index = entry.view_index, .blacklist = false, .id = entry.view};
         samplers[i] = entry.sampler;
-        PrepareImageView(entry.view, false, false);
+        // Lichii #910 (c2e293ec88): as in VisitImageView, the null image has nothing to upload and
+        // no valid format; preparing it on a memo hit reached UNREACHABLE() in Ocarina of Time.
+        if (entry.view != NULL_IMAGE_VIEW_ID) {
+            PrepareImageView(entry.view, false, false);
+        }
     }
     if (has_deleted_images) {
         // Preparing an image deleted others: the full path resolves the views again.
