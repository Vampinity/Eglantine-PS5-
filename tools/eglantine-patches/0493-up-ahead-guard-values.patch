+/// Copy mode: a small value the GPU thread reads from guest memory at a GPU address when it draws
+/// (a texture handle or a storage buffer's pointer in a constant buffer): from the page's copy
+/// when it has one. The page's bit is looked at without the lock; a value that crosses a page, or
+/// has no device address, is read as before.
+template <class T, class GpuMemory>
+[[nodiscard]] T ReadGpu(GpuMemory& gpu_memory, u64 gpu_addr) {
+    if (Mode() != 2 || (gpu_addr & (PageSize - 1)) > PageSize - sizeof(T)) {
+        return gpu_memory.template Read<T>(gpu_addr);
+    }
+    State& s = Get();
+    if (!s.active.load(std::memory_order_acquire)) {
+        return gpu_memory.template Read<T>(gpu_addr);
+    }
+    const auto device_addr = gpu_memory.GpuToCpuAddress(gpu_addr);
+    if (!device_addr) {
+        return gpu_memory.template Read<T>(gpu_addr);
+    }
+    const u64 page = static_cast<u64>(*device_addr) >> PageBits;
+    if (page >= PageLimit || (s.copied[page / 64].load(std::memory_order_acquire) &
+                              (u64{1} << (page % 64))) == 0) {
+        return gpu_memory.template Read<T>(gpu_addr);
+    }
+    std::scoped_lock lk{s.mutex};
+    const u32 slot = Detail::FindCopy(s, page);
+    if (slot == NoSlot) {
+        return gpu_memory.template Read<T>(gpu_addr);
+    }
+    T value{};
+    std::memcpy(&value,
+                s.copy_bytes.get() + u64{slot} * PageSize +
+                    (static_cast<u64>(*device_addr) & (PageSize - 1)),
+                sizeof(T));
+    ++s.stats.value_reads;
+    return value;
+}
