From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: EglantinePS5 <noreply@eglantineps5.local>
Date: Sun, 8 Nov 2026 00:00:00 +0000
Subject: [PATCH] shader: honor the device storage-buffer limit in the #410 port

Keep the #551/#410 pointer routing within the Vulkan descriptor-set limit
already carried in HostTranslateInfo.

diff --git a/src/shader_recompiler/ir_opt/global_memory_to_storage_buffer_pass.cpp b/src/shader_recompiler/ir_opt/global_memory_to_storage_buffer_pass.cpp
index a0f91f357b..31679bb91d 100644
--- a/src/shader_recompiler/ir_opt/global_memory_to_storage_buffer_pass.cpp
+++ b/src/shader_recompiler/ir_opt/global_memory_to_storage_buffer_pass.cpp
@@ -86,6 +86,8 @@ struct StorageInfo {
     bool bind_competing_loaded{true};
     /// A paired access bound the loaded pointer competing with its pair.
     bool competing_loaded_bound{};
+    /// Effective device storage-buffer limit for this translation.
+    size_t max_ssbos{Info::MAX_SSBOS};
     /// Pointer table entries reached through a phi or select of table pointers, or through a
     /// table pointer read from a dynamically indexed constant buffer array. They are bound only
     /// in the bindings the program's other storage buffers leave free (table_budget).
@@ -1430,7 +1432,7 @@ void CollectStorageBuffers(IR::Block& block, IR::Inst& inst, StorageInfo& info,
                 const bool table{std::ranges::find(info.table_candidates, candidate) !=
                                  info.table_candidates.end()};
                 if ((table && info.table_used + added > info.table_budget) ||
-                    info.set.size() + added > Info::MAX_SSBOS) {
+                    info.set.size() + added > info.max_ssbos) {
                     info.bindings_full = true;
                     continue;
                 }
@@ -1501,7 +1503,7 @@ void CollectStorageBuffers(IR::Block& block, IR::Inst& inst, StorageInfo& info,
         LOG_DEBUG(Shader, "Storage buffer tracked without bias, index {} offset {}",
                     storage_buffer->index, storage_buffer->offset);
     }
-    if (info.set.size() >= Info::MAX_SSBOS && info.set.find(*storage_buffer) == info.set.end()) {
+    if (info.set.size() >= info.max_ssbos && info.set.find(*storage_buffer) == info.set.end()) {
         info.bindings_full = true;
         return;
     }
@@ -1707,8 +1709,13 @@ void GlobalMemoryToStorageBufferPass(Environment& env, IR::Program& program,
     if (!has_global_memory) {
         return;
     }
+    const size_t max_ssbos = host_info.max_descriptor_set_storage_buffers == 0
+                                 ? Info::MAX_SSBOS
+                                 : (std::min)(Info::MAX_SSBOS,
+                                              static_cast<size_t>(host_info.max_descriptor_set_storage_buffers));
     TrackingConditions conditions{program};
     StorageInfo info;
+    info.max_ssbos = max_ssbos;
     // Without shaderInt64 the SPIR-V backend cannot route a global access among bound buffers.
     info.bind_competing_loaded = host_info.support_int64;
     info.iterator_words = CollectIteratorWords(program);
@@ -1731,18 +1738,20 @@ void GlobalMemoryToStorageBufferPass(Environment& env, IR::Program& program,
         StorageInfo paired;
         paired.iterator_words = std::move(info.iterator_words);
         paired.atomic_pointers = std::move(info.atomic_pointers);
+        paired.max_ssbos = max_ssbos;
         paired.bind_competing_loaded = false;
         info = std::move(paired);
         collect();
     }
     const size_t reserved{info.tables_seen ? PendingNvnBindings(program, info.set) : 0U};
-    if (info.tables_seen && info.set.size() + reserved < Info::MAX_SSBOS) {
+    if (info.tables_seen && info.set.size() + reserved < info.max_ssbos) {
         // Again with pointer table entries, in the bindings the first pass left free.
         StorageInfo with_tables;
         with_tables.iterator_words = std::move(info.iterator_words);
         with_tables.atomic_pointers = std::move(info.atomic_pointers);
+        with_tables.max_ssbos = max_ssbos;
         with_tables.tables_enabled = true;
-        with_tables.table_budget = Info::MAX_SSBOS - info.set.size() - reserved;
+        with_tables.table_budget = info.max_ssbos - info.set.size() - reserved;
         info = std::move(with_tables);
         collect();
     } else if (info.tables_seen) {
@@ -1750,7 +1759,7 @@ void GlobalMemoryToStorageBufferPass(Environment& env, IR::Program& program,
     }
     if (info.bindings_full) {
         LOG_WARNING(Shader, "All {} storage buffer bindings taken, the rest stay global",
-                    Info::MAX_SSBOS);
+                    info.max_ssbos);
     }
     program.info.native_global_bounds |= info.native_runtime_bounds;
     for (const StorageBufferAddr& storage_buffer : info.set) {
-- 
2.39.0
