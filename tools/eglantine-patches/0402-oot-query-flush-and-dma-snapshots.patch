-    split.Drain(VideoCommon::DrainSite::MacroDmaRead);
+    const auto snapshot_pages = [&] {
+        const u64 first = source >> 12;
+        const u64 last = (source + read_bytes - 1) >> 12;
+        bool hit = method == 0x158 && words != 0;
+        for (u64 page = first; page <= last && hit; ++page) {
+            const auto it = fs.dma_snapshots.find(page);
+            hit = it != fs.dma_snapshots.end() && it->second == split.LastWriterPosition();
+        }
+        return hit && !VideoCommon::QueryDma::HasPendingQueries(memory_manager, *rasterizer,
+                                                                  source, read_bytes);
+    }();
+    if (!snapshot_pages) {
+        split.Defer([this, memory = &memory_manager, macro, method, source, read_bytes] {
+            // EDEN_NX2_QUERY_DMA_TRACE / EDEN_NX2_QUERY_DMA_SYNC: below High accuracy, counter reports
+            // reach guest memory when a later fence pops, and nothing here waits for them.
+            VideoCommon::QueryDma::BeforeRead(*memory, *rasterizer, macro, method, source, read_bytes);
+            // Occlusion reports and semaphore writes can still be pending in the query cache when the
+            // game reads them. Flush them before the DMA read; otherwise stale zeroes cull visible
+            // objects and can produce the measured one-frame white flash.
+            memory->FlushRegion(source, read_bytes, VideoCommon::CacheType::QueryCache);
+            if (memory->IsMemoryDirty(source, read_bytes, VideoCommon::CacheType::BufferCache)) {
+                memory->FlushRegion(source, read_bytes, VideoCommon::CacheType::BufferCache);
+            }
+            VideoCommon::QueryDma::AfterBufferFlush(*memory, *rasterizer, source, read_bytes);
+        });
+        split.Drain(VideoCommon::DrainSite::MacroDmaRead);
+        if (method == 0x158 && words != 0) {
+            const u64 first = source >> 12;
+            const u64 last = (source + read_bytes - 1) >> 12;
+            if (fs.dma_snapshots.size() > 8192) {
+                fs.dma_snapshots.clear();
+            }
+            for (u64 page = first; page <= last; ++page) {
+                fs.dma_snapshots[page] = split.LastWriterPosition();
+            }
+        }
+    }
     for (u32 i = 0; i < words; ++i) {
         const u32 word = memory_manager.Read<u32>(source + u64{i} * sizeof(u32));
         if (method == 0x158) {
