new file mode 100644
index 0000000000..ee333be7e8
--- /dev/null
+++ b/src/video_core/renderer_vulkan/mesh_fallback_limits.h
@@ -0,0 +1,17 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+
+#pragma once
+
+#include <cstddef>
+
+namespace Vulkan {
+
+// A zero limit means the driver did not expose a usable bound.
+[[nodiscard]] constexpr bool FitsStorageBufferSetLimit(std::size_t guest_buffers,
+                                                       std::size_t auxiliary_buffers,
+                                                       std::size_t set_limit) noexcept {
+    return set_limit == 0 ||
+           (guest_buffers <= set_limit && auxiliary_buffers <= set_limit - guest_buffers);
+}
+
+} // namespace Vulkan
