From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: EglantinePS5 <noreply@eglantineps5.local>
Date: Sun, 8 Nov 2026 00:00:00 +0000
Subject: [PATCH] vulkan: load mesh pipeline cache for the compute fallback

---
diff --git a/src/video_core/renderer_vulkan/vk_pipeline_cache.cpp b/src/video_core/renderer_vulkan/vk_pipeline_cache.cpp
index 886fe94f88..8d208cb053 100644
--- a/src/video_core/renderer_vulkan/vk_pipeline_cache.cpp
+++ b/src/video_core/renderer_vulkan/vk_pipeline_cache.cpp
@@ -1382,7 +1382,10 @@ void PipelineCache::LoadDiskResources(u64 title_id, std::stop_token stop_loading
     }};
     VideoCommon::LoadPipelines(stop_loading, pipeline_cache_filename, CACHE_VERSION, load_compute,
                                load_graphics);
-    if (device.IsExtMeshShaderSupported()) {
+    // Mesh pipelines are stored separately because their translation needs mesh state. The
+    // PS5 RADV path runs them as compute when VK_EXT_mesh_shader is absent, so it must load the
+    // same file even without the native mesh extension.
+    if (device.IsExtMeshShaderSupported() || (mesh_scratch && mesh_scratch->IsValid())) {
         loading_mesh_file = true;
         VideoCommon::LoadPipelines(stop_loading, mesh_pipeline_cache_filename, CACHE_VERSION,
                                    load_compute, load_graphics, true);

