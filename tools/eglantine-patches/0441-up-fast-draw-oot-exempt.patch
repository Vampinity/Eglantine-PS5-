+// EDEN_UP_FAST_DRAW_OOT_EXEMPT (nx2_fast_draw.h). What reads these is either run again by every
+// draw, delta draws too (dynamic state, ConfigureDelta's buffers, render targets and render area,
+// the query cache), or nothing on the Vulkan path; never the pipeline key (BuildCleanWatch lists
+// what it reads), the texture handles, or the image views and samplers a delta draw keeps:
+// - vertex_id_base: the native draw macros write it before each draw; only HLE macros, which
+//   assign it, name it.
+// - viewports[] (the Vulkan path reads viewport_transform), scissor_test[], blend_color and
+//   surface_clip: dynamic state, render targets and the render area.
+// - pipelines[].register_count: read by nothing (the program address words still end reuse).
+// - vertex_streams[] stride and enable: buffer bindings and dynamic strides, while strides stay
+//   out of the pipeline key (g_strides_outside_key).
+// - clear_report_value and render_enable: ProcessCounterReset and ProcessQueryCondition, which
+//   act on the query cache only. A render pass that ends there changes the recording epoch, a
+//   submit the tick, and TakeReusableDraw checks both. report_semaphore (query results written
+//   to guest memory) still ends reuse.
+bool Maxwell3D::IsFastDrawExempt(u32 method) {
+    namespace FastDraw = VideoCommon::Nx2FastDraw;
+    if (!FastDraw::OotExemptEnabled()) {
+        return false;
+    }
+    const auto in_block = [method](u32 first, size_t bytes) {
+        return method >= first && method < first + bytes / sizeof(u32);
+    };
+    if (IsFastDrawExemptMethod(method) || method == MAXWELL3D_REG_INDEX(vertex_id_base) ||
+        method == MAXWELL3D_REG_INDEX(render_enable.address_high) ||
+        method == MAXWELL3D_REG_INDEX(render_enable.address_low) ||
+        in_block(MAXWELL3D_REG_INDEX(viewports), sizeof(Regs::viewports)) ||
+        in_block(MAXWELL3D_REG_INDEX(scissor_test), sizeof(Regs::scissor_test)) ||
+        in_block(MAXWELL3D_REG_INDEX(blend_color), sizeof(Regs::blend_color)) ||
+        in_block(MAXWELL3D_REG_INDEX(surface_clip), sizeof(Regs::surface_clip))) {
+        return true;
+    }
+    constexpr u32 pipeline_words = sizeof(Regs::Pipeline) / sizeof(u32);
+    constexpr u32 register_counts = static_cast<u32>(
+        MAXWELL3D_REG_INDEX(pipelines) + offsetof(Regs::Pipeline, register_count) / sizeof(u32));
+    if (method >= register_counts &&
+        method < register_counts + Regs::MaxShaderProgram * pipeline_words &&
+        (method - register_counts) % pipeline_words == 0) {
+        return true;
+    }
+    constexpr u32 streams = MAXWELL3D_REG_INDEX(vertex_streams);
+    constexpr u32 stream_words = sizeof(Regs::VertexStream) / sizeof(u32);
+    if (method >= streams && method < streams + Regs::NumVertexArrays * stream_words &&
+        (method - streams) % stream_words == 0) { // stride and enable
+        return FastDraw::g_strides_outside_key.load(std::memory_order_relaxed);
+    }
+    return false;
+}
+
+bool Maxwell3D::IsFastDrawExemptMethod(u32 method) {
+    return VideoCommon::Nx2FastDraw::OotExemptEnabled() &&
+           (method == MAXWELL3D_REG_INDEX(clear_report_value) ||
+            method == MAXWELL3D_REG_INDEX(render_enable.mode));
+}
