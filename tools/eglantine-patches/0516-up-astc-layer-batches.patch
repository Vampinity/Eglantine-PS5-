+// EDEN_UP_ASTC_BATCH_MIB: rows per band for a slice whose RGBA8 scratch would pass the budget; 0
+// when it fits, when the switch is off, or when not even one band fits (the slice goes whole).
+// A band is a multiple of the ASTC block height and of 4 (one BC block row).
+[[nodiscard]] u32 AstcCpuBandRows(u32 width, u32 height, u32 tile_height) {
+    const u64 budget = AstcBatchBudgetBytes();
+    const u64 row_bytes = u64{width} * BytesPerBlock(PixelFormat::A8B8G8R8_UNORM);
+    if (budget == 0 || row_bytes * height <= budget) {
+        return 0;
+    }
+    const u64 step = std::lcm(tile_height, 4U);
+    const u64 rows = budget / row_bytes / step * step;
+    return rows != 0 && rows < height ? static_cast<u32>(rows) : 0;
+}
