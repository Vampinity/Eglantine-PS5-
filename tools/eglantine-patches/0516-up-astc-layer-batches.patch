         static const u64 limit = [] {
             const char* value = std::getenv("EDEN_PS5_TRANSCODE_PENDING_MIB");
             return value ? std::strtoull(value, nullptr, 10) << 20 : u64{256} << 20;
@@ -5259,6 +5389,10 @@ void TextureCacheRuntime::TranscodeAstcToBcn(
         }
         staging_buffer_pool.CarryTick(old_tick, scheduler.CurrentTick());
     }
+    if (batch_plan) {
+        TranscodeAstcBatched(image, map, swizzles, *batch_plan);
+        return;
+    }
     // A decode image of the same shape the GPU is done with: title 1's title screen decodes
     // dozens of textures a frame, mostly of a few shapes. Making one took 263 us; from VMA's
     // shared blocks 90 us, but freeing them there left ~1 GB of those blocks unused.
@@ -5383,6 +5517,434 @@ void TextureCacheRuntime::TranscodeAstcToBcn(
     pending_transcodes.push_back(std::move(pending));
 }
 
+// EDEN_UP_ASTC_BATCH_MIB=<N>: TranscodeAstcToBcn with its decode image and its output buffer kept
+// to N MiB together. The layer batches follow zortos293/Lichii #1083 (a batch is the same info with
+// fewer layers, read from its first layer on); the row bands are new. Each batch
+// decodes into the one decode image, encodes into the one output buffer and copies that into its
+// part of the image; barriers order a batch's decode after the previous encode read the decode
+// image, and its encode after the previous copy read the output. Everything is recorded in this
+// tick, so the staging pool frees the output only once the GPU is past the last copy, and the
+// decode image waits in pending_transcodes as before.
+void TextureCacheRuntime::TranscodeAstcBatched(
+    Image& image, const StagingBufferRef& map,
+    std::span<const VideoCommon::SwizzleParameters> swizzles, const AstcBatchPlan& plan) {
+    const auto start = std::chrono::steady_clock::now();
+    const ImageInfo& info = image.info;
+    const u32 width = info.size.width;
+    const u32 height = info.size.height;
+    const u32 levels = static_cast<u32>(info.resources.levels);
+    const u32 layers = static_cast<u32>(info.resources.layers);
+    constexpr VkFormat DecodeFormat = VK_FORMAT_A8B8G8R8_UNORM_PACK32;
+    static const bool wait_for_memory = [] {
+        const char* const value = std::getenv("EDEN_NX2_TRANSCODE_WAIT");
+        return value != nullptr && value[0] == '1';
+    }();
+    const u64 block_bytes = plan.bc3 ? 16 : 8;
+    const size_t guest_size = image.guest_size_bytes;
+    const auto level_width = [width](u32 level) { return (std::max)(width >> level, 1U); };
+    const auto level_height = [height](u32 level) { return (std::max)(height >> level, 1U); };
+    const auto make_decode_image = [this](u32 w, u32 h, u32 mips, u32 count) {
+        const VkImageCreateInfo decode_ci{
+            .sType = VK_STRUCTURE_TYPE_IMAGE_CREATE_INFO,
+            .pNext = nullptr,
+            .flags = 0,
+            .imageType = VK_IMAGE_TYPE_2D,
+            .format = DecodeFormat,
+            .extent = {w, h, 1},
+            .mipLevels = mips,
+            .arrayLayers = count,
+            .samples = VK_SAMPLE_COUNT_1_BIT,
+            .tiling = VK_IMAGE_TILING_OPTIMAL,
+            .usage = VK_IMAGE_USAGE_STORAGE_BIT,
+            .sharingMode = VK_SHARING_MODE_EXCLUSIVE,
+            .queueFamilyIndexCount = 0,
+            .pQueueFamilyIndices = nullptr,
+            .initialLayout = VK_IMAGE_LAYOUT_UNDEFINED,
+        };
+        vk::Image result;
+        try {
+            result = memory_allocator.CreateImage(decode_ci, true);
+        } catch (const vk::Exception& refused) {
+            if (refused.GetResult() != VK_ERROR_OUT_OF_DEVICE_MEMORY) {
+                throw;
+            }
+        }
+        return result;
+    };
+
+    // The batches' decode image: one of its shape the GPU is done with, or a new one (refused as
+    // TranscodeAstcToBcn refuses its own).
+    const auto reusable = std::ranges::find_if(free_transcodes, [&](const PendingTranscode& t) {
+        return t.width == plan.scratch_width && t.height == plan.scratch_height &&
+               t.levels == plan.scratch_levels && t.layers == plan.scratch_layers;
+    });
+    PendingTranscode scratch;
+    if (reusable != free_transcodes.end()) {
+        scratch = std::move(*reusable);
+        free_transcodes.erase(reusable);
+    } else {
+        vk::Image scratch_image = make_decode_image(plan.scratch_width, plan.scratch_height,
+                                                    plan.scratch_levels, plan.scratch_layers);
+        if (!scratch_image || (wait_for_memory && scratch_image.IsUnbacked())) {
+            upload_refused = true;
+            return;
+        }
+        scratch = PendingTranscode{
+            .tick = 0,
+            .image = std::move(scratch_image),
+            .views = {},
+            .width = plan.scratch_width,
+            .height = plan.scratch_height,
+            .levels = plan.scratch_levels,
+            .layers = plan.scratch_layers,
+            .unused_frames = 0,
+        };
+        for (u32 level = 0; level < plan.scratch_levels; ++level) {
+            scratch.views.push_back(
+                MakeStorageView(device.GetLogical(), level, *scratch.image, DecodeFormat));
+        }
+    }
+
+    // The image's BC1/BC3 data as TranscodeAstcToBcn lays it out: every layer of level 0, then of
+    // level 1, and so on. Only VERIFY puts it in one buffer.
+    boost::container::small_vector<u64, 16> level_offsets;
+    boost::container::small_vector<u64, 16> layer_bytes;
+    u64 total = 0;
+    for (u32 level = 0; level < levels; ++level) {
+        level_offsets.push_back(total);
+        layer_bytes.push_back(u64{Common::DivCeil(level_width(level), 4U)} *
+                              Common::DivCeil(level_height(level), 4U) * block_bytes);
+        total += layer_bytes.back() * layers;
+    }
+    const auto output = staging_buffer_pool.TryRequest(plan.output_bytes, MemoryUsage::DeviceLocal);
+    if (!output) {
+        // Nothing was recorded with it; TickFrame keeps it or lets it go as any other.
+        scratch.tick = scheduler.CurrentTick();
+        pending_transcodes.emplace_back(std::move(scratch));
+        upload_refused = true;
+        return;
+    }
+
+    // EDEN_UP_ASTC_BATCH_VERIFY=1: the first texture this path converts in layer batches and the
+    // first in row bands (up to 8 tries each while memory for the whole path is refused) are also
+    // converted the old way, whole, into a readable buffer; each batch's output is copied into
+    // another at its place; once the GPU is done both are compared. It needs the whole decode image
+    // and twice the output on top: on the console run it with a small EDEN_UP_ASTC_BATCH_MIB (8) so
+    // the first batched textures are small ones.
+    static const bool verify = Common::PeSwitch("EDEN_UP_ASTC_BATCH_VERIFY");
+    static std::array<u32, 2> verify_tries{};
+    static std::array<bool, 2> verified{};
+    const size_t mode = plan.bands ? 1 : 0;
+    std::optional<StagingBufferRef> verify_whole;
+    std::optional<StagingBufferRef> verify_batched;
+    vk::Image verify_image;
+    std::vector<vk::ImageView> verify_views;
+    if (verify && !verified[mode] && verify_tries[mode] < 8) {
+        ++verify_tries[mode];
+        verify_whole = staging_buffer_pool.TryRequest(total, MemoryUsage::Download);
+        if (verify_whole) {
+            verify_batched = staging_buffer_pool.TryRequest(total, MemoryUsage::Download);
+        }
+        if (verify_batched) {
+            verify_image = make_decode_image(width, height, levels, layers);
+        }
+        if (!verify_image || verify_image.IsUnbacked() ||
+            verify_whole->mapped_span.size() < total ||
+            verify_batched->mapped_span.size() < total) {
+            LOG_WARNING(Render_Vulkan,
+                        "EDEN_UP_ASTC_BATCH_VERIFY: no memory to convert {:#x} ({}x{}x{}) whole "
+                        "next to its {}, try {} of 8",
+                        image.gpu_addr, width, height, layers,
+                        plan.bands ? "row bands" : "layer batches", verify_tries[mode]);
+            verify_image = vk::Image{};
+            verify_whole.reset();
+            verify_batched.reset();
+        } else {
+            for (u32 level = 0; level < levels; ++level) {
+                verify_views.push_back(
+                    MakeStorageView(device.GetLogical(), level, *verify_image, DecodeFormat));
+            }
+        }
+    }
+    const bool verifying = static_cast<bool>(verify_image);
+    if (verifying) {
+        // TranscodeAstcToBcn's decode and encode, into the readable buffer instead of the image.
+        astc_decoder_pass->AssembleInto(
+            info, 0, image.guest_size_bytes,
+            ASTCDecoderPass::Target{
+                .image = *verify_image,
+                .aspect_mask = VK_IMAGE_ASPECT_COLOR_BIT,
+                .initialized = false,
+                .level_view = [&verify_views](s32 level) { return *verify_views[level]; },
+                .wait = false,
+            },
+            map, swizzles);
+        for (u32 level = 0; level < levels; ++level) {
+            bc_encoder_pass->Encode(*verify_views[level], level_width(level), level_height(level),
+                                    layers, plan.bc3, verify_whole->buffer, verify_whole->offset,
+                                    total, level_offsets[level]);
+        }
+    }
+
+    // Each batch's copy must keep what the others wrote, so the image leaves UNDEFINED once, here.
+    TransitionImageLayout(image);
+    const auto encode_before_copy = [this] {
+        scheduler.Record([](vk::CommandBuffer cmdbuf) {
+            const VkMemoryBarrier barrier{
+                .sType = VK_STRUCTURE_TYPE_MEMORY_BARRIER,
+                .pNext = nullptr,
+                .srcAccessMask = VK_ACCESS_SHADER_WRITE_BIT,
+                .dstAccessMask = VK_ACCESS_TRANSFER_READ_BIT,
+            };
+            cmdbuf.PipelineBarrier(VK_PIPELINE_STAGE_COMPUTE_SHADER_BIT,
+                                   VK_PIPELINE_STAGE_TRANSFER_BIT, 0, barrier);
+        });
+    };
+    // The next encode writes the output buffer the last copy read.
+    const auto copy_before_encode = [this] {
+        scheduler.Record([](vk::CommandBuffer cmdbuf) {
+            const VkMemoryBarrier barrier{
+                .sType = VK_STRUCTURE_TYPE_MEMORY_BARRIER,
+                .pNext = nullptr,
+                .srcAccessMask = VK_ACCESS_TRANSFER_READ_BIT,
+                .dstAccessMask = VK_ACCESS_SHADER_WRITE_BIT,
+            };
+            cmdbuf.PipelineBarrier(VK_PIPELINE_STAGE_TRANSFER_BIT,
+                                   VK_PIPELINE_STAGE_COMPUTE_SHADER_BIT, 0, barrier);
+        });
+    };
+    boost::container::small_vector<VkBufferCopy, 16> verify_copies;
+    const auto copy_for_verify = [&] {
+        if (!verifying || verify_copies.empty()) {
+            return;
+        }
+        scheduler.Record([src = output->buffer, dst = verify_batched->buffer,
+                          regions = verify_copies](vk::CommandBuffer cmdbuf) {
+            cmdbuf.CopyBuffer(src, dst, regions);
+        });
+        verify_copies.clear();
+    };
+
+    u32 batch = 0;
+    if (!plan.bands) {
+        boost::container::small_vector<VideoCommon::BufferImageCopy, 16> copies;
+        for (u32 base = 0; base < layers; base += plan.scratch_layers, ++batch) {
+            const u32 count = (std::min)(plan.scratch_layers, layers - base);
+            // The swizzles describe one layer's levels and the decoder steps layer_stride per layer
+            // from the start of its input, so a batch is the same info with fewer layers, read from
+            // its first layer on.
+            ImageInfo batch_info = info;
+            batch_info.resources.layers = static_cast<s32>(count);
+            StagingBufferRef batch_map = map;
+            batch_map.offset += u64{base} * info.layer_stride;
+            const size_t skipped = static_cast<size_t>(u64{base} * info.layer_stride);
+            const size_t batch_size =
+                (std::min)(static_cast<size_t>(u64{count} * info.layer_stride),
+                           guest_size - (std::min)(guest_size, skipped));
+            astc_decoder_pass->AssembleInto(
+                batch_info, 0, batch_size,
+                ASTCDecoderPass::Target{
+                    .image = *scratch.image,
+                    .aspect_mask = VK_IMAGE_ASPECT_COLOR_BIT,
+                    // From the second batch on, after the previous encode read the decode image.
+                    .initialized = batch != 0,
+                    .level_view = [&scratch](s32 level) { return *scratch.views[level]; },
+                    .wait = false,
+                },
+                batch_map, swizzles);
+            if (batch != 0) {
+                copy_before_encode();
+            }
+            copies.clear();
+            u64 offset = 0;
+            for (u32 level = 0; level < levels; ++level) {
+                const u32 w = level_width(level);
+                const u32 h = level_height(level);
+                const u64 size = layer_bytes[level] * count;
+                bc_encoder_pass->Encode(*scratch.views[level], w, h, count, plan.bc3,
+                                        output->buffer, output->offset, plan.output_bytes, offset);
+                copies.push_back({
+                    .buffer_offset = offset,
+                    .buffer_size = size,
+                    .buffer_row_length = Common::DivCeil(w, 4U) * 4,
+                    .buffer_image_height = Common::DivCeil(h, 4U) * 4,
+                    .image_subresource{
+                        .base_level = static_cast<s32>(level),
+                        .base_layer = static_cast<s32>(base),
+                        .num_layers = static_cast<s32>(count),
+                    },
+                    .image_offset{0, 0, 0},
+                    .image_extent{w, h, 1},
+                });
+                if (verifying) {
+                    verify_copies.push_back(VkBufferCopy{
+                        .srcOffset = output->offset + offset,
+                        .dstOffset = verify_batched->offset + level_offsets[level] +
+                                     layer_bytes[level] * base,
+                        .size = size,
+                    });
+                }
+                offset += size;
+            }
+            encode_before_copy();
+            image.UploadMemory(output->buffer, output->offset, copies);
+            copy_for_verify();
+        }
+    } else {
+        const u32 tile_height = VideoCore::Surface::DefaultBlockHeight(info.format);
+        ImageInfo layer_info = info;
+        layer_info.resources.layers = 1;
+        for (u32 layer = 0; layer < layers; ++layer) {
+            StagingBufferRef layer_map = map;
+            layer_map.offset += u64{layer} * info.layer_stride;
+            const size_t skipped = static_cast<size_t>(u64{layer} * info.layer_stride);
+            // One layer is the whole guest data, as the whole path binds it (a single layer's
+            // layer_stride is padded, and 0 would bind nothing).
+            const size_t layer_size =
+                layers == 1 ? guest_size
+                            : (std::min)(static_cast<size_t>(info.layer_stride),
+                                         guest_size - (std::min)(guest_size, skipped));
+            for (u32 level = 0; level < levels; ++level) {
+                const VideoCommon::SwizzleParameters& swizzle = swizzles[level];
+                const u32 w = level_width(level);
+                const u32 h = level_height(level);
+                const u32 band_tiles = AstcBandTiles(swizzle, h, tile_height, plan.band_rows);
+                const u32 block_row_bytes =
+                    VideoCommon::Accelerated::MakeBlockLinearSwizzle2DParams(swizzle, info)
+                        .block_size;
+                for (u32 first = 0; first < swizzle.num_tiles.height;
+                     first += band_tiles, ++batch) {
+                    const u32 tiles = (std::min)(band_tiles, swizzle.num_tiles.height - first);
+                    const u32 y = first * tile_height;
+                    const u32 rows = (std::min)(tiles * tile_height, h - y);
+                    // From its row of GOB blocks on: the decoder writes it from row 0 of the
+                    // decode image, the encoder reads `rows` rows (a multiple of 4 but the last
+                    // band, which ends with the level) and `w` columns of it. Levels narrower than
+                    // level 0 decode into a wider image: the decoder's threads past the last tile
+                    // of a row (up to 7) then decode too, outside what the encoder reads.
+                    VideoCommon::SwizzleParameters band = swizzle;
+                    band.num_tiles.height = tiles;
+                    band.buffer_offset +=
+                        size_t{first >> (Tegra::Texture::GOB_SIZE_Y_SHIFT + swizzle.block.height)} *
+                        block_row_bytes;
+                    astc_decoder_pass->AssembleInto(
+                        layer_info, 0, layer_size,
+                        ASTCDecoderPass::Target{
+                            .image = *scratch.image,
+                            .aspect_mask = VK_IMAGE_ASPECT_COLOR_BIT,
+                            .initialized = batch != 0,
+                            .level_view = [&scratch](s32) { return *scratch.views[0]; },
+                            .wait = false,
+                        },
+                        layer_map, std::span<const VideoCommon::SwizzleParameters>(&band, 1));
+                    if (batch != 0) {
+                        copy_before_encode();
+                    }
+                    const u64 size = u64{Common::DivCeil(w, 4U)} * Common::DivCeil(rows, 4U) *
+                                     block_bytes;
+                    bc_encoder_pass->Encode(*scratch.views[0], w, rows, 1, plan.bc3,
+                                            output->buffer, output->offset, plan.output_bytes, 0);
+                    const VideoCommon::BufferImageCopy copy{
+                        .buffer_offset = 0,
+                        .buffer_size = size,
+                        .buffer_row_length = Common::DivCeil(w, 4U) * 4,
+                        .buffer_image_height = Common::DivCeil(rows, 4U) * 4,
+                        .image_subresource{
+                            .base_level = static_cast<s32>(level),
+                            .base_layer = static_cast<s32>(layer),
+                            .num_layers = 1,
+                        },
+                        .image_offset{0, static_cast<s32>(y), 0},
+                        .image_extent{w, rows, 1},
+                    };
+                    if (verifying) {
+                        verify_copies.push_back(VkBufferCopy{
+                            .srcOffset = output->offset,
+                            .dstOffset = verify_batched->offset + level_offsets[level] +
+                                         layer_bytes[level] * layer +
+                                         u64{y / 4} * Common::DivCeil(w, 4U) * block_bytes,
+                            .size = size,
+                        });
+                    }
+                    encode_before_copy();
+                    image.UploadMemory(output->buffer, output->offset,
+                                       std::span<const VideoCommon::BufferImageCopy>(&copy, 1));
+                    copy_for_verify();
+                }
+            }
+        }
+    }
+    const VkDeviceSize scratch_memory = scratch.image.MemorySize();
+    scratch.tick = scheduler.CurrentTick();
+    pending_transcodes.emplace_back(std::move(scratch));
+    const auto recorded = std::chrono::steady_clock::now();
+    const auto to_mib = [](u64 bytes) { return static_cast<double>(bytes) / (1 << 20); };
+    static u32 logged = 0;
+    ++logged;
+    if (logged <= 32 || (logged & (logged - 1)) == 0) {
+        LOG_INFO(Render_Vulkan,
+                 "EDEN_UP_ASTC_BATCH: {:#x} {}x{}x{} ({} levels, {}): {} batches of up to {} {}, "
+                 "peak scratch {:.1f} MiB (decode image {:.1f}, output {:.1f}) instead of {:.1f} "
+                 "MiB, recorded in {} us ({} so far)",
+                 image.gpu_addr, width, height, layers, levels, plan.bc3 ? "BC3" : "BC1", batch,
+                 plan.bands ? plan.scratch_height : plan.scratch_layers,
+                 plan.bands ? "rows" : "layers",
+                 to_mib(scratch_memory + plan.output_bytes), to_mib(scratch_memory),
+                 to_mib(plan.output_bytes), to_mib(plan.full_bytes),
+                 std::chrono::duration_cast<std::chrono::microseconds>(recorded - start).count(),
+                 logged);
+    }
+    if (!verifying) {
+        // One submit per texture, as AssembleInto's after the whole decode.
+        if (!scheduler.HoldSubmissionForZpass()) {
+            scheduler.Flush();
+        }
+        return;
+    }
+    verified[mode] = true;
+    scheduler.Record([](vk::CommandBuffer cmdbuf) {
+        const VkMemoryBarrier barrier{
+            .sType = VK_STRUCTURE_TYPE_MEMORY_BARRIER,
+            .pNext = nullptr,
+            .srcAccessMask = VK_ACCESS_TRANSFER_WRITE_BIT | VK_ACCESS_SHADER_WRITE_BIT,
+            .dstAccessMask = VK_ACCESS_HOST_READ_BIT,
+        };
+        cmdbuf.PipelineBarrier(
+            VK_PIPELINE_STAGE_TRANSFER_BIT | VK_PIPELINE_STAGE_COMPUTE_SHADER_BIT,
+            VK_PIPELINE_STAGE_HOST_BIT, 0, barrier);
+    });
+    scheduler.Finish(); // EDEN_UP_ASTC_BATCH_VERIFY only
+    const auto waited = std::chrono::duration_cast<std::chrono::microseconds>(
+                            std::chrono::steady_clock::now() - recorded)
+                            .count();
+    const std::span<const u8> whole = verify_whole->mapped_span.first(total);
+    const std::span<const u8> batched = verify_batched->mapped_span.first(total);
+    const auto whole_it = std::ranges::mismatch(whole, batched).in1;
+    if (whole_it == whole.end()) {
+        LOG_INFO(Render_Vulkan,
+                 "EDEN_UP_ASTC_BATCH_VERIFY: {:#x} {}x{}x{} ({} levels, {}): the {} {} wrote the "
+                 "same {} bytes as the whole conversion (GPU wait {} us)",
+                 image.gpu_addr, width, height, layers, levels, plan.bc3 ? "BC3" : "BC1", batch,
+                 plan.bands ? "row bands" : "layer batches", total, waited);
+        return;
+    }
+    const u64 at = static_cast<u64>(whole_it - whole.begin());
+    u32 level = 0;
+    while (level + 1 < levels && level_offsets[level + 1] <= at) {
+        ++level;
+    }
+    u64 differing = 0;
+    for (u64 i = at; i < total; ++i) {
+        differing += whole[i] != batched[i] ? 1 : 0;
+    }
+    LOG_ERROR(Render_Vulkan,
+              "EDEN_UP_ASTC_BATCH_VERIFY: {:#x} {}x{}x{} ({} levels, {}): {} of {} bytes differ "
+              "from the whole conversion, the first at byte {} (level {}, layer {}), {} {}",
+              image.gpu_addr, width, height, layers, levels, plan.bc3 ? "BC3" : "BC1", differing,
+              total, at, level, (at - level_offsets[level]) / layer_bytes[level], batch,
+              plan.bands ? "row bands" : "layer batches");
+}
