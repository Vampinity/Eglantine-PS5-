+// EDEN_UP_ASTC_BATCH_MIB: the ASTC tile rows in one band of a level (TranscodeAstcBatched), at
+// most `rows` texel rows; the whole level when it fits. A band starts on a row of GOB blocks (8 <<
+// block height tile rows, block_size bytes of guest data), so the decoder's block-linear addressing
+// from there on is its addressing of the whole level less that offset. 0: not one row fits.
+[[nodiscard]] u32 AstcBandTiles(const VideoCommon::SwizzleParameters& swizzle, u32 level_height,
+                                u32 tile_height, u32 rows) {
+    if (level_height <= rows) {
+        return swizzle.num_tiles.height;
+    }
+    const u32 granule = 1U << (Tegra::Texture::GOB_SIZE_Y_SHIFT + swizzle.block.height);
+    return rows / tile_height / granule * granule;
+}
+
+// EDEN_UP_ASTC_BATCH_MIB: how TranscodeAstcBatched splits `info`; nothing when the switch is off,
+// when the whole decode image and BC output fit the budget (TranscodeAstcToBcn as before), or when
+// it cannot be split (also as before, logged). Layer batches when one layer with all its levels
+// fits: the decode image is the texture's shape with fewer layers (zortos293/Lichii #1083).
+// Otherwise row bands, one layer and level at a time, through a decode image as wide as level 0
+// and as tall as the budget allows: Ocarina of Time's single-layer 6144x6144 ASTC 5x5 ground
+// texture (13 levels) has a 192 MiB decode image, 144 MiB of it level 0, which layers can't split.
+[[nodiscard]] std::optional<TextureCacheRuntime::AstcBatchPlan> PlanAstcBatches(
+    const ImageInfo& info, std::span<const VideoCommon::SwizzleParameters> swizzles, bool bc3) {
+    const u64 budget = VideoCommon::AstcBatchBudgetBytes();
+    if (budget == 0) {
+        return std::nullopt;
+    }
+    const u32 width = info.size.width;
+    const u32 height = info.size.height;
+    const u32 levels = static_cast<u32>(info.resources.levels);
+    const u32 layers = static_cast<u32>(info.resources.layers);
+    const u64 block_bytes = bc3 ? 16 : 8;
+    const auto output_bytes = [block_bytes](u32 w, u32 rows) {
+        return u64{Common::DivCeil(w, 4U)} * Common::DivCeil(rows, 4U) * block_bytes;
+    };
+    u64 layer_decode = 0;
+    u64 layer_output = 0;
+    for (u32 level = 0; level < levels; ++level) {
+        const u32 w = (std::max)(width >> level, 1U);
+        const u32 h = (std::max)(height >> level, 1U);
+        layer_decode += u64{w} * h * 4;
+        layer_output += output_bytes(w, h);
+    }
+    TextureCacheRuntime::AstcBatchPlan plan{};
+    plan.bc3 = bc3;
+    plan.full_bytes = (layer_decode + layer_output) * layers;
+    if (plan.full_bytes <= budget) {
+        return std::nullopt;
+    }
+    const auto stays_whole = [&](const char* reason) {
+        static std::atomic<u32> logged{0};
+        const u32 count = ++logged;
+        if (count <= 8 || (count & (count - 1)) == 0) {
+            LOG_INFO(Render_Vulkan,
+                     "EDEN_UP_ASTC_BATCH: {}x{}x{} ({} levels) needs {} MiB to convert, over {} "
+                     "MiB, and stays whole: {} ({} so far)",
+                     width, height, layers, levels, plan.full_bytes >> 20, budget >> 20, reason,
+                     count);
+        }
+        return std::optional<TextureCacheRuntime::AstcBatchPlan>{};
+    };
+    if (swizzles.size() != levels) {
+        return stays_whole("its upload is not every level");
+    }
+    for (u32 level = 0; level < levels; ++level) {
+        if (swizzles[level].level != static_cast<s32>(level)) {
+            return stays_whole("its upload levels are out of order");
+        }
+    }
+    if (layer_decode + layer_output <= budget) {
+        const u32 per_batch = static_cast<u32>(
+            (std::min)(u64{layers}, budget / (layer_decode + layer_output)));
+        plan.bands = false;
+        plan.scratch_width = width;
+        plan.scratch_height = height;
+        plan.scratch_levels = levels;
+        plan.scratch_layers = per_batch;
+        plan.band_rows = 0;
+        plan.scratch_bytes = layer_decode * per_batch;
+        plan.output_bytes = layer_output * per_batch;
+        plan.batches = Common::DivCeil(layers, per_batch);
+        return plan;
+    }
+    const u32 tile_height = VideoCore::Surface::DefaultBlockHeight(info.format);
+    // Four rows of level 0, decoded and encoded.
+    const u64 four_rows = u64{width} * 4 * 4 + output_bytes(width, 4);
+    const u32 rows = static_cast<u32>((std::min)(u64{height}, budget / four_rows * 4));
+    u32 scratch_rows = 0;
+    u64 largest_output = 0;
+    u32 batches = 0;
+    for (u32 level = 0; level < levels; ++level) {
+        const u32 w = (std::max)(width >> level, 1U);
+        const u32 h = (std::max)(height >> level, 1U);
+        const u32 band_tiles = AstcBandTiles(swizzles[level], h, tile_height, rows);
+        if (band_tiles == 0) {
+            return stays_whole("one row of GOB blocks is over the budget");
+        }
+        const u32 band_rows = (std::min)(band_tiles * tile_height, h);
+        scratch_rows = (std::max)(scratch_rows, band_rows);
+        largest_output = (std::max)(largest_output, output_bytes(w, band_rows));
+        batches += Common::DivCeil(swizzles[level].num_tiles.height, band_tiles);
+    }
+    plan.bands = true;
+    plan.scratch_width = width;
+    plan.scratch_height = scratch_rows;
+    plan.scratch_levels = 1;
+    plan.scratch_layers = 1;
+    plan.band_rows = rows;
+    plan.scratch_bytes = u64{width} * scratch_rows * 4;
+    plan.output_bytes = largest_output;
+    plan.batches = batches * layers;
+    if (plan.scratch_bytes + plan.output_bytes > budget) {
+        return stays_whole("its rounded rows are over the budget");
+    }
+    return plan;
+}
+
