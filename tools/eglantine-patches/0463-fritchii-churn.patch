diff --git a/src/video_core/churn_counters.h b/src/video_core/churn_counters.h
new file mode 100644
index 0000000..ca8a847
--- /dev/null
+++ b/src/video_core/churn_counters.h
@@ -0,0 +1,154 @@
+// SPDX-FileCopyrightText: Copyright 2026 Eden Emulator Project
+// SPDX-License-Identifier: GPL-3.0-or-later
+
+#pragma once
+
+#include <array>
+#include <atomic>
+#include <chrono>
+#include <cstddef>
+
+#include "common/common_types.h"
+#include "common/logging.h"
+#include "common/pe_switch.h"
+
+/// EDEN_UP_FRITCHII_CHURN=1 (off unless set; Fritchii dcbd696438 + 55dcce4217, fable_answer_16 4):
+/// what the caches make and destroy, the per-frame churn of objects that should be reused (render
+/// targets at drifted addresses, buffers joined over drifted ranges, device memory blocks).
+/// Counted only with the switch (one relaxed add where an object is made or destroyed, next to
+/// far larger work); TextureCache::TickFrame logs "Churn (600 frames)", and
+/// RasterizerVulkan::Clear logs clears over 300 us with what the texture cache made for them.
+namespace VideoCommon::Churn {
+
+enum Counter : size_t {
+    ImagesCreated,
+    ImagesDeleted,
+    ImageViewsCreated,
+    ImageViewsDestroyed,
+    FramebuffersCreated, ///< Vulkan Framebuffer::CreateFramebuffer
+    BuffersCreated,      ///< BufferCache::CreateBuffer
+    BuffersDeleted,      ///< BufferCache::DeleteBuffer
+    BuffersJoined,       ///< BufferCache::JoinOverlap (each also deletes the joined buffer)
+    BufferJoinBytes,     ///< Bytes copied by those joins
+    StagingBuffers,      ///< StagingBufferPool::CreateStagingBuffer
+    StagingBytes,
+    DeviceAllocations,   ///< vkAllocateMemory by the allocator (blocks and dedicated memory)
+    DeviceFrees,
+    DescriptorPools,     ///< New descriptor pools (a bank ran out)
+    Count,
+};
+
+[[nodiscard]] inline bool Enabled() {
+    static const bool enabled = Common::PeSwitch("EDEN_UP_FRITCHII_CHURN");
+    return enabled;
+}
+
+inline std::array<std::atomic<u64>, Count> g_counters{};
+
+inline void Add(Counter counter, u64 amount = 1) {
+    if (Enabled()) {
+        g_counters[counter].fetch_add(amount, std::memory_order_relaxed);
+    }
+}
+
+/// The counts so far, left as they are.
+[[nodiscard]] inline std::array<u64, Count> Peek() {
+    std::array<u64, Count> values{};
+    for (size_t i = 0; i < Count; ++i) {
+        values[i] = g_counters[i].load(std::memory_order_relaxed);
+    }
+    return values;
+}
+
+/// The counts since the last call, and resets them.
+[[nodiscard]] inline std::array<u64, Count> Take() {
+    std::array<u64, Count> values{};
+    for (size_t i = 0; i < Count; ++i) {
+        values[i] = g_counters[i].exchange(0, std::memory_order_relaxed);
+    }
+    return values;
+}
+
+/// RasterizerVulkan::Clear with the switch on (Fritchii 55dcce4217, with these counters in place
+/// of fc40c591e9's per-join timers): a clear over 300 us is logged with the flush and render
+/// target time and what was made while its render targets were set up, at most 40 per 5 s.
+class SlowClear {
+public:
+    using Clock = std::chrono::steady_clock;
+
+    SlowClear() : start{Clock::now()} {}
+    void Flushed() {
+        flushed = Clock::now();
+    }
+    void TargetsBegin() {
+        before = Peek();
+    }
+    void TargetsEnd(u64 rt0, u32 width, u32 height, u32 format, u64 zeta, bool zeta_on,
+                    u32 zeta_format, u32 surface, u32 layers) {
+        targets = Clock::now();
+        after = Peek();
+        target = {rt0, width, height, format, zeta, zeta_on, zeta_format, surface, layers};
+        has_targets = true;
+    }
+    ~SlowClear() {
+        const auto end = Clock::now();
+        if (end - start < std::chrono::microseconds{300}) {
+            return;
+        }
+        static std::atomic<s64> window_start{};
+        static std::atomic<u32> logged{};
+        const s64 now_ms =
+            std::chrono::duration_cast<std::chrono::milliseconds>(end.time_since_epoch()).count();
+        if (now_ms - window_start.load(std::memory_order_relaxed) > 5000) {
+            window_start.store(now_ms, std::memory_order_relaxed);
+            logged.store(0, std::memory_order_relaxed);
+        }
+        if (logged.fetch_add(1, std::memory_order_relaxed) >= 40) {
+            return;
+        }
+        const auto us = [](auto d) {
+            return static_cast<s64>(std::chrono::duration_cast<std::chrono::microseconds>(d).count());
+        };
+        const s64 flush_us = flushed != Clock::time_point{} ? us(flushed - start) : -1;
+        if (!has_targets) {
+            LOG_INFO(Render_Vulkan, "Slow clear {} us (flush work {} us), no render targets set up",
+                     us(end - start), flush_us);
+            return;
+        }
+        const auto made = [this](Counter counter) { return after[counter] - before[counter]; };
+        LOG_INFO(Render_Vulkan,
+                 "Slow clear {} us (flush work {} us, render targets {} us): rt0 {:#x} {}x{} fmt "
+                 "{:#x}, zeta {:#x} {} fmt {:#x}, surface {:#x}, layers {}; while the targets were "
+                 "set up: images {} created, {} deleted, views {} created, {} destroyed, "
+                 "framebuffers {} created, device memory {} allocations, {} frees",
+                 us(end - start), flush_us, us(targets - flushed), target.rt0, target.width,
+                 target.height, target.format, target.zeta, target.zeta_on ? "on" : "off",
+                 target.zeta_format, target.surface, target.layers, made(ImagesCreated),
+                 made(ImagesDeleted), made(ImageViewsCreated), made(ImageViewsDestroyed),
+                 made(FramebuffersCreated), made(DeviceAllocations), made(DeviceFrees));
+    }
+    SlowClear(const SlowClear&) = delete;
+    SlowClear& operator=(const SlowClear&) = delete;
+
+private:
+    struct Target {
+        u64 rt0{};
+        u32 width{};
+        u32 height{};
+        u32 format{};
+        u64 zeta{};
+        bool zeta_on{};
+        u32 zeta_format{};
+        u32 surface{};
+        u32 layers{};
+    };
+    Clock::time_point start;
+    Clock::time_point flushed{};
+    Clock::time_point targets{};
+    std::array<u64, Count> before{};
+    std::array<u64, Count> after{};
+    Target target{};
+    bool has_targets{};
+};
+
+} // namespace VideoCommon::Churn
