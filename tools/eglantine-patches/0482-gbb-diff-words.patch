+// EDEN_GBB_DIFF_WORDS=1 (GrowingBlackBeans, with EDEN_NX2_FETCH_COUNT): which words of a command
+// entry change after submit, by their role in the submitted words. Answers which methods the game
+// patches after submitting (issue 21: "which words legitimately change after submit?").
+bool DiffWordsOn() {
+    static const bool on = [] {
+        const char* value = std::getenv("EDEN_GBB_DIFF_WORDS");
+        return value != nullptr && value[0] == '1';
+    }();
+    return on;
+}
+// Per method (13 bits), the words that differed: [0] as data, [1] as the method's header.
+std::array<std::array<std::atomic<u32>, 2>, 8192> g_diff_by_method{};
+std::atomic<u32> g_diff_carried{0};   // data of a method opened in an earlier entry
+std::atomic<u32> g_diff_entries{0};
+std::atomic<u32> g_diff_logged{0};
+
+struct DiffRole {
+    u32 method;  // ~0: data carried in from an earlier entry
+    u32 subchannel;
+    bool header;
+};
+
+// The role of each word of `words` (n words; `carried` data words open at its start), walking the
+// way ProcessCommands parses: increasing, non-increasing, increase-once and inline headers.
+void DiffRoles(const CommandHeader* words, size_t n, u32 carried, std::vector<DiffRole>& roles) {
+    roles.assign(n, DiffRole{~0U, 0, false});
+    size_t i = (std::min)(static_cast<size_t>(carried), n);
+    while (i < n) {
+        const CommandHeader header = words[i];
+        const u32 method = header.method;
+        const u32 subchannel = header.subchannel;
+        roles[i] = DiffRole{method, subchannel, true};
+        ++i;
+        const auto mode = header.mode.Value();
+        if (mode == SubmissionMode::Inline) {
+            continue;
+        }
+        const u32 count = header.arg_count;
+        for (u32 k = 0; k < count && i < n; ++k, ++i) {
+            u32 m = method;
+            if (mode == SubmissionMode::Increasing || mode == SubmissionMode::IncreasingOld) {
+                m = method + k;
+            } else if (mode == SubmissionMode::IncreaseOnce) {
+                m = k == 0 ? method : method + 1;
+            }
+            roles[i] = DiffRole{m & 0x1fff, subchannel, false};
+        }
+    }
+}
+
+void ReportDiffWords() {
+    if (!DiffWordsOn()) {
+        return;
+    }
+    std::vector<std::tuple<u32, u32, u32>> top;  // total, method, header share
+    for (u32 m = 0; m < g_diff_by_method.size(); ++m) {
+        const u32 data = g_diff_by_method[m][0].load(std::memory_order_relaxed);
+        const u32 head = g_diff_by_method[m][1].load(std::memory_order_relaxed);
+        if (data + head != 0) {
+            top.emplace_back(data + head, m, head);
+        }
+    }
+    std::sort(top.begin(), top.end(), std::greater<>());
+    std::string line;
+    for (size_t k = 0; k < top.size() && k < 16; ++k) {
+        line += fmt::format(" | m{:#x} {} ({} hdr)", std::get<1>(top[k]), std::get<0>(top[k]),
+                            std::get<2>(top[k]));
+    }
+    LOG_WARNING(HW_GPU, "DIFF_WORDS totals: {} entries, carried data {}{}",
+                g_diff_entries.load(std::memory_order_relaxed),
+                g_diff_carried.load(std::memory_order_relaxed), line);
+}
+
 void ReportFetchTotals() {
     std::string totals;
     for (size_t i = 0; i < fetch_reason_names.size(); ++i) {
@@ -137,6 +213,7 @@ void ReportFetchTotals() {
                 totals, fetch_refreshed_lists.load(std::memory_order_relaxed),
                 fetch_dropped_words.load(std::memory_order_relaxed),
                 Tegra::g_nx2_new_written_pages.load(std::memory_order_relaxed));
+    ReportDiffWords();
 }
 
