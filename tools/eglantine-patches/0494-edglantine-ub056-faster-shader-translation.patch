     } else {
         func();
     }
 }
 
+void ComputePipeline::RunBuild() {
+    // The first queued copy to get here builds; a later one finds the claim taken and returns.
+    if (build_claimed.exchange(true)) {
+        return;
+    }
+    try {
+        build_task();
+    } catch (...) {
+        {
+            std::scoped_lock lock{build_mutex};
+            is_built = true;
+            build_condvar.notify_one();
+        }
+        build_task = {};
+        throw;
+    }
+    build_task = {};
+}
+
+void ComputePipeline::BuildFirst() {
+    // Off, or built on the calling thread already: nothing is queued. Asked once per pipeline;
+    // a build that a worker has begun is not queued again.
+    if (build_worker == nullptr || build_claimed.load(std::memory_order::relaxed) ||
+        build_asked_first.exchange(true)) {
+        return;
+    }
+    build_worker->QueueWorkFront([this] { RunBuild(); });
+}
