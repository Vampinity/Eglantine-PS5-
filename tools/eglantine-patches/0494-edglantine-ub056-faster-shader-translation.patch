-    if (thread_worker) {
+    // EDEN_UP_FAST_CFG=1: the build is held by the pipeline and claimed once, so a dispatch that
+    // waits for it can move it to the front of the builder queue (BuildFirst). It still runs on
+    // a VkPipelineBuilder thread: only those may wait for heap memory (EDEN_UP_HEAP_WAIT_MS),
+    // and the scheduler thread keeps its locks out of the driver's compiler.
+    static const bool fast_cfg = Common::PeSwitch("EDEN_UP_FAST_CFG");
+    if (fast_cfg) {
+        build_task = std::move(func);
+        if (thread_worker) {
+            build_worker = thread_worker;
+            thread_worker->QueueWork([this] { RunBuild(); });
+        } else {
+            RunBuild();
+        }
+    } else if (thread_worker) {
