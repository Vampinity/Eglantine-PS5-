@@ -71,7 +72,10 @@ public:
                             break;
                         }
                         task = std::move(requests.front());
-                        requests.pop();
+                        requests.pop_front();
+                        if (front_queued > 0) {
+                            --front_queued; // it was a QueueWorkFront entry
+                        }
                     }
                     if constexpr (with_state) {
                         task(&state);
@@ -102,7 +106,22 @@ public:
     void QueueWork(Task work) {
         {
             std::unique_lock lock{queue_mutex};
-            requests.emplace(std::move(work));
+            requests.emplace_back(std::move(work));
+            ++work_scheduled;
+        }
+        condition.notify_one();
+    }
+
+    /// EDEN_UP_FAST_CFG: the next free worker takes this before the work queued with
+    /// QueueWork (a pipeline a draw waits for, behind hundreds of builds). Front entries keep
+    /// their arrival order among themselves, so a burst P1..PN is taken P1 first, the pipeline
+    /// the first wait is for. The work still runs on a worker thread.
+    void QueueWorkFront(Task work) {
+        {
+            std::unique_lock lock{queue_mutex};
+            const auto at = static_cast<typename std::deque<Task>::difference_type>(front_queued);
+            requests.emplace(requests.begin() + at, std::move(work));
+            ++front_queued;
             ++work_scheduled;
         }
         condition.notify_one();
@@ -121,7 +140,10 @@ public:
     }

 private:
-    std::queue<Task> requests;
+    std::deque<Task> requests;
+    /// How many QueueWorkFront entries lead requests, in arrival order. Guarded by queue_mutex;
+    /// stays 0 unless QueueWorkFront is used (EDEN_UP_FAST_CFG).
+    size_t front_queued{};
     std::mutex queue_mutex;
     std::condition_variable_any condition;
     std::condition_variable wait_condition;
