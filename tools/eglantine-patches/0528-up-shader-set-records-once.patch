+bool ReadRecords(
+    const std::filesystem::path& path, u32 cache_version,
+    const std::function<void(std::ifstream&, std::vector<FileEnvironment>)>& on_graphics) {
+    // One record's bytes at a time, read through an ifstream as the pipeline cache's callbacks
+    // and FileEnvironment::Deserialize expect (they only read forward).
+    struct MemBuf final : std::streambuf {
+        void Set(char* begin, size_t size) { setg(begin, begin, begin + size); }
+        pos_type seekoff(off_type off, std::ios_base::seekdir dir,
+                         std::ios_base::openmode) override {
+            char* const to = dir == std::ios_base::beg   ? eback() + off
+                             : dir == std::ios_base::cur ? gptr() + off
+                                                         : egptr() + off;
+            if (to < eback() || to > egptr()) return pos_type(off_type(-1));
+            setg(eback(), to, egptr());
+            return pos_type(to - eback());
+        }
+        pos_type seekpos(pos_type pos, std::ios_base::openmode mode) override {
+            return seekoff(off_type(pos), std::ios_base::beg, mode);
+        }
+    };
+    try {
+        std::ifstream file(path, std::ios::binary | std::ios::ate);
+        if (!file.is_open()) return true;
+        file.exceptions(std::ifstream::failbit | std::ifstream::badbit);
+        const u64 end = static_cast<u64>(file.tellg());
+        constexpr u64 TrailerBytes = 6 * 8 + 8;
+        if (end < 12 + TrailerBytes) return true;
+        const auto get = [&file](auto& value) {
+            file.read(reinterpret_cast<char*>(&value), sizeof(value));
+        };
+        const auto seek = [&file](u64 at) { file.seekg(static_cast<std::streamoff>(at)); };
+        std::array<char, 8> magic{}, tail{};
+        u32 version{};
+        seek(0);
+        file.read(magic.data(), magic.size());
+        get(version);
+        if (std::memcmp(magic.data(), SetMagic, 8) != 0 || version != cache_version) {
+            return true; // another layout's or another version's file: nothing to read
+        }
+        std::array<u64, 6> where{};
+        seek(end - TrailerBytes);
+        get(where);
+        file.read(tail.data(), tail.size());
+        const u64 records = where[1], facts_at = where[2], facts = where[3];
+        const u64 programs_at = where[4], programs = where[5];
+        if (std::memcmp(tail.data(), SetMagic, 8) != 0 || where[0] != 12 || facts_at < 12 ||
+            programs_at < facts_at || programs_at > end - TrailerBytes) {
+            return false;
+        }
+        struct Fact { u64 at; u32 size; u32 program; };
+        struct Code { u64 at; u64 size; };
+        std::unordered_map<u32, Fact> fact_at;
+        std::unordered_map<u32, Code> code_at;
+        fact_at.reserve(facts);
+        code_at.reserve(programs);
+        u64 at = facts_at;
+        for (u64 i = 0; i < facts; ++i) {
+            u32 id{}, program{}, size{};
+            seek(at);
+            get(id); get(program); get(size);
+            fact_at[id] = Fact{at + 12, size, program};
+            at += 12 + size;
+            if (at > programs_at) return false;
+        }
+        at = programs_at;
+        for (u64 i = 0; i < programs; ++i) {
+            u32 index{};
+            u64 size{};
+            seek(at);
+            get(index); get(size);
+            code_at[index] = Code{at + 12, size};
+            at += 12 + size;
+            if (at > end - TrailerBytes) return false;
+        }
+        std::vector<char> bytes, fact, code;
+        at = 12;
+        for (u64 i = 0; i < records; ++i) {
+            u32 count{}, key_size{};
+            std::array<u32, 6> ids{};
+            seek(at);
+            get(count);
+            if (count == 0 || count > ids.size()) return false;
+            file.read(reinterpret_cast<char*>(ids.data()), count * sizeof(u32));
+            get(key_size);
+            if (key_size > 65536) return false;
+            bytes.resize(sizeof(u32));
+            std::memcpy(bytes.data(), &count, sizeof(count));
+            const u64 key_at = at + 4 + count * 4 + 4;
+            at = key_at + key_size;
+            for (u32 n = 0; n < count; ++n) {
+                const Fact& f = fact_at.at(ids[n]);
+                const Code& c = code_at.at(f.program);
+                fact.resize(f.size);
+                seek(f.at);
+                file.read(fact.data(), fact.size());
+                code.resize(c.size);
+                seek(c.at);
+                file.read(code.data(), code.size());
+                AppendEnvironment(bytes, fact, code);
+            }
+            const size_t key_in = bytes.size();
+            bytes.resize(key_in + key_size);
+            seek(key_at);
+            file.read(bytes.data() + key_in, key_size);
+            MemBuf memory;
+            memory.Set(bytes.data(), bytes.size());
+            std::ifstream in;
+            in.std::basic_ios<char>::rdbuf(&memory);
+            in.exceptions(std::ifstream::failbit | std::ifstream::badbit);
+            u32 num_envs{};
+            in.read(reinterpret_cast<char*>(&num_envs), sizeof(num_envs));
+            std::vector<FileEnvironment> envs(num_envs);
+            for (FileEnvironment& env : envs) env.Deserialize(in);
+            on_graphics(in, std::move(envs));
+        }
+        return true;
+    } catch (const std::exception&) {
+        // A read past the end, no memory, or whatever the callback threw: the reading stops.
+        return false;
+    }
+}
 } // namespace VideoCommon::ShaderSet
