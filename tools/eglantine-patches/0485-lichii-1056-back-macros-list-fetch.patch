diff --git a/src/video_core/dma_pusher.cpp b/src/video_core/dma_pusher.cpp
index 2431217..78459ae 100644
--- a/src/video_core/dma_pusher.cpp
+++ b/src/video_core/dma_pusher.cpp
@@ -446,15 +446,25 @@ static u64 NoteFetchRecheck(GPUVAddr address, u64 words, int mode) {
 // before the last host-level wait. LISTSKIP: an entry that begins between methods
 // (`command_entry`) skips it while no copy engine work is queued (`skipped`). Returns whether any
 // of the work it waited for was still queued.
+// EDEN_UP_L1056_LIST_FETCH / EDEN_UP_L1055_LIST_FETCH (GpuSplit::ListFetchRule, zortos293/Lichii
+// #1056 and #1055): the target instead of LISTSYNC's (or T84's): the last writer sent before the
+// last host-level wait (#1056), or everything sent before that wait (#1055).
 static bool WaitForListWriters(VideoCommon::GpuSplit& split, bool command_entry, bool& skipped) {
     const int mode = VideoCommon::GpuSplit::ListSyncMode();
