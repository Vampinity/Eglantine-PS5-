+bool RasterizerVulkan::IsGpuTickDone(u64 tick) {
+    if (scheduler.IsFree(tick)) {
+        return true;
+    }
+    auto& split = VideoCommon::GpuSplit::Get();
+    // Only the split's back makes a deferred submission (Scheduler::DeferFlush). With the back
+    // stopped nothing will: answer done, and the read again takes the waiting path (no pending
+    // tick without the split), which submits it itself (BufferCacheRuntime::WaitSubmittedTick).
+    if (!split.Active() || !split.BackRunning()) {
+        return true;
+    }
+    if (!scheduler.IsSubmitted(tick)) {
+        split.RequestIdleHook();
+    }
+    scheduler.GetMasterSemaphore().Refresh();
+    return scheduler.IsFree(tick);
+}
+
