     void BindHostIndexBuffer();
 
+    /// EDEN_UP_BUFFER_USE_MARKS=1 (MythosOfs/Orchid 225ed15fb3), read once.
+    [[nodiscard]] static bool BufferUseMarks();
+
+    /// EDEN_UP_BUFFER_USE_MARKS: marks an upload's bytes as used by the command buffer.
+    void MarkUploaded(Buffer& buffer, std::span<const BufferCopy> copies);
+
     void BindHostVertexBuffers();
 
     void BindHostDrawIndirectBuffers();
