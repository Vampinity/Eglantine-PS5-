diff --git a/src/video_core/nx2_query_light.h b/src/video_core/nx2_query_light.h
new file mode 100644
index 0000000..a56d708
--- /dev/null
+++ b/src/video_core/nx2_query_light.h
@@ -0,0 +1,271 @@
+// SPDX-FileCopyrightText: Copyright 2026 Eden Emulator Project
+// SPDX-License-Identifier: GPL-3.0-or-later
+
+#pragma once
+
+#include <array>
+#include <atomic>
+
+#include "common/common_types.h"
+#include "common/logging.h"
+#include "common/pe_switch.h"
+#include "video_core/nx2_fast_draw.h"
+#include "video_core/nx2_profile.h"
+
+/// What Ocarina of Time (Switch 2) does around its draws, and two switches for it.
+///
+/// The game culls with NVN2's conditional rendering. For an object it tests: reset the Z pass
+/// counter (clear_report_value), draw, then report the count (report_semaphore, long form
+/// ZPassPixelCount64, not fence-flagged) into a counter buffer. Where it uses a result: NVN2's
+/// macro 0x142/0x143 sets the MME memory address (3D words 0x154/0x155), reads two counters with
+/// MME_DMA_READ_FIFOED (word 0x158, 6 words: a counter, its timestamp, the next counter),
+/// compares them in the macro and writes render_enable.mode True or False. No guest render
+/// condition reaches the host (EDEN_NX2_COND_TRACE counts 0), and nothing reads a report on the
+/// host GPU.
+///
+/// The emulator's cost for a report is small on the thread that runs it (the query cache queues
+/// the value for the next fence). What costs is that both steps end fast draw reuse
+/// (EDEN_UP_FAST_DRAW, nx2_fast_draw.h): the report as a 3D method with side effects, the macro's
+/// read as a deferred call on the split's back and as changes of words 0x154/0x155. In the Kokiri
+/// walk those were the last break before 8,200 to 16,100 of 20,500 to 27,000 draws a second
+/// (run489: method 0x6c3 4,674 to 8,755, deferred call 3,528 to 7,342).
+///
+/// EDEN_UP_QUERY_LIGHT=1 (exact "1", with EDEN_UP_FAST_DRAW=1) keeps reuse across them. It needs
+/// EDEN_UP_FAST_DRAW_OOT_EXEMPT=1 beside it to show anything: the counter reset and the
+/// render_enable write that surround every test are exempt only there.
+/// - A report_semaphore.query write that only queues a Z pass count (Release or ReportOnly of
+///   ZPassPixelCount64, not a short release) ends no reuse, and neither do the report's address
+///   and payload words. Such a report records an EndQuery and queues the value; the value reaches
+///   guest memory on the fencing thread, which ends reuse itself before and after
+///   (Reason::Fence), and a sync of pending reports ends the render pass, which changes the
+///   recording epoch TakeReusableDraw checks. Every other report (payload releases, fences,
+///   counters without a streamer, which are written at once) still ends reuse.
+/// - The MME memory words 0x154 to 0x158 end no reuse while macros run on the split's front:
+///   the macro engine reads them, no draw does. In the Maxwell layout they are padding inside
+///   the transform feedback block (bytes 0x550 to 0x563, between its buffers at 0x380 and its
+///   controls at 0x700). With macros on the back (EDEN_NX2_SPLIT=1, EDEN_NX2_MME_JIT=0) the
+///   read runs inline there with no call of its own, so the words keep ending reuse.
+/// - A macro DMA read's deferred call on the back ends reuse only when it flushes GPU-written
+///   buffer data to guest memory, or when a query DMA sync or trace mode is on.
+/// EDEN_UP_FAST_DRAW_VERIFY=1 checks the draws this adds like any other delta draw.
+///
+/// EDEN_UP_QUERY_STATS=1 (exact "1", alone or with the above) logs once a second what the game
+/// does: reports by kind, counter resets, render_enable writes by value, draws run and skipped by
+/// the render enable, draws that only count (no colour, depth or stencil write), counted draws
+/// per report, how many reports a macro read before the next report to the same counter, macro
+/// reads that came before the report they read had landed (the timing race a frame wait hides),
+/// fences made only for query work, query syncs, and the time in the report and reset calls.
+/// Log only: it changes nothing else. Macro reads are counted on the split's front only.
+///
+/// EDEN_UP_OOT_OCCLUSION_OFF=1 (core/file_sys/patch_manager.cpp) is the other way: the game's own
+/// two occlusion settings are turned off, so it makes no test draws, reports or conditions at
+/// all and draws every object.
+namespace VideoCommon::QueryLight {
+
+/// EDEN_UP_QUERY_LIGHT=1 (exact "1") with EDEN_UP_FAST_DRAW=1, read once.
+[[nodiscard]] inline bool Enabled() {
+    static const bool enabled = Nx2FastDraw::Enabled() && Common::PeSwitch("EDEN_UP_QUERY_LIGHT");
+    return enabled;
+}
+
+/// EDEN_UP_QUERY_STATS=1 (exact "1"), read once.
+[[nodiscard]] inline bool StatsEnabled() {
+    static const bool enabled = Common::PeSwitch("EDEN_UP_QUERY_STATS");
+    return enabled;
+}
+
+/// Counters of the last second. Relaxed atomics: several threads add, the line is a guide.
+struct Stats {
+    using Count = std::atomic<u64>;
+
+    // The 3D engine's thread (the split's back).
+    Count zpass_reports;       ///< ZPassPixelCount64, queued for a fence (what QUERY_LIGHT exempts)
+    Count zpass_fence_reports; ///< ZPassPixelCount64 as a short release
+    Count payload_releases;    ///< Payload, short release (a fence)
+    Count payload_reports;     ///< Payload, any other form
+    Count other_reports;       ///< Other counters and operations
+    Count zpass_resets;
+    Count other_resets;
+    Count report_ns; ///< In RasterizerInterface::Query, all kinds
+    Count reset_ns;  ///< In RasterizerInterface::ResetCounter
+    /// render_enable.mode written False, True, a guest condition
+    std::array<Count, 3> enable_writes;
+    Count draws_run;
+    Count draws_skipped; ///< By the render enable
+    Count counted_draws; ///< Run with the Z pass counter on
+    Count proxy_draws;   ///< Of counted_draws: no colour, depth or stencil write
+    /// Z pass reports by counted draws run since the previous report or reset: 0, 1, 2-4, 5+
+    std::array<Count, 4> window_draws;
+    Count reports_first;    ///< Z pass reports to a counter not seen before
+    Count reports_consumed; ///< ...to a counter a macro read since its last report
+    Count reports_unread;   ///< ...to a counter no macro read since its last report
+    Count reports_unlanded; ///< ...to a counter whose last report had not landed yet
+
+    // The split's front.
+    Count macro_reads;           ///< MME_DMA_READ_FIFOED
+    Count macro_reads_of_report; ///< Of those: covering a counter a Z pass report wrote
+    // Of the 6-word reads (NVN2's condition macro: counter, its timestamp, the next counter):
+    /// By the macro's first parameter: 0 draw when they differ, 1 draw when equal, other
+    std::array<Count, 3> macro_polarity;
+    Count macro_reads_equal;     ///< The two counters were equal
+    Count macro_reads_pending;   ///< One of the two had a report issued that had not landed
+    Count macro_reads_zero_time; ///< The first counter's timestamp was 0: no report landed there
+    Count macro_reads_suspect;   ///< Equal, and pending or with a zero timestamp
+
+    // The fence manager and the query cache (the back).
+    Count forced_fences;   ///< Fences that could not be skipped as empty with query work pending
+    Count presyncs;        ///< Syncs of pending reports (QueryCacheBase::NotifyWFI with work)
+    Count presync_ns;      ///< In them
+    Count presync_reports; ///< Z pass reports in them
+    Count presync_slots;   ///< Host query slots in them
+    Count presync_scans;   ///< Z pass syncs with the prefix scan compute pass
+    Count host_queries;    ///< Host occlusion queries begun
+};
+
+inline Stats g_stats;
+
+inline void Add(Stats::Count& count, u64 amount = 1) {
+    count.fetch_add(amount, std::memory_order_relaxed);
+}
+
+/// Per 8-byte counter, by a hash of its device address: bit 0 reported at least once, bit 1 read
+/// by a macro since its last report, the bits above how many of its reports have been issued and
+/// not yet settled (written to guest memory, or dropped). Collisions only blur the counts.
+inline std::array<std::atomic<u16>, 1 << 16> g_counter_marks{};
+inline constexpr u16 MarkReported = 1;
+inline constexpr u16 MarkRead = 2;
+inline constexpr u16 MarkPendingOne = 4;
+
+[[nodiscard]] inline size_t MarkIndex(DAddr device) {
+    return static_cast<size_t>(((device >> 3) * 0x9E3779B97F4A7C15ULL) >> 48);
+}
+
+/// The back: counted draws run since the last Z pass report or counter reset.
+inline u32 g_window_draws{};
+
+/// The back: a Z pass report was queued for the counter at `device`.
+inline void NoteZpassReport(DAddr device) {
+    auto& mark = g_counter_marks[MarkIndex(device)];
+    const u16 old = mark.load(std::memory_order_relaxed);
+    Add((old & MarkReported) == 0   ? g_stats.reports_first
+        : old >= MarkPendingOne     ? g_stats.reports_unlanded
+        : (old & MarkRead) != 0     ? g_stats.reports_consumed
+                                    : g_stats.reports_unread);
+    mark.fetch_and(static_cast<u16>(~MarkRead), std::memory_order_relaxed);
+    mark.fetch_add(MarkPendingOne, std::memory_order_relaxed);
+    mark.fetch_or(MarkReported, std::memory_order_relaxed);
+    const u32 draws = g_window_draws;
+    Add(g_stats.window_draws[draws == 0 ? 0 : draws == 1 ? 1 : draws <= 4 ? 2 : 3]);
+    g_window_draws = 0;
+}
+
+/// The thread that runs a queued report's operation (the fencing thread): the report for the
+/// counter at `device` was written to guest memory, or dropped.
+inline void NoteReportSettled(DAddr device) {
+    auto& mark = g_counter_marks[MarkIndex(device)];
+    if (mark.load(std::memory_order_relaxed) >= MarkPendingOne) {
+        mark.fetch_sub(MarkPendingOne, std::memory_order_relaxed);
+    }
+}
+
+/// The front: a macro read `count` words at `device` into its load FIFO, after any drain.
+/// `words` are the words read, `polarity` the macro's first parameter.
+inline void NoteMacroRead(DAddr device, const u32* words, u32 count, u32 polarity) {
+    Add(g_stats.macro_reads);
+    bool reported = false;
+    bool pending = false;
+    // The counters at +0 and +16; the 8 bytes between them are the first one's timestamp.
+    for (u32 word = 0; word + 2 <= count; word += 4) {
+        auto& mark = g_counter_marks[MarkIndex(device + u64{word} * sizeof(u32))];
+        const u16 state = mark.load(std::memory_order_relaxed);
+        reported |= (state & MarkReported) != 0;
+        pending |= state >= MarkPendingOne;
+        mark.fetch_or(MarkRead, std::memory_order_relaxed);
+    }
+    if (reported) {
+        Add(g_stats.macro_reads_of_report);
+    }
+    if (count != 6) {
+        return;
+    }
+    Add(g_stats.macro_polarity[polarity < 2 ? polarity : 2]);
+    const bool equal = words[0] == words[4] && words[1] == words[5];
+    const bool zero_time = (words[2] | words[3]) == 0;
+    Add(g_stats.macro_reads_equal, equal ? 1 : 0);
+    Add(g_stats.macro_reads_pending, pending ? 1 : 0);
+    Add(g_stats.macro_reads_zero_time, zero_time ? 1 : 0);
+    Add(g_stats.macro_reads_suspect, equal && (pending || zero_time) ? 1 : 0);
+}
+
+/// The back, at each draw: logs the last second.
+inline void Report() {
+    static u64 last = Nx2Profile::Now();
+    const u64 now = Nx2Profile::Now();
+    if (now - last < 1'000'000'000ULL) {
+        return;
+    }
+    const double seconds = static_cast<double>(now - last) / 1e9;
+    last = now;
+    const auto take = [seconds](Stats::Count& count) {
+        return static_cast<u64>(
+            static_cast<double>(count.exchange(0, std::memory_order_relaxed)) / seconds + 0.5);
+    };
+    Stats& s = g_stats;
+    const u64 zpass = take(s.zpass_reports);
+    const u64 zpass_fence = take(s.zpass_fence_reports);
+    const u64 releases = take(s.payload_releases);
+    const u64 payload = take(s.payload_reports);
+    const u64 other = take(s.other_reports);
+    const u64 reports = zpass + zpass_fence + releases + payload + other;
+    const u64 zpass_resets = take(s.zpass_resets);
+    const u64 other_resets = take(s.other_resets);
+    const u64 resets = zpass_resets + other_resets;
+    // Both rates are per second, so their quotient is the time of one call.
+    const auto each_us = [](u64 ns, u64 calls) {
+        return calls != 0 ? static_cast<double>(ns) / 1000.0 / static_cast<double>(calls) : 0.0;
+    };
+    const double report_us = each_us(take(s.report_ns), reports);
+    const double reset_us = each_us(take(s.reset_ns), resets);
+    LOG_INFO(HW_GPU,
+             "Query stats per second: reports {} Z pass queued, {} Z pass fence, {} payload "
+             "release, {} payload other, {} other ({:.2f} us each) | resets {} Z pass, {} other "
+             "({:.2f} us each) | render enable written False {}, True {}, guest condition {}",
+             zpass, zpass_fence, releases, payload, other, report_us, zpass_resets, other_resets,
+             reset_us, take(s.enable_writes[0]), take(s.enable_writes[1]),
+             take(s.enable_writes[2]));
+    const u64 run = take(s.draws_run);
+    const u64 skipped = take(s.draws_skipped);
+    const u64 counted = take(s.counted_draws);
+    const u64 proxy = take(s.proxy_draws);
+    const u64 w0 = take(s.window_draws[0]);
+    const u64 w1 = take(s.window_draws[1]);
+    const u64 w2 = take(s.window_draws[2]);
+    const u64 w3 = take(s.window_draws[3]);
+    LOG_INFO(HW_GPU,
+             "Query stats per second: draws {} run, {} skipped by the render enable, {} counted, "
+             "{} of those write no colour, depth or stencil | Z pass reports by counted draws "
+             "since the last report or reset: none {}, one {}, 2-4 {}, more {} | counters "
+             "reported: {} new, {} read by a macro since their last report, {} not read, {} "
+             "reported again before the last report landed",
+             run, skipped, counted, proxy, w0, w1, w2, w3, take(s.reports_first),
+             take(s.reports_consumed), take(s.reports_unread), take(s.reports_unlanded));
+    LOG_INFO(HW_GPU,
+             "Query stats per second: macro reads {}, {} of a reported counter | conditions: "
+             "draw when the counters differ {}, when equal {}, other {} | counters equal {} | "
+             "read before a report landed {}, with a zero timestamp {}, equal and one of those "
+             "two {}",
+             take(s.macro_reads), take(s.macro_reads_of_report), take(s.macro_polarity[0]),
+             take(s.macro_polarity[1]), take(s.macro_polarity[2]), take(s.macro_reads_equal),
+             take(s.macro_reads_pending), take(s.macro_reads_zero_time),
+             take(s.macro_reads_suspect));
+    const u64 presyncs = take(s.presyncs);
+    const double presync_us = each_us(take(s.presync_ns), presyncs);
+    LOG_INFO(HW_GPU,
+             "Query stats per second: fences not skipped with query work pending {} | report "
+             "syncs {} ({} Z pass reports, {} host slots, {} with the prefix scan, {:.1f} us "
+             "each) | host queries begun {}",
+             take(s.forced_fences), presyncs, take(s.presync_reports), take(s.presync_slots),
+             take(s.presync_scans), presync_us, take(s.host_queries));
+}
+
+} // namespace VideoCommon::QueryLight
