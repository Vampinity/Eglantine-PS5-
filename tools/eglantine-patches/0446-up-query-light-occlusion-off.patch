+namespace {
+/// EDEN_UP_QUERY_LIGHT (nx2_query_light.h): whether writing `argument` to `method` is a report
+/// that only queues a Z pass count: Release or ReportOnly of ZPassPixelCount64, and not a short
+/// release, which signals a fence. For such a report QueryCacheBase::CounterReport records the
+/// end of the host query and queues the value; guest memory gets it on the fencing thread.
+bool IsQueuedCounterReport(u32 method, u32 argument) {
+    using Semaphore = Maxwell3D::Regs::ReportSemaphore;
+    if (method != MAXWELL3D_REG_INDEX(report_semaphore.query) ||
+        !VideoCommon::QueryLight::Enabled()) {
+        return false;
+    }
+    Semaphore report{};
+    report.query.raw = argument;
+    if (report.query.report.Value() != Semaphore::Report::ZPassPixelCount64) {
+        return false;
+    }
+    const Semaphore::Operation operation = report.query.operation.Value();
+    return operation == Semaphore::Operation::ReportOnly ||
+           (operation == Semaphore::Operation::Release && report.query.short_query == 0);
+}
+
+/// EDEN_UP_QUERY_LIGHT: whether a macro DMA read's call on the split's back ends fast draw reuse
+/// only when it flushes. With a query DMA sync or trace mode the call can wait for the host GPU
+/// or write reports out, and ends reuse as before.
+bool DmaReadCallIsNeutral() {
+    static const bool neutral = VideoCommon::QueryLight::Enabled() &&
+                                VideoCommon::QueryDma::SyncMode() == 0 &&
+                                !VideoCommon::QueryDma::TraceEnabled();
+    return neutral;
+}
+
+/// EDEN_UP_QUERY_STATS (nx2_query_light.h): counts the report ProcessQueryGet just ran.
+void NoteReportStats(const Maxwell3D::Regs& regs, const MemoryManager& memory, u64 start) {
+    namespace QueryLight = VideoCommon::QueryLight;
+    using Semaphore = Maxwell3D::Regs::ReportSemaphore;
+    auto& stats = QueryLight::g_stats;
+    QueryLight::Add(stats.report_ns, VideoCommon::Nx2Profile::Now() - start);
+    const auto& query = regs.report_semaphore.query;
+    const Semaphore::Operation operation = query.operation.Value();
+    if (operation != Semaphore::Operation::Release &&
+        operation != Semaphore::Operation::ReportOnly) {
+        QueryLight::Add(stats.other_reports);
+        return;
+    }
+    const bool fence = operation == Semaphore::Operation::Release && query.short_query != 0;
+    switch (query.report.Value()) {
+    case Semaphore::Report::Payload:
+        QueryLight::Add(fence ? stats.payload_releases : stats.payload_reports);
+        break;
+    case Semaphore::Report::ZPassPixelCount64:
+        if (fence) {
+            QueryLight::Add(stats.zpass_fence_reports);
+        } else {
+            QueryLight::Add(stats.zpass_reports);
+            if (const auto device = memory.GpuToCpuAddress(regs.report_semaphore.Address())) {
+                QueryLight::NoteZpassReport(*device);
+            }
+        }
+        break;
+    default:
+        QueryLight::Add(stats.other_reports);
+        break;
+    }
+}
