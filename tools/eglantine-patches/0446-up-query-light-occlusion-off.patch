+namespace {
+/// EDEN_UP_QUERY_STATS (nx2_query_light.h): counts a draw, and logs the last second.
+void NoteQueryStatsDraw(const Maxwell3D::Regs& regs, bool executed) {
+    namespace QueryLight = VideoCommon::QueryLight;
+    auto& stats = QueryLight::g_stats;
+    if (!executed) {
+        QueryLight::Add(stats.draws_skipped);
+    } else {
+        QueryLight::Add(stats.draws_run);
+        if (regs.zpass_pixel_count_enable != 0) {
+            QueryLight::Add(stats.counted_draws);
+            ++QueryLight::g_window_draws;
+            // A stencil test counts as a write here: a draw named as only counting never is one.
+            bool writes = regs.stencil_enable != 0 ||
+                          (regs.zeta_enable != 0 && regs.depth_test_enable != 0 &&
+                           regs.depth_write_enabled != 0);
+            const u32 targets = regs.rt_control.count.Value();
+            for (u32 target = 0; target < targets && target < Maxwell3D::Regs::NumRenderTargets &&
+                                 !writes;
+                 ++target) {
+                const u32 mask = regs.color_mask[regs.color_mask_common != 0 ? 0 : target].raw;
+                writes = (mask & 0x1111) != 0;
+            }
+            if (!writes) {
+                QueryLight::Add(stats.proxy_draws);
+            }
+        }
+    }
+    QueryLight::Report();
+}
