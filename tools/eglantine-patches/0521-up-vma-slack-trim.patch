+/// EDEN_UP_VMA_TRIM=1 (off unless exactly "1"): keeps images from leaving holes in the
+/// allocator's shared 16 MiB blocks while the pool is short or an area loads
+/// (MemoryAllocator::CreateImage, vulkan_memory_allocator.cpp). A block goes back to the driver
+/// only when every image in it is gone, so one small image that stays holds the whole block.
+/// While the switch is on and the trim is active, an image goes into space the blocks already
+/// hold; where none fits it gets memory of its own when over half a small block
+/// (EDEN_UP_VMA_TRIM_BLOCK_MIB, 8), else a small block of a pool of its own
+/// (Device::SeparatePool::TrimmedImages), instead of a new 16 MiB block. What it cannot place
+/// that way goes the usual way, with every fallback as before. Active: the pool's largest
+/// free block under EDEN_UP_VMA_TRIM_MIB (2048; off again at 1.5 times that), or for 10 s after
+/// EDEN_UP_VMA_TRIM_BURST (100) images were made within a second (an area load). The line
+/// EDEN_VMA_TRIM in stderr.log says what was placed how and what device memory went back.
+namespace Vulkan::VmaTrim {
+
+[[nodiscard]] inline bool Enabled() {
+    static const bool enabled = Common::PeSwitch("EDEN_UP_VMA_TRIM");
+    return enabled;
+}
+
+enum Counter : size_t {
+    Holes,          ///< Images placed in space the blocks already held
+    HoleBytes,
+    Own,            ///< Images given memory of their own instead of a place in a shared block
+    OwnBytes,
+    Large,          ///< Images over half of VMA's block: memory of their own, as without the trim
+    LargeBytes,
+    Small,          ///< Images placed in the small blocks of the trim's own pool
+    SmallBytes,
+    Fallbacks,      ///< Images the trim could not place (the usual path made them)
+    Freed,          ///< Device memory the allocator gave back (blocks and memory of its own)
+    FreedBytes,
+    Taken,          ///< Device memory the allocator took
+    TakenBytes,
+    Count,
+};
+
+/// Written only with the switch on (the allocator's callbacks, vulkan_device.cpp, and
+/// CreateImage); read and cleared by the EDEN_VMA_TRIM line.
+inline std::array<std::atomic<u64>, Count> g_counters{};
+
+inline void Add(Counter counter, u64 amount = 1) {
+    g_counters[counter].fetch_add(amount, std::memory_order_relaxed);
+}
+
+/// The count since the last call, set back to 0.
+[[nodiscard]] inline u64 Take(Counter counter) {
+    return g_counters[counter].exchange(0, std::memory_order_relaxed);
+}
+
+} // namespace Vulkan::VmaTrim
