+/// Half of VMA's own blocks (EDEN_VMA_BLOCK_MIB, 16 MiB, read as vulkan_device.cpp reads it):
+/// what VMA gives memory of its own anyway.
+[[nodiscard]] VkDeviceSize TrimDefaultHalfBlock() {
+    static const VkDeviceSize half = [] {
+        VkDeviceSize bytes = 16ULL << 20;
+        if (const char* value = std::getenv("EDEN_VMA_BLOCK_MIB")) {
+            const unsigned long mib = std::strtoul(value, nullptr, 10);
+            if (mib >= 2 && mib <= 64) {
+                bytes = VkDeviceSize{mib} << 20;
+            }
+        }
+        return bytes / 2;
+    }();
+    return half;
+}
+
+/// EDEN_UP_VMA_TRIM_BLOCK_MIB: the trim's small blocks, 2, 4 or 8 MiB (anything else: 8), at
+/// most half of VMA's own. An image over half of one gets memory of its own, the rule VMA keeps
+/// for half of its 16 MiB blocks.
+[[nodiscard]] VkDeviceSize TrimBlockBytes() {
+    static const VkDeviceSize bytes = [] {
+        const char* value = std::getenv("EDEN_UP_VMA_TRIM_BLOCK_MIB");
+        const unsigned long mib = value != nullptr ? std::strtoul(value, nullptr, 10) : 0;
+        const VkDeviceSize asked = VkDeviceSize{mib == 2 || mib == 4 || mib == 8 ? mib : 8UL} << 20;
+        return (std::min)(asked, (std::max)(VkDeviceSize{2} << 20, TrimDefaultHalfBlock()));
+    }();
+    return bytes;
+}
+
+/// EDEN_UP_VMA_TRIM_BURST: images made within one second that count as an area load (unset: 100,
+/// as EDEN_NX2_AREA_EVICT_BURST counts 100 within 30 frames); 0: the pool alone decides.
+[[nodiscard]] u32 TrimBurstImages() {
+    static const u32 images = [] {
+        const char* value = std::getenv("EDEN_UP_VMA_TRIM_BURST");
+        return value != nullptr ? static_cast<u32>(std::strtoul(value, nullptr, 10)) : 100U;
+    }();
+    return images;
+}
+
+/// The pool's largest free block (the front's figure); where there is none, what the allocator's
+/// budget leaves in the device-local heap with the most left.
+[[nodiscard]] u64 TrimFreeBytes(VmaAllocator allocator, bool& from_front) {
+#if VULKAN_VMA_TRIM_FRONT
+    if (eden_free_memory_bytes != nullptr) {
+        if (const u64 bytes = eden_free_memory_bytes(); bytes != 0) {
+            from_front = true;
+            return bytes;
+        }
+    }
+#endif
+    from_front = false;
+    const VkPhysicalDeviceMemoryProperties* properties{};
+    vmaGetMemoryProperties(allocator, &properties);
+    std::array<VmaBudget, VK_MAX_MEMORY_HEAPS> budgets{};
+    vmaGetHeapBudgets(allocator, budgets.data());
+    u64 left = 0;
+    for (u32 heap = 0; heap < properties->memoryHeapCount; ++heap) {
+        if ((properties->memoryHeaps[heap].flags & VK_MEMORY_HEAP_DEVICE_LOCAL_BIT) != 0 &&
+            budgets[heap].budget > budgets[heap].usage) {
+            left = (std::max)(left, u64{budgets[heap].budget - budgets[heap].usage});
+        }
+    }
+    return left;
+}
+
+/// Whether the allocator's budget has room for `bytes` more in the heap of that memory type: what
+/// lets the usual path take a new block.
+[[nodiscard]] bool TrimBudgetLeft(VmaAllocator allocator, u32 type, VkDeviceSize bytes) {
+    const VkPhysicalDeviceMemoryProperties* properties{};
+    vmaGetMemoryProperties(allocator, &properties);
+    std::array<VmaBudget, VK_MAX_MEMORY_HEAPS> budgets{};
+    vmaGetHeapBudgets(allocator, budgets.data());
+    const VmaBudget& heap = budgets[properties->memoryTypes[type].heapIndex];
+    return heap.usage + bytes <= heap.budget;
+}
+
+struct TrimState {
+    std::atomic<long long> checked_ns{0};     ///< Last look at the pool (every 100 ms at most)
+    std::atomic<u64> largest{0};              ///< Its largest free block then
+    std::atomic<bool> from_front{false};      ///< That figure was the front's
+    std::atomic<bool> low{false};             ///< Under the mark (back over 1.5 times it: off)
+    std::atomic<long long> window_ns{0};      ///< Start of the second images are counted in
+    std::atomic<u32> window_images{0};
+    std::atomic<long long> burst_until_ns{0}; ///< Active until then after a burst
+    std::atomic<u32> bursts{0};
+    std::atomic<bool> announced{false};
+    std::atomic<long long> logged_ns{0};
+    std::atomic<bool> reported{false};        ///< Active at the last line
+    std::atomic<u64> slack_at_start{0};       ///< The blocks' unused space when it turned on
+};
+TrimState trim_state;
+
+/// EDEN_VMA_TRIM (stderr.log), in MiB, count/MiB for the images and device memory since the last
+/// line: when the trim turns on or off, and while on every 2 s with images placed (else 20 s).
+///   EDEN_VMA_TRIM on|off largest mark burst=<bursts so far>[+] blocks used slack (change since on)
+///       shared sparse buffers trim (blocks/slack each) holes own large small fallback freed taken
+/// slack: the allocator's blocks less their use, all heaps; shared: VMA's own blocks (images up
+/// to half a block, host-visible buffers; memory of its own counts as fully used), sparse /
+/// buffers / trim: the SparsePages, DeviceBuffers and TrimmedImages pools. holes: images in space
+/// the blocks held already; own: images given memory of their own that VMA would have put in a
+/// shared block (over half a small block, up to half of VMA's); large: images over half of VMA's
+/// block (memory of their own as before); small: images in the trim's small blocks; fallback:
+/// images the trim left to the usual path; freed / taken: device memory the allocator gave back
+/// to / took from the driver, its blocks and memory of its own, for any reason (the callbacks in
+/// vulkan_device.cpp).
+void TrimReport(const Device& device, long long now, bool active, bool burst_on) {
+    TrimState& s = trim_state;
+    const bool was = s.reported.load(std::memory_order_relaxed);
+    long long last = s.logged_ns.load(std::memory_order_relaxed);
+    if (active == was) {
+        if (!active) {
+            return;
+        }
+        u64 placed = 0;
+        for (const VmaTrim::Counter counter :
+             {VmaTrim::Holes, VmaTrim::Own, VmaTrim::Large, VmaTrim::Small, VmaTrim::Fallbacks}) {
+            placed += VmaTrim::g_counters[counter].load(std::memory_order_relaxed);
+        }
+        if (now - last < (placed != 0 ? 2'000'000'000LL : 20'000'000'000LL)) {
+            return;
+        }
+    }
+    if (!s.logged_ns.compare_exchange_strong(last, now, std::memory_order_relaxed)) {
+        return; // another thread writes this one
+    }
+    s.reported.store(active, std::memory_order_relaxed);
+    std::array<VmaBudget, VK_MAX_MEMORY_HEAPS> budgets{};
+    vmaGetHeapBudgets(device.GetAllocator(), budgets.data());
+    u64 blocks = 0, used = 0;
+    for (const VmaBudget& heap : budgets) {
+        blocks += heap.statistics.blockBytes;
+        used += heap.statistics.allocationBytes;
+    }
+    const u64 slack = blocks > used ? blocks - used : 0;
+    std::array<u64, 3> pool_blocks{}, pool_used{};
+    for (u32 kind = 0; kind < 3; ++kind) {
+        device.AddSeparatePoolUsage(static_cast<Device::SeparatePool>(kind), pool_blocks[kind],
+                                    pool_used[kind]);
+    }
+    const auto pool_slack = [&](u32 kind) {
+        return static_cast<unsigned long long>(
+            (pool_blocks[kind] > pool_used[kind] ? pool_blocks[kind] - pool_used[kind] : 0) >> 20);
+    };
+    const u64 all_pools = pool_blocks[0] + pool_blocks[1] + pool_blocks[2];
+    const u64 all_pools_used = pool_used[0] + pool_used[1] + pool_used[2];
+    const u64 all_pools_slack = all_pools > all_pools_used ? all_pools - all_pools_used : 0;
+    const u64 shared_blocks = blocks > all_pools ? blocks - all_pools : 0;
+    const u64 shared_slack = slack > all_pools_slack ? slack - all_pools_slack : 0;
+    if (active && !was) {
+        s.slack_at_start.store(slack, std::memory_order_relaxed);
+    }
+    const u64 slack_at_start = s.slack_at_start.load(std::memory_order_relaxed);
+    const long long change =
+        static_cast<long long>(slack >> 20) - static_cast<long long>(slack_at_start >> 20);
+    const auto take = [](VmaTrim::Counter counter) {
+        return static_cast<unsigned long long>(VmaTrim::Take(counter));
+    };
+    const auto mib = [](u64 bytes) { return static_cast<unsigned long long>(bytes >> 20); };
+    const unsigned long long holes = take(VmaTrim::Holes), own = take(VmaTrim::Own),
+                             large = take(VmaTrim::Large), small = take(VmaTrim::Small),
+                             fallbacks = take(VmaTrim::Fallbacks), freed = take(VmaTrim::Freed),
+                             taken = take(VmaTrim::Taken);
+    std::fprintf(stderr,
+                 "EDEN_VMA_TRIM %s largest=%llu mark=%llu burst=%u%s blocks=%llu used=%llu "
+                 "slack=%llu (%+lld since on) shared=%llu/%llu sparse=%llu/%llu buffers=%llu/%llu "
+                 "trim=%llu/%llu holes=%llu/%llu own=%llu/%llu large=%llu/%llu "
+                 "small=%llu/%llu fallback=%llu freed=%llu/%llu taken=%llu/%llu\n",
+                 active ? "on" : "off", mib(s.largest.load(std::memory_order_relaxed)),
+                 mib(TrimMarkBytes()), s.bursts.load(std::memory_order_relaxed), burst_on ? "+" : "",
+                 mib(blocks), mib(used), mib(slack), change, mib(shared_blocks), mib(shared_slack),
+                 mib(pool_blocks[0]), pool_slack(0), mib(pool_blocks[1]), pool_slack(1),
+                 mib(pool_blocks[2]), pool_slack(2), holes, take(VmaTrim::HoleBytes) >> 20,
+                 own, take(VmaTrim::OwnBytes) >> 20, large, take(VmaTrim::LargeBytes) >> 20, small,
+                 take(VmaTrim::SmallBytes) >> 20, fallbacks, freed, take(VmaTrim::FreedBytes) >> 20,
+                 taken, take(VmaTrim::TakenBytes) >> 20);
+}
+
+/// Whether the trim is active now, counting this image toward a burst.
+bool TrimActive(const Device& device) {
+    const VmaAllocator allocator = device.GetAllocator();
+    TrimState& s = trim_state;
+    const long long now = TrimNowNs();
+    if (const u32 burst = TrimBurstImages(); burst != 0) {
+        if (now - s.window_ns.load(std::memory_order_relaxed) >= 1'000'000'000) {
+            s.window_ns.store(now, std::memory_order_relaxed);
+            s.window_images.store(0, std::memory_order_relaxed);
+        }
+        if (s.window_images.fetch_add(1, std::memory_order_relaxed) + 1 == burst) {
+            s.burst_until_ns.store(now + 10'000'000'000LL, std::memory_order_relaxed);
+            s.bursts.fetch_add(1, std::memory_order_relaxed);
+        }
+    }
+    if (now - s.checked_ns.load(std::memory_order_relaxed) >= 100'000'000) {
+        s.checked_ns.store(now, std::memory_order_relaxed);
+        bool from_front = false;
+        const u64 largest = TrimFreeBytes(allocator, from_front);
+        const u64 mark = TrimMarkBytes();
+        s.largest.store(largest, std::memory_order_relaxed);
+        s.from_front.store(from_front, std::memory_order_relaxed);
+        s.low.store(largest < mark ||
+                        (s.low.load(std::memory_order_relaxed) && largest < mark + mark / 2),
+                    std::memory_order_relaxed);
+    }
+    if (!s.announced.exchange(true, std::memory_order_relaxed)) {
+        std::fprintf(stderr,
+                     "EDEN_VMA_TRIM ready: on under %llu MiB of largest free block (off over %llu), "
+                     "small blocks %llu MiB, own memory over %llu MiB, burst %u images/s, the "
+                     "figure from %s\n",
+                     static_cast<unsigned long long>(TrimMarkBytes() >> 20),
+                     static_cast<unsigned long long>((TrimMarkBytes() + TrimMarkBytes() / 2) >> 20),
+                     static_cast<unsigned long long>(TrimBlockBytes() >> 20),
+                     static_cast<unsigned long long>(TrimBlockBytes() >> 21), TrimBurstImages(),
+                     s.from_front.load(std::memory_order_relaxed) ? "the pool"
+                                                                  : "the allocator's budget");
+    }
+    const bool burst_on = now < s.burst_until_ns.load(std::memory_order_relaxed);
+    const bool active = s.low.load(std::memory_order_relaxed) || burst_on;
+    TrimReport(device, now, active, burst_on);
+    return active;
+}
+
+/// While the trim is active: makes the image and gives it memory without a new shared block.
+/// First space the blocks already hold (no new memory, so no budget either); where none fits,
+/// memory of its own when it needs over half a small block, else a small block of the trim's
+/// pool. True with the image made and bound; false leaves nothing behind, and the usual path
+/// makes the image with all its fallbacks (outside the budget, host memory, unbacked, and on the
+/// console the port's ReleaseRefused).
+bool CreateTrimmedImage(const Device& device, VmaAllocator allocator, const VkImageCreateInfo& ci,
+                        const VmaAllocationCreateInfo& alloc_ci, VkImage& handle,
+                        VmaAllocation& allocation, VmaAllocationInfo& alloc_info) {
+    // Images that take no memory the usual way (sparse, lazily allocated, planes bound one by
+    // one) or that the driver may want memory of their own for (external memory) stay on the
+    // usual path: VMA allows them no hole and no pool.
+    constexpr VkImageCreateFlags unusual =
+        VK_IMAGE_CREATE_SPARSE_BINDING_BIT | VK_IMAGE_CREATE_SPARSE_RESIDENCY_BIT |
+        VK_IMAGE_CREATE_SPARSE_ALIASED_BIT | VK_IMAGE_CREATE_DISJOINT_BIT;
+    if ((ci.flags & unusual) != 0 || (ci.usage & VK_IMAGE_USAGE_TRANSIENT_ATTACHMENT_BIT) != 0 ||
+        (ci.tiling != VK_IMAGE_TILING_OPTIMAL && ci.tiling != VK_IMAGE_TILING_LINEAR)) {
+        return false;
+    }
+    for (auto next = static_cast<const VkBaseInStructure*>(ci.pNext); next != nullptr;
+         next = next->pNext) {
+        if (next->sType == VK_STRUCTURE_TYPE_EXTERNAL_MEMORY_IMAGE_CREATE_INFO) {
+            return false;
+        }
+    }
+    const auto& dld = device.GetDispatchLoader();
+    const VkDevice logical = *device.GetLogical();
+    VkImage image{};
+    if (dld.vkCreateImage(logical, &ci, nullptr, &image) != VK_SUCCESS) {
+        return false;
+    }
+    VkMemoryRequirements requirements{};
+    dld.vkGetImageMemoryRequirements(logical, image, &requirements);
+    // vmaAllocateMemoryForImage does not know the image's usage, which VMA_MEMORY_USAGE_AUTO*
+    // needs. UNKNOWN with the same preferred flag (device-local; VMA adds "not uncached" to both)
+    // picks the memory type vmaCreateImage picks for an image the host never touches.
+    VmaAllocationCreateInfo base = alloc_ci;
+    base.usage = VMA_MEMORY_USAGE_UNKNOWN;
+    VmaAllocation memory{};
+    VmaAllocationInfo info{};
+    VmaTrim::Counter kind = VmaTrim::Holes;
+    VkResult result = VK_ERROR_OUT_OF_DEVICE_MEMORY;
+    // The holes and the small blocks only in the type the usual path takes first: VMA would
+    // otherwise go on to the holes of the host-visible types, where the usual path puts no image
+    // while it can still take a block.
+    u32 type{};
+    if (vmaFindMemoryTypeIndex(allocator, requirements.memoryTypeBits, &base, &type) ==
+        VK_SUCCESS) {
+        VmaAllocationCreateInfo holes = base;
+        holes.flags =
+            (holes.flags & ~VmaAllocationCreateFlags{VMA_ALLOCATION_CREATE_WITHIN_BUDGET_BIT}) |
+            VMA_ALLOCATION_CREATE_NEVER_ALLOCATE_BIT;
+        holes.memoryTypeBits = 1U << type;
+        result = vmaAllocateMemoryForImage(allocator, image, &holes, &memory, &info);
+        const VkDeviceSize block = TrimBlockBytes();
+        if (result != VK_SUCCESS && requirements.size > block / 2) {
+            // Within the budget and in any type, as the usual path asks for memory of its own.
+            VmaAllocationCreateInfo own = base;
+            own.flags |= VMA_ALLOCATION_CREATE_DEDICATED_MEMORY_BIT;
+            kind = requirements.size > TrimDefaultHalfBlock() ? VmaTrim::Large : VmaTrim::Own;
+            result = vmaAllocateMemoryForImage(allocator, image, &own, &memory, &info);
+        } else if (result != VK_SUCCESS) {
+            if (const VmaPool pool =
+                    device.GetSeparatePool(Device::SeparatePool::TrimmedImages, type, block)) {
+                VmaAllocationCreateInfo small = base;
+                small.pool = pool;
+                // A new small block only within the budget, as the usual path takes a new block;
+                // past it, only the small blocks held already.
+                if (!TrimBudgetLeft(allocator, type, block)) {
+                    small.flags |= VMA_ALLOCATION_CREATE_NEVER_ALLOCATE_BIT;
+                }
+                kind = VmaTrim::Small;
+                result = vmaAllocateMemoryForImage(allocator, image, &small, &memory, &info);
+            }
+        }
+    }
+    if (result == VK_SUCCESS && vmaBindImageMemory(allocator, memory, image) == VK_SUCCESS) {
+        handle = image;
+        allocation = memory;
+        alloc_info = info;
+        VmaTrim::Add(kind);
+        VmaTrim::Add(kind == VmaTrim::Holes   ? VmaTrim::HoleBytes
+                     : kind == VmaTrim::Own   ? VmaTrim::OwnBytes
+                     : kind == VmaTrim::Large ? VmaTrim::LargeBytes
+                                              : VmaTrim::SmallBytes,
+                     info.size);
+        return true;
+    }
+    if (memory != VK_NULL_HANDLE) {
+        vmaFreeMemory(allocator, memory);
+    }
+    dld.vkDestroyImage(logical, image, nullptr);
+    VmaTrim::Add(VmaTrim::Fallbacks);
+    return false;
+}
