diff --git a/b/src/video_core/submit_stats.h b/src/video_core/submit_stats.h
new file mode 100644
index 0000000..51ec8b4
--- /dev/null
+++ b/src/video_core/submit_stats.h
@@ -0,0 +1,377 @@
+// SPDX-FileCopyrightText: Copyright 2026 Eden Emulator Project
+// SPDX-License-Identifier: GPL-3.0-or-later
+
+#pragma once
+
+#include <array>
+#include <atomic>
+#include <chrono>
+#include <cstddef>
+#include <string>
+
+#include <fmt/format.h>
+
+#include "common/common_types.h"
+#include "common/logging.h"
+#include "common/pe_switch.h"
+#include "video_core/zpass_cut.h"
+
+namespace VideoCommon::SubmitStats {
+
+/// EDEN_UP_SUBMIT_STATS=1 (exact "1", off without it). Statistics only: with it nothing is
+/// submitted, deferred or waited for differently. Every 10 s three lines:
+///  - submissions by who asked for them (ZpassCut's sites, and for its "other" the callers without
+///    a SiteScope: Finish, Scheduler::Wait's own flush, the present, host reads), the waits for
+///    each one's GPU work (MasterSemaphore::Wait), the waits of other threads for the submission
+///    itself (Scheduler::WaitSubmitted), and how often a thread that may not flush gave up waiting
+///    for a submission after 20 ms (Scheduler::WaitForSubmission);
+///  - deferred submissions (Scheduler::DeferFlush): how long each waited and what sent it;
+///  - the front's macro memory reads (Maxwell3D::FrontDmaRead): snapshot hits, misses by reason,
+///    reads of listed reports, and the reads that drained the back.
+inline bool Enabled() {
+    static const bool enabled = Common::PeSwitch("EDEN_UP_SUBMIT_STATS");
+    return enabled;
+}
+
+/// Who asked for a submission.
+enum class Origin : u32 {
+    Draws,
+    Astc,
+    Fence,
+    FenceFlush,
+    ListCopy,
+    Idle,
+    Finish,
+    Wait,
+    Present,
+    HostRead,
+    Other,
+    Count,
+};
+inline constexpr std::size_t OriginCount = static_cast<std::size_t>(Origin::Count);
+inline constexpr std::array<const char*, OriginCount> OriginNames{
+    "draws", "astc",   "fence",   "fence flush", "list copy", "idle",
+    "finish", "wait",  "present", "host read",   "other"};
+
+/// Who made the back's idle hook run. The hook sends a deferred submission.
+enum class Hook : u8 { None, OwnIdle, Waiter, Drain, Other };
+
+/// What sent a deferred submission.
+enum class Sender : u32 {
+    OwnIdle,   ///< The idle hook, the back ran out of work
+    Waiter,    ///< The idle hook, asked for by Scheduler::WaitSubmitted
+    Drain,     ///< The idle hook, asked for by GpuSplit::DrainAt
+    OtherHook, ///< The idle hook, asked for by someone else (fence manager, tick polls)
+    Direct,    ///< Scheduler::FlushDeferred outside the hook (FenceManager::SubmitDeferred)
+    NextFlush, ///< A later flush that was not deferred
+    Finish,
+    Wait,
+    Count,
+};
+inline constexpr std::size_t SenderCount = static_cast<std::size_t>(Sender::Count);
+inline constexpr std::array<const char*, SenderCount> SenderNames{
+    "the back's own idle",     "a submission waiter's hook", "a drain's hook",
+    "another requested hook",  "the fence manager",          "the next flush",
+    "a finish",                "a wait"};
+
+/// Maxwell3D::FrontDmaRead and FrontDmaReadAhead.
+enum class Dma : u32 {
+    Hit,
+    MissNewPage,
+    MissWriter,
+    MissUnranged,
+    MissNoted,
+    ListedReport,
+    Narrowed,
+    Ahead,
+    AheadPending,
+    AheadUnsynced,
+    Plain,
+    Count,
+};
+inline constexpr std::size_t DmaCount = static_cast<std::size_t>(Dma::Count);
+
+inline constexpr std::size_t TickSlots = 1024;
+
+struct Stats {
+    std::array<std::atomic<u64>, OriginCount> submissions{};
+    std::array<std::atomic<u64>, OriginCount> waits{};
+    std::array<std::atomic<u64>, OriginCount> wait_ns{};
+    std::array<std::atomic<u64>, OriginCount> submit_waits{};
+    std::array<std::atomic<u64>, OriginCount> submit_wait_ns{};
+    std::array<std::atomic<u64>, SenderCount> sent{};
+    std::array<std::atomic<u64>, SenderCount> sent_ns{};
+    std::array<std::atomic<u64>, SenderCount> sent_max_ns{};
+    std::array<std::atomic<u64>, DmaCount> dma{};
+    std::atomic<u64> deferrals{};
+    std::atomic<u64> gave_up{};
+    std::atomic<u64> frames{};
+    /// The origin of the submission that carried each tick, by tick % TickSlots.
+    std::array<std::atomic<u8>, TickSlots> origin_of_tick{};
+    std::atomic<u8> requested_hook{};
+};
+
+inline Stats& Get() {
+    static Stats stats;
+    return stats;
+}
+
+/// For a submission without a ZpassCut::SiteScope: who asked for it.
+inline thread_local Origin detail = Origin::Other;
+/// On the split's back, while the idle hook runs: who made it run.
+inline thread_local Hook running_hook = Hook::None;
+
+class DetailScope {
+public:
+    explicit DetailScope(Origin origin) : previous{detail} {
+        detail = origin;
+    }
+    ~DetailScope() {
+        detail = previous;
+    }
+    DetailScope(const DetailScope&) = delete;
+    DetailScope& operator=(const DetailScope&) = delete;
+
+private:
+    Origin previous;
+};
+
+class HookScope {
+public:
+    explicit HookScope(Hook hook) : previous{running_hook} {
+        running_hook = hook;
+    }
+    ~HookScope() {
+        running_hook = previous;
+    }
+    HookScope(const HookScope&) = delete;
+    HookScope& operator=(const HookScope&) = delete;
+
+private:
+    Hook previous;
+};
+
+inline Origin CurrentOrigin() {
+    switch (ZpassCut::current_site) {
+    case ZpassCut::Site::Draws:
+        return Origin::Draws;
+    case ZpassCut::Site::Astc:
+        return Origin::Astc;
+    case ZpassCut::Site::Fence:
+        return Origin::Fence;
+    case ZpassCut::Site::FenceFlush:
+        return Origin::FenceFlush;
+    case ZpassCut::Site::ListCopy:
+        return Origin::ListCopy;
+    case ZpassCut::Site::Idle:
+        return Origin::Idle;
+    default:
+        return detail;
+    }
+}
+
+inline void Add(std::atomic<u64>& counter, u64 amount = 1) {
+    counter.fetch_add(amount, std::memory_order_relaxed);
+}
+
+/// Before GpuSplit::RequestIdleHook: who asks. The last asker before the hook runs is named.
+inline void NoteHookRequest(Hook hook) {
+    if (Enabled()) {
+        Get().requested_hook.store(static_cast<u8>(hook), std::memory_order_relaxed);
+    }
+}
+
+/// On the back, before it runs the hook on request.
+inline Hook TakeRequestedHook() {
+    const auto hook =
+        static_cast<Hook>(Get().requested_hook.exchange(0, std::memory_order_relaxed));
+    return hook == Hook::None ? Hook::Other : hook;
+}
+
+inline void NoteDeferral() {
+    Add(Get().deferrals);
+}
+
+inline void NoteGaveUp() {
+    Add(Get().gave_up);
+}
+
+inline void NoteFrame() {
+    Add(Get().frames);
+}
+
+inline void NoteDma(Dma what) {
+    if (Enabled()) {
+        Add(Get().dma[static_cast<std::size_t>(what)]);
+    }
+}
+
+/// A submission on this thread that carries `tick`. deferred: a flush was put off since the last
+/// submission (Scheduler::DeferFlush), at `since`; this submission sends its work.
+inline void NoteSubmission(u64 tick, bool deferred, std::chrono::steady_clock::time_point since) {
+    auto& stats = Get();
+    const Origin origin = CurrentOrigin();
+    Add(stats.submissions[static_cast<std::size_t>(origin)]);
+    stats.origin_of_tick[tick % TickSlots].store(static_cast<u8>(origin),
+                                                 std::memory_order_relaxed);
+    if (!deferred) {
+        return;
+    }
+    Sender sender = Sender::NextFlush;
+    if (origin == Origin::Idle) {
+        switch (running_hook) {
+        case Hook::OwnIdle:
+            sender = Sender::OwnIdle;
+            break;
+        case Hook::Waiter:
+            sender = Sender::Waiter;
+            break;
+        case Hook::Drain:
+            sender = Sender::Drain;
+            break;
+        case Hook::Other:
+            sender = Sender::OtherHook;
+            break;
+        default:
+            sender = Sender::Direct;
+            break;
+        }
+    } else if (origin == Origin::Finish) {
+        sender = Sender::Finish;
+    } else if (origin == Origin::Wait) {
+        sender = Sender::Wait;
+    }
+    const auto index = static_cast<std::size_t>(sender);
+    const u64 ns = static_cast<u64>(std::chrono::duration_cast<std::chrono::nanoseconds>(
+                                        std::chrono::steady_clock::now() - since)
+                                        .count());
+    Add(stats.sent[index]);
+    Add(stats.sent_ns[index], ns);
+    u64 longest = stats.sent_max_ns[index].load(std::memory_order_relaxed);
+    while (ns > longest && !stats.sent_max_ns[index].compare_exchange_weak(
+                               longest, ns, std::memory_order_relaxed)) {
+    }
+}
+
+inline Origin OriginOfTick(u64 tick) {
+    const u8 origin = Get().origin_of_tick[tick % TickSlots].load(std::memory_order_relaxed);
+    return origin < OriginCount ? static_cast<Origin>(origin) : Origin::Other;
+}
+
+/// A wait of `ns` for another thread to submit `tick` (Scheduler::WaitSubmitted), noted once the
+/// tick is submitted, so its origin is known.
+inline void NoteSubmitWait(u64 tick, u64 ns) {
+    auto& stats = Get();
+    const auto index = static_cast<std::size_t>(OriginOfTick(tick));
+    Add(stats.submit_waits[index]);
+    Add(stats.submit_wait_ns[index], ns);
+}
+
+/// Times a wait for the GPU to finish `tick`'s work (MasterSemaphore::Wait, past its quick
+/// checks). A tick that is not submitted yet shows under the origin that had its slot before.
+class WaitTimer {
+public:
+    explicit WaitTimer(u64 tick_) : tick{tick_}, enabled{Enabled()} {
+        if (enabled) {
+            start = std::chrono::steady_clock::now();
+        }
+    }
+    ~WaitTimer() {
+        if (!enabled) {
+            return;
+        }
+        auto& stats = Get();
+        const auto index = static_cast<std::size_t>(OriginOfTick(tick));
+        Add(stats.waits[index]);
+        Add(stats.wait_ns[index],
+            static_cast<u64>(std::chrono::duration_cast<std::chrono::nanoseconds>(
+                                 std::chrono::steady_clock::now() - start)
+                                 .count()));
+    }
+    WaitTimer(const WaitTimer&) = delete;
+    WaitTimer& operator=(const WaitTimer&) = delete;
+
+private:
+    u64 tick;
+    bool enabled;
+    std::chrono::steady_clock::time_point start{};
+};
+
+/// The three lines, every 10 s. One caller: the GPU thread's loop (GpuSplit::MaybeStart).
+inline void MaybeReport() {
+    if (!Enabled()) {
+        return;
+    }
+    static u32 calls = 0;
+    if ((++calls & 255) != 0) {
+        return;
+    }
+    const auto now = std::chrono::steady_clock::now();
+    static auto window_start = now;
+    const auto elapsed = now - window_start;
+    if (elapsed < std::chrono::seconds{10}) {
+        return;
+    }
+    window_start = now;
+    auto& stats = Get();
+    const auto take = [](std::atomic<u64>& value) {
+        return value.exchange(0, std::memory_order_relaxed);
+    };
+    std::string text;
+    u64 total = 0;
+    for (std::size_t i = 0; i < OriginCount; ++i) {
+        const u64 count = take(stats.submissions[i]);
+        const u64 waits = take(stats.waits[i]);
+        const u64 wait_ns = take(stats.wait_ns[i]);
+        const u64 submit_waits = take(stats.submit_waits[i]);
+        const u64 submit_wait_ns = take(stats.submit_wait_ns[i]);
+        total += count;
+        if (count == 0 && waits == 0 && submit_waits == 0) {
+            continue;
+        }
+        text += fmt::format("{}{} {} ({} waits for the GPU {:.1f} ms, {} waits to be submitted "
+                            "{:.1f} ms)",
+                            text.empty() ? "" : ", ", OriginNames[i], count, waits,
+                            static_cast<double>(wait_ns) / 1e6, submit_waits,
+                            static_cast<double>(submit_wait_ns) / 1e6);
+    }
+    LOG_INFO(HW_GPU,
+             "EDEN_UP_SUBMIT_STATS in {:.1f} s, {} frames: {} submissions: {}; {} waits for a "
+             "submission gave up after 20 ms",
+             std::chrono::duration<double>(elapsed).count(), take(stats.frames), total,
+             text.empty() ? "none" : text, take(stats.gave_up));
+    text.clear();
+    total = 0;
+    for (std::size_t i = 0; i < SenderCount; ++i) {
+        const u64 count = take(stats.sent[i]);
+        const u64 ns = take(stats.sent_ns[i]);
+        const u64 longest = take(stats.sent_max_ns[i]);
+        total += count;
+        if (count == 0) {
+            continue;
+        }
+        text += fmt::format("{}{} {} (mean {:.2f} ms, longest {:.2f} ms)",
+                            text.empty() ? "" : ", ", SenderNames[i], count,
+                            static_cast<double>(ns) / 1e6 / static_cast<double>(count),
+                            static_cast<double>(longest) / 1e6);
+    }
+    LOG_INFO(HW_GPU,
+             "EDEN_UP_SUBMIT_STATS deferred: {} flushes put off, {} deferred submissions, sent "
+             "by: {}",
+             take(stats.deferrals), total, text.empty() ? "none" : text);
+    std::array<u64, DmaCount> dma{};
+    for (std::size_t i = 0; i < DmaCount; ++i) {
+        dma[i] = take(stats.dma[i]);
+    }
+    const auto of = [&dma](Dma what) { return dma[static_cast<std::size_t>(what)]; };
+    LOG_INFO(HW_GPU,
+             "EDEN_UP_SUBMIT_STATS front macro reads: {} snapshot hits; misses: {} new page, {} "
+             "compute/copy, {} unranged writer, {} noted write; {} of listed reports (drained), "
+             "{} narrowed without a drain; read ahead: {} reads, {} drained for a pending word, "
+             "{} drained unsynced; {} plain drains",
+             of(Dma::Hit), of(Dma::MissNewPage), of(Dma::MissWriter), of(Dma::MissUnranged),
+             of(Dma::MissNoted), of(Dma::ListedReport), of(Dma::Narrowed), of(Dma::Ahead),
+             of(Dma::AheadPending), of(Dma::AheadUnsynced), of(Dma::Plain));
+}
