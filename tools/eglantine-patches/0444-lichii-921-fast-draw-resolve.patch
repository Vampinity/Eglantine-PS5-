+namespace VideoCommon {
+
+/// Lichii #921 (1c25fbdfb4) for EDEN_UP_FAST_DRAW: whether TextureCache::PrepareImageView
+/// prepares the view's image. Neither an invalid id, nor the null view (0438), nor a buffer view.
+template <typename ImageViews>
+[[nodiscard]] bool PreparesImage(const ImageViews& image_views, ImageViewId id) noexcept {
+    return id && id != NULL_IMAGE_VIEW_ID && !image_views[id].IsBuffer();
+}
+
+/// Whether TextureCache::PrepareImage would change a sampled image: upload it from guest memory
+/// (RefreshContents) or copy a newer alias into it (SynchronizeAliases). newest_alias_tick is
+/// only kept with EDEN_UP_BACK_DRAW_CHEAP; without it the aliases are walked as
+/// SynchronizeAliases does.
+template <typename Images>
+[[nodiscard]] bool SamplingChangesImage(const Images& images, const ImageBase& image) noexcept {
+    if (True(image.flags & ImageFlagBits::CpuModified)) {
+        return true;
+    }
+    if (image.aliased_images.empty()) {
+        return false;
+    }
+    if (UpBackDrawCheap() && image.newest_alias_tick <= image.modification_tick) {
+        return false;
+    }
+    return std::ranges::any_of(image.aliased_images, [&](const AliasedImage& alias) {
+        return images[alias.id].modification_tick > image.modification_tick;
+    });
+}
+
+/// Whether sampling any of the views now needs a resolve that prepares their images (fast draw
+/// delta draws keep the previous resolve's views and prepare none).
+template <typename Views, typename ImageViews, typename Images>
+[[nodiscard]] bool SampledViewsChange(const Views& views, const ImageViews& image_views,
+                                      const Images& images) noexcept {
+    return std::ranges::any_of(views, [&](const auto& view) {
+        return PreparesImage(image_views, view.id) &&
+               SamplingChangesImage(images, images[image_views[view.id].image_id]);
+    });
+}
+
+} // namespace VideoCommon
