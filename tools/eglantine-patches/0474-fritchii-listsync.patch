+        if (header.sync && g_nx2_ampere.load(std::memory_order_relaxed)) {
+            VideoCommon::GpuSplit::Get().NoteListSync();
+        }
         if (!resumed_entry && subchannels[dma_state.subchannel] && dma_state.method_count) {
             const auto engine = subchannel_type[dma_state.subchannel];
             const bool kepler_payload = engine == Engines::EngineTypes::KeplerCompute && dma_state.method == ComputeInline && dma_state.non_incrementing;
@@ -690,7 +750,10 @@ bool DmaPusher::Step() {
             const int list_fast = ListFastMode();
             const bool settled = list_fast != 0 && WrittenPagesSettled();
             if (!(settled && list_fast == 1)) {
-                if (VideoCommon::GpuSplit::Get().WaitForWriters()) {
+                // EDEN_UP_FRITCHII_LISTSYNC / _LISTSKIP: which writers (WaitForListWriters).
+                bool list_wait_skipped = false;
+                if (WaitForListWriters(VideoCommon::GpuSplit::Get(), dma_state.method_count == 0,
+                                       list_wait_skipped)) {
                     gpu_written =
                         IsGpuWrittenCommands(dma_state.dma_get, size_t{header.size} * sizeof(u32));
                     if (settled) {
@@ -708,6 +771,10 @@ bool DmaPusher::Step() {
                         NoteListFastCheck(dma_state.dma_get, true);
                     }
                 }
+                if (!gpu_written) {
+                    CheckListWriters(VideoCommon::GpuSplit::Get(), memory_manager, dma_state.dma_get,
+                                     size_t{header.size} * sizeof(u32), list_wait_skipped);
+                }
             }
         }
         // The words as submitted, unless this is a resumed entry or the GPU has newer ones the
@@ -1203,6 +1270,9 @@ void DmaPusher::CallMethod(u32 argument) {
         SCOPE_EXIT {
             if (writer) {
                 split.NoteWriter();
+                if (subchannel_type[dma_state.subchannel] == Engines::EngineTypes::MaxwellDMA) {
+                    split.NoteCopyWriter(); // EDEN_UP_FRITCHII_LISTSKIP; nothing unless set
+                }
             } else if (memory_writer) {
                 split.NoteUnrangedWriter();
             }
@@ -1269,6 +1339,9 @@ void DmaPusher::CallMultiMethod(const u32* base_start, u32 num_methods) {
         SCOPE_EXIT {
             if (writer) {
                 split.NoteWriter();
+                if (subchannel_type[dma_state.subchannel] == Engines::EngineTypes::MaxwellDMA) {
+                    split.NoteCopyWriter(); // EDEN_UP_FRITCHII_LISTSKIP; nothing unless set
