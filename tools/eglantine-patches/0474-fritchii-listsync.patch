@@ -338,6 +338,9 @@ bool Puller::ResumeAcquire(DmaPusher& dma_pusher) {
     // counting those made the count odd ("suspended") at random, so submit-time snapshots were
     // thrown away for about half of all entries (CommandList::snapshot_suspensions).
     if (pending_acquire) {
+        // EDEN_UP_FRITCHII_LISTSYNC: the met acquire orders the work sent so far before the
+        // commands after it (other channels' releases included; nothing unless set).
+        VideoCommon::GpuSplit::Get().NoteListSync();
         pending_acquire.reset();
         dma_pusher.suspensions.fetch_add(1, std::memory_order_release);
         Nx2SemaphoreWaiters::Get().Remove(this);
@@ -406,6 +409,8 @@ void Puller::ProcessFenceActionMethod(DmaPusher& dma_pusher) {
         // UNIMPLEMENTED_MSG("Channel Scheduling pending.");
         // WaitFence(regs.fence_action.syncpoint_id, regs.fence_value);
         OnBack([rasterizer = dma_pusher.rasterizer] { rasterizer->ReleaseFences(); });
+        // EDEN_UP_FRITCHII_LISTSYNC: a syncpoint acquire is a host-level wait (nothing unless set).
+        VideoCommon::GpuSplit::Get().NoteListSync();
         break;
     case Puller::FenceOperation::Increment:
         if (auto& split = VideoCommon::GpuSplit::Get();
@@ -487,6 +492,10 @@ void Puller::ProcessSemaphoreTriggerMethod(DmaPusher& dma_pusher) {
             LOG_ERROR(HW_GPU, "Invalid semaphore operation {}", static_cast<u32>(op));
             return;
         }
+        // EDEN_UP_FRITCHII_LISTSYNC: a semaphore acquire is a host-level wait, whichever way it is
+        // met below (drained, queued release, SEM_FAST; a suspended one again at ResumeAcquire).
+        // Nothing unless set.
+        VideoCommon::GpuSplit::Get().NoteListSync();
         VideoCommon::Nx2Profile::Add(VideoCommon::Nx2Profile::Counter::AcquireChecks, 1);
         const auto matches = [&acquire](u32 value) { return acquire.Matches(value); };
         if (MetByPendingRelease(dma_pusher, acquire.address, matches,
@@ -602,6 +611,8 @@ void Puller::ProcessSemaphoreExecute(DmaPusher& dma_pusher, u32 argument) {
         NoteReleaseWrite(dma_pusher, address);
         return;
     }
+    // EDEN_UP_FRITCHII_LISTSYNC: an acquire, met or not below (nothing unless set).
+    VideoCommon::GpuSplit::Get().NoteListSync();
     const auto met = [operation, payload](u32 word) {
         return operation == 0   ? word == payload
                : operation == 2 ? word >= payload
diff --git a/src/video_core/gpu_split.cpp b/src/video_core/gpu_split.cpp
index 22a516c..e5f3df7 100644
--- a/src/video_core/gpu_split.cpp
+++ b/src/video_core/gpu_split.cpp
@@ -197,6 +197,8 @@ void GpuSplit::Stop() {
     front_reports.clear();
     reported_words.clear();
     sync_position = 0;
+    list_sync_position = 0;
+    last_copy_writer_position = 0;
     same_read_count = 0;
     same_read_position = 0;
     back_engine_now.store(nullptr, std::memory_order_relaxed);
@@ -444,6 +446,13 @@ bool GpuSplit::WaitForWriters(DrainSite site) {
     return WaitFor(std::min(last_writer_position, write_position), site);
 }
 
+// EDEN_UP_FRITCHII_LISTSYNC (Fritchii 6baafdd7d9, zortos293/Lichii#805 6229487c8c): the earlier of
+// the last writer and the last host-level wait. A writer before the wait is waited for with
+// everything before it; one after it is not.
+bool GpuSplit::WaitForSyncedWriters(DrainSite site) {
+    return WaitFor(std::min({last_writer_position, list_sync_position, write_position}), site);
+}
+
 // From Lichii (zortos293/Lichii, nx2 at 27226d2568): one wait with a site for the report. It waits
 // as WaitForWriters and WaitForSpace did, and now both wake a parked back and report as Drain does.
 bool GpuSplit::WaitFor(u64 target, DrainSite site) {
diff --git a/src/video_core/gpu_split.h b/src/video_core/gpu_split.h
index a269023..feb89e5 100644
--- a/src/video_core/gpu_split.h
+++ b/src/video_core/gpu_split.h
@@ -337,9 +337,54 @@ public:
     /// DMA reads) of bytes not flushed after it wait for it (a drain does not make GPU-written
     /// data visible, only a flush of those bytes does).
     void NoteSync() {
+        NoteListSync(); // EDEN_UP_FRITCHII_LISTSYNC; nothing unless set
         if (!DmaReadAhead()) return;
         sync_position = write_position;
     }
+
+    // EDEN_UP_FRITCHII_LISTSYNC=1 (Frizti/Fritchii 6baafdd7d9, from zortos293/Lichii#805
+    // 6229487c8c by jpkto): before the front parses a command entry on pages no GPU work has
+    // written yet, it waits only for the compute and copy work sent before the last host-level
+    // wait, not for every queued writer (DmaPusher::Step, the "list writers" site). The PBDMA
+    // fetches an entry ahead of the engines running the work before it; only a host-level wait
+    // in between (a GP entry's sync bit, a host or 3D wait for idle, a syncpoint or semaphore
+    // acquire) makes that work complete first, so a game cannot rely on a later writer.
+    // EDEN_UP_FRITCHII_LISTSKIP=1 (Lichii#805 d4e8d85d4d; includes LISTSYNC): an entry that begins
+    // between methods (a command buffer the CPU writes) does not wait at all while no copy engine
+    // work is queued; entries that begin inside a method's data (the parameters compute writes,
+    // as Ocarina's 0xe62/0xe74 macro data) still wait. Entries that skipped any writer are checked
+    // on the back and logged when one of those writers wrote them. Both off unless exactly "1".
+    /// 0: wait for every writer (unset), 1: LISTSYNC, 2: LISTSKIP.
+    static int ListSyncMode() {
+        static const int mode = Common::PeSwitch("EDEN_UP_FRITCHII_LISTSKIP")   ? 2
+                                : Common::PeSwitch("EDEN_UP_FRITCHII_LISTSYNC") ? 1
+                                                                                : 0;
+        return mode;
+    }
+    /// Front: a host-level wait was just sent or passed (see ListSyncMode). Every acquire counts,
+    /// drained or not: more syncs only make command entries wait for more writers.
+    void NoteListSync() {
+        if (ListSyncMode() == 0) return;
+        list_sync_position = write_position;
+    }
+    /// Front, EDEN_UP_FRITCHII_LISTSKIP: copy engine work that may write memory was just sent (after
+    /// NoteWriter). It can copy GPU-written words anywhere, so every entry waits while it is queued.
+    void NoteCopyWriter() {
+        if (ListSyncMode() < 2) return;
+        last_copy_writer_position = write_position;
+    }
+    /// Front, EDEN_UP_FRITCHII_LISTSKIP: whether copy engine work sent so far may still be queued.
+    [[nodiscard]] bool CopyWritersPending() const {
+        return consumed.load(std::memory_order_acquire) < last_copy_writer_position;
+    }
+    /// Front, EDEN_UP_FRITCHII_LISTSYNC: waits until the back executed the compute and copy work
+    /// sent before the last NoteListSync. Returns whether any of it was still queued.
+    bool WaitForSyncedWriters(DrainSite site = DrainSite::ListWriters);
+    /// Whether the back executed the work sent before `position` (as far as it stored `consumed`,
+    /// every few thousand words of a batch and at its end).
+    [[nodiscard]] bool Ran(u64 position) const {
+        return consumed.load(std::memory_order_acquire) >= position;
+    }
     /// The ring position of the last wait for idle sent; 0 when none was sent this session.
     [[nodiscard]] u64 SyncPosition() const {
         return sync_position;
@@ -604,6 +649,10 @@ private:
     std::unordered_map<u64, u64> front_reports; ///< key of each word -> write_position after it
     std::unordered_set<u64> reported_words;     ///< every word a report was sent to
     u64 sync_position{};
+    /// EDEN_UP_FRITCHII_LISTSYNC / _LISTSKIP: the last host-level wait and the last copy engine
+    /// writer (NoteListSync, NoteCopyWriter); 0 before the first this session.
+    u64 list_sync_position{};
+    u64 last_copy_writer_position{};
     /// EDEN_UP_DRAIN_SKIP_SAME: the words whose drained reads hold at same_read_position.
     std::array<u64, 4> same_read_keys{};
     size_t same_read_count{};
