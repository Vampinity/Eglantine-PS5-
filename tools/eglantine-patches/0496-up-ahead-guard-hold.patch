+inline bool HoldWrites() {
+    return Mode() == 3 && Get().active.load(std::memory_order_acquire);
+}
 inline bool Guarded(u64 device_addr, u64 size) {
     constexpr u64 limit = u64{1} << AddressBits;
     if (size == 0 || device_addr >= limit) {
@@ -552,7 +578,7 @@ void Read(u64 device_addr, u8* out, u64 size, bool upload, Live&& live) {
 /// has no device address, is read as before.
