         const int parsed =
-            value != nullptr && (value[0] == '1' || value[0] == '2') && value[1] == '\0'
+            value != nullptr && value[0] >= '1' && value[0] <= '3' && value[1] == '\0'
                 ? value[0] - '0'
                 : 0;
         if (parsed == 1) {
             LOG_INFO(HW_GPU, "EDEN_UP_AHEAD_GUARD=1: guest writes to buffer pages of a frame in "
