diff --git a/src/video_core/gpu.cpp b/src/video_core/gpu.cpp
index 0fc3621..bb8c30b 100644
--- a/src/video_core/gpu.cpp
+++ b/src/video_core/gpu.cpp
@@ -184,6 +184,41 @@ struct GPU::Impl {
         }
     }
 
+    /// The guest writes to apply now. EDEN_UP_AHEAD_GUARD (ahead_guard.h):
+    ///  =2, =3: ranges uploads read from copies of a frame that is done now count as guest writes,
+    ///      so buffers uploaded from the copies are uploaded again;
+    ///  =3: first the writes gathered at the present that put the guard up
+    ///      (GatherForAheadGuard): they were made before it, so they are the frame's own. While
+    ///      the guard is up nothing more is gathered: what the cores collect meanwhile is a later
+    ///      frame's, stays with them (and in ForEachPendingCpuWrite's view), and is applied by
+    ///      the first gather after the guard is lifted.
+    void GatherForApply(std::function<void(PAddr, size_t)>& callback_writes) {
+        if (!VideoCommon::AheadGuard::Enabled()) [[likely]] {
+            system.GatherGPUDirtyMemory(callback_writes);
+            return;
+        }
+        std::scoped_lock lock{ahead_gather_mutex};
+        for (const auto& [address, size] : ahead_gathered_writes) {
+            callback_writes(address, size);
+        }
+        ahead_gathered_writes.clear();
+        if (!VideoCommon::AheadGuard::HoldWrites()) {
+            system.GatherGPUDirtyMemory(callback_writes);
+            VideoCommon::AheadGuard::TakeRedirty(callback_writes);
+        }
+    }
+
+    /// EDEN_UP_AHEAD_GUARD=3, from nx2:vi2 PresentClientBuffer on its own thread, just before a
+    /// present that returns ahead of its frame's fence puts the guard up: gathers what the cores
+    /// collected so far for the next GatherAndApply.
+    void GatherForAheadGuard() {
+        std::scoped_lock lock{ahead_gather_mutex};
+        std::function<void(PAddr, size_t)> keep([this](PAddr address, size_t size) {
+            ahead_gathered_writes.emplace_back(address, size);
+        });
+        system.GatherGPUDirtyMemory(keep);
+    }
+
     /// Gathers the collected guest writes and applies them. EDEN_UP_L1028_ASYNC_READBACK
     /// (zortos293/Lichii #1028): they stay pending (ForEachPendingCpuWrite) until applied, so a
     /// read download written to guest memory meanwhile, on another thread or by the apply itself
@@ -194,10 +229,7 @@ struct GPU::Impl {
