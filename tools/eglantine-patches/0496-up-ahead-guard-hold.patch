                 ForgetHandedOutWrites();
@@ -206,10 +238,7 @@ struct GPU::Impl {
         }
         {
             std::scoped_lock lock{applying_writes_mutex};
-            system.GatherGPUDirtyMemory(callback_writes);
-            // EDEN_UP_AHEAD_GUARD=2 (ahead_guard.h): pages copied for a frame that is done now
-            // count as guest writes, so buffers uploaded from the copies are uploaded again.
-            VideoCommon::AheadGuard::TakeRedirty(callback_writes);
+            GatherForApply(callback_writes);
             if (writes.empty()) {
                 return;
             }
@@ -270,6 +299,13 @@ struct GPU::Impl {
         for (auto& manager : system.GetGPUDirtyMemoryManager()) {
             manager.ForEachPending(callback);
         }
+        // EDEN_UP_AHEAD_GUARD=3: the writes gathered at a present and not applied yet.
