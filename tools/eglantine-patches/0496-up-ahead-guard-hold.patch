+        } else if (parsed >= 2) {
+            LOG_INFO(HW_GPU,
+                     "EDEN_UP_AHEAD_GUARD={}: buffer pages of a frame in flight are copied "
+                     "before a guest write, and the GPU thread reads the copies{}",
+                     parsed,
+                     parsed == 3 ? "; guest writes made meanwhile are applied after its fence"
+                                 : "");
         }
         return parsed;
     }();
@@ -85,6 +100,11 @@ inline bool Enabled() {
     return Mode() != 0;
 }
 
+/// Writers copy the page first (=2 and =3).
+inline bool CopyMode() {
+    return Mode() >= 2;
+}
+
