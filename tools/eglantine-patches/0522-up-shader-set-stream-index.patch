+/// EDEN_UP_SHADER_SET_STREAM: inflates `frame` from its start once more; `chunk(at, bytes)` sees
+/// the content in order, up to StreamChunk bytes at a time, from `window`. Stops as Inflate does
+/// (end of frame, or no more input). Returns the content size.
+u64 StreamFrame(const Zstd& zstd, ZSTD_DCtx* context, Bytes frame, std::vector<u8>& window,
+                const std::function<void(u64 at, Bytes chunk)>& chunk) {
+    ZSTD_DCtx_reset(context, ZSTD_reset_session_and_parameters);
+    if (const ZSTD_DDict* dict = zstd.Dictionary(frame)) {
+        ZSTD_DCtx_refDDict(context, dict);
+    }
+    window.resize(StreamChunk);
+    ZSTD_inBuffer in{frame.data(), frame.size(), 0};
+    u64 at = 0;
+    for (;;) {
+        ZSTD_outBuffer o{window.data(), window.size(), 0};
+        const size_t status = ZSTD_decompressStream(context, &o, &in);
+        if (ZSTD_isError(status)) {
+            throw Bad(fmt::format("zstd: {}", ZSTD_getErrorName(status)));
+        }
+        if (o.pos != 0) {
+            chunk(at, Bytes{window.data(), o.pos});
+            at += o.pos;
+            if (at > StreamMost) {
+                throw Bad(fmt::format("zstd content over {} GiB", StreamMost >> 30));
+            }
+        }
+        if (status == 0 || (in.pos == in.size && o.pos == 0)) {
+            return at;
+        }
+    }
+}
+
+/// [start, end) byte ranges of streamed content, sorted and merged (pieces StreamGap apart join).
+using Ranges = std::vector<std::pair<u64, u64>>;
+
+void Merge(Ranges& ranges) {
+    std::sort(ranges.begin(), ranges.end());
+    Ranges merged;
+    for (const auto& [start, end] : ranges) {
+        if (start >= end) {
+            continue;
+        }
+        if (!merged.empty() && start <= merged.back().second + StreamGap) {
+            merged.back().second = std::max(merged.back().second, end);
+        } else {
+            merged.emplace_back(start, end);
+        }
+    }
+    ranges = std::move(merged);
+}
+
+/// EDEN_UP_SHADER_SET_STREAM: the pieces of streamed content a pass kept, by start.
+class Held {
+public:
+    /// [at, at + size) if one kept piece holds all of it.
+    std::optional<Bytes> Find(u64 at, u64 size) const {
+        auto it = pieces.upper_bound(at);
+        if (it == pieces.begin()) {
+            return std::nullopt;
+        }
+        --it;
+        const u64 into = at - it->first;
+        const auto& bytes = it->second;
+        if (into > bytes.size() || size > bytes.size() - into) {
+            return std::nullopt;
+        }
+        return Bytes{bytes}.subspan(static_cast<size_t>(into), static_cast<size_t>(size));
+    }
+
+    /// One more pass: keeps what is kept now plus `asked`, and nothing else.
+    void Refill(const Zstd& zstd, ZSTD_DCtx* context, Bytes frame, std::vector<u8>& window,
+                Ranges asked) {
+        for (const auto& [start, bytes] : pieces) {
+            asked.emplace_back(start, start + bytes.size());
+        }
+        Merge(asked);
+        u64 total = 0;
+        for (const auto& [start, end] : asked) {
+            total += end - start;
+        }
+        if (total > MaxBlob) {
+            throw Bad(fmt::format("BNSH tables and control sections of {} MiB are over the {} MiB "
+                                  "cap", total >> 20, MaxBlob >> 20));
+        }
+        pieces.clear();
+        std::vector<std::vector<u8>*> into;
+        for (const auto& [start, end] : asked) {
+            auto& bytes = pieces[start];
+            bytes.resize(static_cast<size_t>(end - start));
+            into.push_back(&bytes);
+        }
+        size_t first = 0;
+        const u64 size = StreamFrame(zstd, context, frame, window, [&](u64 at, Bytes chunk) {
+            const u64 end = at + chunk.size();
+            while (first < asked.size() && asked[first].second <= at) {
+                ++first;
+            }
+            for (size_t i = first; i < asked.size() && asked[i].first < end; ++i) {
+                const u64 from = std::max(at, asked[i].first);
+                const u64 to = std::min(end, asked[i].second);
+                if (from < to) {
+                    std::memcpy(into[i]->data() + (from - asked[i].first),
+                                chunk.data() + (from - at), static_cast<size_t>(to - from));
+                }
+            }
+        });
+        for (size_t i = 0; i < asked.size(); ++i) {
+            if (asked[i].second > size) { // the content ended early: keep what came
+                into[i]->resize(static_cast<size_t>(size > asked[i].first ? size - asked[i].first : 0));
+            }
+        }
+    }
+
+private:
+    std::map<u64, std::vector<u8>> pieces;
+};
