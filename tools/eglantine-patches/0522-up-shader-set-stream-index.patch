+/// EDEN_UP_SHADER_SET_INDEX=1: shader_set_index.txt beside the recipe lists the RomFS sources of
+/// the game's shaders, one per line ("/dir/file[/member...]", anything from a '#' on ignored),
+/// as nxnative's shader_map.tsv names them (github.com/seedds/nxnative, MIT, Copyright (c) 2026
+/// seedds). Each line and every '/'-prefix of it goes into `only`, so a RomFS file is read when
+/// a source lies in it. False when the file is missing or names nothing (then all files are read).
+constexpr const char* IndexName = "shader_set_index.txt";
+bool ReadIndex(const std::filesystem::path& path, std::unordered_set<std::string>& only, size_t& sources) {
+    std::ifstream f{path};
+    sources = 0;
+    for (std::string line; f && std::getline(f, line);) {
+        if (const auto hash = line.find('#'); hash != std::string::npos) line.resize(hash);
+        while (!line.empty() && (line.back() == '\r' || line.back() == ' ' || line.back() == '\t')) line.pop_back();
+        if (line.size() < 2 || line.front() != '/') continue;
+        ++sources;
+        for (size_t slash = line.find('/', 1); slash != std::string::npos; slash = line.find('/', slash + 1))
+            only.insert(line.substr(0, slash));
+        only.insert(line);
+    }
+    return sources != 0;
+}
