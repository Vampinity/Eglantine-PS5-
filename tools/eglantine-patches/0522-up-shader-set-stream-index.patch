+    /// What a member cut gives, for _VERIFY's comparison.
+    struct Cutout {
+        Stage stage;
+        u64 fingerprint;
+        std::string origin;
+        bool operator<(const Cutout& other) const {
+            return std::tie(origin, fingerprint, stage) <
+                   std::tie(other.origin, other.fingerprint, other.stage);
+        }
+        bool operator==(const Cutout& other) const {
+            return stage == other.stage && fingerprint == other.fingerprint &&
+                   origin == other.origin;
+        }
+    };
+
+    /// Content Walk() would only search for BNSH (and sead's drawer, which needs under 1 MiB).
+    static bool Streamable(Bytes data) {
+        return data.size() >= 8 && !IsZstd(data) && !Starts(data, "Yaz0") &&
+               !Starts(data, "SARC") && !Starts(data, "BAHS") && !Starts(data, "NDSR") &&
+               !Starts(data, "NDVE");
+    }
+
+    /// A zstd member as Top() and Walk() inflate it, except that content over the cap is never
+    /// searched cut short: BNSH data is cut in passes, anything else is an error.
+    void InflateMember(Bytes frame, const std::string& label, int depth) {
+        const unsigned long long declared = ZSTD_getFrameContentSize(frame.data(), frame.size());
+        const bool over = declared != ZSTD_CONTENTSIZE_UNKNOWN &&
+                          declared != ZSTD_CONTENTSIZE_ERROR && declared > MaxBlob;
+        if (!over) {
+            bool cut = false;
+            const auto inner = Inflate(zstd, context, frame, MaxBlob, &cut);
+            if (!cut) {
+                stats.inflated_bytes += inner.size();
+                if (StreamVerify() && depth <= MaxDepth && Streamable(inner)) {
+                    VerifyStreamed(frame, inner, label, depth);
+                } else {
+                    Walk(inner, label, depth);
+                }
+                return;
+            }
+        }
+        ++stats.cut_at_cap;
+        if (depth > MaxDepth) {
+            return; // Walk() would not look at it
+        }
+        const auto head = Inflate(zstd, context, frame, PeekBytes);
+        if (!Streamable(head)) {
+            throw Bad(fmt::format("zstd content over the {} MiB cap is a container, not BNSH "
+                                  "data, and was not read (EDEN_UP_SHADER_SET_MAX_MB)",
+                                  MaxBlob >> 20));
+        }
+        auto cut = Streamed(frame, label, [&](Stage stage, Bytes control, Bytes code,
+                                              const std::string& origin) {
+            Emit(stage, control, code, origin, origin);
+        });
+        ++stats.streamed;
+        stats.stream_passes += cut.passes;
+        stats.inflated_bytes += cut.size;
+        stats.containers += cut.containers;
+        errors.insert(errors.end(), cut.errors.begin(), cut.errors.end());
+    }
+
+    /// _VERIFY: Walk() as usual, watched, then the same member cut in passes; the two must give
+    /// the same programs from the same BNSH variations.
+    void VerifyStreamed(Bytes frame, Bytes inner, const std::string& label, int depth) {
+        std::vector<Cutout> whole;
+        tap = &whole;
+        try {
+            Walk(inner, label, depth);
+        } catch (...) {
+            tap = nullptr;
+            throw;
+        }
+        tap = nullptr;
+        std::erase_if(whole, [](const Cutout& c) { return c.origin.ends_with("#SEADPRIM"); });
+        std::vector<Cutout> streamed;
+        u64 passes = 0;
+        std::string failed;
+        try {
+            const auto cut = Streamed(frame, label, [&](Stage stage, Bytes control, Bytes code,
+                                                        const std::string& origin) {
+                streamed.push_back({stage, Fingerprint(control, code), origin});
+            });
+            passes = cut.passes;
+        } catch (const Bad& e) {
+            failed = e.what();
+        }
+        ++stats.verified;
+        stats.stream_passes += passes;
+        std::sort(whole.begin(), whole.end()); // as multisets: one per stage record, both ways
+        std::sort(streamed.begin(), streamed.end());
+        if (failed.empty() && whole == streamed) {
+            return;
+        }
+        std::string first = failed;
+        if (first.empty()) {
+            const auto [a, b] = std::mismatch(whole.begin(), whole.end(), streamed.begin(),
+                                              streamed.end());
+            const auto& c = a != whole.end() ? *a : *b;
+            first = fmt::format("{} {:016x} {} only {}", StageName(c.stage), c.fingerprint,
+                                c.origin, a != whole.end() ? "whole" : "streamed");
+        }
+        errors.push_back(fmt::format("{}: stream verify: whole cut {} programs, streamed {}; {}",
+                                     label, whole.size(), streamed.size(), first));
+    }
