+            users.emplace(std::pair{p.code_at, p.code_at + p.code_size}, &p);
+        }
+        const auto deliver = [&](const std::pair<u64, u64>& range, Bytes code) {
+            const auto [from, to] = users.equal_range(range);
+            for (auto it = from; it != to; ++it) {
+                const Piece& p = *it->second;
+                const auto control = held.Find(p.control_at, p.control_size);
+                if (!control) {
+                    throw Bad(fmt::format("control section at {:#x} was not kept", p.control_at));
+                }
+                sink(p.stage, *control, code,
+                     fmt::format("{}#BNSH@{:#x}#var{}", label, p.base, p.variation));
+            }
+        };
+        struct Open {
+            size_t range;
+            std::vector<u8> bytes;
+        };
