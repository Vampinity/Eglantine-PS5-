+    using Sink = std::function<void(Stage, Bytes control, Bytes code, const std::string& origin)>;
+
+    struct StreamedCut {
+        u64 size{};       ///< the content's
+        u64 passes{};
+        u64 containers{}; ///< BNSH parsed without an error, as EmbeddedBnsh counts them
+        std::vector<std::string> errors;
