+constexpr size_t StreamChunk = 4 * 1024 * 1024;  // output window of a pass
+constexpr u64 StreamMost = u64{4} << 30;          // content a pass inflates at most
+constexpr u64 StreamGap = 64;                     // kept pieces this close are merged
+constexpr u64 StreamAsk = 0x100;                  // a missed read asks for at least this much
+constexpr int StreamMaxPasses = 12;
