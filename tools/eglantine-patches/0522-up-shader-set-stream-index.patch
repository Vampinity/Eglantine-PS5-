+    /// A read of one BNSH (offsets from its start, as Bnsh() reads them) not kept yet: asked for.
+    struct Missing {};
+
+    /// One BNSH read from kept pieces with Bnsh()'s bounds checks and messages; a read that is
+    /// not kept yet is asked for (at least StreamAsk bytes) and throws Missing.
+    struct View {
+        const Held& held;
+        Ranges& asked;
+        u64 base;
+        u64 size;
+
+        void Ask(u64 at, u64 n) const {
+            if (at < size) {
+                asked.emplace_back(base + at, base + at + std::min(n, size - at));
+            }
+        }
+        Bytes Get(u64 at, u64 n) const {
+            if (n == 0) {
+                return {};
+            }
+            if (const auto bytes = held.Find(base + at, n)) {
+                return *bytes;
+            }
+            Ask(at, std::max(n, StreamAsk));
+            throw Missing{};
+        }
+        template <typename T>
+        T Load(u64 at) const {
+            if (at > size || sizeof(T) > size - at) {
+                throw Bad(fmt::format("read past the end at {:#x}", at));
+            }
+            T value;
+            std::memcpy(&value, Get(at, sizeof(T)).data(), sizeof(T));
+            return value;
+        }
+        Bytes Sub(u64 at, u64 n) const {
+            if (at > size || n > size - at) {
+                throw Bad(fmt::format("range {:#x}+{:#x} past the end", at, n));
+            }
+            return Get(at, n);
+        }
+    };
+
+    /// A program Bnsh() would emit: where its pieces are in the content.
+    struct Piece {
+        Stage stage;
+        u64 base;      ///< the BNSH's offset
+        u32 variation;
+        u64 control_at;
+        u32 control_size;
+        u64 code_at;
+        u32 code_size;
+    };
+
+    struct Plan {
+        std::vector<Piece> pieces; ///< in Bnsh()'s order
+        bool complete = true;      ///< no read was missing up to the end (or the error)
+        std::optional<std::string> bad;
+    };
+
+    /// Bnsh() line for line over kept pieces, recording instead of emitting. While reads are
+    /// missing the plan is not complete; it is used only once a pass leaves none missing, and
+    /// then it is exactly what Bnsh() emits, up to the Bad that ends the BNSH.
+    Plan PlanBnsh(const View& d) {
+        Plan plan;
+        try {
+            if (!Starts(d.Sub(0x60, 4), "grsc")) {
+                throw Bad("no grsc block");
+            }
+            const u32 count = d.Load<u32>(0x7c);
+            const u64 table = d.Load<u64>(0x80);
+            if (table < d.size) {
+                d.Ask(table, std::min<u64>(u64{count} * 0x40, d.size - table));
+            }
+            static constexpr std::array slots{Stage::Vertex,   Stage::TessControl,
+                                              Stage::TessEval, Stage::Geometry,
+                                              Stage::Fragment, Stage::Compute};
+            // A missing read ends only its own stage, so one pass asks for every stage's reads.
+            const auto attempt = [&](auto&& step) {
+                try {
+                    step();
+                } catch (const Missing&) {
+                    plan.complete = false;
+                }
+            };
+            for (u32 v = 0; v < count; ++v) {
+                u64 program = 0;
+                attempt([&] { program = d.Load<u64>(table + 0x40 * u64{v} + 0x10); });
+                if (program == 0) {
+                    continue; // none, or not kept yet
+                }
+                const auto stage_at = [&](u64 record, Stage stage, bool optional) {
+                    const u64 control_at = d.Load<u64>(record + 0x08);
+                    const u64 code_at = d.Load<u64>(record + 0x10);
+                    const u32 code_size = d.Load<u32>(record + 0x18);
+                    const u32 control_size = d.Load<u32>(record + 0x1c);
+                    if (optional && (control_size < KeyControl || control_size >= 0x10000 ||
+                                     control_at + control_size > d.size ||
+                                     code_at + code_size > d.size)) {
+                        return;
+                    }
+                    const auto control = d.Sub(control_at, control_size);
