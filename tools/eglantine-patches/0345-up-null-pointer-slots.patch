+                if (up_collect) env_.StoragePointerSlots(pipeline->pointer_slots, pipeline->null_pointer_slots);
+            }
             std::scoped_lock lock{state.mutex};
             if (pipeline) {
-                compute_cache.emplace(key, std::move(pipeline));
+                // A program rebuilt for a filled pointer slot has a second record: keep the one
+                // that binds more pointers.
+                static const bool up_keep_best = Common::PeSwitch("EDEN_UP_NULL_POINTER_SLOTS");
+                if (!up_keep_best) {
+                    compute_cache.emplace(key, std::move(pipeline));
+                } else {
+                auto& slot{compute_cache[key]};
+                if (!slot || slot->pointer_slots.size() < pipeline->pointer_slots.size()) {
+                    slot = std::move(pipeline);
+                }
+                }
             }
             ++state.built;
             if (state.has_loaded) {
@@ -2065,7 +2122,8 @@ std::unique_ptr<GraphicsPipeline> PipelineCache::CreateGraphicsPipeline() {
 }
 
 std::unique_ptr<ComputePipeline> PipelineCache::CreateComputePipeline(
-    const ComputePipelineCacheKey& key, const ShaderInfo* shader) {
+    const ComputePipelineCacheKey& key, const ShaderInfo* shader,
+    const ComputePipeline* previous) {
     Common::HangSite site{"building a compute pipeline"};
     const auto begin = std::chrono::steady_clock::now();
     SCOPE_EXIT {
@@ -2076,9 +2134,19 @@ std::unique_ptr<ComputePipeline> PipelineCache::CreateComputePipeline(
     ComputeEnvironment env{*kepler_compute, *gpu_memory, program_base, qmd.program_start,
                            shader->lowered_native};
     env.SetCachedSize(shader->size_bytes);
+    if (previous) {
+        // Keep the buffers the previous build bound, so a slot that empties again later doesn't
+        // drop them and start another rebuild.
+        env.SeedStoragePointers(previous->pointer_slots);
+    }
 
     main_pools.ReleaseContents();
     auto pipeline{CreateComputePipeline(main_pools, key, env, nullptr, true)};
+    if (pipeline) {
+        static const bool up_collect = Common::PeSwitch("EDEN_UP_NULL_POINTER_SLOTS");
+        if (up_collect) env.StoragePointerSlots(pipeline->pointer_slots, pipeline->null_pointer_slots);
+        pipeline->pointer_rebuilds = previous ? previous->pointer_rebuilds + 1 : 0;
+    }
     if (!pipeline || pipeline_cache_filename.empty()) {
         return pipeline;
     }
