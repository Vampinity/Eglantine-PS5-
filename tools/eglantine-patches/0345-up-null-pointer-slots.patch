 .../renderer_vulkan/vk_pipeline_cache.cpp     | 74 ++++++++++++++++++-
 .../renderer_vulkan/vk_pipeline_cache.h       |  6 +-
 src/video_core/shader_environment.cpp         | 39 ++++++++++
 src/video_core/shader_environment.h           | 10 +++
 5 files changed, 132 insertions(+), 4 deletions(-)

