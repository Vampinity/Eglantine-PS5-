diff --git a/src/video_core/renderer_vulkan/vk_driver_build_report.h b/src/video_core/renderer_vulkan/vk_driver_build_report.h
new file mode 100644
index 0000000..f544ee1
--- /dev/null
+++ b/src/video_core/renderer_vulkan/vk_driver_build_report.h
@@ -0,0 +1,145 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+// EDEN_UP_DRIVER_BUILD_LOG=1 (exactly "1", off by default): log only.
+// Every 10 s with builds: how many graphics and compute pipelines the driver built, how many took
+// over 10 ms (compiled, not taken from the driver's cache), the mean and the maximum.
+// Every 5 s with any: how many compute pipelines and mesh pipelines were translated with the
+// runtime pools, that is on the GPU thread. A window with none is not logged.
+// Port of Eglantine-Community 212568b2 (kraibse); the translation counts are ours.
+//
+// Build() runs on the pipeline builder threads. It only adds to the window under the lock: it
+// never logs, so a builder that waits for heap memory (EDEN_UP_HEAP_WAIT_MS) never does so with
+// this lock held. Poll() runs once a frame on the thread that ticks the pipeline cache, takes the
+// due windows under the lock and logs them after it is released.
+#pragma once
+
+#include <algorithm>
+#include <chrono>
+#include <mutex>
+
+#include "common/common_types.h"
+#include "common/logging.h"
+#include "common/pe_switch.h"
+
+namespace Vulkan::DriverBuildReport {
+
+using Clock = std::chrono::steady_clock;
+
+enum class Kind { Graphics, Compute };
+
+inline bool On() {
+    static const bool on = Common::PeSwitch("EDEN_UP_DRIVER_BUILD_LOG");
+    return on;
+}
+
+struct Totals {
+    u64 graphics{};
+    u64 compute{};
+    u64 slow{};
+    double sum_ms{};
+    double max_ms{};
+};
+
+struct State {
+    Totals builds;
+    u64 compute_translations{};
+    u64 mesh_translations{};
+    Clock::time_point builds_start{};
+    Clock::time_point translations_start{};
+    bool announced{};
+};
+
+inline std::mutex state_mutex;
+inline State state;
+
+/// One compute pipeline (mesh false) or one mesh pipeline (mesh true) translated on the GPU thread.
+inline void Translation(bool mesh) {
+    if (!On()) {
+        return;
+    }
+    std::scoped_lock lock{state_mutex};
+    ++(mesh ? state.mesh_translations : state.compute_translations);
+}
+
+/// Times one driver call that makes a pipeline and returns what it made. A call that throws is
+/// not counted. Off: the call and nothing else.
+template <typename F>
+auto Build(Kind kind, F&& make) {
+    if (!On()) {
+        return make();
+    }
+    const Clock::time_point begin = Clock::now();
+    auto made = make();
+    const double ms = std::chrono::duration<double, std::milli>(Clock::now() - begin).count();
+    {
+        std::scoped_lock lock{state_mutex};
+        if (state.builds_start == Clock::time_point{}) {
+            state.builds_start = begin;
+        }
+        ++(kind == Kind::Graphics ? state.builds.graphics : state.builds.compute);
+        state.builds.slow += ms > 10.0 ? 1 : 0;
+        state.builds.sum_ms += ms;
+        state.builds.max_ms = (std::max)(state.builds.max_ms, ms);
+    }
+    return made;
+}
+
+/// Once a frame (PipelineCache::TickFrame). The builds of the boot, made before the first frame,
+/// come out as the first line, with the time they took as its window.
+inline void Poll() {
+    if (!On()) {
+        return;
+    }
+    const Clock::time_point now = Clock::now();
+    Totals builds;
+    u64 compute = 0;
+    u64 mesh = 0;
+    double builds_s = 0.0;
+    double translations_s = 0.0;
+    bool announce = false;
+    {
+        std::scoped_lock lock{state_mutex};
+        if (!state.announced) {
+            state.announced = true;
+            announce = true;
+        }
+        if (state.builds_start == Clock::time_point{}) {
+            state.builds_start = now;
+        }
+        if (state.translations_start == Clock::time_point{}) {
+            state.translations_start = now;
+        }
+        if (now - state.builds_start >= std::chrono::seconds{10}) {
+            builds = state.builds;
+            builds_s = std::chrono::duration<double>(now - state.builds_start).count();
+            state.builds = Totals{};
+            state.builds_start = now;
+        }
+        if (now - state.translations_start >= std::chrono::seconds{5}) {
+            compute = state.compute_translations;
+            mesh = state.mesh_translations;
+            translations_s = std::chrono::duration<double>(now - state.translations_start).count();
+            state.compute_translations = 0;
+            state.mesh_translations = 0;
+            state.translations_start = now;
+        }
+    }
+    if (announce) {
+        LOG_INFO(Render_Vulkan,
+                 "EDEN_UP_DRIVER_BUILD_LOG on: driver pipeline builds per 10 s, GPU thread compute "
+                 "translations per 5 s; a window with none is not logged");
+    }
+    if (const u64 count = builds.graphics + builds.compute; count != 0) {
+        LOG_INFO(Render_Vulkan,
+                 "Driver pipeline builds: {} graphics, {} compute, {} over 10 ms; {:.1f} ms mean, "
+                 "{:.1f} ms max; {:.1f} s window",
+                 builds.graphics, builds.compute, builds.slow,
+                 builds.sum_ms / static_cast<double>(count), builds.max_ms, builds_s);
+    }
+    if (compute + mesh != 0) {
+        LOG_INFO(Render_Vulkan,
+                 "GPU thread compute translations: {} compute, {} mesh pipelines in {:.1f} s",
+                 compute, mesh, translations_s);
+    }
+}
+
+} // namespace Vulkan::DriverBuildReport
