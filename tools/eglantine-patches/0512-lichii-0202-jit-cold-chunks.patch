 #include <array>
+#include <atomic>
+#include <cstdio>
 #include <cstring>
 
 #include "common/assert.h"
+#include "common/pe_switch.h"
 #include "dynarmic/mcl/bit.hpp"
 #include "dynarmic/backend/x64/xbyak.h"
 
@@ -221,6 +224,7 @@ void BlockOfCode::DisableWriting() {
