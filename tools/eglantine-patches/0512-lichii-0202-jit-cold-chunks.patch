+++ b/src/dynarmic/src/dynarmic/backend/x64/block_of_code.h
@@ -143,6 +143,17 @@ public:
     void SetCodePtr(CodePtr code_ptr);
     void EnsurePatchLocationSize(CodePtr begin, size_t size);
 
+    /// EDEN_UP_JIT_COLD_CHUNKS=1: a block's slow paths (deferred emits) go into cold chunks reserved
+    /// in the code stream instead of right after its hot code, so hot code stays dense in the
+    /// instruction caches. BeginColdCode returns where the block's hot code ends; ColdCodeStep goes
+    /// before each deferred emit; EndColdCode returns to the hot frontier (true if cold code was
+    /// used). ResetColdCode forgets the chunk (the cache was cleared). Off: all four leave the
+    /// emitted code as it was.
+    CodePtr BeginColdCode();
+    void ColdCodeStep();
+    bool EndColdCode();
+    void ResetColdCode();
+
     static const Xbyak::Reg64 ABI_JIT_PTR;
     // ABI registers
 #ifdef _WIN32
@@ -180,6 +191,13 @@ private:
     RunCodeFuncType step_code = nullptr;
     RunCodeCallbacks cb;
     CodePtr code_begin = nullptr;
+    // Cold code (EDEN_UP_JIT_COLD_CHUNKS): the current chunk's next free byte and end, and where hot
+    // code resumes after a block's slow paths. Forgotten by ResetColdCode (EmitX64::ClearCache).
+    const u8* cold_ptr = nullptr;
+    const u8* cold_end = nullptr;
+    const u8* hot_resume = nullptr;
+    bool cold_active = false;
+    bool writing_cold = false;
 #ifdef _WIN32
     size_t committed_size = 0;
 #endif
