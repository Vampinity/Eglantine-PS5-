 }
 
+namespace {
+// EDEN_UP_JIT_COLD_CHUNKS=1 (exact "1"), read at the first block that has slow paths, after env.txt
+// is in the environment. Unset or anything else: slow paths stay right after their block.
+bool ColdCodeSwitch() {
+    static const bool on = ::Common::PeSwitch("EDEN_UP_JIT_COLD_CHUNKS");
+    return on;
+}
+constexpr size_t COLD_CHUNK = 256 * 1024;        // one reservation in the code stream
+constexpr size_t COLD_SLACK = 8 * 1024;          // more than any single deferred emit
+constexpr size_t COLD_KEEP = 2 * 1024 * 1024;    // below this room after a chunk, stay inline
+std::atomic<unsigned> cold_chunks_total{0};
+std::atomic<bool> cold_logged{false};
+}  // namespace
+
+CodePtr BlockOfCode::BeginColdCode() {
+    const u8* const hot_end = getCurr<const u8*>();
+    cold_active = writing_cold = false;
+    if (!ColdCodeSwitch() || !prelude_complete)
+        return hot_end;
+    // Cold code is written behind the hot frontier, which the port's page-local W^X allows only
+    // through the separate writable view (headless/jit-alias.cmake).
+#ifdef EDEN_JIT_ALIAS_LAYOUT
+    const bool alias = hasWritableAlias();
+#else
+    const bool alias = false;
+#endif
+    if (!cold_logged.load(std::memory_order_relaxed) && !cold_logged.exchange(true, std::memory_order_relaxed))
+        std::printf("EDEN_UP_JIT_COLD_CHUNKS on=%d chunk_kib=%zu\n", alias ? 1 : 0, COLD_CHUNK / 1024);
+    if (!alias)
+        return hot_end;
+    // After a full clear the frontier is behind the old chunk: that chunk is free space now.
+    if (cold_end > hot_end)
+        cold_ptr = cold_end = nullptr;
+    hot_resume = hot_end;
+    cold_active = true;
+    ColdCodeStep();
+    return hot_end;
+}
+
+void BlockOfCode::ColdCodeStep() {
+    if (!cold_active)
+        return;
+    if (writing_cold) {
+        cold_ptr = getCurr<const u8*>();
+        ASSERT(cold_ptr <= cold_end);
+    }
+    if (cold_ptr && size_t(cold_end - cold_ptr) >= COLD_SLACK) {
+        if (!writing_cold)
+            SetCodePtr(cold_ptr);
+        writing_cold = true;
+        return;
+    }
+    // A new chunk at the hot frontier; hot code continues after it. Near the end of the cache the
+    // rest of this block's slow paths stay inline, as without the switch.
+    if (writing_cold) {
+        // A slow path may fall through into the next one (EmitDetectMisalignedVAddr's page-boundary
+        // check falls into the access's abort path): carry it on to where the next one goes.
+        jmp(static_cast<const void*>(hot_resume), T_NEAR);
+        cold_ptr = getCurr<const u8*>();
+        ASSERT(cold_ptr <= cold_end);
+    }
+    SetCodePtr(hot_resume);
+    writing_cold = false;
+    if (size_t(&top_[maxSize_] - hot_resume) < COLD_CHUNK + COLD_KEEP) {
+        cold_active = false;
+        return;
+    }
+    EnsureMemoryCommitted(COLD_CHUNK + 1024 * 1024);
+    cold_ptr = hot_resume;
+    cold_end = hot_resume + COLD_CHUNK;
+    hot_resume = cold_end;
+    writing_cold = true;
+    const unsigned chunks = cold_chunks_total.fetch_add(1, std::memory_order_relaxed) + 1;
+    if (chunks % 64 == 0)
+        std::printf("EDEN_UP_JIT_COLD_CHUNKS chunks=%u (all caches, since start)\n", chunks);
+}
+
+bool BlockOfCode::EndColdCode() {
+    if (!cold_active)
+        return false;
+    if (writing_cold)
+        cold_ptr = getCurr<const u8*>();
+    ASSERT(cold_ptr <= cold_end);
+    SetCodePtr(hot_resume);
+    cold_active = writing_cold = false;
+    return true;
+}
+
+void BlockOfCode::ResetColdCode() {
+    cold_ptr = cold_end = hot_resume = nullptr;
+    cold_active = writing_cold = false;
+}
+
 }  // namespace Dynarmic::Backend::X64
