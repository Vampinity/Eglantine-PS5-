+        if (image->HasScaled()) {
+            scaled += GetScaledImageSizeBytes(*image);
+        }
+        if (True(image->flags & ImageFlagBits::Unbacked)) {
+            sparse += bytes;
+        } else if (True(image->flags & ImageFlagBits::GpuModified)) {
+            target += bytes;
+        } else if (IsPixelFormatASTC(image->info.format)) {
