+    bool from_front = false;
+#if VIDEO_CORE_CENSUS_FRONT
+    if (eden_vma_usage != nullptr) {
+        eden_vma_usage(&blocks, &used);
+        from_front = true;
+    }
+#endif
+    if (!from_front) {
+        used = device.GetDeviceMemoryUsage();
+        blocks = used + device.GetDeviceMemorySlack();
+    }
+    Census::Set(Census::DecodeInFlight, in_flight);
+    Census::Set(Census::DecodeKept, kept);
+    Census::Set(Census::CopyBuffers, copy);
+    Census::Set(Census::MsaaScratch, msaa_scratch_images.size());
+    Census::Set(Census::StagingDevice, held[0]);
+    Census::Set(Census::StagingUpload, held[1]);
+    Census::Set(Census::StagingDownload, held[2]);
+    Census::Set(Census::StagingIdle, idle[0] + idle[1] + idle[2]);
+    Census::Set(Census::StagingStream, stream);
+    Census::Set(Census::VmaBlocks, blocks);
+    Census::Set(Census::VmaUsed, used);
+}
