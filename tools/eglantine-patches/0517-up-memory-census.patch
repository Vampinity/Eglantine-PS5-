+    const u64 heap = pieces + large;
+    const u64 fragmented = pieces > free_pages + live ? pieces - free_pages - live : 0;
+    const u64 named = guest + reserve + jit + tables + heap + v[VmaBlocks];
+    const long long rest = out != 0 ? static_cast<long long>(out) - static_cast<long long>(named) : 0;
+    const u64 cpu_side = v[AsyncReady] + v[CpuScratch];
+
+    char line[1024];
+    int length = std::snprintf(
+        line, sizeof(line),
+        "EDEN_MEM_CENSUS n=%u why=%s t_s=%.1f largest=%llu low=%llu mark=%llu gpu=%s/%lldms "
+        "images=%llu/%llu sparse=%llu target=%llu astc=%llu other=%llu scaled=%llu stale_clean=%llu "
+        "stale_written=%llu retiring=%llu decode_in_flight=%llu decode_kept=%llu copy_buffers=%llu "
+        "msaa=%llu staging=%llu device=%llu upload=%llu download=%llu idle=%llu stream=%llu "
+        "buffers=%llu async_ready=%llu/%llu cpu_scratch=%llu (MiB)\n",
