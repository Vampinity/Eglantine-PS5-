+// EDEN_UP_MEM_CENSUS=1: only when a census asks (TextureCache::CensusTick), on the GPU thread,
+// which owns the allocator. The decode images are sized as TickFrame sizes them for
+// EDEN_NX2_TRANSCODE_KEEP_MIB (four bytes a texel, every level and layer). A copy buffer of level
+// n is 2^n bytes (GetTemporaryBuffer). The allocator's blocks and use come from the front's
+// EDEN_VMA_USAGE function (all heaps) where there is one, else from the main heap's figures.
+void TextureCacheRuntime::PublishMemoryCensus() {
+    namespace Census = VideoCommon::MemoryCensus;
+    const auto decode_bytes = [](const PendingTranscode& t) {
+        u64 bytes{};
+        for (u32 level = 0; level < t.levels; ++level) {
+            bytes += u64{(std::max)(t.width >> level, 1U)} * (std::max)(t.height >> level, 1U) * 4;
+        }
+        return bytes * t.layers;
+    };
+    u64 in_flight = 0, kept = 0, copy = 0;
+    for (const PendingTranscode& t : pending_transcodes) {
+        in_flight += decode_bytes(t);
+    }
+    for (const PendingTranscode& t : free_transcodes) {
+        kept += decode_bytes(t);
+    }
+    for (size_t level = 0; level < indexing_slots; ++level) {
+        if (buffers[level]) {
+            copy += u64{1} << level;
+        }
+    }
