+        static_cast<unsigned long long>(v[ImageCount]), Mib(v[ImagesSparse]),
+        Mib(v[ImagesTarget]), Mib(v[ImagesAstc]), Mib(v[ImagesOther]), Mib(v[ImagesScaled]),
+        Mib(v[StaleClean]), Mib(v[StaleWritten]), Mib(v[Retiring]), Mib(v[DecodeInFlight]),
+        Mib(v[DecodeKept]), Mib(v[CopyBuffers]), static_cast<unsigned long long>(v[MsaaScratch]),
+        Mib(staging), Mib(v[StagingDevice]), Mib(v[StagingUpload]), Mib(v[StagingDownload]),
+        Mib(v[StagingIdle]), Mib(v[StagingStream]), Mib(v[Buffers]), Mib(v[AsyncReady]),
+        static_cast<unsigned long long>(v[AsyncWaiting]), Mib(v[CpuScratch]));
+    if (length > 0) {
+        std::fputs(line, stderr);
+    }
+    length = std::snprintf(
+        line, sizeof(line),
+        "EDEN_MEM_CENSUS_POOL n=%u out=%llu guest=%llu reserve=%llu jit=%llu tables=%llu heap=%llu "
+        "(pieces=%llu live=%llu free_pages=%llu idle_arenas=%llu fragmented=%llu large=%llu "
+        "in_use=%llu) vma_blocks=%llu vma_used=%llu vma_slack=%llu rest=%lld (MiB)\n",
+        number, Mib(out), Mib(guest), Mib(reserve), Mib(jit), Mib(tables), Mib(heap), Mib(pieces),
+        Mib(live), Mib(free_pages), Mib(idle_arenas), Mib(fragmented), Mib(large), Mib(in_use),
+        Mib(v[VmaBlocks]), Mib(v[VmaUsed]), Mib(vma_slack), rest / (1LL << 20));
+    if (length > 0) {
+        std::fputs(line, stderr);
+    }
+
+    // What could be given back now, each by one change (see the patch notes for which).
+    struct Candidate {
+        const char* name;
+        u64 bytes;
+    };
+    std::array<Candidate, 13> candidates{{
+        {"vma_slack", vma_slack},
+        {"stale_clean", v[StaleClean]},
+        {"stale_written", v[StaleWritten]},
+        {"heap_free_pages", free_pages},
+        {"heap_fragmented", fragmented},
+        {"decode_kept", v[DecodeKept]},
+        {"decode_in_flight", v[DecodeInFlight]},
+        {"staging_idle", v[StagingIdle]},
+        {"copy_buffers", v[CopyBuffers]},
+        {"cpu_scratch", v[CpuScratch]},
+        {"async_ready", v[AsyncReady]},
+        {"retiring", v[Retiring]},
+        {"guest_reserve", reserve},
+    }};
+    std::sort(candidates.begin(), candidates.end(),
+              [](const Candidate& a, const Candidate& b) { return a.bytes > b.bytes; });
+    Owners now;
+    now.bytes = {v[Images], decode, staging, v[Buffers], vma_slack,
+                 guest,     heap,   jit,     rest > 0 ? static_cast<u64>(rest) : 0, cpu_side};
+    const char* grew = "none";
+    long long grew_by = 0;
+    const bool compared = have_previous;
+    if (compared) {
+        for (size_t i = 0; i < Owners::Count; ++i) {
+            const long long delta =
+                static_cast<long long>(now.bytes[i]) - static_cast<long long>(previous.bytes[i]);
+            if (delta > grew_by) {
+                grew_by = delta;
+                grew = Owners::names[i];
+            }
+        }
+    }
+    previous = now;
+    have_previous = have_previous || published != 0; // no GPU answer yet: no baseline
+    const long long short_by = largest != 0 ? static_cast<long long>(ThresholdBytes()) -
+                                                  static_cast<long long>(largest)
+                                            : 0;
+    length = std::snprintf(line, sizeof(line), "EDEN_MEM_CENSUS_TOP n=%u short_by=%lld:", number,
+                           short_by / (1LL << 20));
