+// What a kept buffer holds is measured as the console's port measures it (staging_buffers.h
+// Holds): its mapping's size, or 2^log2_level for a buffer that is not mapped.
+void StagingBufferPool::CensusBytes(u64 (&held)[3], u64 (&idle)[3], u64* stream) const {
+    const StagingBuffersCache* const caches[3] = {&device_local_cache, &upload_cache,
+                                                  &download_cache};
+    for (size_t kind = 0; kind < 3; ++kind) {
+        held[kind] = 0;
+        idle[kind] = 0;
+        for (const StagingBuffers& level : *caches[kind]) {
+            for (const StagingBuffer& entry : level.entries) {
+                const u64 bytes = !entry.mapped_span.empty() ? entry.mapped_span.size()
+                                                             : u64{1} << entry.log2_level;
+                held[kind] += bytes;
+                if (!entry.deferred && scheduler.IsFree(entry.tick)) {
+                    idle[kind] += bytes;
+                }
+            }
+        }
+    }
+    *stream = stream_buffer_size;
+}
