+            std::snprintf(line + length, sizeof(line) - length, "; grew_most=- (first census)\n");
+        }
+        std::fputs(line, stderr);
+    }
+#if VIDEO_CORE_CENSUS_FRONT
+    if (detail) {
+        if (eden_radv_private_radv_ps5_memory_report_now != nullptr) {
+            eden_radv_private_radv_ps5_memory_report_now();
+        }
+        if (eden_guest_memory_report != nullptr) {
+            eden_guest_memory_report();
+        }
+    }
+#else
+    (void)detail;
+#endif
+}
+
+inline void Run() {
+    ::Common::SetCurrentThreadName("MemCensus");
+    State& state = Get();
+    using Clock = std::chrono::steady_clock;
+    const auto start = Clock::now();
+    const u64 mark = ThresholdBytes();
+    std::fprintf(stderr,
+                 "EDEN_MEM_CENSUS on: every 2 s while the largest free block is under %llu MiB, "
+                 "and at each area change%s\n",
+                 Mib(mark), FreeLargest() != 0 ? "" : " (free memory not known here: area changes only)");
+    Owners previous;
+    bool have_previous = false;
+    unsigned number = 0;
+    u32 area_seen = state.area_notes.load(std::memory_order_acquire);
+    bool after_area = false;
+    Clock::time_point after_area_at{};
+    Clock::time_point last_census{};
+    Clock::time_point last_low{};
+    bool any_census = false, any_low = false;
+    u64 low = ~u64{0};
+    for (;;) {
+        {
+            std::unique_lock lock{state.mutex};
+            state.changed.wait_for(lock, std::chrono::milliseconds(250), [&] {
+                return state.area_notes.load(std::memory_order_acquire) != area_seen;
+            });
+        }
+        const auto now = Clock::now();
+        const u64 largest = FreeLargest();
+        if (largest != 0) {
+            low = (std::min)(low, largest);
+        }
+        const char* why = nullptr;
+        bool detail = false;
+        bool area_start = false;
+        if (const u32 area = state.area_notes.load(std::memory_order_acquire); area != area_seen) {
+            area_seen = area;
+            why = "area";
+            area_start = true;
+            after_area = true;
+            after_area_at = now + std::chrono::seconds(3);
+        } else if (after_area && now >= after_area_at) {
+            after_area = false;
+            why = "area+3s";
+            detail = true;
+        } else if (largest != 0 && largest < mark &&
+                   (!any_census || now - last_census >= std::chrono::seconds(2))) {
+            why = "low";
+            // Entering a low stretch (none for 10 s): the detail lines too.
+            detail = !any_low || now - last_low >= std::chrono::seconds(10);
+            any_low = true;
+            last_low = now;
+        }
+        if (why == nullptr) {
+            continue;
+        }
+        any_census = true;
+        last_census = now;
+        if (area_start) {
+            std::fprintf(stderr, "EDEN_MEM_CENSUS_AREA n=%u frame=%llu new_images=%llu\n", number,
+                         static_cast<unsigned long long>(state.area_frame.load(std::memory_order_relaxed)),
+                         static_cast<unsigned long long>(state.area_images.load(std::memory_order_relaxed)));
+        }
+        const double seconds = std::chrono::duration<double>(now - start).count();
+        Write(number, why, largest, low != ~u64{0} ? low : 0, seconds, detail, previous,
+              have_previous);
+        ++number;
+        low = ~u64{0};
+    }
+}
+
+/// GPU thread, end of frame: starts the census thread once. Never joined: the process ends with
+/// _exit on the console, and the thread only sleeps and reads counters.
+inline void Start() {
+    State& state = Get();
+    if (state.started.load(std::memory_order_relaxed)) {
+        return;
+    }
+    state.started.store(true, std::memory_order_relaxed);
+    try {
+        std::thread(Run).detach();
+    } catch (...) {
+        std::fputs("EDEN_MEM_CENSUS could not start its thread: no census\n", stderr);
+    }
+}
