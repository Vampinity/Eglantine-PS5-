+    census_created_seen = area_images_created;
+    if (frame_tick - census_window_frame >= WindowFrames) {
+        census_window_frame = frame_tick;
+        census_window_created = 0;
+    }
+    census_window_created += created;
+    if (census_window_created >= burst) {
+        if (frame_tick >= census_quiet_until) {
+            MemoryCensus::NoteArea(frame_tick, census_window_created);
+        }
+        census_quiet_until = frame_tick + QuietFrames;
+        census_window_frame = frame_tick;
+        census_window_created = 0;
+    }
+    const u32 request = MemoryCensus::ImagesWanted();
+    if (request == 0) {
+        return;
+    }
+    u64 images = 0, count = 0, sparse = 0, target = 0, astc = 0, other = 0, scaled = 0;
+    for (const auto [image_id, image] : slot_images) {
+        const u64 bytes = ImageMemoryBytes(*image);
+        images += bytes;
