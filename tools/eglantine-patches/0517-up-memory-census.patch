diff --git a/src/video_core/memory_census.h b/src/video_core/memory_census.h
new file mode 100644
index 0000000..a6e903e
--- /dev/null
+++ b/src/video_core/memory_census.h
@@ -0,0 +1,493 @@
+// SPDX-FileCopyrightText: Copyright 2026 Eden Emulator Project
+// SPDX-License-Identifier: GPL-3.0-or-later
+
+#pragma once
+
+#include <algorithm>
+#include <array>
+#include <atomic>
+#include <chrono>
+#include <condition_variable>
+#include <cstddef>
+#include <cstdio>
+#include <cstdlib>
+#include <mutex>
+#include <thread>
+
+#include "common/common_types.h"
+#include "common/pe_switch.h"
+#include "common/thread.h"
+
+/// EDEN_UP_MEM_CENSUS=1 (off unless set): who holds the memory when it runs out at an area change.
+///
+/// A thread of its own ("MemCensus") looks at the pool's largest free block every 250 ms. While it
+/// is under EDEN_UP_MEM_CENSUS_MIB (unset: 768) it writes a census every 2 s, and it writes one when
+/// an area load begins and one 3 s later. A census is three lines in stderr:
+///
+///   EDEN_MEM_CENSUS       the graphics caches, a split of what the allocator's blocks hold in use:
+///                         images by kind, ASTC decode images, staging, buffers, the CPU scratch
+///   EDEN_MEM_CENSUS_POOL  everything taken out of the pool by owner: guest memory, its reserve,
+///                         JIT, tables, heap (pieces live / whole free pages / fragmented, large
+///                         blocks), the allocator's blocks, and the rest (the driver's own buffers,
+///                         packed guest slots, anything nobody counts)
+///   EDEN_MEM_CENSUS_TOP   what could be given back now, largest first, and the owner that grew most
+///                         since the last census. Its first entry is the single change that frees
+///                         the most.
+///
+/// The first census under the mark and the one 3 s after an area change also write the existing
+/// detail lines: RADV_PS5_MEMORY (with RADV_PS5_MEMORY_REPORT=1) and EDEN_CRAM / EDEN_SWAP /
+/// EDEN_SWAP_PACK (the guest memory service's own report).
+///
+/// Every number is a counter something already keeps, read at census time. The GPU thread walks
+/// the images only when a census asks for them (TextureCache::CensusTick), at most every 2 s and
+/// twice per area change; between censuses it reads two atomics a frame. Without the switch none of
+/// this runs: one cached flag is checked at the end of each frame.
+///
+/// The front's numbers (pool, heap, guest memory, JIT, the allocator's blocks) come from the PS5
+/// front's functions, declared weak: where there are none, those fields read 0 and only the
+/// graphics caches and area changes are counted.
+
+// ELF only (the console is FreeBSD): a weak reference nobody defines reads as null there.
+#if (defined(__GNUC__) || defined(__clang__)) && (defined(__FreeBSD__) || defined(__linux__))
+#define VIDEO_CORE_CENSUS_FRONT 1
+// headless/performance.cpp: the pool's largest free block (0: not known).
+extern "C" unsigned long long eden_free_memory_bytes(void) __attribute__((weak));
+// src/direct_memory.c: what is out of the pool, by block size (EDEN_POOL_LEDGER).
+extern "C" void eden_direct_ledger(unsigned long long* bytes, unsigned long long* blocks,
+                                   unsigned long long* hits, unsigned long long* fallbacks)
+    __attribute__((weak));
+// headless/heap_arenas.inc (EDEN_HEAP_PAGES, [EglantinePS5] heap).
+extern "C" std::size_t eden_heap_committed(void) __attribute__((weak));
+extern "C" std::size_t eden_heap_large_held(unsigned* blocks) __attribute__((weak));
+extern "C" void eden_heap_usage(std::size_t* held, std::size_t* in_use, std::size_t* returned)
+    __attribute__((weak));
+extern "C" void eden_heap_page_usage(std::size_t* free_pages, std::size_t* idle_arenas,
+                                     std::size_t* live) __attribute__((weak));
+// src/guest_memory_service.inc: the guest's reserve, and its full report (EDEN_CRAM, EDEN_SWAP).
+extern "C" void eden_guest_memory_reserve(std::size_t* held, std::size_t* target)
+    __attribute__((weak));
+extern "C" void eden_guest_memory_report(void) __attribute__((weak));
+// vulkan_memory_allocator.cpp as the port adapts it (EDEN_VMA_USAGE): blocks and use, all heaps.
+extern "C" void eden_vma_usage(unsigned long long* blocks, unsigned long long* used)
+    __attribute__((weak));
+// The console's RADV (tools/patch-radv-memory-report.py, as isolate-radv.py names it).
+extern "C" void eden_radv_private_radv_ps5_memory_report_now(void) __attribute__((weak));
+namespace Common {
+// src/memory_pages.cpp: guest memory, sparse tables and the JIT's code ranges (EDEN_POOL_LEDGER).
+void GuestMemoryUsage(std::size_t* span, std::size_t* held) noexcept __attribute__((weak));
+void SparseUsage(std::size_t* reserved, std::size_t* committed) noexcept __attribute__((weak));
+void CodeRangeUsage(std::size_t* reserved, std::size_t* committed) noexcept __attribute__((weak));
+} // namespace Common
+#else
+#define VIDEO_CORE_CENSUS_FRONT 0
+#endif
+
+namespace VideoCommon::MemoryCensus {
+
+[[nodiscard]] inline bool Enabled() {
+    static const bool enabled = ::Common::PeSwitch("EDEN_UP_MEM_CENSUS");
+    return enabled;
+}
+
+/// An image unused for this many frames counts as stale (AreaEvict's window is 120 frames too).
+inline constexpr u64 StaleFrames = 120;
+
+enum Value : size_t {
+    // TextureCache::CensusTick
+    Images,       ///< ImageMemoryBytes of every image (the collector's own measure)
+    ImageCount,
+    ImagesSparse, ///< Unbacked: what BindLayers/BindTiles gave them
+    ImagesTarget, ///< GpuModified: render targets and other images the GPU wrote
+    ImagesAstc,   ///< ASTC textures, as stored on the host (transcoded)
+    ImagesOther,
+    ImagesScaled, ///< The scaled copies (on top of Images)
+    StaleClean,   ///< Unused for StaleFrames, nothing to copy back: deletable now
+    StaleWritten, ///< Unused for StaleFrames, GPU-written: deletable after a copy back
+    Retiring,     ///< Deleted, memory not yet free (waiting for the GPU or TICKS_TO_DESTROY)
+    AsyncReady,   ///< CPU-decoded results waiting for their upload (heap)
+    AsyncWaiting, ///< Decodes not finished (a count)
+    CpuScratch,   ///< The upload swizzle/unswizzle scratch buffers (heap)
+    // TextureCacheRuntime::PublishMemoryCensus (Vulkan)
+    DecodeInFlight, ///< ASTC decode images (RGBA8, every level) the GPU may still use
+    DecodeKept,     ///< Finished decode images kept for the next texture of their shape
+    CopyBuffers,    ///< Image copy buffers (GetTemporaryBuffer)
+    MsaaScratch,    ///< MSAA scratch images (a count)
+    StagingDevice,
+    StagingUpload,
+    StagingDownload,
+    StagingIdle, ///< Of the three, kept buffers the GPU is done with and nothing pins
+    StagingStream,
+    VmaBlocks,
+    VmaUsed,
+    // BufferCache::TickFrame
+    Buffers,
+    Count,
+};
+
+struct State {
+    std::array<std::atomic<u64>, Count> values{};
+    std::atomic<u32> wanted{0};       ///< The census asking for the GPU thread's numbers
+    std::atomic<u32> images_done{0};  ///< The last request the texture cache answered
+    std::atomic<u32> buffers_done{0}; ///< The last request the buffer cache answered
+    std::atomic<long long> published_ns{0};
+    std::atomic<u32> area_notes{0};
+    std::atomic<u64> area_frame{0};
+    std::atomic<u64> area_images{0};
+    std::atomic<bool> started{false};
+    std::mutex mutex;
+    std::condition_variable changed;
+};
+
+[[nodiscard]] inline State& Get() {
+    static State* const state = new State; // outlives every static destructor
+    return *state;
+}
+
+[[nodiscard]] inline long long NowNs() {
+    return std::chrono::duration_cast<std::chrono::nanoseconds>(
+               std::chrono::steady_clock::now().time_since_epoch())
+        .count();
+}
+
+inline void Set(Value value, u64 amount) {
+    Get().values[value].store(amount, std::memory_order_relaxed);
+}
+
+/// GPU thread, end of frame: the request to answer, or 0. Two atomic loads.
+[[nodiscard]] inline u32 ImagesWanted() {
+    State& state = Get();
+    const u32 wanted = state.wanted.load(std::memory_order_acquire);
+    return wanted != state.images_done.load(std::memory_order_relaxed) ? wanted : 0;
+}
+[[nodiscard]] inline u32 BuffersWanted() {
+    State& state = Get();
+    const u32 wanted = state.wanted.load(std::memory_order_acquire);
+    return wanted != state.buffers_done.load(std::memory_order_relaxed) ? wanted : 0;
+}
+inline void ImagesPublished(u32 request) {
+    State& state = Get();
+    state.published_ns.store(NowNs(), std::memory_order_relaxed);
+    state.images_done.store(request, std::memory_order_release);
+}
+inline void BuffersPublished(u32 request) {
+    Get().buffers_done.store(request, std::memory_order_release);
+}
+
+/// GPU thread: an area load began (a burst of new images). No lock on this side: the census
+/// thread wakes within 250 ms if it misses the notification.
+inline void NoteArea(u64 frame, u64 images) {
+    State& state = Get();
+    state.area_frame.store(frame, std::memory_order_relaxed);
+    state.area_images.store(images, std::memory_order_relaxed);
+    state.area_notes.fetch_add(1, std::memory_order_release);
+    state.changed.notify_one();
+}
+
+[[nodiscard]] inline u64 ThresholdBytes() {
+    static const u64 bytes = [] {
+        const char* const value = std::getenv("EDEN_UP_MEM_CENSUS_MIB");
+        const u64 mib = value != nullptr ? std::strtoull(value, nullptr, 10) : 0ULL;
+        return (mib != 0 && mib < (u64{1} << 20) ? mib : u64{768}) << 20;
+    }();
+    return bytes;
+}
+
+[[nodiscard]] inline u64 FreeLargest() {
+#if VIDEO_CORE_CENSUS_FRONT
+    if (eden_free_memory_bytes != nullptr) {
+        return eden_free_memory_bytes();
+    }
+#endif
+    return 0;
+}
+
+inline constexpr unsigned long long Mib(u64 bytes) {
+    return static_cast<unsigned long long>(bytes >> 20);
+}
+
+/// The census thread's own snapshot of the owners, for "grew_most".
+struct Owners {
+    static constexpr size_t Count = 10;
+    std::array<u64, Count> bytes{};
+    static constexpr std::array<const char*, Count> names{
+        "images", "decode", "staging", "buffers", "vma_slack",
+        "guest",  "heap",   "jit",     "rest",    "cpu_side"};
+};
+
+/// One census. `detail`: also the existing RADV and guest memory report lines.
+inline void Write(unsigned number, const char* why, u64 largest, u64 low, double seconds,
+                  bool detail, Owners& previous, bool& have_previous) {
+    State& state = Get();
+    // The GPU thread's numbers: asked for, answered at its next frame end. A frame can take a
+    // second at a door; after 300 ms the last answer is used and its age printed.
+    const u32 request = state.wanted.fetch_add(1, std::memory_order_acq_rel) + 1;
+    bool fresh = false;
+    for (int waited = 0; waited < 75; ++waited) {
+        if (state.images_done.load(std::memory_order_acquire) == request &&
+            state.buffers_done.load(std::memory_order_acquire) == request) {
+            fresh = true;
+            break;
+        }
+        std::this_thread::sleep_for(std::chrono::milliseconds(4));
+    }
+    const long long published = state.published_ns.load(std::memory_order_relaxed);
+    const long long gpu_age_ms = published != 0 ? (NowNs() - published) / 1000000 : -1;
+    std::array<u64, Count> v{};
+    for (size_t i = 0; i < Count; ++i) {
+        v[i] = state.values[i].load(std::memory_order_relaxed);
+    }
+    const u64 staging = v[StagingDevice] + v[StagingUpload] + v[StagingDownload];
+    const u64 decode = v[DecodeInFlight] + v[DecodeKept];
+    const u64 vma_slack = v[VmaBlocks] > v[VmaUsed] ? v[VmaBlocks] - v[VmaUsed] : 0;
+
+    // The front: every owner of the pool, as EDEN_POOL_LEDGER and the heap lines count them.
+    u64 out = 0, guest = 0, reserve = 0, jit = 0, tables = 0;
+    u64 pieces = 0, large = 0, in_use = 0, free_pages = 0, idle_arenas = 0, live = 0;
+#if VIDEO_CORE_CENSUS_FRONT
+    if (eden_direct_ledger != nullptr) {
+        unsigned long long bytes[4]{}, blocks[4]{}, hits = 0, fallbacks = 0;
+        eden_direct_ledger(bytes, blocks, &hits, &fallbacks);
+        out = bytes[0] + bytes[1] + bytes[2] + bytes[3];
+    }
+    std::size_t span = 0, held = 0;
+    if (::Common::GuestMemoryUsage != nullptr) {
+        ::Common::GuestMemoryUsage(&span, &held);
+        guest = held;
+    }
+    if (::Common::CodeRangeUsage != nullptr) {
+        ::Common::CodeRangeUsage(&span, &held);
+        jit = held;
+    }
+    if (::Common::SparseUsage != nullptr) {
+        ::Common::SparseUsage(&span, &held);
+        tables = held;
+    }
+    if (eden_guest_memory_reserve != nullptr) {
+        std::size_t target = 0;
+        eden_guest_memory_reserve(&held, &target);
+        reserve = held;
+    }
+    if (eden_heap_committed != nullptr) {
+        pieces = eden_heap_committed();
+    }
+    if (eden_heap_large_held != nullptr) {
+        unsigned large_blocks = 0;
+        large = eden_heap_large_held(&large_blocks);
+    }
+    if (eden_heap_usage != nullptr) {
+        std::size_t heap_held = 0, heap_in_use = 0, returned = 0;
+        eden_heap_usage(&heap_held, &heap_in_use, &returned);
+        in_use = heap_in_use;
+    }
+    if (eden_heap_page_usage != nullptr) {
+        std::size_t page_free = 0, page_idle = 0, page_live = 0;
+        eden_heap_page_usage(&page_free, &page_idle, &page_live);
+        free_pages = page_free;
+        idle_arenas = page_idle;
+        live = page_live;
+    }
