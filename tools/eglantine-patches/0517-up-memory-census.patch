+                                  static_cast<size_t>(length) < sizeof(line) - 96;
+         ++i) {
+        if (candidates[i].bytes < (u64{1} << 20)) {
+            break;
+        }
+        ++shown;
+        length += std::snprintf(line + length, sizeof(line) - length, " %zu %s=%llu", shown,
+                                candidates[i].name, Mib(candidates[i].bytes));
+    }
+    if (length > 0 && static_cast<size_t>(length) < sizeof(line) - 96) {
+        if (compared) {
+            std::snprintf(line + length, sizeof(line) - length,
