From 9efe16f93acba69bf8bac29ad2dd09a7cf245a4f Mon Sep 17 00:00:00 2001
From: EglantinePS5 <noreply@eglantineps5.local>
Date: Sun, 8 Nov 2026 05:00:46 +0100
Subject: [PATCH] pe: vma-own-budget

---
 src/video_core/vulkan_common/vulkan_device.cpp | 4 +++-
 1 file changed, 3 insertions(+), 1 deletion(-)

diff --git a/src/video_core/vulkan_common/vulkan_device.cpp b/src/video_core/vulkan_common/vulkan_device.cpp
index d69140d..54cdf8b 100644
--- a/src/video_core/vulkan_common/vulkan_device.cpp
+++ b/src/video_core/vulkan_common/vulkan_device.cpp
@@ -4,6 +4,7 @@
 // SPDX-FileCopyrightText: Copyright 2018 yuzu Emulator Project
 // SPDX-License-Identifier: GPL-2.0-or-later
 
+#include "common/pe_switch.h"
 #include <algorithm>
 #include <array>
 #include <bitset>
@@ -785,7 +786,8 @@ Device::Device(VkInstance instance_, vk::PhysicalDevice physical_, VkSurfaceKHR
     functions.vkGetDeviceProcAddr = dld.vkGetDeviceProcAddr;
 
     VmaAllocatorCreateFlags flags = VMA_ALLOCATOR_CREATE_EXTERNALLY_SYNCHRONIZED_BIT;
-    if (extensions.memory_budget) {
+    static const bool own_budget = Common::PeSwitch("EDEN_PE_VMA_OWN_BUDGET");
+    if (extensions.memory_budget && !own_budget) {
         flags |= VMA_ALLOCATOR_CREATE_EXT_MEMORY_BUDGET_BIT;
     }
     if (extensions.buffer_device_address) {
