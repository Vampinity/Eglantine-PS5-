+void PipelineCache::WarnKeptPointer(size_t program, u64 slot) const {
+    if ((slot >> 63) != 0) {
+        return; // pointer-table entry: kept, not logged
+    }
+    const u32 index = static_cast<u32>(slot >> 32);
+    const u32 offset = static_cast<u32>(slot);
+    const size_t stage = program == 0 ? 0 : program - 1;
+    if (stage >= maxwell3d->state.shader_stages.size()) {
+        return;
+    }
+    const auto& cbufs = maxwell3d->state.shader_stages[stage].const_buffers;
+    GPUVAddr value = 0;
+    const char* reason = nullptr;
+    if (index >= cbufs.size() || !cbufs[index].enabled ||
+        u64{offset} + sizeof(u64) > cbufs[index].size ||
+        !gpu_memory->IsFullyMappedRange(cbufs[index].address + offset, sizeof(u64))) {
+        reason = "constant buffer not bound";
+    } else {
+        value = gpu_memory->Read<u64>(cbufs[index].address + offset);
+        if (value == 0) {
+            reason = "null";
+        } else if (!gpu_memory->IsWithinGPUAddressRange(value)) {
+            reason = "outside the GPU address range";
+        } else if (!gpu_memory->IsFullyMappedRange(value, 1)) {
+            reason = "unmapped";
+        }
+    }
+    if (reason == nullptr) {
+        return;
+    }
+    static std::atomic<u64> kept{};
+    const u64 count = kept.fetch_add(1, std::memory_order_relaxed) + 1;
+    if (count <= 32 || count % 1000 == 0) {
+        LOG_WARNING(Render_Vulkan,
+                    "Graphics pipeline {:016x} translated again after eviction: s{}:c{}[{:#x}] "
+                    "holds {:#x} ({}), kept as the storage buffer pointer it was ({} so far)",
+                    graphics_key.Hash(), program, index, offset, value, reason, count);
+    }
+}
+
 std::unique_ptr<GraphicsPipeline> PipelineCache::CreateGraphicsPipeline() {
     Common::HangSite site{"building a graphics pipeline"};
     const auto begin = std::chrono::steady_clock::now();
@@ -2828,6 +2908,26 @@ std::unique_ptr<GraphicsPipeline> PipelineCache::CreateGraphicsPipeline() {
     };
     GraphicsEnvironments environments;
     GetGraphicsEnvironments(environments, graphics_key.unique_hashes);
+    if (EvictKeepSsbo()) {
+        // An evicted pipeline of this key: the slots it bound stay pointers whatever they hold
+        // now. Before the kept-translation check too, which asks these slots of the same envs.
+        if (const auto keep = evicted_pointer_slots.Take(key_hash)) {
+            try {
+                for (size_t index = 0; index < Maxwell::MaxShaderProgram; ++index) {
+                    if (graphics_key.unique_hashes[index] == 0) {
+                        continue;
+                    }
+                    environments.envs[index].SeedStoragePointers((*keep)[index]);
+                    for (const u64 slot : (*keep)[index]) {
+                        WarnKeptPointer(index, slot);
+                    }
+                }
+            } catch (const std::bad_alloc&) {
+                // Seeded in part: still no fewer pointers than without the switch.
+                SurviveBadAlloc("an evicted graphics pipeline's storage buffer pointers");
+            }
+        }
+    }
 
     // EDEN_UP_SHADER_PREP: a pipeline whose translation was kept is made from that, without
     // translating on this thread (null: translated as before). What follows is the same for
@@ -2860,6 +2960,20 @@ std::unique_ptr<GraphicsPipeline> PipelineCache::CreateGraphicsPipeline() {
     auto pipeline{kept ? std::move(kept)
                        : CreateGraphicsPipeline(main_pools, graphics_key, environments.Span(),
                                                 nullptr, true)};
+    if (pipeline && EvictKeepSsbo()) {
+        // Out of memory: the pipeline is kept without its slots, as with the switch off.
+        try {
+            VideoCommon::EvictedPointerSlots::Slots slots;
+            for (size_t index = 0; index < Maxwell::MaxShaderProgram; ++index) {
+                if (graphics_key.unique_hashes[index] != 0) {
+                    slots[index] = environments.envs[index].MappedStoragePointerKeys();
+                }
+            }
+            pipeline->SetMappedPointers(std::move(slots));
+        } catch (const std::bad_alloc&) {
+            SurviveBadAlloc("a graphics pipeline's storage buffer pointer slots");
+        }
+    }
     if (!pipeline || pipeline_cache_filename.empty()) {
         return pipeline;
     }
