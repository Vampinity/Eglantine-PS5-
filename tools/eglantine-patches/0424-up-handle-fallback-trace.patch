Subject: [PATCH] bindless handle fallback trace, EDEN_UP_HANDLE_FALLBACK_TRACE (off by default, diagnostic): logs what the per-draw handle program stopped at, the constant buffer word used instead and the handle's IR chain (zortos293/Lichii 1d2293c968, texture_pass part only)

diff --git a/src/shader_recompiler/ir_opt/texture_pass.cpp b/src/shader_recompiler/ir_opt/texture_pass.cpp
index 5aaafb7..c8101f8 100644
--- a/src/shader_recompiler/ir_opt/texture_pass.cpp
+++ b/src/shader_recompiler/ir_opt/texture_pass.cpp
@@ -5,6 +5,7 @@
 // SPDX-License-Identifier: GPL-2.0-or-later
 
 #include <algorithm>
+#include <string>
 #include <queue>
 #include <unordered_map>
 #include <unordered_set>
@@ -16,6 +17,8 @@
 #include <limits>
 #include <boost/container/small_vector.hpp>
 
+#include "common/logging.h"
+#include "common/pe_switch.h"
 #include "common/scope_exit.h"
 #include "common/settings.h"
 #include "shader_recompiler/environment.h"
@@ -942,6 +945,51 @@ TextureInst MakeInst(Environment& env, IR::Block* block, IR::Inst& inst, const H
                     throw NotImplementedException("Failed to track bindless texture constant buffer (stopped at {}, budget {})",
                                                   g_handle_failure, budget);
                 }
+                // EDEN_UP_HANDLE_FALLBACK_TRACE=1 (zortos293/Lichii 1d2293c968, a diagnostic): what
+                // the per-draw handle program stopped at, the constant buffer word the fallback
+                // uses instead, and the IR the handle comes from. Logged at translation only.
+                static const bool trace_fallback = Common::PeSwitch("EDEN_UP_HANDLE_FALLBACK_TRACE");
+                if (trace_fallback) {
+                    std::string chain;
+                    std::vector<const IR::Inst*> queue;
+                    std::unordered_set<const IR::Inst*> seen;
+                    if (!inst.Arg(0).IsImmediate()) {
+                        queue.push_back(inst.Arg(0).InstRecursive());
+                    }
+                    for (size_t i = 0; i < queue.size() && i < 48; ++i) {
+                        const IR::Inst* const node = queue[i];
+                        chain += fmt::format(" [{:p}]{}(", static_cast<const void*>(node), node->GetOpcode());
+                        for (size_t arg = 0; arg < node->NumArgs(); ++arg) {
+                            const IR::Value value = node->Arg(arg);
+                            if (value.IsImmediate()) {
+                                const IR::Type type = value.Type();
+                                if (type == IR::Type::U32) {
+                                    chain += fmt::format("{}{:#x}", arg ? "," : "", value.U32());
+                                } else if (type == IR::Type::F32) {
+                                    chain += fmt::format("{}{:#x}", arg ? "," : "",
+                                                         std::bit_cast<u32>(value.F32()));
+                                } else if (type == IR::Type::U1) {
+                                    chain += fmt::format("{}{}", arg ? "," : "", value.U1());
+                                } else {
+                                    chain += fmt::format("{}{}", arg ? "," : "", IR::NameOf(type));
+                                }
+                            } else {
+                                const IR::Inst* const def = value.InstRecursive();
+                                chain += fmt::format("{}{:p}", arg ? "," : "", static_cast<const void*>(def));
+                                if (seen.insert(def).second) {
+                                    queue.push_back(def);
+                                }
+                            }
+                        }
+                        chain += ")";
+                    }
+                    LOG_WARNING(Shader,
+                                "Bindless handle fallback: program stopped at {} (budget {}); using "
+                                "c{}[{:#x}] shift {} secondary {} c{}[{:#x}]; chain:{}",
+                                g_handle_failure, budget, legacy->index, legacy->offset,
+                                legacy->shift_left, legacy->has_secondary, legacy->secondary_index,
+                                legacy->secondary_offset, chain);
+                }
                 return TextureInst{.cbuf = *legacy, .inst = &inst, .block = block};
             }
             auto& programs{*g_handle_programs};
