+    BuiltinPatchRecord{0xF5C70, OOT_ZSTD_STREAM_CAVE, OOT_ZSTD_STREAM_CAVE_ORIGINAL},
+};
+
 // EDEN_UP_OOT_FAST_LOOKUP=1: the string-keyed sorted-index lookup at main+0x58EEA0 binary-searches
 // with an inlined strcmp (8-way unrolled, two branches per byte). Both hot copies (lower bound
 // main+0x58FC64, upper bound main+0x591E24) are rewritten in place as an 8-bytes-per-iteration
@@ -272,6 +295,9 @@ constexpr std::array BUILTIN_GROUP_PATCHES{
     BuiltinGroupPatch{"Native zstd (built-in)", 0x0400486024DEC000, "main",
                       "E0F3CCFAF50065AE4EA01EB5AEB13B1A45DA3348", OOT_NATIVE_ZSTD_RECORDS,
                       NativeZstdEnabled},
+    BuiltinGroupPatch{"Native zstd stream (built-in)", 0x0400486024DEC000, "main",
