+/// Whether a texture descriptor's handle word overlaps the storage-buffer pointer word of the
+/// same program. A per-pixel light lookup cannot be evaluated at draw time; treating the pointer's
+/// low bits as a TIC selects unrelated textures and made Ocarina's water flicker when its light
+/// buffer was double-buffered. Bind the null texture instead.
+template <typename Descriptor>
+[[nodiscard]] bool HandleIsStoragePointer(const Shader::Info& info, const Descriptor& desc,
+                                          u32 index) {
+    if (desc.handle_program != ~0U || desc.has_secondary) {
+        return false;
+    }
+    const u32 offset = desc.cbuf_offset + (index << desc.size_shift);
+    for (const auto& storage : info.storage_buffers_descriptors) {
+        if (storage.cbuf_index == desc.cbuf_index && offset >= storage.cbuf_offset &&
+            offset - storage.cbuf_offset < sizeof(u64)) {
+            return true;
+        }
+    }
+    return false;
+}
+
+/// A texture handle with no valid table entry; the texture cache binds its null view and sampler.
+inline constexpr std::pair<u32, u32> NULL_TEXTURE_HANDLE{~0U, ~0U};
+
 } // namespace VideoCommon
