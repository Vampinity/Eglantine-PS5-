+/// EDEN_UP_HITCH_TRACE: an image's geometry and format for its trace line.
+[[nodiscard]] inline HitchTrace::Desc HitchTraceDesc(const ImageInfo& info, GPUVAddr gpu_addr) {
+    return HitchTrace::Desc{
