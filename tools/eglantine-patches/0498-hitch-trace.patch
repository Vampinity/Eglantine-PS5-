diff --git a/src/video_core/hitch_trace.h b/src/video_core/hitch_trace.h
new file mode 100644
index 0000000..7cce680
--- /dev/null
+++ b/src/video_core/hitch_trace.h
@@ -0,0 +1,261 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+
+#pragma once
+
+#include <algorithm>
+#include <array>
+#include <chrono>
+#include <optional>
+#include <string>
+
+#include <fmt/format.h>
+
+#include "common/common_types.h"
+#include "common/logging.h"
+#include "common/pe_switch.h"
+#include "video_core/nx2_profile.h"
+
+// EDEN_UP_HITCH_TRACE=1: what the GPU thread spends a long frame on. Unset: every Op is a bool
+// check and nothing else.
+//
+// Ocarina of Time, the village after Link's door (batch t87-a, 10 Nov): a frame of ~1.0 s on the
+// GPU thread in every run, with no log line inside it. The texture cache's 5 s and 600-present
+// lines give totals, not frames, and the pieces that could take a second (a 128 MiB buffer
+// upload through a staging buffer made for it, 619 images uploaded in 23 frames, the 1365x1365x90
+// arrays queued for decode, a collector pass with a Finish per downloaded image) log nothing of
+// their own time. Each one is an Op here:
+//
+//   Hitch trace: <kind>: <what> took 412.3 ms
+//       one operation of 20 ms or more (a staging buffer made: 5 ms or more), with its size.
+//   Hitch trace: frame 3082 took 1004.2 ms on the GPU thread; traced 980.1 ms: buffer uploads
+//       520.0 ms (3, 192.0 MiB, worst 412.3 ms: 128.0 MiB at 0x7fc... in 1 copies) | image
+//       uploads 301.2 ms (142, 388.5 MiB, worst 61.0 ms: 1365x1365x90 ...) | ...
+//       a frame (TextureCache::TickFrame to the next) of 100 ms or more, every kind with a count,
+//       longest first. The rest of the frame is "traced" subtracted from the frame: the draws,
+//       command parsing and whatever has no Op.
+//
+// A Finish wait inside a collector pass counts under both kinds (the collector line says what
+// its Finish waits cost). With EDEN_NX2_GPU_PROFILE=1 and EDEN_NX2_SLOW_FRAME_MS=100 the same
+// operations also show as zones of the profile's "Slow frame" line, next to draw, update
+// buffers and the rest.
+namespace VideoCommon::HitchTrace {
+
+enum class Kind : u32 {
+    ImageUpload,   ///< TextureCache::RefreshContents (any upload of an image's guest data)
+    ImageMade,     ///< TextureCache::InsertImage: the host image made (vkCreateImage + memory)
+    DecodeQueue,   ///< TextureCache::QueueAsyncDecode: unswizzle + zero fill on the GPU thread
+    DecodeLanding, ///< TextureCache::TickAsyncDecode: decoded data copied and uploaded
+    Collector,     ///< TextureCache::RunGarbageCollector, one pass
+    BufferUpload,  ///< BufferCache::MappedUploadMemory: guest memory read into staging + copy
+    BufferMade,    ///< BufferCache::JoinBuffer: the host buffer made
+    StagingMade,   ///< StagingBufferPool::CreateStagingBuffer: a new staging buffer made and mapped
+    Finish,        ///< Scheduler::Finish: submit and wait for the device
+    Count,
+};
+
+inline constexpr std::array<const char*, static_cast<size_t>(Kind::Count)> names{
+    "image upload",    "image made",   "decode queued", "decode landing", "collector pass",
+    "buffer upload",   "buffer made",  "staging buffer made", "Finish wait",
+};
+inline constexpr std::array<const char*, static_cast<size_t>(Kind::Count)> plural_names{
+    "image uploads",   "images made",  "decodes queued", "decode landings", "collector passes",
+    "buffer uploads",  "buffers made", "staging buffers made", "Finish waits",
+};
+
+/// One operation of this many ns or more gets its own line.
+inline constexpr std::array<u64, static_cast<size_t>(Kind::Count)> op_log_ns{
+    20'000'000, 20'000'000, 20'000'000, 20'000'000, 20'000'000,
+    20'000'000, 20'000'000, 5'000'000,  20'000'000,
+};
+/// A frame of this many ns or more logs its kinds.
+inline constexpr u64 frame_log_ns = 100'000'000;
+
+inline bool On() {
+    static const bool on = Common::PeSwitch("EDEN_UP_HITCH_TRACE");
+    return on;
+}
+
+/// What an operation was, formatted only when it is logged.
+struct Desc {
+    u64 addr{}; ///< Guest address, 0: none
+    u64 a{};    ///< Images: width. Buffer upload: copies. Staging: usage.
+    u64 b{};    ///< Images: height
+    u64 c{};    ///< Images: layers
+    u64 d{};    ///< Images: levels
+    u64 e{};    ///< Images: format
+};
+
+inline std::string Describe(Kind kind, u64 bytes, const Desc& desc) {
+    std::string text;
+    switch (kind) {
+    case Kind::ImageUpload:
+    case Kind::ImageMade:
+    case Kind::DecodeQueue:
+        text = fmt::format("{}x{}x{} ({} levels, format {})", desc.a, desc.b, desc.c, desc.d, desc.e);
+        break;
+    case Kind::BufferUpload:
+        text = fmt::format("in {} copies", desc.a);
+        break;
+    case Kind::StagingMade:
+        text = fmt::format("usage {}", desc.a);
+        break;
+    default:
+        break;
+    }
+    if (bytes != 0) {
+        text = fmt::format("{:.1f} MiB{}{}", static_cast<double>(bytes) / (1024.0 * 1024.0),
+                           text.empty() ? "" : " ", text);
+    }
+    if (desc.addr != 0) {
+        text += fmt::format("{}at {:#x}", text.empty() ? "" : " ", desc.addr);
+    }
+    return text;
+}
+
+struct KindData {
+    u64 ns{};
+    u64 count{};
+    u64 bytes{};
+    u64 worst_ns{};
+    u64 worst_bytes{};
+    Desc worst{};
+};
+
+struct FrameData {
+    std::array<KindData, static_cast<size_t>(Kind::Count)> kinds{};
+    std::chrono::steady_clock::time_point start{};
+    bool started{};
+};
+
+inline thread_local FrameData t_frame;
+
+/// The profile zone an operation also counts under (EDEN_NX2_GPU_PROFILE); image uploads are
+/// already the "texture upload" zone.
+inline Nx2Profile::Zone ZoneOf(Kind kind) {
+    switch (kind) {
+    case Kind::ImageMade:
+        return Nx2Profile::Zone::ImageMade;
+    case Kind::DecodeQueue:
+    case Kind::DecodeLanding:
+        return Nx2Profile::Zone::DecodeWork;
+    case Kind::Collector:
+        return Nx2Profile::Zone::Collector;
+    case Kind::BufferUpload:
+        return Nx2Profile::Zone::BufferUpload;
+    case Kind::BufferMade:
+        return Nx2Profile::Zone::BufferMade;
+    case Kind::StagingMade:
+        return Nx2Profile::Zone::StagingMade;
+    case Kind::Finish:
+        return Nx2Profile::Zone::FinishWait;
+    default:
+        return Nx2Profile::Zone::TextureUpload;
+    }
+}
+
+/// Times one operation on the calling thread from its making to End() or its destruction.
+class Op {
+public:
+    Op(Kind kind_, u64 bytes_, Desc desc_) : kind{kind_}, bytes{bytes_}, desc{desc_}, on{On()} {
+        if (!on) {
+            return;
+        }
+        if (kind_ != Kind::ImageUpload) {
+            zone.emplace(ZoneOf(kind_));
+        }
+        start = std::chrono::steady_clock::now();
+    }
+
+    ~Op() {
+        End();
+    }
+
+    Op(const Op&) = delete;
+    Op& operator=(const Op&) = delete;
+
+    void End() {
+        if (!on || ended) {
+            return;
+        }
+        ended = true;
+        zone.reset();
+        const auto elapsed = static_cast<u64>(
+            std::chrono::duration_cast<std::chrono::nanoseconds>(std::chrono::steady_clock::now() - start)
+                .count());
+        const auto index = static_cast<size_t>(kind);
+        KindData& data = t_frame.kinds[index];
+        data.ns += elapsed;
+        ++data.count;
+        data.bytes += bytes;
+        if (elapsed > data.worst_ns) {
+            data.worst_ns = elapsed;
+            data.worst_bytes = bytes;
+            data.worst = desc;
+        }
+        if (elapsed >= op_log_ns[index]) {
+            LOG_INFO(HW_GPU, "Hitch trace: {}: {} took {:.1f} ms", names[index],
+                     Describe(kind, bytes, desc), static_cast<double>(elapsed) / 1e6);
+        }
+    }
+
+private:
+    Kind kind;
+    u64 bytes;
+    Desc desc;
+    bool on;
+    bool ended{};
+    std::optional<Nx2Profile::Scope> zone;
+    std::chrono::steady_clock::time_point start{};
+};
+
+/// Called once per frame on the GPU thread (TextureCache::TickFrame): logs the frame that just
+/// ended when it was long, and starts the next.
+inline void EndFrame(u64 frame_number) {
+    if (!On()) {
+        return;
+    }
+    FrameData& frame = t_frame;
+    const auto now = std::chrono::steady_clock::now();
+    if (frame.started) {
+        const auto wall = static_cast<u64>(
+            std::chrono::duration_cast<std::chrono::nanoseconds>(now - frame.start).count());
+        if (wall >= frame_log_ns) {
+            std::array<size_t, static_cast<size_t>(Kind::Count)> order{};
+            u64 traced{};
+            for (size_t i = 0; i < order.size(); ++i) {
+                order[i] = i;
+                // Nested kinds (a Finish inside a collector pass) would count twice: the outer
+                // ones carry the inner ones' time already.
+                if (i != static_cast<size_t>(Kind::Finish) &&
+                    i != static_cast<size_t>(Kind::StagingMade) &&
+                    i != static_cast<size_t>(Kind::DecodeQueue)) {
+                    traced += frame.kinds[i].ns;
+                }
+            }
+            std::sort(order.begin(), order.end(), [&frame](size_t a, size_t b) {
+                return frame.kinds[a].ns > frame.kinds[b].ns;
+            });
+            std::string line;
+            for (const size_t i : order) {
+                const KindData& data = frame.kinds[i];
+                if (data.count == 0) {
+                    continue;
+                }
+                line += fmt::format(" | {} {:.1f} ms ({}, {:.1f} MiB, worst {:.1f} ms: {})",
+                                    plural_names[i], static_cast<double>(data.ns) / 1e6, data.count,
+                                    static_cast<double>(data.bytes) / (1024.0 * 1024.0),
+                                    static_cast<double>(data.worst_ns) / 1e6,
+                                    Describe(static_cast<Kind>(i), data.worst_bytes, data.worst));
+            }
+            LOG_INFO(HW_GPU, "Hitch trace: frame {} took {:.1f} ms on the GPU thread; traced {:.1f} ms{}",
+                     frame_number - 1, static_cast<double>(wall) / 1e6,
+                     static_cast<double>((std::min)(traced, wall)) / 1e6,
+                     line.empty() ? std::string{" (nothing traced)"} : line);
+        }
+    }
+    frame.kinds = {};
+    frame.start = now;
+    frame.started = true;
+}
+
+} // namespace VideoCommon::HitchTrace
