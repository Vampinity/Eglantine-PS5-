--- /dev/null
+++ b/src/video_core/oot_network.h
@@ -0,0 +1,66 @@
+// SPDX-FileCopyrightText: Copyright 2026 Eden Emulator Project
+// SPDX-License-Identifier: GPL-3.0-or-later
+
+#pragma once
+
+#include <atomic>
+#include <cstdlib>
+#include <mutex>
+
+#include "common/common_types.h"
+#include "video_core/engines/maxwell_3d.h"
+
+// EDEN_NX2_OOT_SKIP_AA=1 (port of zortos293/Lichii PR 616, imports #319 by ProphetWild): The Legend
+// of Zelda: Ocarina of Time's anti-aliasing. After tonemapping, the game runs a single-frame tensor
+// network on the tonemapped image and an output pass that sharpens the result hard (the halos).
+// With the switch, the prepass and the network are skipped and the output pass is replaced by a
+// same-size point copy of the tonemapped image. Unset: nothing here runs.
+//
+// Shader hashes, native program keys and the constant buffer offset are those of the game's main
+// with build id E0F3CCFAF50065AE4EA01EB5AEB13B1A45DA3348; with other keys nothing is replaced.
+namespace VideoCommon::OotNetwork {
+
+constexpr u64 ProgramId = 0x0400486024DEC000ULL;
+
+// Native program keys (Shader::Ampere::NativeProgramKey, the EDEN_NX2_SHADER_DUMP file names) of
+// the network's compute passes.
+constexpr u64 PrepassProgramKey = 0x8475d671e6967428ULL;
+constexpr u64 NetworkProgramKey = 0x42593194bb0b2b32ULL;
+constexpr u64 OutputProgramKey = 0xda6df3e54c716df2ULL;
+
+/// Constant buffer 0 offset of the output pass's texture handle for the B10G11R11 image it writes
+/// (the scene image the rest of the frame uses).
+constexpr u32 OutputImageHandleOffset = 0xd0;
+
+/// Fragment shaders of the game's tonemap passes; render target 0 of their draws is the network's
+/// input. The lowest bit of a pipeline hash is a salt (ours log bded5ce917183215), so it is ignored.
+constexpr bool IsTonemapShader(u64 hash) {
+    hash |= 1;
+    return hash == (0xbded5ce917183214ULL | 1) || // outdoors
+           hash == (0x6cb06edf14be1d79ULL | 1) || // indoors
+           hash == (0x3ac011bd2d772994ULL | 1);   // outdoors at another time of day
+}
+
+/// Owned by the rasterizer: the tonemap pass draws on the 3D engine, the network's passes compute.
+struct BypassState {
+    std::mutex mutex;
+    /// Render target 0 of the latest tonemap draw (address 0 until one is seen), under mutex.
+    Tegra::Engines::Maxwell3D::Regs::RenderTargetConfig tonemapped{};
+    std::atomic<bool> output_replaced{}; ///< the latest output pass was replaced
+};
+
+inline bool SkipAaSwitch() {
+    static const bool enabled = [] {
+        const char* const value = std::getenv("EDEN_NX2_OOT_SKIP_AA");
+        return value != nullptr && value[0] == '1';
+    }();
+    return enabled;
+}
+
+/// Takes the program id getter so that, with the switch unset, a draw or dispatch costs one
+/// static bool and no call.
+inline bool BypassEnabled(u64 (*current_program_id)()) {
+    return SkipAaSwitch() && current_program_id() == ProgramId;
+}
+
+} // namespace VideoCommon::OotNetwork
