+void RasterizerVulkan::TrackOotTonemappedImage(const GraphicsPipeline& pipeline) {
+    const auto& hashes = pipeline.Key().unique_hashes;
+    if (!VideoCommon::OotNetwork::IsTonemapShader(hashes[5])) {
+        return;
+    }
+    const auto& target = maxwell3d->regs.rt[0];
+    if (target.Address() == 0) {
+        return;
+    }
+    std::scoped_lock lock{oot_network_bypass.mutex};
+    if (oot_network_bypass.tonemapped.Address() != target.Address()) {
+        // The game may alternate targets: a few lines are enough to see which.
+        static u32 logged = 0;
+        if (logged < 8) {
+            ++logged;
+            LOG_INFO(Render_Vulkan,
+                     "EDEN_NX2_OOT_SKIP_AA: tonemapped image at {:#x} {}x{} format {:#x}",
+                     target.Address(), target.width, target.height,
+                     static_cast<u32>(target.format));
+        }
+    }
+    oot_network_bypass.tonemapped = target;
+}
