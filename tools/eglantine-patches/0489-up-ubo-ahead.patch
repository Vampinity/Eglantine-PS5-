diff --git a/src/video_core/ubo_ahead.cpp b/src/video_core/ubo_ahead.cpp
new file mode 100644
index 0000000..3aa3211
--- /dev/null
+++ b/src/video_core/ubo_ahead.cpp
@@ -0,0 +1,734 @@
+// SPDX-FileCopyrightText: Copyright 2026 Eden Emulator Project
+// SPDX-License-Identifier: GPL-3.0-or-later
+
+#include <algorithm>
+#include <array>
+#include <atomic>
+#include <chrono>
+#include <cstring>
+#include <memory>
+#include <mutex>
+#include <span>
+#include <unordered_map>
+#include <vector>
+
+#include "common/logging.h"
+#include "video_core/gpu_split.h"
+#include "video_core/ubo_ahead.h"
+
+namespace VideoCommon::UboAhead {
+
+namespace {
+
+constexpr u64 PageBits = 12; // Core::DEVICE_PAGEBITS
+constexpr u64 PageSize = u64{1} << PageBits;
+constexpr u64 PageMask = PageSize - 1;
+constexpr u64 AddressBits = 36; // the device address space (DevicePageFlags::AddressBits)
+constexpr u64 NumPages = u64{1} << (AddressBits - PageBits);
+constexpr u32 SlotsPerBlock = 256; // 1 MiB blocks
+constexpr u32 MaxBlocks = 128;     // 128 MiB of copies at most
+constexpr u32 NoSlot = ~0U;
+constexpr u32 DropFlag = 1U << 31;  // An update that drops the page (slot ids stay below 2^15)
+constexpr size_t MaxLive = 16;      // Copies of one page alive at once: the back's and the queued
+constexpr u64 DropAfter = 32;       // Epochs without a capture before the front drops a page
+constexpr u64 SweepEvery = 16;      // Epochs between the front's drop sweeps
+constexpr size_t MaxBatchWords = 2 + 2 * 512;
+constexpr u64 ReportNs = 10'000'000'000;
+
+/// A page's copies alive at once, oldest first: the one the back applied last (if any) and the
+/// ones the front sent after it. GPU writes go into all of them. Under State::mutex; inserted by
+/// the front, erased by the back once a drop emptied it.
+struct SharedPage {
+    std::array<u32, MaxLive> slots{};
+    u32 count{};
+    std::atomic<u64> writes{}; ///< GPU writes copied into its copies (BackProbe's signature)
+};
+/// Front only: the newest copy of a page and the epoch it was last captured (or failed) in.
+struct FrontPage {
+    u32 slot{NoSlot};
+    u64 epoch{};
+    SharedPage* shared{};
+};
+/// Back only: the copy draws read now, and the epoch it was last captured in.
+struct BackPage {
+    u32 slot{NoSlot};
+    u64 epoch{};
+    u64 seq{}; ///< Changes with the copy (BackProbe's signature)
+    SharedPage* shared{};
+};
+
+struct Stats {
+    std::atomic<u64> epochs{};
+    std::atomic<u64> captures{};       ///< Front: bindings captured (bind or a new epoch's draw)
+    std::atomic<u64> pages_checked{};  ///< Front: pages read this epoch for the first time
+    std::atomic<u64> new_copies{};     ///< ...whose bytes differed from their last copy
+    std::atomic<u64> unchanged{};      ///< ...whose last copy still held them
+    std::atomic<u64> unhinted{};       ///< Front: bindings no draw read yet (not captured)
+    std::atomic<u64> large_capped{};   ///< Front: over 4 KiB without _LARGE (first 4 KiB taken)
+    std::atomic<u64> unmapped{};       ///< Front: pages without guest memory
+    std::atomic<u64> lag{};            ///< Front: a page with MaxLive copies alive (not captured)
+    std::atomic<u64> pool_full{};      ///< Front: no room for a copy (not captured)
+    std::atomic<u64> front_ns{};
+    std::atomic<u64> batches{};
+    std::atomic<u64> drops{};
+    std::atomic<u64> applied{};        ///< Back: copies it switched to
+    std::atomic<u64> served_small{};
+    std::atomic<u64> served_large{};
+    std::atomic<u64> reused_large{};
+    std::array<std::atomic<u64>, static_cast<size_t>(Fallback::Count)> fallbacks{};
+    std::atomic<u64> write_throughs{}; ///< GPU writes that reached copies
+    std::atomic<u64> errors{};         ///< Updates naming a copy the page doesn't have (a bug)
+    std::atomic<u64> verified{};       ///< VERIFY: ranges compared
+    std::atomic<u64> verify_uncaptured{}; ///< VERIFY: ranges with no current copy (not compared)
+    std::atomic<u64> changed_small{};  ///< VERIFY: ranges up to 4 KiB whose bytes changed
+    std::atomic<u64> changed_bytes_small{};
+    std::atomic<u64> changed_first_kib{}; ///< VERIFY: larger ranges (first 4 KiB compared),
+    std::atomic<u64> changed_to_4kib{};   ///< ...first change in the 1st KiB, or in 1-4 KiB
+    std::atomic<u64> changed_bytes_large{};
+    std::atomic<u64> handles_compared{};   ///< VERIFY: texture handle words compared
+    std::atomic<u64> handles_uncaptured{}; ///< VERIFY: ...with no current copy (not compared)
+    std::atomic<u64> handles_changed{};    ///< VERIFY: ...whose guest word differs from the copy
+};
+
+struct State {
+    State() : live_bits{std::make_unique<std::atomic<u64>[]>(NumPages / 64)} {
+        pending.reserve(MaxBatchWords);
+        free_slots.reserve(size_t{SlotsPerBlock} * 4);
+    }
+
+    /// Guards the pool, the shared pages and the bytes of the copies against GPU writes.
+    std::mutex mutex;
+    std::array<std::atomic<u8*>, MaxBlocks> blocks{};
+    std::vector<std::unique_ptr<u8[]>> block_storage; ///< Under mutex
+    std::vector<u32> free_slots;                      ///< Under mutex
+    u32 used_slots{};                                 ///< Under mutex
+    u32 peak_slots{};                                 ///< Under mutex
+    std::unordered_map<u64, SharedPage> shared;       ///< Under mutex
+    /// One bit per device page: set while it has a SharedPage (any thread reads it unlocked).
+    std::unique_ptr<std::atomic<u64>[]> live_bits;
+    std::atomic<Tegra::MaxwellDeviceMemoryManager*> memory{};
+    /// Per stage and slot: the most bytes a shader read (NoteUsedSize); 0 until a draw read it.
+    std::array<std::atomic<u32>, NumStages * NumSlots> hints{};
+
+    // Front thread only.
+    u64 epoch{1};
+    bool epoch_sent{};
+    u64 last_sweep{};
+    std::unordered_map<u64, FrontPage> front;
+    std::vector<u32> pending;
+    std::chrono::steady_clock::time_point report_at{};
+
+    // Back thread only.
+    std::unordered_map<u64, BackPage> back;
+    u64 back_epoch{};
+    u64 back_seq{};
+
+    Stats stats;
+};
+
+State& Get() {
+    static State state;
+    return state;
+}
+
+void Count(std::atomic<u64>& counter, u64 amount = 1) {
+    counter.fetch_add(amount, std::memory_order_relaxed);
+}
+
+bool Live(const State& s, u64 page) {
+    return page < NumPages &&
+           (s.live_bits[page / 64].load(std::memory_order_relaxed) >> (page % 64) & 1) != 0;
+}
+void SetLive(State& s, u64 page, bool live) {
+    const u64 bit = u64{1} << (page % 64);
+    if (live) {
+        s.live_bits[page / 64].fetch_or(bit, std::memory_order_seq_cst);
+    } else {
+        s.live_bits[page / 64].fetch_and(~bit, std::memory_order_seq_cst);
+    }
+}
+
+u8* SlotPointer(const State& s, u32 slot) {
+    return s.blocks[slot / SlotsPerBlock].load(std::memory_order_acquire) +
+           size_t{slot % SlotsPerBlock} * PageSize;
+}
+
+/// Under mutex. NoSlot once MaxBlocks are in use.
+u32 AllocateSlot(State& s) {
+    if (s.free_slots.empty()) {
+        const size_t block = s.block_storage.size();
+        if (block >= MaxBlocks) {
+            return NoSlot;
+        }
+        s.block_storage.push_back(std::make_unique<u8[]>(size_t{SlotsPerBlock} * PageSize));
+        s.blocks[block].store(s.block_storage.back().get(), std::memory_order_release);
+        for (u32 i = SlotsPerBlock; i-- > 0;) {
+            s.free_slots.push_back(static_cast<u32>(block) * SlotsPerBlock + i);
+        }
+    }
+    const u32 slot = s.free_slots.back();
+    s.free_slots.pop_back();
+    s.peak_slots = (std::max)(s.peak_slots, ++s.used_slots);
+    return slot;
+}
+/// Under mutex.
+void FreeSlot(State& s, u32 slot) {
+    s.free_slots.push_back(slot);
+    --s.used_slots;
+}
+
+/// Front: an update for the back (a page's copy, or a drop), after the epoch header. Sent by
+/// FrontFlush, or by FlushIfFull once a batch is full: never under the mutex (sending may wait
+/// for the back to make room in the ring, and the back's GPU writes take the mutex).
+void Queue(State& s, u64 page, u32 value) {
+    if (s.pending.empty()) {
+        s.pending.push_back(static_cast<u32>(s.epoch));
+        s.pending.push_back(static_cast<u32>(s.epoch >> 32));
+    }
+    s.pending.push_back(static_cast<u32>(page));
+    s.pending.push_back(value);
+    g_front_pending = true;
+}
+void FlushIfFull(State& s) {
+    if (s.pending.size() + 2 > MaxBatchWords) {
+        FrontFlushImpl();
+    }
+}
+
+/// Front: captures `page` for this epoch, unless it was already.
+void CapturePage(State& s, Tegra::MaxwellDeviceMemoryManager& memory, u64 page) {
+    if (page >= NumPages) {
+        Count(s.stats.unmapped);
+        return;
+    }
+    FrontPage& fp = s.front[page];
+    if (fp.epoch == s.epoch) {
+        return; // Captured (or failed) in this epoch already
+    }
+    fp.epoch = s.epoch;
+    Count(s.stats.pages_checked);
+    const u8* const guest = memory.GetPointer<u8>(page << PageBits);
+    if (guest == nullptr) {
+        Count(s.stats.unmapped);
+        return; // No update: the back's copy stays from an older epoch (Stale)
+    }
+    // Touched before the lock: a page the guest memory service swapped out comes back here.
+    [[maybe_unused]] const volatile u8 touch = *guest;
+    std::scoped_lock lock{s.mutex};
+    // A GPU write lands in guest memory, then takes this lock to reach the copies: compared and
+    // copied under it, a copy either holds the write already or is written by it afterwards.
+    if (fp.slot != NoSlot && std::memcmp(SlotPointer(s, fp.slot), guest, PageSize) == 0) {
+        Count(s.stats.unchanged);
+        Queue(s, page, fp.slot);
+        return;
+    }
+    SharedPage& shared = fp.shared != nullptr ? *fp.shared : s.shared[page];
+    if (shared.count == MaxLive) {
+        Count(s.stats.lag);
+        return;
+    }
+    const u32 slot = AllocateSlot(s);
+    if (slot == NoSlot) {
+        Count(s.stats.pool_full);
+        return;
+    }
+    // Live before the copy: a GPU write that misses the bit landed before the copy reads it.
+    SetLive(s, page, true);
+    std::memcpy(SlotPointer(s, slot), guest, PageSize);
+    shared.slots[shared.count++] = slot;
+    fp.slot = slot;
+    fp.shared = &shared;
+    Count(s.stats.new_copies);
+    Queue(s, page, slot);
+}
+
+/// Front: drops the pages no binding captured for DropAfter epochs.
+void Sweep(State& s) {
+    for (auto it = s.front.begin(); it != s.front.end();) {
+        if (it->second.epoch + DropAfter < s.epoch) {
+            if (it->second.slot != NoSlot) {
+                Count(s.stats.drops);
+                Queue(s, it->first, it->second.slot | DropFlag);
+                FlushIfFull(s);
+            }
+            it = s.front.erase(it);
+        } else {
+            ++it;
+        }
+    }
+}
+
+void Report(State& s) {
+    const auto now = std::chrono::steady_clock::now();
+    if (s.report_at.time_since_epoch().count() == 0) {
+        s.report_at = now;
+        return;
+    }
+    if (now - s.report_at < std::chrono::nanoseconds{ReportNs}) {
+        return;
+    }
+    s.report_at = now;
+    Stats& t = s.stats;
+    const auto take = [](std::atomic<u64>& counter) {
+        return counter.exchange(0, std::memory_order_relaxed);
+    };
+    u32 pool_mib = 0;
+    u32 used = 0;
+    u32 peak = 0;
+    {
+        std::scoped_lock lock{s.mutex};
+        pool_mib = static_cast<u32>(s.block_storage.size() * SlotsPerBlock * PageSize >> 20);
+        used = s.used_slots;
+        peak = s.peak_slots;
+        s.peak_slots = s.used_slots;
+    }
+    auto& f = t.fallbacks;
+    const u64 new_copies = take(t.new_copies);
+    // Three lines: the log formats into a BUFSIZ buffer (1 KiB on the console).
+    LOG_INFO(HW_GPU,
+             "EDEN_UP_UBO_AHEAD={} LARGE={} VERIFY={} 10 s front: {} epochs, {} bindings captured "
+             "({} over 4 KiB: first 4 KiB only), {} pages read ({} new copies = {} KiB, {} "
+             "unchanged); not captured: {} unread slots, {} unmapped, {} lag, {} pool full; "
+             "front {:.1f} ms; pool {} MiB, {} copies alive (peak {}); {} batches, {} drops",
+             Enabled() ? 1 : 0, LargeEnabled() ? 1 : 0, VerifyEnabled() ? 1 : 0, take(t.epochs),
+             take(t.captures), take(t.large_capped), take(t.pages_checked), new_copies,
+             new_copies * PageSize >> 10, take(t.unchanged), take(t.unhinted), take(t.unmapped),
+             take(t.lag), take(t.pool_full), static_cast<double>(take(t.front_ns)) / 1e6,
+             pool_mib, used, peak, take(t.batches), take(t.drops));
+    LOG_INFO(HW_GPU,
+             "EDEN_UP_UBO_AHEAD 10 s back: {} copies applied; binds served from copies: {} small, "
+             "{} large ({} rebound); binds that read guest memory: {} not captured, {} stale, {} "
+             "GPU-modified, {} large (switch off); {} GPU writes into copies; {} errors",
+             take(t.applied), take(t.served_small), take(t.served_large), take(t.reused_large),
+             take(f[0]), take(f[1]), take(f[2]), take(f[3]),
+             take(t.write_throughs), take(t.errors));
+    if (VerifyEnabled()) {
+        LOG_INFO(HW_GPU,
+                 "EDEN_UP_UBO_AHEAD_VERIFY 10 s: {} binds compared ({} without a current copy); "
+                 "bytes changed since the front's copy: {} binds up to 4 KiB ({} bytes); larger "
+                 "binds (first 4 KiB compared): {} changed in the first KiB, {} in 1-4 KiB ({} "
+                 "bytes); texture handle words: {} compared ({} without a current copy), {} "
+                 "changed",
+                 take(t.verified), take(t.verify_uncaptured), take(t.changed_small),
+                 take(t.changed_bytes_small), take(t.changed_first_kib), take(t.changed_to_4kib),
+                 take(t.changed_bytes_large), take(t.handles_compared),
+                 take(t.handles_uncaptured), take(t.handles_changed));
+    }
+}
+
+/// Back: the copies of `page`, the back's view of it.
+void BackApply(std::span<const u32> words) {
+    State& s = Get();
+    if (words.size() < 2) {
+        return;
+    }
+    s.back_epoch = u64{words[0]} | (u64{words[1]} << 32);
+    Count(s.stats.batches);
+    for (size_t i = 2; i + 1 < words.size(); i += 2) {
+        const u64 page = words[i];
+        const u32 value = words[i + 1];
+        if ((value & DropFlag) != 0) {
+            // Copies up to the front's last one go (a later one is a capture made after the drop).
+            s.back.erase(page);
+            std::scoped_lock lock{s.mutex};
+            const auto it = s.shared.find(page);
+            if (it == s.shared.end()) {
+                Count(s.stats.errors);
+                continue;
+            }
+            SharedPage& shared = it->second;
+            const u32 last = value & ~DropFlag;
+            const u32* const begin = shared.slots.data();
+            const u32* const end = begin + shared.count;
+            const u32* const found = std::find(begin, end, last);
+            if (found == end) {
+                Count(s.stats.errors);
+                continue;
+            }
+            const u32 gone = static_cast<u32>(found - begin) + 1;
+            for (u32 k = 0; k < gone; ++k) {
+                FreeSlot(s, shared.slots[k]);
+            }
+            std::copy(shared.slots.data() + gone, shared.slots.data() + shared.count,
+                      shared.slots.data());
+            shared.count -= gone;
+            if (shared.count == 0) {
+                SetLive(s, page, false);
+                s.shared.erase(it);
+            }
+            continue;
+        }
+        BackPage& bp = s.back[page];
+        if (bp.slot != value) {
+            std::scoped_lock lock{s.mutex};
+            const auto it = s.shared.find(page);
+            SharedPage* const shared = it != s.shared.end() ? &it->second : nullptr;
+            const u32* const begin = shared != nullptr ? shared->slots.data() : nullptr;
+            const u32* const end = shared != nullptr ? begin + shared->count : nullptr;
+            const u32* const found = shared != nullptr ? std::find(begin, end, value) : nullptr;
+            if (found == end) {
+                Count(s.stats.errors);
+                bp.slot = NoSlot;
+                bp.shared = nullptr;
+                continue;
+            }
+            // The older copies: no draw after this point reads them, and the front moved on.
+            const u32 older = static_cast<u32>(found - begin);
+            for (u32 k = 0; k < older; ++k) {
+                FreeSlot(s, shared->slots[k]);
+            }
+            std::copy(shared->slots.data() + older, shared->slots.data() + shared->count,
+                      shared->slots.data());
+            shared->count -= older;
+            bp.slot = value;
+            bp.shared = shared;
+            bp.seq = ++s.back_seq;
+            Count(s.stats.applied);
+        }
+        bp.epoch = s.back_epoch;
+    }
+}
+
+/// The front captures at least `size` bytes of (stage, slot)'s bindings from now on.
+void RaiseHint(State& s, size_t stage, u32 slot, u32 size) {
+    if (stage >= NumStages || slot >= NumSlots) {
+        return;
+    }
+    std::atomic<u32>& hint = s.hints[stage * NumSlots + slot];
+    u32 known = hint.load(std::memory_order_relaxed);
+    while (size > known && !hint.compare_exchange_weak(known, size, std::memory_order_relaxed)) {
+    }
+}
+
+/// Calls `func(page_pointer_offset, dest_offset, bytes, page)` for each page piece of a range.
+template <typename Func>
+void ForEachPiece(u64 device, u64 size, Func&& func) {
+    u64 done = 0;
+    while (done < size) {
+        const u64 address = device + done;
+        const u64 bytes = (std::min)(size - done, PageSize - (address & PageMask));
+        func(address & PageMask, done, bytes, address >> PageBits);
+        done += bytes;
+    }
+}
+
+} // Anonymous namespace
+
+bool Enabled() noexcept {
+    static const bool enabled = Capturing() && Common::PeSwitch("EDEN_UP_UBO_AHEAD");
+    return enabled;
+}
+bool LargeEnabled() noexcept {
+    static const bool enabled = Enabled() && Common::PeSwitch("EDEN_UP_UBO_AHEAD_LARGE");
+    return enabled;
+}
+bool VerifyEnabled() noexcept {
+    static const bool enabled = Capturing() && Common::PeSwitch("EDEN_UP_UBO_AHEAD_VERIFY");
+    return enabled;
+}
+bool StatsEnabled() noexcept {
+    static const bool enabled = Common::PeSwitch("EDEN_UP_UBO_AHEAD_STATS");
+    return enabled;
+}
+
+void FrontNewEpochImpl() {
+    State& s = Get();
+    if (!s.pending.empty()) {
+        FrontFlushImpl(); // Updates of the old epoch go with its header
+    }
+    [[maybe_unused]] static const bool announced = [] {
+        LOG_INFO(HW_GPU,
+                 "EDEN_UP_UBO_AHEAD={} (uniform binds read the front's copies), LARGE={}, "
+                 "VERIFY={}, STATS={}",
+                 Enabled() ? 1 : 0, LargeEnabled() ? 1 : 0, VerifyEnabled() ? 1 : 0,
+                 StatsEnabled() ? 1 : 0);
+        return true;
+    }();
+    ++s.epoch;
+    s.epoch_sent = false;
+    g_front_pending = true; // The epoch goes to the back with the next method sent
+    Count(s.stats.epochs);
+    if (s.epoch - s.last_sweep >= SweepEvery) {
+        s.last_sweep = s.epoch;
+        Sweep(s);
+    }
+    if (StatsEnabled() || VerifyEnabled()) [[unlikely]] {
+        Report(s);
+    }
+}
+
+u64 FrontEpoch() noexcept {
+    return Get().epoch;
+}
+
+void FrontCapture(u64 device, u32 size, size_t stage, u32 slot) {
+    State& s = Get();
+    if (stage >= NumStages || slot >= NumSlots || size == 0) {
+        return;
+    }
+    const u32 hint = s.hints[stage * NumSlots + slot].load(std::memory_order_relaxed);
+    if (hint == 0) {
+        Count(s.stats.unhinted);
+        return;
+    }
+    u32 bytes = (std::min)(size, hint);
+    if (bytes > SmallMax && !LargeEnabled()) {
+        // The hint is the most any shader read from this slot; a bind uses its own shader's size
+        // from the binding's address. Without _LARGE the back serves binds up to 4 KiB (and
+        // BackVerify compares the first 4 KiB of larger ones): the same with or without VERIFY.
+        Count(s.stats.large_capped);
+        bytes = SmallMax;
+    }
+    Tegra::MaxwellDeviceMemoryManager* const memory = s.memory.load(std::memory_order_acquire);
+    if (memory == nullptr) {
+        return;
+    }
+    const bool timed = StatsEnabled() || VerifyEnabled();
+    const auto start = timed ? std::chrono::steady_clock::now()
+                             : std::chrono::steady_clock::time_point{};
+    Count(s.stats.captures);
+    const u64 last = (device + bytes - 1) >> PageBits;
+    for (u64 page = device >> PageBits; page <= last; ++page) {
+        CapturePage(s, *memory, page);
+        FlushIfFull(s);
+    }
+    if (timed) {
+        const auto spent = std::chrono::steady_clock::now() - start;
+        Count(s.stats.front_ns, static_cast<u64>(
+                                    std::chrono::duration_cast<std::chrono::nanoseconds>(spent)
+                                        .count()));
+    }
+}
+
+void FrontFlushImpl() {
+    State& s = Get();
+    g_front_pending = false;
+    GpuSplit& split = GpuSplit::Get();
+    if (!split.Active()) {
+        s.pending.clear(); // No back to send to (the split stops: Reset follows)
+        return;
+    }
+    if (s.pending.empty()) {
+        if (s.epoch_sent) {
+            return;
+        }
+        s.pending.push_back(static_cast<u32>(s.epoch));
+        s.pending.push_back(static_cast<u32>(s.epoch >> 32));
+    }
+    s.epoch_sent = true;
+    split.DeferWords([](std::span<const u32> words) { BackApply(words); },
+                     std::span<const u32>{s.pending}, GpuSplit::FastDrawNeutral);
+    s.pending.clear();
+}
+
+void NoteUsedSize(size_t stage, u32 slot, u32 size, Tegra::MaxwellDeviceMemoryManager& memory) {
+    State& s = Get();
+    // The current session's device memory (Reset forgets the last one's).
+    if (s.memory.load(std::memory_order_relaxed) != &memory) [[unlikely]] {
+        s.memory.store(&memory, std::memory_order_release);
+    }
+    RaiseHint(s, stage, slot, size);
+}
+
+void NoteFallback(Fallback reason) {
+    Count(Get().stats.fallbacks[static_cast<size_t>(reason)]);
+}
+
+bool BackProbe(u64 device, u32 size, u64& signature) {
+    State& s = Get();
+    u64 hash = 0xcbf29ce484222325ULL;
+    bool ok = true;
+    Fallback reason = Fallback::NotCaptured;
+    ForEachPiece(device, size, [&](u64, u64, u64, u64 page) {
+        if (!ok) {
+            return;
+        }
+        const auto it = s.back.find(page);
+        if (it == s.back.end() || it->second.slot == NoSlot) {
+            ok = false;
+            reason = Fallback::NotCaptured;
+            return;
+        }
+        if (it->second.epoch != s.back_epoch) {
+            ok = false;
+            reason = Fallback::Stale;
+            return;
+        }
+        const u64 writes = it->second.shared->writes.load(std::memory_order_acquire);
+        for (const u64 value : {page, it->second.seq, writes}) {
+            hash = (hash ^ value) * 0x100000001b3ULL;
+        }
+    });
+    if (!ok) {
+        NoteFallback(reason);
+        return false;
+    }
+    signature = hash;
+    return true;
+}
+
+void BackCopy(u64 device, u32 size, u8* dest) {
+    State& s = Get();
+    ForEachPiece(device, size, [&](u64 offset, u64 done, u64 bytes, u64 page) {
+        std::memcpy(dest + done, SlotPointer(s, s.back.find(page)->second.slot) + offset, bytes);
+    });
+}
+
+void NoteServed(bool large, bool reused) {
+    Stats& t = Get().stats;
+    Count(large ? t.served_large : t.served_small);
+    if (reused) {
+        Count(t.reused_large);
+    }
+}
+
+void BackVerify(u64 device, u32 size, Tegra::MaxwellDeviceMemoryManager& memory) {
+    State& s = Get();
+    if (size == 0) {
+        return;
+    }
+    // A bind's own data starts at its address: of a larger range (Ocarina's 64 KiB banks hold
+    // other draws' blocks after it) the first 4 KiB are compared, at a 16th of the cost.
+    const bool large = size > SmallMax;
+    size = (std::min)(size, SmallMax);
+    // Without a current copy of every page there is nothing to compare.
+    bool captured = true;
+    ForEachPiece(device, size, [&](u64, u64, u64, u64 page) {
+        const auto it = s.back.find(page);
+        captured = captured && it != s.back.end() && it->second.slot != NoSlot &&
+                   it->second.epoch == s.back_epoch;
+    });
+    if (!captured) {
+        Count(s.stats.verify_uncaptured);
+        return;
+    }
+    Count(s.stats.verified);
+    u64 first = ~u64{0};
+    u64 changed = 0;
+    ForEachPiece(device, size, [&](u64 offset, u64 done, u64 bytes, u64 page) {
+        const u8* const guest = memory.GetPointer<u8>((page << PageBits) + offset);
+        const u8* const copy = SlotPointer(s, s.back.find(page)->second.slot) + offset;
+        if (guest == nullptr || std::memcmp(guest, copy, bytes) == 0) {
+            return;
+        }
+        for (u64 i = 0; i < bytes; ++i) {
+            if (guest[i] != copy[i]) {
+                first = (std::min)(first, done + i);
+                ++changed;
+            }
+        }
+    });
+    if (changed == 0) {
+        return;
+    }
+    Stats& t = s.stats;
+    if (!large) {
+        Count(t.changed_small);
+        Count(t.changed_bytes_small, changed);
+        return;
+    }
+    Count(first < 1024 ? t.changed_first_kib : t.changed_to_4kib);
+    Count(t.changed_bytes_large, changed);
+}
+
+void BackVerifyHandle(size_t stage, u32 slot, u32 offset, std::optional<u64> device, u32 word) {
+    State& s = Get();
+    // The front captures the binding up to this word from now on (VERIFY only: binds the back
+    // serves never reach past their own shader's size, so they don't change).
+    RaiseHint(s, stage, slot, offset + static_cast<u32>(sizeof(u32)));
+    if (!device || (*device & PageMask) > PageSize - sizeof(u32)) {
+        Count(s.stats.handles_uncaptured);
+        return;
+    }
+    const auto it = s.back.find(*device >> PageBits);
+    if (it == s.back.end() || it->second.slot == NoSlot || it->second.epoch != s.back_epoch) {
+        Count(s.stats.handles_uncaptured);
+        return;
+    }
+    u32 copy{};
+    std::memcpy(&copy, SlotPointer(s, it->second.slot) + (*device & PageMask), sizeof(copy));
+    Count(s.stats.handles_compared);
+    if (copy != word) {
+        Count(s.stats.handles_changed);
+    }
+}
+
+void OnGpuWrite(u64 device, const void* source, size_t size) {
+    State& s = Get();
+    // The bytes are in guest memory: a capture that misses the live bit below reads them.
+    std::atomic_thread_fence(std::memory_order_seq_cst);
+    const u8* const bytes = static_cast<const u8*>(source);
+    ForEachPiece(device, size, [&](u64 offset, u64 done, u64 length, u64 page) {
+        if (!Live(s, page)) {
+            return;
+        }
+        std::scoped_lock lock{s.mutex};
+        const auto it = s.shared.find(page);
+        if (it == s.shared.end()) {
+            return;
+        }
+        SharedPage& shared = it->second;
+        for (u32 k = 0; k < shared.count; ++k) {
+            std::memcpy(SlotPointer(s, shared.slots[k]) + offset, bytes + done, length);
+        }
+        shared.writes.fetch_add(1, std::memory_order_release);
+        Count(s.stats.write_throughs);
+    });
+}
+
+void OnGpuWriteInPlace(u64 device, size_t size, Tegra::MaxwellDeviceMemoryManager& memory) {
+    State& s = Get();
+    std::atomic_thread_fence(std::memory_order_seq_cst);
+    ForEachPiece(device, size, [&](u64 offset, u64, u64 length, u64 page) {
+        if (!Live(s, page)) {
+            return;
+        }
+        const u8* const guest = memory.GetPointer<u8>((page << PageBits) + offset);
+        if (guest == nullptr) {
+            return;
+        }
+        std::scoped_lock lock{s.mutex};
+        const auto it = s.shared.find(page);
+        if (it == s.shared.end()) {
+            return;
+        }
+        SharedPage& shared = it->second;
+        for (u32 k = 0; k < shared.count; ++k) {
+            std::memcpy(SlotPointer(s, shared.slots[k]) + offset, guest, length);
+        }
+        shared.writes.fetch_add(1, std::memory_order_release);
+        Count(s.stats.write_throughs);
+    });
+}
+
+void Reset() {
+    State& s = Get();
+    std::scoped_lock lock{s.mutex};
+    for (const auto& [page, shared] : s.shared) {
+        SetLive(s, page, false);
+    }
+    s.shared.clear();
+    // The pool goes back to the system: a GPU write on another thread reaches a copy only
+    // through s.shared, under this mutex, and the front and the back are stopped.
+    for (std::atomic<u8*>& block : s.blocks) {
+        block.store(nullptr, std::memory_order_relaxed);
+    }
+    s.block_storage.clear();
+    s.block_storage.shrink_to_fit();
+    s.free_slots.clear();
+    s.used_slots = 0;
+    s.peak_slots = 0;
+    // The next session's device memory and shaders: none until its back binds again.
+    s.memory.store(nullptr, std::memory_order_release);
+    for (std::atomic<u32>& hint : s.hints) {
+        hint.store(0, std::memory_order_relaxed);
+    }
+    s.front.clear();
+    s.pending.clear();
+    s.epoch_sent = false;
+    g_front_pending = false;
+    s.back.clear();
+    s.back_epoch = 0;
+}
+
+} // namespace VideoCommon::UboAhead
diff --git a/src/video_core/ubo_ahead.h b/src/video_core/ubo_ahead.h
new file mode 100644
index 0000000..d1ec250
--- /dev/null
+++ b/src/video_core/ubo_ahead.h
@@ -0,0 +1,158 @@
+// SPDX-FileCopyrightText: Copyright 2026 Eden Emulator Project
+// SPDX-License-Identifier: GPL-3.0-or-later
+
+#pragma once
+
+#include <array>
+#include <cstddef>
+#include <optional>
+
+#include "common/common_types.h"
+#include "common/pe_switch.h"
+#include "video_core/host1x/gpu_device_memory_manager.h"
+
+// EDEN_UP_UBO_AHEAD=1 (for EDEN_NX2_FRAMES_AHEAD=1; after GrowingBlackBeans' EDEN_GBB_UBO_AHEAD,
+// issue 21): run a frame ahead, the game writes the next frame's uniform data while the split GPU
+// thread's back still records this frame's draws, and a constant buffer the back reads from guest
+// memory then holds next-frame values (short dark and bright flashes). The front parses each
+// command list soon after its submit: it copies the guest pages of the constant buffers the draws
+// bind (4 KiB pages, "captures") and sends them to the back in stream order, and the back's
+// uniform binds read those copies instead of guest memory.
+//  - When: a page is captured at most once per capture epoch, at the first bind or draw method
+//    that needs it. An epoch begins at each DmaPusher::DispatchCalls (a batch of submitted lists):
+//    the game writes a list's uniform data before it submits the list, so a copy made after that
+//    holds it for every draw of the batch. Each semaphore acquire the front passes begins one too,
+//    also one met at once: the CPU may write what the commands after it read until it releases
+//    it. At the first draw method of an epoch the front captures every binding of the engine
+//    again, rebound or not.
+//  - What: the 3D bind groups as the front parses them, as many bytes of each binding as the back's
+//    shaders read from that stage and slot (learnt from the back's binds: nothing is captured for a
+//    slot no draw read yet). Ranges up to 4 KiB (the streamed uniforms); larger ones (Ocarina's
+//    64 KiB indirectly read banks) are served only with EDEN_UP_UBO_AHEAD_LARGE=1, streamed whole
+//    (a 64 KiB stream allocation and copy per bind at a new address: try it after UBO_AHEAD=1
+//    alone). Without it the first 4 KiB of a larger binding are captured, for smaller binds of
+//    the same slot.
+//  - Versions: a page whose bytes equal its last copy keeps that copy; the back frees a copy once
+//    it applied the next one, and pages no draw used for 32 epochs are dropped. Copies live in a
+//    pool of 1 MiB blocks that grows on demand, at most 128 MiB (the high-water mark stays until
+//    the split stops; STATS shows it).
+//  - GPU writes the back makes in stream order (constant buffer data, inline uploads, DMA copies,
+//    downloads, reports, semaphores) reach guest memory after the front copied: they are written
+//    into the copies too (OnGpuWrite, through the hooks EDEN_UP_UBO_SNAPSHOT placed). Ranges the
+//    GPU wrote on the host (GPU-modified in the buffer cache) keep reading the host buffer.
+//  - Not covered: texture and sampler handles (the back still reads the handle words and the
+//    texture and sampler headers from guest memory; VERIFY counts changed handle words),
+//    compute constant buffers (QMDs are scheduled and read on the back), the root table bank
+//    (method data, in the command copy), engines whose macros run on the back
+//    (EDEN_UP_L1056_BACK_MACROS turns all of this off).
+// A bind the copies can't serve reads guest memory as without the switch (counted by reason).
+// A served bind reads no guest memory, so EDEN_NX2_OVERWRITE_CHECK no longer counts it as an
+// ahead read, whether or not its copy was in time.
+// EDEN_UP_UBO_AHEAD_STATS=1: a line every 10 s. EDEN_UP_UBO_AHEAD_VERIFY=1 (with UBO_AHEAD or
+// without): at each uniform bind the back compares the front's copy with guest memory and counts
+// the ranges whose bytes changed in between (the CPU's writes: GPU writes are in the copies), and
+// at each full texture resolve the handle words read from constant buffers (it then captures
+// their words too; served binds stay the same). A low count is a lower bound: a copy the front
+// takes after the CPU already wrote the next frame matches guest memory and counts as unchanged.
+// All off unless exactly "1"; unset, nothing here runs.
+namespace VideoCommon::UboAhead {
+
+constexpr size_t NumStages = 5;
+constexpr u32 NumSlots = 18; ///< Maxwell constant buffers per stage
+constexpr u32 SmallMax = 4096; ///< Up to this the back streams a uniform buffer (skip cache size)
+
+/// EDEN_UP_UBO_AHEAD=1: the back's uniform binds read the front's copies.
+[[nodiscard]] bool Enabled() noexcept;
+/// EDEN_UP_UBO_AHEAD_LARGE=1 (with UBO_AHEAD): ranges over 4 KiB too.
+[[nodiscard]] bool LargeEnabled() noexcept;
+/// EDEN_UP_UBO_AHEAD_VERIFY=1: the back compares the copies with guest memory.
+[[nodiscard]] bool VerifyEnabled() noexcept;
+/// EDEN_UP_UBO_AHEAD_STATS=1: the 10 s line (also logged with VERIFY).
+[[nodiscard]] bool StatsEnabled() noexcept;
+
+/// UBO_AHEAD or VERIFY (and no back macros): the front captures, GPU writes reach the copies.
+[[nodiscard]] inline bool Capturing() noexcept {
+    static const bool capturing = [] {
+        const bool wanted = Common::PeSwitch("EDEN_UP_UBO_AHEAD") ||
+                            Common::PeSwitch("EDEN_UP_UBO_AHEAD_VERIFY");
+        return wanted && !Common::PeSwitch("EDEN_UP_L1056_BACK_MACROS");
+    }();
+    return capturing;
+}
+
+/// A constant buffer binding as the back will hold it: `device` is valid only when `valid`.
+struct Binding {
+    u64 device{};
+    u32 size{};
+    bool valid{};
+};
+/// The front's copy of a 3D engine's bindings, per stage and slot.
+using FrontBindings = std::array<std::array<Binding, NumSlots>, NumStages>;
+
+// Front thread (the split GPU thread's front, which parses the command lists).
+
+/// Front: true while updates for the back wait to be sent (FrontFlush).
+inline bool g_front_pending{};
+void FrontNewEpochImpl();
+/// Front, DmaPusher::DispatchCalls and semaphore acquires: a new capture epoch (see above).
+inline void FrontNewEpoch() {
+    if (Capturing()) [[unlikely]] {
+        FrontNewEpochImpl();
+    }
+}
+/// Front: the current capture epoch.
+[[nodiscard]] u64 FrontEpoch() noexcept;
+/// Front: slot `slot` of `stage` is bound to `size` bytes at `device`: captures the pages of the
+/// part the shaders read that this epoch has not captured yet.
+void FrontCapture(u64 device, u32 size, size_t stage, u32 slot);
+void FrontFlushImpl();
+/// Front, before it sends a method: sends the captures and the epoch to the back, in order.
+inline void FrontFlush() {
+    if (g_front_pending) [[unlikely]] {
+        FrontFlushImpl();
+    }
+}
+
+// Back thread (draws).
+
+/// Back: the shaders of (stage, slot) read `size` bytes of the binding; `memory` is the device
+/// memory the front copies from.
+void NoteUsedSize(size_t stage, u32 slot, u32 size, Tegra::MaxwellDeviceMemoryManager& memory);
+
+/// Why a bind read guest memory.
+enum class Fallback : u32 {
+    NotCaptured, ///< A page of the range has no copy (no draw read it before, unmapped, dropped)
+    Stale,       ///< A page's copy is from an older epoch (the front could not capture it now)
+    GpuModified, ///< The range holds GPU-written data on the host
+    LargeOff,    ///< Over 4 KiB without EDEN_UP_UBO_AHEAD_LARGE
+    Count,
+};
+void NoteFallback(Fallback reason);
+
+/// Back: whether every page of [device, device + size) has a copy of the current epoch (counts
+/// the fallback when not). `signature` changes whenever the bytes of any of those copies may have.
+[[nodiscard]] bool BackProbe(u64 device, u32 size, u64& signature);
+/// Back, right after a BackProbe that returned true: copies the bytes to `dest`.
+void BackCopy(u64 device, u32 size, u8* dest);
+/// Back: counts a bind served from the copies (`large`: over 4 KiB, `reused`: bound again).
+void NoteServed(bool large, bool reused);
+/// Back, EDEN_UP_UBO_AHEAD_VERIFY: compares the copy of [device, device + size) with guest memory
+/// (of a range over 4 KiB its first 4 KiB, all the front copies of it without _LARGE).
+void BackVerify(u64 device, u32 size, Tegra::MaxwellDeviceMemoryManager& memory);
+/// Back, EDEN_UP_UBO_AHEAD_VERIFY: a draw read texture handle word `word` from guest memory,
+/// `offset` bytes into slot `slot` of `stage`, at `device` (none: unmapped). Compares it with the
+/// front's copy of the page, and has the front capture the slot up to it from now on.
+void BackVerifyHandle(size_t stage, u32 slot, u32 offset, std::optional<u64> device, u32 word);
+
+// Any thread that writes guest memory for the GPU (through ubo_snapshot.h's OnGpuWrite).
+
+/// The GPU just wrote `size` bytes at `device` (already in guest memory).
+void OnGpuWrite(u64 device, const void* source, size_t size);
+/// The same for bytes written in place: read back from guest memory.
+void OnGpuWriteInPlace(u64 device, size_t size, Tegra::MaxwellDeviceMemoryManager& memory);
+
+/// The split stopped (the front's thread and the back joined): forgets every copy, frees the
+/// pool, and the device memory and read sizes of the session.
+void Reset();
+
+} // namespace VideoCommon::UboAhead
