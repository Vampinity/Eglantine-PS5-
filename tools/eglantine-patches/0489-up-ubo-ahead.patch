+template <class P>
+bool BufferCache<P>::BindUboAheadUniformBuffer(size_t stage, u32 index, u32 binding_index,
+                                               DAddr device_addr, u32 size) {
+    if constexpr (!IS_OPENGL && VideoCommon::StreamUniformReusable<Runtime>) {
+        const bool gpu_modified = memory_tracker.IsRegionGpuModified(device_addr, size);
+        if (UboAhead::VerifyEnabled() && !gpu_modified) {
+            UboAhead::BackVerify(device_addr, size, device_memory);
+        }
+        if (!UboAhead::Enabled()) {
+            return false;
+        }
+        if (gpu_modified) {
+            UboAhead::NoteFallback(UboAhead::Fallback::GpuModified);
+            return false;
+        }
+        const bool large = size > UboAhead::SmallMax;
+        if (large && !UboAhead::LargeEnabled()) {
+            UboAhead::NoteFallback(UboAhead::Fallback::LargeOff);
+            return false;
+        }
+        u64 signature = 0;
+        if (!UboAhead::BackProbe(device_addr, size, signature)) {
+            return false; // Counted by BackProbe
+        }
+        if (!large) {
+            UboAhead::BackCopy(device_addr, size, ubo_ahead_scratch.data());
+            bool streamed = false;
+            if (VideoCommon::UniformStreamReuseEnabled()) {
+                streamed = VideoCommon::BindSmallUniformFromSource(
+                    runtime, stage, index, binding_index, ubo_ahead_scratch.data(), size);
+            }
+            if (!streamed) {
+                const std::span<u8> span =
+                    runtime.BindMappedUniformBuffer(stage, binding_index, size);
+                std::memcpy(span.data(), ubo_ahead_scratch.data(), size);
+            }
+            UboAhead::NoteServed(false, false);
+            return true;
+        }
+        // Over 4 KiB (the 64 KiB banks): streamed whole from the copies, and bound again while
+        // nothing changes in the same command buffer, instead of the host buffer synchronized from
+        // guest memory (the bank re-mark and SynchronizeBuffer are skipped; tracking stays).
+        if (stage >= ubo_ahead_reuse.size() || index >= ubo_ahead_reuse[stage].size()) {
+            UboAhead::NoteFallback(UboAhead::Fallback::LargeOff);
+            return false;
+        }
+        UboAheadReuse& reuse = ubo_ahead_reuse[stage][index];
+        if (reuse.size == size && reuse.device_addr == device_addr &&
+            reuse.signature == signature && reuse.tick == runtime.CurrentTick()) {
+            runtime.RebindStreamUniform(reuse.ref, size);
+            UboAhead::NoteServed(true, true);
+            return true;
+        }
+        const std::span<u8> span = runtime.BindMappedUniformBuffer(stage, binding_index, size);
+        UboAhead::BackCopy(device_addr, size, span.data());
+        reuse.ref = runtime.LastStreamUniformRef();
+        reuse.device_addr = device_addr;
+        reuse.signature = signature;
+        // After the allocation: the tick its stream region is tagged with.
+        reuse.tick = runtime.CurrentTick();
+        reuse.size = size;
+        UboAhead::NoteServed(true, false);
+        return true;
+    } else {
+        return false;
+    }
+}
