+// EDEN_UP_UBO_AHEAD / _VERIFY: a bind group write (`value`, shadow RAM applied) as ProcessCBBind
+// will run it on the back, against the front's copy of the registers: the binding, and the
+// front's copy of the pages it reads (ubo_ahead.h).
+void FrontNoteUboAheadBind(VideoCommon::UboAhead::FrontBindings& bindings,
+                           MemoryManager& memory_manager, const u32* regs, u32 method, u32 value) {
+    constexpr u32 first = MAXWELL3D_REG_INDEX(bind_groups[0].raw_config);
+    constexpr u32 stride = MAXWELL3D_REG_INDEX(bind_groups[1].raw_config) - first;
+    const u32 stage = (method - first) / stride;
+    const u32 slot = (value >> 4) & 31;
+    if (stage >= VideoCommon::UboAhead::NumStages || slot >= VideoCommon::UboAhead::NumSlots) {
+        return; // ProcessCBBind ignores slots past the 18 it holds
