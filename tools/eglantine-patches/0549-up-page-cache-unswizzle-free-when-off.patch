+/// Lines [first, end) of a swizzle or unswizzle, index = slice * height + line, for the helper
+/// threads. A function of its own with everything by value, so nothing is reloaded per pixel.
+template <bool TO_LINEAR, u32 BYTES_PER_PIXEL>
+void SwizzleLines(u8* const output, const u8* const input, const u32 first, const u32 end,
+                  const u32 width, const u32 height, const u32 pitch, const u32 block_height,
+                  const u32 block_depth, const u32 block_size, const u32 slice_size,
+                  const bool native_tiling) {
+    const u32 block_height_mask = (1U << block_height) - 1;
+    const u32 block_depth_mask = (1U << block_depth) - 1;
+    const u32 x_shift = GOB_SIZE_SHIFT + block_height + block_depth;
+    for (u32 index = first; index < end; ++index) {
+        const u32 slice = index / height;
+        const u32 line = index % height;
+        const u32 offset_z = (slice >> block_depth) * slice_size +
+                             ((slice & block_depth_mask) << (GOB_SIZE_SHIFT + block_height));
+        const u32 swizzled_y = pdep<SWIZZLE_Y_BITS>(line);
+        const u32 block_y = line >> GOB_SIZE_Y_SHIFT;
+        const u32 offset_y = (block_y >> block_height) * block_size +
+                             ((block_y & block_height_mask) << GOB_SIZE_SHIFT);
+        u32 swizzled_x = 0;
+        for (u32 column = 0; column < width;
+             ++column, incrpdep<SWIZZLE_X_BITS, BYTES_PER_PIXEL>(swizzled_x)) {
+            const u32 x = column * BYTES_PER_PIXEL;
+            const u32 offset_x = (x >> GOB_SIZE_X_SHIFT) << x_shift;
+            const u32 base_swizzled_offset = offset_z + offset_y + offset_x;
+            const u32 swizzled_offset =
+                NativeGobOffset(base_swizzled_offset + (swizzled_x | swizzled_y), native_tiling);
+            const u32 unswizzled_offset =
+                slice * pitch * height + line * pitch + column * BYTES_PER_PIXEL;
+            u8* const dst = &output[TO_LINEAR ? swizzled_offset : unswizzled_offset];
+            const u8* const src = &input[TO_LINEAR ? unswizzled_offset : swizzled_offset];
+            std::memcpy(dst, src, BYTES_PER_PIXEL);
+        }
+    }
+}
+
+/// The same lines in 16-byte units (EDEN_UP_SWIZZLE_UNITS; `width` counts units), their places in
+/// a GOB from GobUnitOffsets' table.
+template <bool TO_LINEAR>
+void SwizzleUnitLines(u8* const output, const u8* const input, const u32 first, const u32 end,
+                      const u32 width, const u32 height, const u32 pitch, const u32 block_height,
+                      const u32 block_depth, const u32 block_size, const u32 slice_size,
+                      const u32* const unit_offsets) {
+    const u32 block_height_mask = (1U << block_height) - 1;
+    const u32 block_depth_mask = (1U << block_depth) - 1;
+    const u32 x_shift = GOB_SIZE_SHIFT + block_height + block_depth;
+    const u32 gobs_wide = Common::DivCeil(width, 4U);
+    for (u32 index = first; index < end; ++index) {
+        const u32 slice = index / height;
+        const u32 line = index % height;
+        const u32 offset_z = (slice >> block_depth) * slice_size +
+                             ((slice & block_depth_mask) << (GOB_SIZE_SHIFT + block_height));
+        const u32 block_y = line >> GOB_SIZE_Y_SHIFT;
+        const u32 offset_y = (block_y >> block_height) * block_size +
+                             ((block_y & block_height_mask) << GOB_SIZE_SHIFT);
+        const u32* const row_offsets = &unit_offsets[(line & (GOB_SIZE_Y - 1)) * 4];
+        const u32 row_linear = slice * pitch * height + line * pitch;
+        for (u32 gob_x = 0; gob_x < gobs_wide; ++gob_x) {
+            const u32 gob_offset = offset_z + offset_y + (gob_x << x_shift);
+            const u32 units = (std::min)(4U, width - gob_x * 4);
+            for (u32 unit = 0; unit < units; ++unit) {
+                const u32 swizzled_offset = gob_offset + row_offsets[unit];
+                const u32 unswizzled_offset = row_linear + (gob_x * 4 + unit) * 16;
+                u8* const dst = &output[TO_LINEAR ? swizzled_offset : unswizzled_offset];
+                const u8* const src = &input[TO_LINEAR ? unswizzled_offset : swizzled_offset];
+                std::memcpy(dst, src, 16);
+            }
+        }
+    }
+}
