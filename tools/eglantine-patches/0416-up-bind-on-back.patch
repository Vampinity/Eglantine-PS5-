Subject: [PATCH] split: a new channel's cache setup runs on the thread that binds it, the back (heydemoura/EglantinePS5 3c7bcba292, core patch 0034; EDEN_UP_BIND_ON_BACK, off by default)

diff --git a/src/video_core/control/channel_state.h b/src/video_core/control/channel_state.h
index 80811c1..8505a53 100644
--- a/src/video_core/control/channel_state.h
+++ b/src/video_core/control/channel_state.h
@@ -62,6 +62,9 @@ struct ChannelState {
     s32 bind_id = -1;
     u64 program_id = 0;
     bool initialized = false;
+    /// EDEN_UP_BIND_ON_BACK: the caches' per-channel state is still to be set up, by the thread
+    /// that binds the channel (the split's back, in order with its draws).
+    bool rasterizer_pending = false;
 };
 
 } // namespace Control
diff --git a/src/video_core/gpu.cpp b/src/video_core/gpu.cpp
index 051eaff..bf46a0b 100644
--- a/src/video_core/gpu.cpp
+++ b/src/video_core/gpu.cpp
@@ -17,6 +17,7 @@
 #include <vector>
 
 #include "common/assert.h"
+#include "common/pe_switch.h"
 #include "common/settings.h"
 #include "common/settings_enums.h"
 #include "core/core.h"
@@ -36,6 +37,7 @@
 #include "video_core/engines/maxwell_3d.h"
 #include "video_core/engines/maxwell_dma.h"
 #include "video_core/gpu.h"
+#include "video_core/gpu_split.h"
 #include "video_core/gpu_thread.h"
 #include "video_core/host1x/host1x.h"
 #include "video_core/host1x/syncpoint_manager.h"
@@ -104,6 +106,13 @@ struct GPU::Impl {
         if (bound_channel != channel_id) {
             auto it = channels.find(channel_id);
             ASSERT(it != channels.end());
+            // EDEN_UP_BIND_ON_BACK: a channel set up while the split's back ran gets its caches'
+            // state now, on the thread that binds it (the back, in order with its draws). Never
+            // set with the switch off.
+            if (it->second->rasterizer_pending) {
+                it->second->rasterizer_pending = false;
+                renderer->ReadRasterizer()->InitializeChannel(*it->second);
+            }
             bound_channel = channel_id;
             current_channel = it->second.get();
             renderer->ReadRasterizer()->BindChannel(*current_channel);
@@ -117,6 +126,18 @@ struct GPU::Impl {
     void InitChannel(Control::ChannelState& to_init, u64 program_id) {
         to_init.Init(system, program_id);
         to_init.BindRasterizer(renderer->ReadRasterizer());
+        // EDEN_UP_BIND_ON_BACK (heydemoura/EglantinePS5 core patch 0034, 3c7bcba292): the caches'
+        // per-channel state (channel lists, address-space page tables, pipeline and query caches)
+        // belongs to the split's back while it runs. Set up from here (a guest thread) it changed
+        // under the back's draws: Bananza crashed at startup on its second channel (a null list
+        // node in a syncpoint increment on the back, after garbage puller methods). The thread
+        // that binds the channel (BindChannel, deferred to the back by the scheduler) finishes it.
+        // BackRunning, not Active: Active is the front's own flag, and this runs on a guest thread.
+        if (static const bool bind_on_back = Common::PeSwitch("EDEN_UP_BIND_ON_BACK");
+            bind_on_back && VideoCommon::GpuSplit::Get().BackRunning()) {
+            to_init.rasterizer_pending = true;
+            return;
+        }
         renderer->ReadRasterizer()->InitializeChannel(to_init);
     }
 
