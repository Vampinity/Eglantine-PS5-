@@ -771,6 +771,20 @@ PipelineCache::PipelineCache(Tegra::MaxwellDeviceMemoryManager& device_memory_,
         .min_ssbo_alignment = device.GetStorageBufferAlignment(),
         .max_user_clip_distances = device.GetMaxUserClipDistances()
     };
+    // EDEN_GBB_POSITION_INVARIANT=1 / EDEN_GBB_NAN_GUARD=1 (exact "1", both off without it; GBB's
+    // patch 0915, the fix PS5_Lichii v1.20 ships as 0229, from notquiteog/Dragoon 395547c and
+    // NX2navi 0007 / 0027): positions are decorated Invariant, so a colour pass with depth EQUAL
+    // after a depth pre-pass computes the same depth, and float colour outputs are written
+    // without NaN or infinity, which otherwise spread through bloom. Both change the SPIR-V of
+    // nearly every shader: the names are in the prepared store's stamp (vk_pipeline_prep.cpp),
+    // so a flip starts that store empty and the shader set is converted again.
+    profile.invariant_position = Common::PeSwitch("EDEN_GBB_POSITION_INVARIANT");
+    profile.guard_frag_color_nan = Common::PeSwitch("EDEN_GBB_NAN_GUARD");
+    if (profile.invariant_position || profile.guard_frag_color_nan) {
+        LOG_INFO(Render_Vulkan, "EDEN_GBB: position invariant {}, colour NaN guard {}",
+                 profile.invariant_position ? "on" : "off",
+                 profile.guard_frag_color_nan ? "on" : "off");
+    }
 
     host_info = Shader::HostTranslateInfo{
         .min_ssbo_alignment = device.GetStorageBufferAlignment(),
