+        }
     }
     if (info.stores[IR::Attribute::PointSize] || runtime_info.fixed_state_point_size) {
         if (stage == Stage::Fragment) {
diff --git a/src/shader_recompiler/profile.h b/src/shader_recompiler/profile.h
index c3e95da..44a71bb 100644
--- a/src/shader_recompiler/profile.h
+++ b/src/shader_recompiler/profile.h
@@ -104,6 +104,13 @@ struct Profile {
     /// Some drivers have broken support for OpVectorExtractDynamic on subgroup mask inputs
     bool has_broken_spirv_subgroup_mask_vector_extract_dynamic{};
     bool has_broken_spirv_subgroup_shuffle{};
+    /// EDEN_GBB_POSITION_INVARIANT: gl_Position is decorated Invariant. A colour pass drawn again
+    /// with depth EQUAL after a depth pre-pass must compute the same depth, which AMD's compiler
+    /// only keeps with the decoration.
+    bool invariant_position{};
+    /// EDEN_GBB_NAN_GUARD: float colour outputs are written without NaN or infinity (NaN to 0,
+    /// the rest clamped to +-1e30). One NaN texel spreads through bloom and blur averages.
+    bool guard_frag_color_nan{};
     /// Subgroup shuffles in fragment shaders go through the broadcast fallback (Lichii PR 273:
     /// AMD's Windows driver; EDEN_NX2_AMD_PR273=1 tries it on RADV).
     bool has_broken_spirv_fragment_shuffle{};
