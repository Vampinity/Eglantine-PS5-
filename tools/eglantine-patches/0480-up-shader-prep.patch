+    std::atomic<size_t> probed{};
+    std::atomic<size_t> probe_differed{};
+    std::unordered_set<u64> todo;
+    std::array<size_t, 4> left_out{};
+    size_t struck = 0;
+    size_t own_left = 0;
+    size_t probes_queued = 0;
+    const auto scan_graphics = [&](bool own, bool mesh_file) {
+        return [&, own, mesh_file](std::ifstream& file, std::vector<FileEnvironment> envs) {
+            GraphicsPipelineCacheKey key;
+            file.read(reinterpret_cast<char*>(&key), sizeof(key));
+            const u64 hash = key.Hash();
+            if (stop_loading.stop_requested() || (own && !disk_pipelines.contains(hash))) {
+                return;
+            }
+            if (const u32 why_not = preparable(key, envs, mesh_file); why_not != 0) {
