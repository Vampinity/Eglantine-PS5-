+                return;
+            }
+            todo.insert(hash);
+        };
+    };
+    for (int attempt = 0; attempt < 2; ++attempt) {
+        todo.clear();
+        left_out = {};
+        struck = 0;
+        own_left = 0;
+        size_t own_seen = 0;
+        const bool whole = read_files([&](bool own, bool mesh_file) {
