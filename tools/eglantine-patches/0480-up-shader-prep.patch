     return it->second;
 }
 
+// EDEN_UP_SHADER_PREP (renderer_vulkan/vk_pipeline_prep.h): the answers a recorded environment
+// gave its translation, without the program's code, and the check that the game's state still
+// gives them. The check follows zortos293/Lichii#896's FileEnvironment::AnswersHoldFor
+// (zmckenney), for the questions this tree's translation asks, with one difference: upstream
+// takes a constant buffer word for a texture handle when its value is one the translation asked
+// a texture type for; here the caller names the handle words from the program's descriptors.
+namespace {
+constexpr u32 AnswersVersion = 1;
+
+template <typename T>
+void PutAnswer(std::vector<u8>& out, const T& value) {
+    static_assert(std::is_trivially_copyable_v<T>);
+    const auto* const bytes = reinterpret_cast<const u8*>(&value);
+    out.insert(out.end(), bytes, bytes + sizeof(T));
+}
+
+template <typename T>
+[[nodiscard]] bool GetAnswer(std::span<const u8>& in, T& value) {
+    static_assert(std::is_trivially_copyable_v<T>);
+    if (in.size() < sizeof(T)) {
+        return false;
+    }
+    std::memcpy(&value, in.data(), sizeof(T));
+    in = in.subspan(sizeof(T));
+    return true;
+}
+
+/// What translation uses of a sampled texture's pixel format (ir_opt/texture_pass.cpp): whether
+/// it is an integer format, and for buffer texel fetches on hosts without snorm render buffers
+/// which width of snorm it is.
+[[nodiscard]] u32 PixelFormatTraits(u32 format_word) {
+    using F = Shader::TexturePixelFormat;
+    const F format = static_cast<F>(format_word);
+    u32 snorm = 0;
+    switch (format) {
+    case F::A8B8G8R8_SNORM:
+    case F::R8G8_SNORM:
+    case F::R8_SNORM:
+        snorm = 1;
+        break;
+    case F::R16G16B16A16_SNORM:
+    case F::R16G16_SNORM:
+    case F::R16_SNORM:
+        snorm = 2;
+        break;
+    default:
+        break;
+    }
+    return (VideoCore::Surface::IsPixelFormatInteger(
+                static_cast<VideoCore::Surface::PixelFormat>(format))
+                ? 1U
+                : 0U) |
+           (snorm << 1);
+}
+
+template <typename Map>
+[[nodiscard]] std::vector<std::pair<u64, u32>> SortedAnswers(const Map& map) {
+    std::vector<std::pair<u64, u32>> sorted;
+    sorted.reserve(map.size());
+    for (const auto& [key, value] : map) {
+        sorted.emplace_back(static_cast<u64>(key), static_cast<u32>(value));
+    }
+    std::ranges::sort(sorted);
+    return sorted;
+}
+
+void PutAnswerMap(std::vector<u8>& out, const std::vector<std::pair<u64, u32>>& sorted) {
+    PutAnswer(out, static_cast<u32>(sorted.size()));
+    for (const auto& [key, value] : sorted) {
+        PutAnswer(out, key);
+        PutAnswer(out, value);
+    }
+}
+
+[[nodiscard]] bool GetAnswerMap(std::span<const u8>& in, std::vector<std::pair<u64, u32>>& map) {
+    u32 count{};
+    if (!GetAnswer(in, count) || count > in.size() / (sizeof(u64) + sizeof(u32))) {
+        return false;
+    }
+    map.resize(count);
+    for (auto& [key, value] : map) {
+        if (!GetAnswer(in, key) || !GetAnswer(in, value)) {
+            return false;
+        }
+    }
+    return true;
+}
+
+/// `sorted` is sorted by key.
+[[nodiscard]] const u32* FindAnswer(const std::vector<std::pair<u64, u32>>& sorted, u64 key) {
+    const auto it = std::ranges::lower_bound(sorted, key, {}, &std::pair<u64, u32>::first);
+    return it != sorted.end() && it->first == key ? &it->second : nullptr;
+}
+} // Anonymous namespace
+
+void FileEnvironment::SerializeAnswers(std::vector<u8>& out) const {
+    PutAnswer(out, AnswersVersion);
+    PutAnswer(out, static_cast<u32>(stage));
+    PutAnswer(out, start_address);
+    PutAnswer(out, local_memory_size);
+    PutAnswer(out, texture_bound);
+    PutAnswer(out, viewport_transform_state);
+    PutAnswer(out, static_cast<u32>(cbuf_replacements.empty() ? 0 : 1));
+    PutAnswer(out, static_cast<u32>(is_proprietary_driver ? 1 : 0));
+    PutAnswer(out, shared_memory_size);
+    PutAnswer(out, workgroup_size);
+    PutAnswer(out, sph);
+    PutAnswer(out, gp_passthrough_mask);
+    PutAnswer(out, mesh_registers);
+    PutAnswer(out, mesh_primitive_header);
+    PutAnswerMap(out, SortedAnswers(texture_types));
+    PutAnswerMap(out, SortedAnswers(texture_pixel_formats));
+    PutAnswerMap(out, SortedAnswers(cbuf_values));
+    PutAnswerMap(out, SortedAnswers(storage_pointer_types));
+}
+
+bool FileEnvironment::AnswersHoldFor(std::span<const u8> in, Shader::Environment& live,
+                                     std::span<const AnswerHandle> handles, const char** why) {
+    const auto fail = [why](const char* reason) {
+        if (why) {
+            *why = reason;
+        }
+        return false;
+    };
+    u32 version{}, stage_word{}, start{}, local{}, bound{}, viewport{}, hle{}, proprietary{};
+    u32 shared{};
+    std::array<u32, 3> workgroup{};
+    Shader::ProgramHeader header{};
+    std::array<u32, 8> passthrough{};
+    std::array<u32, 3> mesh{};
+    Shader::ProgramHeader mesh_header{};
+    std::vector<std::pair<u64, u32>> types, formats, values, pointers;
+    if (!GetAnswer(in, version) || version != AnswersVersion || !GetAnswer(in, stage_word) ||
+        !GetAnswer(in, start) || !GetAnswer(in, local) || !GetAnswer(in, bound) ||
+        !GetAnswer(in, viewport) || !GetAnswer(in, hle) || !GetAnswer(in, proprietary) ||
+        !GetAnswer(in, shared) || !GetAnswer(in, workgroup) || !GetAnswer(in, header) ||
+        !GetAnswer(in, passthrough) || !GetAnswer(in, mesh) || !GetAnswer(in, mesh_header) ||
+        !GetAnswerMap(in, types) || !GetAnswerMap(in, formats) || !GetAnswerMap(in, values) ||
+        !GetAnswerMap(in, pointers) || !in.empty()) {
+        return fail("answers unreadable");
+    }
+    const Shader::Stage recorded_stage = static_cast<Shader::Stage>(stage_word);
+    if (live.ShaderStage() != recorded_stage || live.StartAddress() != start ||
+        live.LocalMemorySize() != local || live.TextureBoundBuffer() != bound ||
+        live.IsProprietaryDriver() != (proprietary != 0) ||
+        std::memcmp(&live.SPH(), &header, sizeof(header)) != 0) {
+        return fail("program");
+    }
+    if (recorded_stage == Shader::Stage::Compute &&
+        (live.SharedMemorySize() != shared || live.WorkgroupSize() != workgroup)) {
+        return fail("program");
+    }
+    if (recorded_stage == Shader::Stage::Geometry && live.GpPassthroughMask() != passthrough) {
+        return fail("geometry passthrough");
+    }
+    if ((recorded_stage == Shader::Stage::Task || recorded_stage == Shader::Stage::Mesh) &&
+        (live.MeshRegisters() != mesh ||
+         std::memcmp(&live.MeshPrimitiveHeader(), &mesh_header, sizeof(mesh_header)) != 0)) {
+        return fail("mesh state");
+    }
+    // Only a vertex program asks (ir_opt/position_pass.cpp).
+    if (recorded_stage == Shader::Stage::VertexB &&
+        live.ReadViewportTransformState() != viewport) {
+        return fail("viewport transform");
+    }
+    // HLE replacements are asked for every constant buffer read when there are any, and only
+    // the ones that were found are recorded.
+    if (hle != 0 || live.HasHLEMacroState()) {
+        return fail("HLE constant replacements");
+    }
+    // The words the program's descriptors read their texture handles from. Only these may hold
+    // another value now: which word is a handle is told by where it is, never by what it holds
+    // (a folded constant can hold the same number as a handle).
+    std::vector<u64> handle_words;
+    std::vector<u32> handles_asked;
+    for (const AnswerHandle& handle : handles) {
+        if (handle.shift_left >= 32 || handle.secondary_shift_left >= 32) {
+            return fail("texture handle");
+        }
+        const u64 first = MakeCbufKey(handle.index, handle.offset);
+        const u64 second = handle.has_secondary
+                               ? MakeCbufKey(handle.secondary_index, handle.secondary_offset)
+                               : first;
+        const u32* const recorded_first = FindAnswer(values, first);
+        const u32* const recorded_second = FindAnswer(values, second);
+        if (recorded_first == nullptr || recorded_second == nullptr) {
+            // The translation did not read this descriptor's handle: nothing to hold it to.
+            return fail("texture handle");
+        }
+        handle_words.push_back(first);
+        handle_words.push_back(second);
+        // As ir_opt/texture_pass.cpp makes a handle of its words.
+        const u32 recorded = (*recorded_first << handle.shift_left) |
+                             (*recorded_second << handle.secondary_shift_left);
+        const u32 live_first = live.ReadCbufValue(handle.index, handle.offset);
+        const u32 live_second =
+            handle.has_secondary
+                ? live.ReadCbufValue(handle.secondary_index, handle.secondary_offset)
+                : live_first;
+        const u32 now = (live_first << handle.shift_left) |
+                        (live_second << handle.secondary_shift_left);
+        // Asked of `live` even when it is the same handle, so `live` holds the answers its own
+        // translation would have asked for (they go to the disk cache with a new pipeline).
+        if (const u32* const type = FindAnswer(types, recorded);
+            type != nullptr && static_cast<u32>(live.ReadTextureType(now)) != *type) {
+            return fail("texture type");
+        }
+        if (const u32* const format = FindAnswer(formats, recorded);
+            format != nullptr &&
+            PixelFormatTraits(static_cast<u32>(live.ReadTexturePixelFormat(now))) !=
+                PixelFormatTraits(*format)) {
+            return fail("texture pixel format");
+        }
+        handles_asked.push_back(recorded);
+    }
+    std::ranges::sort(handle_words);
+    const auto is_pointer_word = [&pointers](u64 key) {
+        const u32 offset = static_cast<u32>(key);
+        return FindAnswer(pointers, key) != nullptr ||
+               (offset >= 4 && FindAnswer(pointers, key - 4) != nullptr);
+    };
+    for (const auto& [key, value] : values) {
+        if (std::ranges::binary_search(handle_words, key)) {
+            continue;
+        }
+        const u32 index = static_cast<u32>(key >> 32);
+        const u32 offset = static_cast<u32>(key);
+        if (live.ReadCbufValue(index, offset) != value && !is_pointer_word(key)) {
+            return fail("constant buffer value");
+        }
+    }
+    const auto asked = [&handles_asked](u32 handle) {
+        return std::ranges::find(handles_asked, handle) != handles_asked.end();
+    };
+    // Handles no descriptor's words gave (computed per draw, or read some other way): the
+    // words they came from were compared above, so they are asked as they are.
+    for (const auto& [handle, type] : types) {
+        const u32 raw = static_cast<u32>(handle);
+        if (!asked(raw) && static_cast<u32>(live.ReadTextureType(raw)) != type) {
+            return fail("texture type");
+        }
+    }
+    for (const auto& [handle, format] : formats) {
+        const u32 raw = static_cast<u32>(handle);
+        if (!asked(raw) &&
+            PixelFormatTraits(static_cast<u32>(live.ReadTexturePixelFormat(raw))) !=
+                PixelFormatTraits(format)) {
+            return fail("texture pixel format");
+        }
+    }
+    for (const auto& [key, mapped] : pointers) {
+        const bool table = (key >> 63) != 0;
+        const u32 index = static_cast<u32>((key >> 32) & (table ? 0xffU : 0xffffffffU));
+        const u32 offset = static_cast<u32>(key);
+        const bool live_mapped =
+            table ? live.IsCbufIndirectStorageBufferPointer(
+                        index, offset, static_cast<u32>((key >> 40) & 0x3fffff))
+                  : live.IsCbufStorageBufferPointer(index, offset);
+        if (live_mapped != (mapped != 0)) {
+            return fail("storage buffer pointer");
+        }
+    }
+    return true;
+}
+
+bool ReadPipelines(
+    const std::filesystem::path& filename, u32 expected_cache_version,
+    const std::function<void(std::ifstream&, FileEnvironment)>& on_compute,
+    const std::function<void(std::ifstream&, std::vector<FileEnvironment>)>& on_graphics,
+    bool with_mesh_state) {
+    // A pipeline has at most this many shaders.
+    constexpr u32 MostShaders = 6;
+    try {
+        std::ifstream file(filename, std::ios::binary | std::ios::ate);
+        if (!file.is_open()) {
+            return true;
+        }
+        file.exceptions(std::ifstream::failbit);
+        const std::streamoff end{file.tellg()};
+        file.seekg(0, std::ios::beg);
+        std::array<char, 8> magic_number{};
+        u32 cache_version{};
+        file.read(magic_number.data(), magic_number.size())
+            .read(reinterpret_cast<char*>(&cache_version), sizeof(cache_version));
+        if (magic_number != MAGIC_NUMBER || cache_version != expected_cache_version) {
+            return true; // another version's file: nothing of this build's to read
+        }
+        std::streamoff at{file.tellg()};
+        while (at != end) {
+            u32 num_envs{};
+            file.read(reinterpret_cast<char*>(&num_envs), sizeof(num_envs));
+            if (num_envs == 0 || num_envs > MostShaders) {
+                return false;
+            }
+            std::vector<FileEnvironment> envs(num_envs);
+            for (FileEnvironment& env : envs) {
+                // An environment begins with six counts; none can exceed what is left.
+                const std::streamoff start{file.tellg()};
+                std::array<u64, 6> sizes{};
+                file.read(reinterpret_cast<char*>(sizes.data()), sizeof(sizes));
+                for (const u64 size : sizes) {
+                    if (size > static_cast<u64>(end - start)) {
+                        return false;
+                    }
+                }
+                file.seekg(start);
+                env.Deserialize(file, with_mesh_state);
+            }
+            if (envs.front().ShaderStage() == Shader::Stage::Compute) {
+                on_compute(file, std::move(envs.front()));
+            } else {
+                on_graphics(file, std::move(envs));
+            }
+            at = file.tellg();
+        }
+        return true;
+    } catch (const std::exception&) {
+        // A read past the end, no memory, or whatever a callback threw: the reading stops here
+        // and the file stays as it is.
+        return false;
+    }
+}
