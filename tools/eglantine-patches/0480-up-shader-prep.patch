+bool KeptStore::IsPredicted(u64 key_hash) const {
+    std::scoped_lock lock{mutex};
+    const auto it = records.find(key_hash);
+    return it != records.end() && (it->second.flags & FlagPredicted) != 0;
+}
+
+void KeptStore::AddNotKeepable(u64 key_hash) {
+    std::scoped_lock lock{mutex};
+    if (!open || records.contains(key_hash)) {
+        return;
+    }
+    Record record;
+    record.flags = FlagNotKeepable;
+    records.emplace(key_hash, record);
+    ++uncommitted;
+}
+
+bool KeptStore::Find(u64 key_hash, Record& record) const {
+    std::scoped_lock lock{mutex};
+    const auto it = records.find(key_hash);
+    if (it == records.end()) {
+        return false;
+    }
+    record = it->second;
+    return true;
+}
+
+bool KeptStore::Read(u32 id, std::vector<u8>& out) {
+    std::scoped_lock lock{mutex};
+    if (!open || id >= blobs.size()) {
+        return false;
+    }
+    const Blob blob = blobs[id];
+    try {
+        if (uncommitted != 0) {
+            data.flush();
+        }
+        if (!reader.is_open()) {
+            reader.open(data_path, std::ios::binary);
+        }
+        reader.clear();
+        reader.seekg(static_cast<std::streamoff>(blob.offset));
+        std::vector<u8> stored(blob.size);
+        if (!reader.read(reinterpret_cast<char*>(stored.data()),
+                         static_cast<std::streamsize>(stored.size()))) {
+            reader.close();
+            return false;
+        }
+        if (blob.kind == KindSpirv) {
+            auto words = Common::Compression::TryDecompressDataZSTD(stored, blob.raw_size);
+            if (!words || words->size() != blob.raw_size || words->size() % sizeof(u32) != 0) {
+                return false;
+            }
+            out = std::move(*words);
+        } else {
+            out = std::move(stored);
+        }
+    } catch (const std::exception&) {
+        return false;
+    }
+    return HashBytes(out) == blob.hash;
+}
+
+bool KeptStore::SameSpirv(u64 key_hash, const Stages& stages) const {
+    std::scoped_lock lock{mutex};
+    const auto it = records.find(key_hash);
+    if (it == records.end() || (it->second.flags & FlagNotKeepable) != 0) {
+        return false;
+    }
+    for (size_t stage = 0; stage < NumStages; ++stage) {
+        const u32 id = it->second.spirv[stage];
+        if ((id != NoBlob) != stages.present[stage]) {
+            return false;
+        }
+        if (id == NoBlob) {
+            continue;
+        }
+        const Blob& blob = blobs[id];
+        if (blob.raw_size != stages.spirv[stage].size() * sizeof(u32) ||
+            blob.hash != HashSpirv(stages.spirv[stage])) {
+            return false;
+        }
+    }
+    return true;
+}
+
+u32 KeptStore::Keep(u32 kind, u64 hash, std::span<const u8> bytes, u32 raw_size) {
+    const u64 key = hash + u64{raw_size} * 0x9E3779B97F4A7C15ULL;
+    if (const auto it = by_hash[kind].find(key); it != by_hash[kind].end()) {
+        return it->second;
+    }
+    if (!data.write(reinterpret_cast<const char*>(bytes.data()),
+                    static_cast<std::streamsize>(bytes.size()))) {
+        // The disk is full or gone: nothing more is kept this session; what the index lists stays.
+        open = false;
+        LOG_WARNING(Render_Vulkan, "Shader preparation: write to {} failed, keeping stops",
+                    Common::FS::PathToUTF8String(data_path));
+        return NoBlob;
+    }
+    const u32 id = static_cast<u32>(blobs.size());
+    blobs.push_back(Blob{.offset = data_end,
+                         .hash = hash,
+                         .size = static_cast<u32>(bytes.size()),
+                         .raw_size = raw_size,
+                         .kind = kind});
+    data_end += bytes.size();
+    by_hash[kind].emplace(key, id);
+    return id;
+}
+
+void KeptStore::Add(u64 key_hash, const Stages& stages, std::span<const std::vector<u8>> answers,
+                    u32 flags) {
+    if (stages.unsuitable || answers.empty() || answers.size() > NumStages) {
+        return;
+    }
+    // Serialized and compressed outside the lock: the workers add in parallel.
+    std::array<std::vector<u8>, NumStages> infos;
+    std::array<std::vector<u8>, NumStages> packed;
+    std::array<u64, NumStages> info_hash{};
+    std::array<u64, NumStages> spirv_hash{};
+    bool any = false;
+    for (size_t stage = 0; stage < NumStages; ++stage) {
+        if (!stages.present[stage]) {
+            continue;
+        }
+        const auto& words = stages.spirv[stage];
+        if (words.empty() || words.size() > (u64{1} << 28)) {
+            return;
+        }
+        SerializeInfo(stages.infos[stage], infos[stage]);
+        info_hash[stage] = HashBytes(infos[stage]);
+        spirv_hash[stage] = HashSpirv(words);
+        packed[stage] = Common::Compression::CompressDataZSTD(
+            reinterpret_cast<const u8*>(words.data()), words.size() * sizeof(u32), 3);
+        if (packed[stage].empty()) {
+            return;
+        }
+        any = true;
+    }
+    if (!any) {
+        return;
+    }
+    std::scoped_lock lock{mutex};
+    if (!open || records.contains(key_hash)) {
+        return;
+    }
+    EnsureDedupe();
+    Record record;
+    record.flags = flags & ~FlagNotKeepable;
+    record.env_count = static_cast<u32>(answers.size());
+    for (size_t stage = 0; stage < NumStages; ++stage) {
+        if (!stages.present[stage]) {
+            continue;
+        }
+        record.infos[stage] = Keep(KindInfo, info_hash[stage], infos[stage],
+                                   static_cast<u32>(infos[stage].size()));
+        record.spirv[stage] =
+            Keep(KindSpirv, spirv_hash[stage], packed[stage],
+                 static_cast<u32>(stages.spirv[stage].size() * sizeof(u32)));
+        if (record.infos[stage] == NoBlob || record.spirv[stage] == NoBlob) {
+            return;
+        }
+    }
+    for (size_t i = 0; i < answers.size(); ++i) {
+        record.answers[i] = Keep(KindAnswers, HashBytes(answers[i]), answers[i],
+                                 static_cast<u32>(answers[i].size()));
+        if (record.answers[i] == NoBlob) {
+            return;
+        }
+    }
+    records.emplace(key_hash, record);
+    ++uncommitted;
+}
+
+void KeptStore::Forget(u64 key_hash) {
+    std::scoped_lock lock{mutex};
+    records.erase(key_hash);
+}
+
+bool KeptStore::Commit() {
+    std::scoped_lock lock{mutex};
+    if (!open) {
+        return false;
+    }
+    if (!data.flush()) {
+        open = false;
+        return false;
+    }
+    std::vector<u8> out;
+    out.reserve(64 + stamp.size() + blobs.size() * 32 + records.size() * 76);
+    out.insert(out.end(), IndexMagic.begin(), IndexMagic.end());
+    Put(out, FormatVersion);
+    Put(out, static_cast<u32>(stamp.size()));
+    out.insert(out.end(), stamp.begin(), stamp.end());
+    Put(out, data_end);
+    Put(out, static_cast<u32>(records.size()));
+    Put(out, static_cast<u32>(blobs.size()));
+    for (const Blob& blob : blobs) {
+        Put(out, blob.offset);
+        Put(out, blob.hash);
+        Put(out, blob.size);
+        Put(out, blob.raw_size);
+        Put(out, blob.kind);
+        Put(out, u32{0});
+    }
+    for (const auto& [key_hash, record] : records) {
+        Put(out, key_hash);
+        Put(out, record.env_count);
+        Put(out, record.flags);
+        Put(out, record.infos);
+        Put(out, record.spirv);
+        Put(out, record.answers);
+    }
+    Put(out, HashBytes(out));
+    if (!WriteWholeFile(index_path, out)) {
+        LOG_WARNING(Render_Vulkan, "Shader preparation: cannot write {}",
+                    Common::FS::PathToUTF8String(index_path));
+        return false;
+    }
+    uncommitted = 0;
+    return true;
+}
+
+void KeptStore::Reset() {
+    std::scoped_lock lock{mutex};
+    data.close();
+    data.clear();
+    reader.close();
+    reader.clear();
+    open = false;
+    if (!StartEmpty()) {
+        return;
+    }
+    {
+        auto strikes = data_path;
+        strikes.replace_extension(".strikes");
+        std::error_code error;
+        std::filesystem::remove(strikes, error);
+    }
+    data.open(data_path, std::ios::binary | std::ios::app);
+    open = static_cast<bool>(data);
+}
+
+} // namespace Vulkan::ShaderPrep
diff --git a/src/video_core/renderer_vulkan/vk_pipeline_prep.h b/src/video_core/renderer_vulkan/vk_pipeline_prep.h
new file mode 100644
index 0000000..32f700b
--- /dev/null
+++ b/src/video_core/renderer_vulkan/vk_pipeline_prep.h
@@ -0,0 +1,187 @@
+// SPDX-FileCopyrightText: Copyright 2026 Eden Emulator Project
+// SPDX-License-Identifier: GPL-3.0-or-later
+
+// EDEN_UP_SHADER_PREP=1 (default off): shaders are prepared before play.
+//
+// The idea is Fritchii v5's "Preparing shaders" screen, built on zortos293/Lichii#895 (precompile
+// before play, zmckenney) and #896 (draw precompiled pipelines without translating them on the
+// GPU thread, zmckenney). On the PS5 the costly part of a pipeline's first use is not the driver:
+// RADV keeps what it compiled in its disk cache, and a pipeline it has seen builds in 2-3 ms on a
+// worker. It is the translation of the game's shaders to SPIR-V, which runs on the GPU thread
+// (8-18 ms a pipeline, up to 280 ms for a mesh pipeline) every time a pipeline this session has
+// not built is drawn: 255 of the 408 pipeline builds in an 8 minute play session were pipelines
+// the console had drawn before and that had aged out of the list built at boot.
+//
+// So, at boot, every graphics pipeline record of this console's own disk cache (vulkan.bin,
+// vulkan_mesh.bin, and prep_predicted.bin when a later step has made one from the game's files) is
+// translated once on the pipeline workers, built once so RADV's disk cache holds it, and dropped;
+// its SPIR-V, its shader infos and the answers its translation got from the game's state are kept
+// in a file beside the cache. When a draw later needs such a pipeline, the GPU thread checks that
+// the game's state still gives those answers (FileEnvironment answers, shader_environment.h) and
+// creates the pipeline from the kept SPIR-V and infos instead of translating. Anything that does
+// not hold, cannot be read or looks damaged falls back to the translation there was before.
+//
+// Nothing is shared between consoles: every byte comes from this console's own cache files, which
+// come from this player's own game.
+
+#pragma once
+
+#include <array>
+#include <filesystem>
+#include <fstream>
+#include <mutex>
+#include <span>
+#include <string>
+#include <unordered_map>
+#include <vector>
+
+#include "common/common_types.h"
+#include "shader_recompiler/shader_info.h"
+
+namespace Vulkan::ShaderPrep {
+
+/// Pipeline stages of a graphics pipeline (vertex B to fragment).
+inline constexpr size_t NumStages = 5;
+inline constexpr u32 NoBlob = ~0U;
+
+/// EDEN_UP_SHADER_PREP=1.
+[[nodiscard]] bool Enabled();
+/// EDEN_UP_SHADER_PREP_FAST=0: prepared, but draws translate as before (the control arm).
+[[nodiscard]] bool FastPath();
+/// EDEN_UP_SHADER_PREP_VERIFY=1: a pipeline made from kept SPIR-V is also translated from the
+/// game's state on the GPU thread and compared (slow; a first test, not play).
+[[nodiscard]] bool Verify();
+/// EDEN_UP_SHADER_PREP_LOG=<n>: a progress line every n pipelines while preparing (256).
+[[nodiscard]] u32 LogEvery();
+/// EDEN_UP_SHADER_PREP_MAX=<n>: at most n pipelines are prepared per boot (5000; the rest at
+/// later boots).
+[[nodiscard]] size_t MaxPerBoot();
+
+/// What one translation of a graphics pipeline gave.
+struct Stages {
+    std::array<bool, NumStages> present{};
+    std::array<std::vector<u32>, NumStages> spirv;
+    std::array<Shader::Info, NumStages> infos;
+    /// Its mesh programs run as compute in the emulator, or a stage needs layer emulation: more
+    /// than SPIR-V and infos makes this pipeline, so it is not kept.
+    bool unsuitable{};
+    /// In: build with the driver's own cache only, not the emulator's VkPipelineCache (every
+    /// pipeline that is only being prepared: no draw has asked for it yet).
+    bool driver_cache_only{};
+};
+
+/// Every field of Shader::Info, in a fixed order.
+void SerializeInfo(const Shader::Info& info, std::vector<u8>& out);
+/// False when `in` is not a whole info.
+[[nodiscard]] bool DeserializeInfo(std::span<const u8> in, Shader::Info& info);
+
+/// CityHash64 of SPIR-V words.
+[[nodiscard]] u64 HashSpirv(std::span<const u32> words);
+
+/// What the kept translations depend on besides the records themselves: the cache version, the
+/// driver, the layout of Shader::Info, the installed build (its eboot's size and write time), the
+/// settings the translation reads (resolution scaling, bloom fix, loop safety checks, renderer
+/// debug) and every EDEN_ switch the translation sources and the video core name. Another stamp is
+/// another store (the last three are kept, so test arms do not wipe each other's).
+[[nodiscard]] std::string MakeStamp(u32 cache_version, u32 driver_id, u32 driver_version);
+
+/// The kept translations of one stamp: prep_<stamp hash>.bin holds the blobs, back to back, and is
+/// only ever appended to; prep_<stamp hash>.idx lists the blobs and the pipelines and is written
+/// whole beside itself and renamed, so a kill at any moment leaves the last complete index and at
+/// worst some unlisted bytes at the end of the blob file, which the next start cuts off.
+class KeptStore {
+public:
+    /// Record::flags. Not keepable: the record was tried and cannot be kept (it has no blobs);
+    /// it is remembered so no later start translates it again for nothing.
+    static constexpr u32 FlagNotKeepable = 1;
+    /// From prep_predicted.bin: its answers were guessed, not recorded from a draw.
+    static constexpr u32 FlagPredicted = 2;
+
+    struct Record {
+        std::array<u32, NumStages> infos{NoBlob, NoBlob, NoBlob, NoBlob, NoBlob};
+        std::array<u32, NumStages> spirv{NoBlob, NoBlob, NoBlob, NoBlob, NoBlob};
+        /// Per shader environment of the record, in program order.
+        std::array<u32, NumStages> answers{NoBlob, NoBlob, NoBlob, NoBlob, NoBlob};
+        u32 env_count{};
+        u32 flags{};
+    };
+
+    /// Opens the store of `stamp` in `dir`, or starts an empty one. False: no store this session.
+    bool Open(const std::filesystem::path& dir, const std::string& stamp);
+
+    [[nodiscard]] bool IsOpen() const noexcept {
+        return open;
+    }
+    [[nodiscard]] size_t Size() const;
+    [[nodiscard]] u64 DataBytes() const;
+    /// Known: kept, or remembered as not keepable.
+    [[nodiscard]] bool Contains(u64 key_hash) const;
+    /// Kept with its SPIR-V, infos and answers.
+    [[nodiscard]] bool IsKept(u64 key_hash) const;
+    [[nodiscard]] bool IsPredicted(u64 key_hash) const;
+    [[nodiscard]] bool Find(u64 key_hash, Record& record) const;
+
+    /// One blob, checked against its hash. SPIR-V comes back as its words' bytes.
+    [[nodiscard]] bool Read(u32 blob, std::vector<u8>& out);
+
+    /// Whether the kept SPIR-V of `key_hash` is `stages`' (false also when it is not kept).
+    [[nodiscard]] bool SameSpirv(u64 key_hash, const Stages& stages) const;
+
+    /// Keeps a pipeline. `answers`: one blob per shader environment, in program order.
+    void Add(u64 key_hash, const Stages& stages, std::span<const std::vector<u8>> answers,
+             u32 flags = 0);
+
+    /// Remembers that this record cannot be kept.
+    void AddNotKeepable(u64 key_hash);
+
+    /// Drops a record (its blobs stay in the file); the next Commit writes the index without it.
+    void Forget(u64 key_hash);
+
+    /// The preparation is over: frees what only adding needs.
+    void Compact();
+
+    /// Writes the index. Returns false when it could not be written (the old one stays).
+    bool Commit();
+
+    /// Drops everything kept: the translation changed under the stamp.
+    void Reset();
+
+    /// Pipelines added since the last Commit.
+    [[nodiscard]] size_t Uncommitted() const;
+
+    /// A file beside this stamp's store (prep_<stamp hash><extension>), removed with it.
+    [[nodiscard]] std::filesystem::path Sidecar(const char* extension) const;
+
+private:
+    struct Blob {
+        u64 offset{};
+        u64 hash{};
+        u32 size{};
+        u32 raw_size{};
+        u32 kind{};
+    };
+    enum : u32 { KindInfo = 0, KindSpirv = 1, KindAnswers = 2, KindCount = 3 };
+
+    [[nodiscard]] u32 Keep(u32 kind, u64 hash, std::span<const u8> bytes, u32 raw_size);
+    void EnsureDedupe();
+    [[nodiscard]] bool StartEmpty();
+    [[nodiscard]] bool LoadIndex();
+    [[nodiscard]] std::string Header() const;
+
+    mutable std::mutex mutex;
+    bool open{};
+    std::string stamp;
+    std::filesystem::path data_path;
+    std::filesystem::path index_path;
+    std::ofstream data;
+    std::ifstream reader;
+    u64 data_end{};
+    size_t uncommitted{};
+    std::vector<Blob> blobs;
+    /// Blob by content hash, per kind: filled when the first pipeline is added, freed by Compact.
+    std::array<std::unordered_map<u64, u32>, KindCount> by_hash;
+    bool dedupe_ready{};
+    std::unordered_map<u64, Record> records;
+};
+
+} // namespace Vulkan::ShaderPrep
