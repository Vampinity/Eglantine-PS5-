+// EDEN_UP_SHADER_PREP (vk_pipeline_prep.h): shaders prepared before play.
+
+void PipelineCache::KeepPrepared(const GraphicsPipelineCacheKey& key,
+                                 const ShaderPrep::Stages& stages,
+                                 std::span<const VideoCommon::FileEnvironment> envs, u32 flags) {
+    if (stages.unsuitable || envs.empty() || envs.size() > ShaderPrep::NumStages) {
+        return;
+    }
+    std::vector<std::vector<u8>> answers(envs.size());
+    for (size_t i = 0; i < envs.size(); ++i) {
+        envs[i].SerializeAnswers(answers[i]);
+    }
+    prep_store.Add(key.Hash(), stages, answers, flags);
+}
+
+void PipelineCache::NotePrepared(const GraphicsPipelineCacheKey& key,
+                                 const ShaderPrep::Stages& stages,
+                                 std::span<const VideoCommon::FileEnvironment> envs,
+                                 std::atomic<size_t>& compared,
+                                 std::atomic<size_t>& differed) noexcept try {
+    const u64 hash = key.Hash();
+    if (stages.unsuitable) {
+        // More than SPIR-V and infos makes it: remembered, so no later start tries again.
+        prep_store.AddNotKeepable(hash);
+        return;
+    }
+    if (!prep_store.Contains(hash)) {
+        KeepPrepared(key, stages, envs, 0);
+        return;
+    }
+    if (!prep_store.IsKept(hash)) {
+        return;
+    }
+    // Kept by an earlier start: this start translated the same record again, so the two must be
+    // the same SPIR-V. They are not when the translation changed without the stamp noticing.
+    if (prep_store.SameSpirv(hash, stages)) {
+        compared.fetch_add(1, std::memory_order_relaxed);
+        return;
+    }
+    if (prep_store.IsPredicted(hash)) {
+        // Kept from a predicted record, with guessed answers; this is the game's own record of
+        // the same key, which the boot builds and draws with. It takes the predicted one's place.
+        prep_store.Forget(hash);
+        KeepPrepared(key, stages, envs, 0);
+        return;
+    }
+    compared.fetch_add(1, std::memory_order_relaxed);
+    differed.fetch_add(1, std::memory_order_relaxed);
+} catch (const std::exception&) {
+    // No memory to keep this one: the boot goes on, a later start keeps it.
+}
+
+void PipelineCache::PrepareKept(std::stop_token stop_loading,
+                                const VideoCore::DiskResourceLoadCallback& callback,
+                                size_t compared, size_t differed) {
+    const auto begin = std::chrono::steady_clock::now();
+    const auto seconds_since = [](std::chrono::steady_clock::time_point since) {
+        return std::chrono::duration<double>(std::chrono::steady_clock::now() - since).count();
+    };
+    if (differed != 0) {
+        LOG_WARNING(Render_Vulkan,
+                    "Shader preparation: {} of {} pipelines built at boot translate differently "
+                    "from the kept ones; the translation changed, everything is prepared again",
+                    differed, compared);
+        prep_store.Reset();
+    }
+    if (!prep_store.IsOpen()) {
+        return;
+    }
+    const auto predicted_filename = pipeline_cache_filename.parent_path() / "prep_predicted.bin";
+    // Beside this stamp's store, and removed with it: another build starts without strikes.
+    const auto journal_filename = prep_store.Sidecar(".inflight");
+    const auto strikes_filename = prep_store.Sidecar(".strikes");
+    const size_t max_in_flight = std::max<size_t>(GetTotalPipelineWorkers() * 2, 8);
+
+    // A pipeline whose build took the app down twice is left to the draw that needs it. The
+    // journal holds the key hashes being built; what it still holds at the next start was in
+    // flight when the app ended (a crash, or the PS menu's close: those count too, so a record
+    // can be struck out without fault; it then only builds as it did before).
+    std::unordered_map<u64, u32> strikes;
+    {
+        std::ifstream file{strikes_filename};
+        u64 hash{};
+        u32 count{};
+        while (file >> std::hex >> hash >> std::dec >> count) {
+            strikes.emplace(hash, count);
+        }
+    }
+    {
+        std::ifstream file{journal_filename, std::ios::binary};
+        u64 hash{};
+        bool added = false;
+        while (file.read(reinterpret_cast<char*>(&hash), sizeof(hash))) {
+            if (hash != 0) {
+                ++strikes[hash];
+                added = true;
+            }
+        }
+        if (added) {
+            std::ofstream out{strikes_filename, std::ios::trunc};
+            for (const auto& [struck, count] : strikes) {
+                out << std::hex << struck << ' ' << std::dec << count << '\n';
+            }
+        }
+    }
+    const auto struck_out = [&strikes](u64 hash) {
+        const auto it = strikes.find(hash);
+        return it != strikes.end() && it->second >= 2;
+    };
+
+    struct {
+        std::mutex mutex;
+        std::condition_variable cv;
+        size_t in_flight{};
+        size_t finished{};
+        size_t failed{};
+        size_t total{};
+        std::vector<u32> free_slots;
+        std::fstream journal;
+    } state;
+    {
+        // Created with every slot zero, then opened to write single slots.
+        std::ofstream create{journal_filename, std::ios::binary | std::ios::trunc};
+        const std::vector<char> zeros(max_in_flight * sizeof(u64), 0);
+        create.write(zeros.data(), static_cast<std::streamsize>(zeros.size()));
+    }
+    state.journal.open(journal_filename, std::ios::binary | std::ios::in | std::ios::out);
+    state.free_slots.reserve(max_in_flight);
+    for (u32 slot = 0; slot < max_in_flight; ++slot) {
+        state.free_slots.push_back(slot);
+    }
+    // Under state.mutex.
+    const auto note_slot = [&state](u32 slot, u64 hash) noexcept {
+        try {
+            if (!state.journal.is_open()) {
+                return;
+            }
+            state.journal.clear();
+            state.journal.seekp(static_cast<std::streamoff>(slot * sizeof(u64)));
+            state.journal.write(reinterpret_cast<const char*>(&hash), sizeof(hash));
+            state.journal.flush();
+        } catch (const std::exception&) {
+        }
+    };
+    const auto wait_for_jobs = [&state] {
+        // Every job holds references to what is on this stack: all of them end first.
+        std::unique_lock lock{state.mutex};
+        state.cv.wait(lock, [&] { return state.in_flight == 0; });
+    };
+
+    // Which records can be prepared at all. Task and mesh records are only whole in the mesh file
+    // (the other one does not carry their mesh state); a key made for another driver version or
+    // drawn inside an HLE macro is never asked for again, or always refused when it is.
+    // Returns 0 when it can, else why not: 1 its stages, 2 another driver, 3 an HLE macro.
+    const auto preparable = [this](const GraphicsPipelineCacheKey& key,
+                                   const std::vector<FileEnvironment>& envs,
+                                   bool mesh_file) -> u32 {
+        if (envs.empty() || envs.size() > ShaderPrep::NumStages || key.unique_hashes[0] != 0) {
+            return 1;
+        }
+        if (key.state.driver_id != dynamic_features.driver_id ||
+            key.state.driver_version != dynamic_features.driver_version) {
+            return 2;
+        }
+        if (key.state.app_stage.Value() == Tegra::Engines::Maxwell3D::EngineHint::OnHLEMacro) {
+            return 3;
+        }
+        const bool mesh = std::ranges::any_of(envs, [](const FileEnvironment& env) {
+            return env.ShaderStage() == Shader::Stage::Task ||
+                   env.ShaderStage() == Shader::Stage::Mesh;
+        });
+        return mesh && !mesh_file ? 1 : 0;
+    };
+    // The files are read with a reader of our own: the boot's reader cuts a file back when
+    // anything in its loop runs out of memory, and these passes would be two more chances.
+    const auto read_files = [&](const auto& graphics_for) {
+        const auto skip_compute = [](std::ifstream& file, FileEnvironment) {
+            ComputePipelineCacheKey key;
+            file.read(reinterpret_cast<char*>(&key), sizeof(key));
+        };
+        bool whole = VideoCommon::ReadPipelines(pipeline_cache_filename, CACHE_VERSION,
+                                                skip_compute, graphics_for(true, false), false);
+        if (device.IsExtMeshShaderSupported()) {
+            whole &= VideoCommon::ReadPipelines(mesh_pipeline_cache_filename, CACHE_VERSION,
