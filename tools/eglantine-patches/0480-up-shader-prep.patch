+                    }
+                    state.free_slots.push_back(slot); // room reserved: cannot throw
+                    note_slot(slot, 0);
+                    try {
+                        if (state.finished % 16 == 0 || state.finished == state.total) {
+                            callback(VideoCore::LoadCallbackStage::Build, state.finished,
+                                     state.total);
+                        }
+                        if (state.finished % ShaderPrep::LogEvery() == 0) {
+                            const double seconds = std::chrono::duration<double>(
+                                                       std::chrono::steady_clock::now() - begin)
+                                                       .count();
+                            LOG_INFO(Render_Vulkan,
+                                     "Shader preparation: {} of {} pipelines, {:.1f} s, {} failed, "
+                                     "about {:.0f} s left",
+                                     state.finished, state.total, seconds, state.failed,
+                                     seconds / static_cast<double>(state.finished) *
+                                         static_cast<double>(state.total - state.finished));
+                        }
+                    } catch (const std::exception&) {
+                    }
+                    state.cv.notify_all();
+                });
+            } catch (...) {
+                std::scoped_lock lock{state.mutex};
+                --state.in_flight;
+                state.free_slots.push_back(slot);
+                note_slot(slot, 0);
+                state.cv.notify_all();
+                throw;
+            }
+        };
+    };
+    const bool whole = read_files(build_graphics);
+    wait_for_jobs();
+    {
+        std::scoped_lock lock{state.mutex};
+        state.journal.close();
+    }
+    const bool committed = prep_store.Commit();
+    prep_store.Compact();
+    std::error_code error;
+    std::filesystem::remove(journal_filename, error);
+    LOG_INFO(Render_Vulkan,
+             "Shader preparation: {} pipelines prepared in {:.1f} s ({} failed, {} left for the "
+             "next start); {} kept in {} MiB{}{}",
+             state.finished, seconds_since(begin), state.failed, left - std::min(left, queued),
+             prep_store.Size(), prep_store.DataBytes() >> 20,
+             committed ? "" : "; the index was NOT written",
+             whole ? "" : "; a cache file could not be read to its end");
+}
+
+std::unique_ptr<GraphicsPipeline> PipelineCache::CreateKeptGraphicsPipeline(
+    GraphicsEnvironments& environments) {
+    if (!prep_store.IsOpen() || !ShaderPrep::FastPath()) {
+        return nullptr;
+    }
+    const u64 hash = graphics_key.Hash();
+    ShaderPrep::KeptStore::Record record;
+    if (prep_rejected.contains(hash) || !prep_store.Find(hash, record) ||
+        (record.flags & ShaderPrep::KeptStore::FlagNotKeepable) != 0) {
+        return nullptr;
+    }
+    // GPU thread only: what the kept translations did since the last report.
+    static u32 used{}, refused{}, audit_same{}, audit_differ{}, redone{};
+    static std::chrono::steady_clock::duration spent{};
+    static std::map<std::string, u32> reasons;
+    static auto window = std::chrono::steady_clock::now();
+    const auto begin = std::chrono::steady_clock::now();
+    // Neither of these lets an exception out: a pipeline whose build is queued on a worker must
+    // never be dropped because the bookkeeping after it ran out of memory.
+    const auto report = [&]() noexcept {
+        try {
+            spent += std::chrono::steady_clock::now() - begin;
+            if (begin - window < std::chrono::seconds{10}) {
+                return;
+            }
+            std::string why;
+            for (const auto& [reason, count] : reasons) {
+                why += fmt::format("{}{} {}", why.empty() ? "" : ", ", count, reason);
+            }
+            LOG_INFO(Render_Vulkan,
+                     "Kept translations in the last 10 s: {} pipelines made without translating, "
+                     "{:.1f} ms on the GPU thread, {} refused{}{}{}",
+                     used, std::chrono::duration<double, std::milli>(spent).count(), refused,
+                     why.empty() ? "" : " (", why, why.empty() ? "" : ")");
+            if (ShaderPrep::Verify()) {
+                LOG_INFO(Render_Vulkan,
+                         "Kept translations verified so far: {} the same, {} differ", audit_same,
+                         audit_differ);
+            }
+            used = 0;
+            refused = 0;
+            spent = {};
+            reasons.clear();
+            window = begin;
+        } catch (const std::exception&) {
+        }
+    };
+    const auto note_refusal = [&](const char* why) noexcept {
+        try {
+            ++refused;
+            prep_rejected.insert(hash);
+            ++reasons[why];
+        } catch (const std::exception&) {
+        }
+        report();
+    };
+    const auto refuse = [&](const char* why) noexcept -> std::unique_ptr<GraphicsPipeline> {
+        note_refusal(why);
+        return nullptr;
+    };
+    // The kept bytes did not read back whole: this pipeline is prepared again at the next start.
+    const auto unreadable = [&]() noexcept -> std::unique_ptr<GraphicsPipeline> {
+        try {
+            prep_store.Forget(hash);
+            if (redone++ < 8) {
+                prep_store.Commit();
+            }
+        } catch (const std::exception&) {
+        }
+        return refuse("files unreadable");
+    };
+    const auto live = environments.Span();
+    // A vertex A program is merged into vertex B: never kept.
+    if (graphics_key.unique_hashes[0] != 0 || live.size() != record.env_count) {
+        return refuse("other stages");
+    }
+    // Outside the try: once made, its build is queued on a worker and it has to be returned.
+    std::unique_ptr<GraphicsPipeline> made;
+    bool verified_same = true;
+    try {
+        std::vector<u8> bytes;
+        std::array<Shader::Info, ShaderPrep::NumStages> infos{};
+        std::array<const Shader::Info*, Maxwell::MaxShaderStage> info_ptrs{};
+        for (size_t stage = 0; stage < ShaderPrep::NumStages; ++stage) {
+            if (record.infos[stage] == ShaderPrep::NoBlob) {
+                continue;
+            }
+            if (!prep_store.Read(record.infos[stage], bytes) ||
+                !ShaderPrep::DeserializeInfo(bytes, infos[stage]) ||
+                infos[stage].requires_layer_emulation) {
+                return unreadable();
+            }
+            info_ptrs[stage] = &infos[stage];
+        }
+        // As CreateGraphicsPipeline decides it: task and mesh programs the emulator runs as
+        // compute are made of more than their modules (and are never kept).
+        const bool mesh_as_compute{mesh_scratch != nullptr && mesh_scratch->IsValid() &&
+                                   (!MeshComputeLoneOnly() || graphics_key.unique_hashes[3] == 0)};
+        if (info_ptrs[0] == nullptr ||
+            (mesh_as_compute && (infos[0].is_task || infos[0].is_mesh))) {
+            return refuse("other stages");
+        }
+        // Each environment against the answers its translation got. The words a stage's
+        // descriptors read their texture handles from may hold other handles now.
+        size_t env_index = 0;
+        std::vector<VideoCommon::FileEnvironment::AnswerHandle> handles;
+        for (size_t index = 1; index < Maxwell::MaxShaderProgram; ++index) {
+            if (graphics_key.unique_hashes[index] == 0) {
+                continue;
+            }
+            if (env_index >= live.size() || info_ptrs[index - 1] == nullptr) {
+                return refuse("other stages");
+            }
+            const Shader::Info& info = infos[index - 1];
+            handles.clear();
+            const auto add = [&handles](const auto& desc, bool has_secondary, u32 shift_left,
+                                        u32 secondary_index, u32 secondary_offset,
+                                        u32 secondary_shift_left) {
+                if (desc.handle_program != ~0U) {
+                    return; // computed per draw: its words are compared like any other
+                }
+                handles.push_back({.index = desc.cbuf_index,
+                                   .offset = desc.cbuf_offset,
+                                   .shift_left = shift_left,
+                                   .secondary_index = secondary_index,
+                                   .secondary_offset = secondary_offset,
+                                   .secondary_shift_left = secondary_shift_left,
+                                   .has_secondary = has_secondary});
+            };
+            for (const auto& desc : info.texture_buffer_descriptors) {
+                add(desc, desc.has_secondary, desc.shift_left, desc.secondary_cbuf_index,
+                    desc.secondary_cbuf_offset, desc.secondary_shift_left);
+            }
+            for (const auto& desc : info.texture_descriptors) {
+                add(desc, desc.has_secondary, desc.shift_left, desc.secondary_cbuf_index,
+                    desc.secondary_cbuf_offset, desc.secondary_shift_left);
+            }
+            for (const auto& desc : info.image_buffer_descriptors) {
+                add(desc, false, 0, 0, 0, 0);
+            }
+            for (const auto& desc : info.image_descriptors) {
+                add(desc, false, 0, 0, 0, 0);
+            }
+            if (!prep_store.Read(record.answers[env_index], bytes)) {
+                return unreadable();
+            }
+            const char* why = "";
+            if (!VideoCommon::FileEnvironment::AnswersHoldFor(bytes, *live[env_index], handles,
+                                                              &why)) {
+                return refuse(why);
+            }
+            ++env_index;
+        }
+        if (env_index != live.size()) {
+            return refuse("other stages");
+        }
+        std::array<std::vector<u8>, ShaderPrep::NumStages> spirv;
+        for (size_t stage = 0; stage < ShaderPrep::NumStages; ++stage) {
+            if (info_ptrs[stage] != nullptr &&
+                (!prep_store.Read(record.spirv[stage], spirv[stage]) || spirv[stage].empty())) {
+                return unreadable();
+            }
+        }
+        if (ShaderPrep::Verify()) {
+            // What the translation of the game's state gives now, built like any new pipeline
+            // (with its own pools: the caller releases main_pools after this). It is the one
+            // drawn with either way: its build is queued on a worker already.
+            ShaderPrep::Stages fresh;
+            ShaderPools pools;
+            made = CreateGraphicsPipeline(pools, graphics_key, live, nullptr, true, &fresh);
+            if (made == nullptr) {
+                return refuse("not translated (verify)");
+            }
+            verified_same = !fresh.unsuitable;
+            for (size_t stage = 0; verified_same && stage < ShaderPrep::NumStages; ++stage) {
+                verified_same = fresh.present[stage] == (info_ptrs[stage] != nullptr);
+                if (!verified_same || !fresh.present[stage]) {
+                    continue;
+                }
+                std::vector<u8> fresh_info, kept_info;
+                ShaderPrep::SerializeInfo(fresh.infos[stage], fresh_info);
+                ShaderPrep::SerializeInfo(infos[stage], kept_info);
+                const auto& words = fresh.spirv[stage];
+                verified_same =
+                    fresh_info == kept_info && words.size() * sizeof(u32) == spirv[stage].size() &&
+                    std::memcmp(words.data(), spirv[stage].data(), spirv[stage].size()) == 0;
+                if (!verified_same && audit_differ < 32) {
+                    LOG_ERROR(Render_Vulkan,
+                              "Kept translation of pipeline {:016x} differs at stage {} ({})", hash,
+                              stage, fresh_info == kept_info ? "SPIR-V" : "infos");
+                }
+            }
+        } else {
+            std::array<vk::ShaderModule, Maxwell::MaxShaderStage> modules;
+            for (size_t stage = 0; stage < ShaderPrep::NumStages; ++stage) {
+                if (info_ptrs[stage] == nullptr) {
+                    continue;
+                }
+                const std::span<const u32> words{
+                    reinterpret_cast<const u32*>(spirv[stage].data()),
+                    spirv[stage].size() / sizeof(u32)};
+                modules[stage] = BuildShader(device, words);
+            }
+            if (graphics_key.unique_hashes[1] != 0 && StaticVertexInputEnabled()) {
+                EdenRecordAttributeless(
+                    {graphics_key.unique_hashes[0], graphics_key.unique_hashes[1]}, infos[0]);
+            }
+            made = std::make_unique<GraphicsPipeline>(
+                scheduler, buffer_cache, texture_cache, vulkan_pipeline_cache, &shader_notify,
+                device, descriptor_pool, guest_descriptor_queue, descriptor_buffer_ring, &workers,
+                nullptr, render_pass_cache, graphics_key, std::move(modules), info_ptrs,
+                mesh_scratch.get(), nullptr);
+        }
+    } catch (const std::exception&) {
+        if (made == nullptr) {
+            return refuse("files unreadable");
+        }
+        // The pipeline exists and its build is queued: it is returned whatever failed after it.
+    }
+    if (ShaderPrep::Verify()) {
+        ++(verified_same ? audit_same : audit_differ);
+    }
+    if (verified_same) {
+        ++used;
+        report();
+    } else {
+        note_refusal("differs from its translation (verify)");
+    }
+    return made;
+}
+
 } // namespace Vulkan
