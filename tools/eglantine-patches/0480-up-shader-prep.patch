+    io(d.cbuf_offset);
+    io(d.shift_left);
+    io(d.secondary_cbuf_index);
+    io(d.secondary_cbuf_offset);
+    io(d.secondary_shift_left);
+    io(d.count);
+    io(d.size_shift);
+    io(d.handle_program);
+}
