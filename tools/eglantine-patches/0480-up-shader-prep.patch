+template <typename Io, typename D>
+void VisitImage(Io& io, D& d) {
+    io(d.type);
+    io(d.format);
+    io(d.is_written);
+    io(d.is_read);
+    io(d.is_integer);
+    io(d.cbuf_index);
+    io(d.cbuf_offset);
+    io(d.count);
+    io(d.size_shift);
+    io(d.handle_program);
+}
+
+template <typename Io, typename D>
+void VisitAnyDescriptor(Io& io, D& d) {
+    using T = std::remove_const_t<D>;
+    if constexpr (std::is_same_v<T, Shader::ConstantBufferDescriptor>) {
+        VisitConstantBuffer(io, d);
+    } else if constexpr (std::is_same_v<T, Shader::StorageBufferDescriptor>) {
+        VisitStorageBuffer(io, d);
+    } else if constexpr (std::is_same_v<T, Shader::StorageWriteExtentEntry>) {
+        VisitWriteExtentEntry(io, d);
+    } else if constexpr (std::is_same_v<T, Shader::TextureBufferDescriptor>) {
+        VisitTextureBuffer(io, d);
+    } else if constexpr (std::is_same_v<T, Shader::ImageBufferDescriptor>) {
+        VisitImageBuffer(io, d);
+    } else if constexpr (std::is_same_v<T, Shader::TextureDescriptor>) {
+        VisitTexture(io, d);
+    } else {
+        static_assert(std::is_same_v<T, Shader::ImageDescriptor>);
+        VisitImage(io, d);
+    }
+}
+
+/// The descriptor lists (boost static_vector and small_vector, std::vector).
+template <typename Container>
+void VisitDescriptors(Writer& io, const Container& descriptors) {
+    io(static_cast<u32>(descriptors.size()));
+    for (const auto& descriptor : descriptors) {
+        VisitAnyDescriptor(io, descriptor);
+    }
+}
+template <typename Container>
+void VisitDescriptors(Reader& io, Container& descriptors) {
+    u32 count{};
+    io(count);
+    if (count > descriptors.max_size() || count > io.in.size()) {
+        throw std::out_of_range{"shader info"};
+    }
+    descriptors.clear();
+    for (u32 i = 0; i < count; ++i) {
+        auto& descriptor = descriptors.emplace_back();
+        VisitAnyDescriptor(io, descriptor);
+    }
+}
