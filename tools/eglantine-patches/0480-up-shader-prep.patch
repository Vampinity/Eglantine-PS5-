+template <typename Io, typename D>
+void VisitConstantBuffer(Io& io, D& d) {
+    io(d.index);
+    io(d.count);
+}
+template <typename Io, typename D>
+void VisitStorageBuffer(Io& io, D& d) {
+    io(d.cbuf_index);
+    io(d.cbuf_offset);
+    io(d.count);
+    io(d.is_written);
+    io(d.indirect_offset);
+}
+/// EDEN_UP_FRITCHII_WRITEMARK's proven store extents (0475).
+template <typename Io, typename D>
+void VisitWriteExtentEntry(Io& io, D& d) {
+    io(d.cbuf_index);
+    io(d.cbuf_offset);
+    io(d.indirect_offset);
+    io(d.extent.bounded);
+    io(d.extent.guarded);
+    io(d.extent.const_end);
+    io(d.extent.local_stride);
+    io(d.extent.group_stride);
+    io(d.extent.guard_const);
+    io(d.extent.guard_local_stride);
+    io(d.extent.guard_group_stride);
+}
