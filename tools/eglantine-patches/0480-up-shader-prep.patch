+// --- Files --------------------------------------------------------------------------------------
+
+template <typename T>
+void Put(std::vector<u8>& out, const T& value) {
+    const auto* const bytes = reinterpret_cast<const u8*>(&value);
+    out.insert(out.end(), bytes, bytes + sizeof(T));
+}
+
+template <typename T>
+[[nodiscard]] bool Get(std::span<const u8>& in, T& value) {
+    if (in.size() < sizeof(T)) {
+        return false;
+    }
+    std::memcpy(&value, in.data(), sizeof(T));
+    in = in.subspan(sizeof(T));
+    return true;
+}
+
+[[nodiscard]] bool ReadWholeFile(const std::filesystem::path& path, std::vector<u8>& bytes) try {
+    std::error_code error;
+    const auto size = std::filesystem::file_size(path, error);
+    // An index of 130,000 pipelines is about 16 MiB.
+    if (error || size > (u64{1} << 28)) {
+        return false;
+    }
+    std::ifstream file{path, std::ios::binary};
+    bytes.resize(static_cast<size_t>(size));
+    return static_cast<bool>(
+        file.read(reinterpret_cast<char*>(bytes.data()), static_cast<std::streamsize>(size)));
+} catch (const std::exception&) {
+    return false;
+}
+
+/// Written beside the file, then renamed over it: a kill mid-write keeps the previous one.
+[[nodiscard]] bool WriteWholeFile(const std::filesystem::path& path, std::span<const u8> bytes) {
+    auto partial = path;
+    partial += ".part";
+    std::error_code error;
+    {
+        std::ofstream file{partial, std::ios::binary | std::ios::trunc};
+        if (!file.write(reinterpret_cast<const char*>(bytes.data()),
+                        static_cast<std::streamsize>(bytes.size())) ||
+            !file.flush()) {
+            file.close();
+            std::filesystem::remove(partial, error);
+            return false;
+        }
+    }
+    std::filesystem::rename(partial, path, error);
+    if (error) {
+        std::filesystem::remove(partial, error);
+        return false;
+    }
+    return true;
+}
+
+/// prep_stores.txt lists the stores of this folder, the one used last first. Stores past the
+/// third are removed. (A list, since the console's file system is not walked from here.)
+void RememberStore(const std::filesystem::path& dir, const std::string& name) {
+    const auto list_path = dir / "prep_stores.txt";
+    std::vector<std::string> names{name};
+    {
+        std::ifstream list{list_path};
+        std::string line;
+        while (std::getline(list, line)) {
+            const bool plain = !line.empty() && line.size() < 64 &&
+                               line.find_first_not_of("abcdefghijklmnopqrstuvwxyz0123456789_") ==
+                                   std::string::npos;
+            if (plain && std::ranges::find(names, line) == names.end()) {
+                names.push_back(line);
+            }
+        }
+    }
+    std::error_code error;
+    while (names.size() > StoresKept) {
+        for (const char* const extension : {".bin", ".idx", ".idx.part", ".inflight", ".strikes"}) {
+            std::filesystem::remove(dir / (names.back() + extension), error);
+        }
+        names.pop_back();
+    }
+    std::string text;
+    for (const std::string& entry : names) {
+        text += entry;
+        text += '\n';
+    }
+    (void)WriteWholeFile(list_path, std::span<const u8>{reinterpret_cast<const u8*>(text.data()),
+                                                        text.size()});
+}
