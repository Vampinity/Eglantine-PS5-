+    return most;
+}
+
+void SerializeInfo(const Shader::Info& info, std::vector<u8>& out) {
+    Writer writer{out};
+    VisitInfo(writer, info);
+}
+
+bool DeserializeInfo(std::span<const u8> in, Shader::Info& info) {
+    try {
+        Reader reader{in};
+        VisitInfo(reader, info);
+        return in.empty();
+    } catch (const std::out_of_range&) {
+        return false;
+    } catch (const std::bad_alloc&) {
+        return false;
+    } catch (const std::length_error&) {
+        return false;
+    }
+}
+
+u64 HashSpirv(std::span<const u32> words) {
+    return Common::CityHash64(reinterpret_cast<const char*>(words.data()),
+                              words.size() * sizeof(u32));
+}
+
+std::string MakeStamp(u32 cache_version, u32 driver_id, u32 driver_version) {
+    // FNV-1a over NAME=VALUE of the switches that are set.
+    u64 hash = 0xcbf29ce484222325ULL;
+    const auto mix = [&hash](std::string_view text) {
+        for (const char c : text) {
+            hash = (hash ^ static_cast<u8>(c)) * 0x100000001b3ULL;
+        }
+    };
+    u32 set = 0;
+    for (const char* const name : TranslationSwitches) {
+        if (const char* const value = std::getenv(name)) {
+            mix(name);
+            mix("=");
+            mix(value);
+            mix("\n");
+            ++set;
+        }
+    }
+    // The settings the translation reads (shader_recompiler: rescaling_pass.cpp,
+    // translate_program.cpp, emit_spirv.cpp, emit_spirv_image.cpp). A switch or setting that is
+    // missed here is still noticed by the comparison at boot when it changes a compared pipeline.
+    const auto& values = Settings::values;
+    const auto& scale = values.resolution_info;
+    const std::string settings =
+        fmt::format("{}.{}.{:08x}.{:08x}.{}{}{}{}{}", scale.up_scale, scale.down_shift,
+                    std::bit_cast<u32>(scale.up_factor), std::bit_cast<u32>(scale.down_factor),
+                    scale.active ? 1 : 0, scale.downscale ? 1 : 0,
+                    static_cast<bool>(values.fix_bloom_effects.GetValue()) ? 1 : 0,
+                    static_cast<bool>(values.disable_shader_loop_safety_checks) ? 1 : 0,
+                    static_cast<bool>(values.renderer_debug) ? 1 : 0);
+    return fmt::format("prep{} cache{} driver{:x}.{:x} info{} exe{} settings{} switches{}:{:016x}",
+                       FormatVersion, cache_version, driver_id, driver_version,
+                       sizeof(Shader::Info), BuildIdentity(), settings, set, hash);
+}
+
+std::string KeptStore::Header() const {
+    std::string header{DataMagic};
+    const u32 version = FormatVersion;
+    const u32 size = static_cast<u32>(stamp.size());
+    header.append(reinterpret_cast<const char*>(&version), sizeof(version));
+    header.append(reinterpret_cast<const char*>(&size), sizeof(size));
+    header += stamp;
+    return header;
+}
+
+bool KeptStore::StartEmpty() {
+    blobs.clear();
+    records.clear();
+    for (auto& map : by_hash) {
+        map.clear();
+    }
+    dedupe_ready = true;
+    uncommitted = 0;
+    std::error_code error;
+    std::filesystem::remove(index_path, error);
+    const std::string header = Header();
+    std::ofstream file{data_path, std::ios::binary | std::ios::trunc};
+    if (!file.write(header.data(), static_cast<std::streamsize>(header.size())) || !file.flush()) {
+        return false;
+    }
+    data_end = header.size();
+    return true;
+}
+
+bool KeptStore::LoadIndex() {
+    std::vector<u8> bytes;
+    if (!ReadWholeFile(index_path, bytes)) {
+        return false;
+    }
+    std::span<const u8> in{bytes};
+    if (in.size() < IndexMagic.size() ||
+        std::memcmp(in.data(), IndexMagic.data(), IndexMagic.size()) != 0) {
+        return false;
+    }
+    // The last eight bytes are the hash of everything before them.
+    if (in.size() < IndexMagic.size() + sizeof(u64)) {
+        return false;
+    }
+    {
+        u64 stored{};
+        std::memcpy(&stored, in.data() + in.size() - sizeof(u64), sizeof(u64));
+        in = in.first(in.size() - sizeof(u64));
+        if (HashBytes(in) != stored) {
+            return false;
+        }
+    }
+    in = in.subspan(IndexMagic.size());
+    u32 version{}, stamp_size{}, record_count{}, blob_count{};
+    u64 end{};
+    if (!Get(in, version) || version != FormatVersion || !Get(in, stamp_size) ||
+        stamp_size != stamp.size() || in.size() < stamp_size ||
+        std::memcmp(in.data(), stamp.data(), stamp_size) != 0) {
+        return false;
+    }
+    in = in.subspan(stamp_size);
+    if (!Get(in, end) || !Get(in, record_count) || !Get(in, blob_count)) {
+        return false;
+    }
+    constexpr size_t BlobBytes = 8 + 8 + 4 + 4 + 4 + 4;
+    constexpr size_t RecordBytes = 8 + 4 + 4 + 3 * NumStages * 4;
+    if (in.size() != u64{blob_count} * BlobBytes + u64{record_count} * RecordBytes) {
+        return false;
+    }
+    const std::string header = Header();
+    std::vector<Blob> loaded_blobs;
+    std::unordered_map<u64, Record> loaded_records;
+    try {
+        loaded_blobs.resize(blob_count);
+        for (Blob& blob : loaded_blobs) {
+            u32 pad{};
+            if (!Get(in, blob.offset) || !Get(in, blob.hash) || !Get(in, blob.size) ||
+                !Get(in, blob.raw_size) || !Get(in, blob.kind) || !Get(in, pad) ||
+                blob.kind >= KindCount || blob.offset < header.size() || blob.offset > end ||
+                blob.size > end - blob.offset) {
+                return false;
+            }
+        }
+        loaded_records.reserve(record_count);
+        for (u32 i = 0; i < record_count; ++i) {
+            u64 key_hash{};
+            Record record;
+            if (!Get(in, key_hash) || !Get(in, record.env_count) || !Get(in, record.flags) ||
+                !Get(in, record.infos) || !Get(in, record.spirv) || !Get(in, record.answers) ||
+                record.env_count > NumStages ||
+                (record.env_count == 0) != ((record.flags & FlagNotKeepable) != 0)) {
+                return false;
+            }
+            const auto listed = [&](u32 blob, u32 kind) {
+                return blob == NoBlob || (blob < blob_count && loaded_blobs[blob].kind == kind);
+            };
+            for (size_t stage = 0; stage < NumStages; ++stage) {
+                if (!listed(record.infos[stage], KindInfo) || !listed(record.spirv[stage], KindSpirv) ||
+                    !listed(record.answers[stage], KindAnswers)) {
+                    return false;
+                }
+            }
+            loaded_records.emplace(key_hash, record);
+        }
+    } catch (const std::bad_alloc&) {
+        return false;
+    } catch (const std::length_error&) {
+        return false;
+    }
+    // The blob file must be this stamp's and hold at least what the index lists. What it holds
+    // past that was written by a run that ended before its index: cut off.
+    std::error_code error;
+    const auto data_size = std::filesystem::file_size(data_path, error);
+    if (error || data_size < end || end < header.size()) {
+        return false;
+    }
+    {
+        std::ifstream file{data_path, std::ios::binary};
+        std::string found(header.size(), '\0');
+        if (!file.read(found.data(), static_cast<std::streamsize>(found.size())) ||
+            found != header) {
+            return false;
+        }
+    }
+    if (data_size > end) {
+        std::filesystem::resize_file(data_path, end, error);
+        if (error) {
+            return false;
+        }
+    }
+    blobs = std::move(loaded_blobs);
+    records = std::move(loaded_records);
+    for (auto& map : by_hash) {
+        map.clear();
+    }
+    dedupe_ready = false;
+    data_end = end;
+    uncommitted = 0;
+    return true;
+}
+
+void KeptStore::EnsureDedupe() {
+    if (dedupe_ready) {
+        return;
+    }
+    for (auto& map : by_hash) {
+        map.clear();
+    }
+    for (u32 id = 0; id < blobs.size(); ++id) {
+        const Blob& blob = blobs[id];
+        by_hash[blob.kind].emplace(blob.hash + u64{blob.raw_size} * 0x9E3779B97F4A7C15ULL, id);
+    }
+    dedupe_ready = true;
+}
+
+void KeptStore::Compact() {
+    std::scoped_lock lock{mutex};
+    for (auto& map : by_hash) {
+        std::unordered_map<u64, u32>{}.swap(map);
+    }
+    dedupe_ready = false;
+}
+
+bool KeptStore::Open(const std::filesystem::path& dir, const std::string& stamp_) {
+    std::scoped_lock lock{mutex};
+    open = false;
+    stamp = stamp_;
+    const u64 id = Common::CityHash64(stamp.data(), stamp.size());
+    const std::string name = fmt::format("prep_{:08x}", static_cast<u32>(id));
+    data_path = dir / (name + ".bin");
+    index_path = dir / (name + ".idx");
+    RememberStore(dir, name);
+    data.close();
+    data.clear();
+    reader.close();
+    reader.clear();
+    if (!LoadIndex() && !StartEmpty()) {
+        LOG_WARNING(Render_Vulkan, "Shader preparation: cannot write {}",
+                    Common::FS::PathToUTF8String(data_path));
+        return false;
+    }
+    data.open(data_path, std::ios::binary | std::ios::app);
+    if (!data) {
+        LOG_WARNING(Render_Vulkan, "Shader preparation: cannot open {}",
+                    Common::FS::PathToUTF8String(data_path));
+        return false;
+    }
+    open = true;
+    return true;
+}
