+                }
+                ++probes_queued;
+                {
+                    std::scoped_lock lock{state.mutex};
+                    ++state.in_flight;
+                }
+                try {
+                    workers.QueueWork([this, key, hash, envs_ = std::move(envs), &state, &probed,
+                                       &probe_differed]() mutable {
+                        try {
+                            ShaderPrep::Stages stages;
+                            stages.driver_cache_only = true;
+                            ShaderPools pools;
+                            boost::container::static_vector<Shader::Environment*, 5> env_ptrs;
+                            for (auto& env : envs_) {
+                                env_ptrs.push_back(&env);
+                            }
+                            const auto pipeline{CreateGraphicsPipeline(
+                                pools, key, MakeSpan(env_ptrs), nullptr, false, &stages)};
+                            if (pipeline != nullptr && !stages.unsuitable) {
+                                probed.fetch_add(1, std::memory_order_relaxed);
+                                if (!prep_store.SameSpirv(hash, stages)) {
+                                    probe_differed.fetch_add(1, std::memory_order_relaxed);
+                                }
+                            }
+                        } catch (const std::exception&) {
+                        }
+                        std::scoped_lock lock{state.mutex};
+                        --state.in_flight;
+                        state.cv.notify_all();
+                    });
+                } catch (...) {
+                    std::scoped_lock lock{state.mutex};
+                    --state.in_flight;
+                    state.cv.notify_all();
+                    throw;
+                }
+                return;
+            }
+            if (struck_out(hash)) {
