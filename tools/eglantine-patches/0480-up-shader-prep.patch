+[[nodiscard]] bool SwitchIs(const char* name, char wanted) {
+    const char* const value = std::getenv(name);
+    return value != nullptr && value[0] == wanted && value[1] == '\0';
+}
+
+[[nodiscard]] size_t SwitchNumber(const char* name, size_t fallback) {
+    const char* const value = std::getenv(name);
+    if (value == nullptr) {
+        return fallback;
+    }
+    char* end = nullptr;
+    const unsigned long long number = std::strtoull(value, &end, 10);
+    return end == value || number == 0 ? fallback : static_cast<size_t>(number);
+}
+
+/// Which build runs: the size and write time of the app's eboot (the folders the PS5 app looks
+/// for itself in, headless/storage_paths.h; EDEN_UP_SHADER_PREP_EXE names another file). A build
+/// that is installed again gets a new store even when it translates the same: it costs one
+/// preparation, and a build whose translation changed can never draw with the old one's. "?"
+/// when no eboot is found: then only the comparison at boot tells that the translation changed.
+[[nodiscard]] std::string BuildIdentity() {
+    std::vector<std::filesystem::path> candidates;
+    if (const char* const named = std::getenv("EDEN_UP_SHADER_PREP_EXE")) {
+        candidates.emplace_back(named);
+    }
+    for (const char* const folder : {"/app0", "/system_ex/app/PPSA98515",
+                                     "/data/homebrew/PPSA98515",
+                                     "/mnt/sandbox/PPSA98515_000/app0"}) {
+        candidates.emplace_back(std::filesystem::path{folder} / "eboot.bin");
+    }
+    for (const auto& candidate : candidates) {
+        std::error_code error;
+        const auto size = std::filesystem::file_size(candidate, error);
+        if (error) {
+            continue;
+        }
+        const auto written = std::filesystem::last_write_time(candidate, error);
+        if (error) {
+            continue;
+        }
+        return fmt::format("{}.{}", size,
+                           static_cast<long long>(written.time_since_epoch().count()));
+    }
+    return "?";
+}
+
+[[nodiscard]] u64 HashBytes(std::span<const u8> bytes) {
+    return Common::CityHash64(reinterpret_cast<const char*>(bytes.data()), bytes.size());
+}
+
+// --- Shader::Info -------------------------------------------------------------------------------
+
+// Every field of Info is listed in VisitInfo below. An info that grows a field has to be listed
+// there too: these size checks fail the PS5 build until it is (update the sizes and FormatVersion
+// with it). The descriptors are held in vectors, so a field they grow does not change
+// sizeof(Info): they are checked on their own.
+#if defined(__x86_64__) && defined(__LP64__) && !defined(_WIN32)
+static_assert(sizeof(Shader::Info) == 3120,
+              "Shader::Info changed: list the new fields in VisitInfo, then update this size");
+static_assert(sizeof(Shader::ConstantBufferDescriptor) == 8 &&
+                  sizeof(Shader::StorageBufferDescriptor) == 20 &&
+                  sizeof(Shader::TextureBufferDescriptor) == 40 &&
+                  sizeof(Shader::ImageBufferDescriptor) == 28 &&
+                  sizeof(Shader::TextureDescriptor) == 44 &&
+                  sizeof(Shader::ImageDescriptor) == 32 &&
+                  sizeof(Shader::StorageWriteExtent) == 60 &&
+                  sizeof(Shader::StorageWriteExtentEntry) == 72,
+              "A Shader::Info descriptor changed: list the new fields in its Visit function");
+#endif
+
+struct Writer {
+    std::vector<u8>& out;
+
+    template <typename T>
+        requires(std::is_arithmetic_v<T> || std::is_enum_v<T>)
+    void operator()(const T& value) {
+        const auto* const bytes = reinterpret_cast<const u8*>(&value);
+        out.insert(out.end(), bytes, bytes + sizeof(T));
+    }
+    void operator()(const bool& value) {
+        out.push_back(value ? u8{1} : u8{0});
+    }
+    template <typename T, size_t N>
+    void operator()(const std::array<T, N>& values) {
+        for (const T& value : values) {
+            (*this)(value);
+        }
+    }
+    template <size_t N>
+    void operator()(const std::bitset<N>& bits) {
+        for (size_t word = 0; word < (N + 63) / 64; ++word) {
+            u64 value = 0;
+            for (size_t bit = 0; bit < 64 && word * 64 + bit < N; ++bit) {
+                value |= u64{bits[word * 64 + bit]} << bit;
+            }
+            (*this)(value);
+        }
+    }
+    void operator()(const Shader::VaryingState& state) {
+        (*this)(state.mask);
+    }
+    template <typename K, typename V>
+    void operator()(const std::map<K, V>& map) {
+        (*this)(static_cast<u32>(map.size()));
+        for (const auto& [key, value] : map) {
+            (*this)(key);
+            (*this)(value);
+        }
+    }
+    void operator()(const std::vector<std::vector<u32>>& lists) {
+        (*this)(static_cast<u32>(lists.size()));
+        for (const auto& list : lists) {
+            (*this)(static_cast<u32>(list.size()));
+            for (const u32 value : list) {
+                (*this)(value);
+            }
+        }
+    }
+};
+
+struct Reader {
+    std::span<const u8>& in;
+
+    template <typename T>
+        requires(std::is_arithmetic_v<T> || std::is_enum_v<T>)
+    void operator()(T& value) {
+        if (in.size() < sizeof(T)) {
+            throw std::out_of_range{"shader info"};
+        }
+        std::memcpy(&value, in.data(), sizeof(T));
+        in = in.subspan(sizeof(T));
+    }
+    void operator()(bool& value) {
+        if (in.empty() || in[0] > 1) {
+            throw std::out_of_range{"shader info"};
+        }
+        value = in[0] != 0;
+        in = in.subspan(1);
+    }
+    template <typename T, size_t N>
+    void operator()(std::array<T, N>& values) {
+        for (T& value : values) {
+            (*this)(value);
+        }
+    }
+    template <size_t N>
+    void operator()(std::bitset<N>& bits) {
+        for (size_t word = 0; word < (N + 63) / 64; ++word) {
+            u64 value = 0;
+            (*this)(value);
+            for (size_t bit = 0; bit < 64 && word * 64 + bit < N; ++bit) {
+                bits[word * 64 + bit] = ((value >> bit) & 1) != 0;
+            }
+        }
+    }
+    void operator()(Shader::VaryingState& state) {
+        (*this)(state.mask);
+    }
+    template <typename K, typename V>
+    void operator()(std::map<K, V>& map) {
+        u32 count{};
+        (*this)(count);
+        if (count > in.size()) {
+            throw std::out_of_range{"shader info"};
+        }
+        map.clear();
+        for (u32 i = 0; i < count; ++i) {
+            K key{};
+            V value{};
+            (*this)(key);
+            (*this)(value);
+            map.emplace(key, value);
+        }
+    }
+    void operator()(std::vector<std::vector<u32>>& lists) {
+        u32 count{};
+        (*this)(count);
+        if (count > in.size()) {
+            throw std::out_of_range{"shader info"};
+        }
+        lists.assign(count, {});
+        for (auto& list : lists) {
+            u32 size{};
+            (*this)(size);
+            if (size > in.size() / sizeof(u32)) {
+                throw std::out_of_range{"shader info"};
+            }
+            list.resize(size);
+            for (u32& value : list) {
+                (*this)(value);
+            }
+        }
+    }
+};
