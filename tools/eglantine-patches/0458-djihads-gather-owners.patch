@@ -5,6 +5,7 @@
 #include <mutex>
 #include <utility>
 
+#include "common/pe_switch.h"
 #include "video_core/renderer_vulkan/vk_multi_range_buffer.h"
 #include "video_core/renderer_vulkan/vk_scheduler.h"
 #include "video_core/vulkan_common/vulkan_device.h"
@@ -168,6 +169,24 @@ SparseBuffer MultiRangeBufferCache::CreateSparse(const Device& device, Scheduler
     return handle;
 }
 
+namespace {
+// EDEN_UP_DJ_GATHER_OWNERS=1 (Djihads80/Eglantine c6d2acd37, "release gathered buffers together
+// with their sources"): a gathered copy (the path when the sources can't be bound sparse) records
+// its source buffers as owners too, so DropOwner retires it when one of them is deleted, and the
+// retired copies are freed each frame (TickFrame), not only on the next Get. Off: a gathered copy
+// lives until its key comes back with another layout, after its sources are gone.
+bool GatherOwners() {
+    static const bool on = Common::PeSwitch("EDEN_UP_DJ_GATHER_OWNERS");
+    return on;
+}
+} // Anonymous namespace
+
+void MultiRangeBufferCache::TickFrame(Scheduler& scheduler) {
+    if (GatherOwners() && !retired.empty()) {
+        DrainRetired(scheduler);
+    }
+}
+
 void MultiRangeBufferCache::RetireEntry(Scheduler& scheduler, Entry& entry) {
     if (!entry.sparse_handle && !entry.gathered) {
         return;
@@ -248,9 +267,15 @@ MultiRangeRef MultiRangeBufferCache::Get(const Device& device, Scheduler& schedu
     entry.geometry = geometry;
     entry.content = content;
     entry.size = total;
+    if (GatherOwners()) {
+        entry.owners.reserve(sources.size());
+        for (const MultiRangeSource& source : sources) {
+            entry.owners.push_back(source.handle);
+        }
+    }
     if (CanBindSparse(sources)) {
         entry.sparse_handle = CreateSparse(device, scheduler, sources, total);
-        if (entry.sparse_handle) {
+        if (entry.sparse_handle && !GatherOwners()) {
             entry.owners.reserve(sources.size());
             for (const MultiRangeSource& source : sources) {
                 entry.owners.push_back(source.handle);
