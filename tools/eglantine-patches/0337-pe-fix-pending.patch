+// The inline QMDs (0x107) the front sent, by address space and GPU address, with the position
+// after each: what the back writes to guest memory when it gets there. The front's copy reads
+// them from here until then (guest memory still holds the slot's previous QMD).
+struct FrontInlineQmd {
+    NativeQmdScheduler::Descriptor descriptor;
+    u64 position;
+};
+std::unordered_map<u64, FrontInlineQmd>& FrontInlineQmds(const VideoCommon::GpuSplit& split) {
+    static std::unordered_map<u64, FrontInlineQmd> qmds;
