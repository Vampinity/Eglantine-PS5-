+// EDEN_PE_DMA_READ_AHEAD: an MME DMA read of at most 64 words skips the drain when the back has no
+// write the front sent to those words still to run and no wait for idle sent since their device
+// pages were last flushed (a drained read here or in the DMA snapshot path, fs.dma_snapshots).
+// A drain alone does not make GPU-written data visible: only a flush of those bytes after the
+// wait does. EDEN_PE_DMA_READ_TRUST also skips it for a source 16 drained reads found unchanged,
+// while nothing sent since the last of them may write it.
+void Maxwell3D::FrontDmaReadAhead(VideoCommon::GpuSplit& split, FrontState& fs, u32 macro,
+                                  u32 method, GPUVAddr source, u32 words) {
+    const size_t read_bytes = size_t{words} * sizeof(u32);
+    if (fs.read_ahead_generation != split.SessionGeneration()) {
+        fs.dma_snapshots.clear();
+        fs.read_trust.clear();
+        fs.read_ahead_generation = split.SessionGeneration();
+    }
+    bool pending = false;
+    const u64 space = u64{memory_manager.GetID()} << 48;
+    for (u32 i = 0; i < words; ++i) {
+        const u64 key = space | (source + u64{i} * sizeof(u32));
+        if (split.WritePending(key) || split.EverReported(key)) {
+            pending = true;
+            break;
+        }
+    }
+    std::optional<u64> device;
+    if (words != 0) {
+        device = memory_manager.GpuToCpuAddress(source);
+        if (device &&
+            memory_manager.GpuToCpuAddress(source + read_bytes - 1) != *device + read_bytes - 1) {
+            device.reset();
+        }
+    }
+    const u64 first_page = device ? *device >> 12 : 0;
+    const u64 last_page = device ? (*device + read_bytes - 1) >> 12 : 0;
+    // Every wait for idle sent so far came before a flush of these pages.
+    bool synced = true;
+    if (const u64 sync_at = split.SyncPosition(); sync_at != 0 && words != 0) {
+        synced = device.has_value();
+        for (u64 page = first_page; synced && page <= last_page; ++page) {
+            const auto it = fs.dma_snapshots.find(page);
+            synced = it != fs.dma_snapshots.end() && it->second >= sync_at;
+        }
+    }
+    bool drain = !synced || pending;
+    static const bool trust_sources = Common::PeSwitch("EDEN_PE_DMA_READ_TRUST");
+    FrontState::ReadTrust* trust = nullptr;
+    std::array<u32, 64> early{};
+    if (trust_sources && drain && !pending) {
+        if (fs.read_trust.size() > 65536) fs.read_trust.clear();
+        trust = &fs.read_trust[space | source];
+        // Checked again every 64th read, and whenever something sent since may write it.
+        if (trust->count >= 16 && (++trust->uses & 63) != 0 && device &&
+            !split.MayBeWrittenSince(trust->checked_at, *device, read_bytes)) {
+            trust = nullptr;
+            drain = false;
+        }
+    }
+    if (trust && trust->count >= 0) {
+        for (u32 i = 0; i < words; ++i) {
+            early[i] = memory_manager.Read<u32>(source + u64{i} * sizeof(u32));
+        }
+    }
+    if (!drain) {
+        return;
+    }
+    bool read_dirty = false;
+    // The whole device pages when they translate as one range, so they count as flushed.
+    const GPUVAddr flush_begin = device ? source & ~GPUVAddr{0xfff} : source;
+    const size_t flush_bytes =
+        device ? static_cast<size_t>(((source + read_bytes + 0xfff) & ~GPUVAddr{0xfff}) - flush_begin)
+               : read_bytes;
+    split.Defer([this, memory = &memory_manager, macro, method, source, read_bytes, flush_begin,
+                 flush_bytes, dirty_ptr = trust && trust->count >= 0 ? &read_dirty : nullptr] {
+        // EDEN_NX2_QUERY_DMA_TRACE / EDEN_NX2_QUERY_DMA_SYNC: below High accuracy, counter reports
+        // reach guest memory when a later fence pops, and nothing here waits for them.
+        VideoCommon::QueryDma::BeforeRead(*memory, *rasterizer, macro, method, source, read_bytes);
+        if (dirty_ptr != nullptr) {
+            *dirty_ptr = memory->IsMemoryDirty(source, read_bytes, VideoCommon::CacheType::BufferCache);
+        }
+        if (memory->IsMemoryDirty(flush_begin, flush_bytes, VideoCommon::CacheType::BufferCache)) {
+            memory->FlushRegion(flush_begin, flush_bytes, VideoCommon::CacheType::BufferCache);
+        }
+        VideoCommon::QueryDma::AfterBufferFlush(*memory, *rasterizer, source, read_bytes);
+    });
+    split.Drain(VideoCommon::DrainSite::MacroDmaRead);
+    // Taken after the drain: the whole pages are current up to what was sent.
+    const u64 position = split.SentPosition();
+    if (device) {
+        if (fs.dma_snapshots.size() > 8192) {
+            fs.dma_snapshots.clear();
+        }
+        for (u64 page = first_page; page <= last_page; ++page) {
+            fs.dma_snapshots[page] = position;
+        }
+    }
+    if (trust && trust->count >= 0) {
+        bool changed = read_dirty;
+        for (u32 i = 0; i < words && !changed; ++i) {
+            changed = early[i] != memory_manager.Read<u32>(source + u64{i} * sizeof(u32));
+        }
+        trust->count = changed ? -1 : trust->count + 1;
+        trust->checked_at = position;
+    }
+}
