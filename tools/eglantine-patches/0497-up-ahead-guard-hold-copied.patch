+    /// EDEN_UP_AHEAD_GUARD=3 (ahead_guard.h): guest writes that are applied later. Until then a
+    /// download must not land the GPU's older bytes over them: they leave the GPU-written ranges
+    /// now, as OnCacheInvalidations does first.
+    virtual void ClaimCpuWrites([[maybe_unused]] std::span<const std::pair<DAddr, u64>> ranges) {}
+
     /// EDEN_UP_HELD_VS_DOWNLOAD: around each round of OnCacheInvalidations (one gather).
     virtual void BeginCachedWrites() {}
     virtual void EndCachedWrites() {}
diff --git a/src/video_core/renderer_vulkan/vk_rasterizer.cpp b/src/video_core/renderer_vulkan/vk_rasterizer.cpp
