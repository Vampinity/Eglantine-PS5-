Subject: [PATCH] review fix for the ProsperoEden port (astc), 8 Nov

diff --git a/src/video_core/renderer_vulkan/vk_staging_buffer_pool.cpp b/src/video_core/renderer_vulkan/vk_staging_buffer_pool.cpp
index f6f6667..5060b27 100644
--- a/src/video_core/renderer_vulkan/vk_staging_buffer_pool.cpp
+++ b/src/video_core/renderer_vulkan/vk_staging_buffer_pool.cpp
@@ -200,6 +200,26 @@ void StagingBufferPool::FreeDeferred(StagingBufferRef& ref, bool completed) {
     it->deferred = false;
 }
 
+void StagingBufferPool::CarryTick(u64 old_tick, u64 new_tick) {
+    if (old_tick == new_tick) {
+        return;
+    }
+    for (u64& tick : sync_ticks) {
+        if (tick == old_tick) {
+            tick = new_tick;
+        }
+    }
+    for (StagingBuffersCache* const cache : {&upload_cache, &device_local_cache, &download_cache}) {
+        for (StagingBuffers& level : *cache) {
+            for (StagingBuffer& entry : level.entries) {
+                if (!entry.deferred && entry.tick == old_tick) {
+                    entry.tick = new_tick;
+                }
+            }
+        }
+    }
+}
+
 void StagingBufferPool::TickFrame() {
     current_delete_level = (current_delete_level + 1) % NUM_LEVELS;
 
