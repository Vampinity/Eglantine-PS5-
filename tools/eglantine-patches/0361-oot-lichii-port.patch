From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: EglantinePS5 <noreply@eglantineps5.local>
Date: Sun, 8 Nov 2026 00:00:00 +0000
Subject: [PATCH] shader: port Lichii #410 near-foliage paired pointer routing

Port Lichii #410's unconditional paired-pointer search and its backend and
binding-limit guards into the PS5 pointer tracker.

diff --git a/src/shader_recompiler/ir_opt/global_memory_to_storage_buffer_pass.cpp b/src/shader_recompiler/ir_opt/global_memory_to_storage_buffer_pass.cpp
index a5f4f39f79..a0f91f357b 100644
--- a/src/shader_recompiler/ir_opt/global_memory_to_storage_buffer_pass.cpp
+++ b/src/shader_recompiler/ir_opt/global_memory_to_storage_buffer_pass.cpp
@@ -82,6 +82,10 @@ struct StorageInfo {
     std::unordered_set<const IR::Inst*> native_dynamic;
     /// A native access with several candidate pointers was left global.
     bool native_runtime_bounds{};
+    /// A paired access may bind a loaded pointer only when the backend can route it.
+    bool bind_competing_loaded{true};
+    /// A paired access bound the loaded pointer competing with its pair.
+    bool competing_loaded_bound{};
     /// Pointer table entries reached through a phi or select of table pointers, or through a
     /// table pointer read from a dynamically indexed constant buffer array. They are bound only
     /// in the bindings the program's other storage buffers leave free (table_budget).
@@ -154,6 +158,24 @@ bool IsGlobalMemory(const IR::Inst& inst) {
     }
 }
 
+/// Returns true when the backend can select a global access's buffer at run time.
+bool IsRuntimeRoutable(const IR::Inst& inst) {
+    switch (inst.GetOpcode()) {
+    case IR::Opcode::LoadGlobal32:
+    case IR::Opcode::LoadGlobal64:
+    case IR::Opcode::LoadGlobal128:
+    case IR::Opcode::WriteGlobal32:
+    case IR::Opcode::WriteGlobal64:
+    case IR::Opcode::WriteGlobal128:
+    case IR::Opcode::GlobalAtomicIAdd32:
+    case IR::Opcode::GlobalAtomicUMax32:
+    case IR::Opcode::GlobalAtomicCompareExchange32:
+        return true;
+    default:
+        return false;
+    }
+}
+
 /// Returns true when the instruction is a global memory instruction
 bool IsGlobalMemoryWrite(const IR::Inst& inst) {
     switch (inst.GetOpcode()) {
@@ -1362,22 +1384,11 @@ void CollectStorageBuffers(IR::Block& block, IR::Inst& inst, StorageInfo& info,
         !env.IsCbufStorageBufferPointer(storage_buffer->index, storage_buffer->offset)) {
         storage_buffer.reset();
     }
-    // EDEN_NX2_PAIRED_POINTERS=1 (Djihads80/Eglantine PR 715, Duck912): a paired constant buffer
-    // pointer can be only one input of a select or phi whose other input is a pointer loaded from
-    // that buffer (Ocarina of Time's foliage unit placement records are read from c0[12] or from
-    // *c0[12]). Rebasing on the constant buffer pointer then reads the loaded path's records out of
-    // bounds, as zeros, so look for loaded pointers here as well.
-    static const bool paired_search = [] {
-        const char* const value = std::getenv("EDEN_NX2_PAIRED_POINTERS");
-        return value != nullptr && value[0] != '0';
-    }();
-    // With every binding taken and the pair not bound yet, binding it would make 33 and overflow
-    // storage_buffers_descriptors. PR 715 has no such limit: leave the access to the MAX_SSBOS
-    // check below, as without the switch.
-    const bool paired_found =
-        paired_search && storage_buffer.has_value() &&
-        (info.set.size() < Info::MAX_SSBOS || info.set.find(*storage_buffer) != info.set.end());
-    if (native && (!storage_buffer || paired_found) && !low_addr.IsImmediate()) {
+    // A paired constant-buffer pointer may be one input of a select or phi whose other input is
+    // a pointer loaded from that buffer. Ocarina reads foliage placement records through both c0[12]
+    // and *c0[12]; rebasing the loaded path on c0[12] reads zeros.
+    const bool paired_found = storage_buffer.has_value();
+    if (native && !low_addr.IsImmediate()) {
         const IR::Inst* const start{low_addr.InstRecursive()};
         auto it{info.native_candidates.find(start)};
         if (it == info.native_candidates.end()) {
@@ -1392,8 +1403,10 @@ void CollectStorageBuffers(IR::Block& block, IR::Inst& inst, StorageInfo& info,
         const auto& candidates{it->second};
         const bool has_loaded_pointer{std::ranges::any_of(
             candidates, [](const StorageBufferAddr& c) { return c.indirect != ~0U; })};
-        if (paired_found && !has_loaded_pointer) {
-            // No pointer loaded from memory competes with the paired one: keep the pair.
+        if (paired_found &&
+            (!has_loaded_pointer || !info.bind_competing_loaded || !IsRuntimeRoutable(inst))) {
+            // No pointer loaded from memory competes with the pair, or this opcode cannot be routed
+            // among bound buffers by the SPIR-V backend: keep the pair.
         } else if (candidates.size() > 1 || paired_found ||
                    (!candidates.empty() && info.native_dynamic.contains(start))) {
             // Bind every candidate and keep the access global; the backend picks the buffer at
@@ -1401,6 +1414,7 @@ void CollectStorageBuffers(IR::Block& block, IR::Inst& inst, StorageInfo& info,
             bool accepted{};
             if (paired_found) {
                 // The paired pointer is the other input of the select or phi; bind it too.
+                info.competing_loaded_bound = true;
                 info.set.insert(*storage_buffer);
                 if (IsGlobalMemoryWrite(inst)) {
                     info.writes.insert(*storage_buffer);
@@ -1695,6 +1709,8 @@ void GlobalMemoryToStorageBufferPass(Environment& env, IR::Program& program,
     }
     TrackingConditions conditions{program};
     StorageInfo info;
+    // Without shaderInt64 the SPIR-V backend cannot route a global access among bound buffers.
+    info.bind_competing_loaded = host_info.support_int64;
     info.iterator_words = CollectIteratorWords(program);
     info.atomic_pointers = CollectAtomicPointers(program);
     const auto collect = [&] {
@@ -1709,6 +1725,16 @@ void GlobalMemoryToStorageBufferPass(Environment& env, IR::Program& program,
         }
     };
     collect();
+    if (info.competing_loaded_bound && info.set.size() > Info::MAX_SSBOS) {
+        // Keep the paired cbuf binding when the competing loaded pointers would overflow the
+        // storage-buffer array. Binding only part of the candidates would still misaddress data.
+        StorageInfo paired;
+        paired.iterator_words = std::move(info.iterator_words);
+        paired.atomic_pointers = std::move(info.atomic_pointers);
+        paired.bind_competing_loaded = false;
+        info = std::move(paired);
+        collect();
+    }
     const size_t reserved{info.tables_seen ? PendingNvnBindings(program, info.set) : 0U};
     if (info.tables_seen && info.set.size() + reserved < Info::MAX_SSBOS) {
         // Again with pointer table entries, in the bindings the first pass left free.
-- 
