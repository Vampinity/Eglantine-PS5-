+// Built-in patches of several sites, or of more than one instruction, applied all or none.
+// The table shape and the three patches below are from Lichii PR 717 (stephenjayakar,
+// zortos293/Lichii eb3553bcb8). There each is on by default; here each has its own switch
+// (exact "1") and is off unless set.
+struct BuiltinPatchRecord {
+    size_t module_offset;
+    std::span<const u8> bytes;
+    std::span<const u8> original;
+};
+
+struct BuiltinGroupPatch {
+    std::string_view name;
+    u64 title_id;
+    std::string_view module;
+    std::string_view build_id;
+    std::span<const BuiltinPatchRecord> records;
+    bool (*enabled)(); ///< The switch that applies it
+};
+
+[[nodiscard]] bool UpSwitch(const char* name) {
+    const char* const value = std::getenv(name);
+    return value != nullptr && value[0] == '1' && value[1] == '\0';
+}
+
+// EDEN_UP_OOT_NATIVE_ZSTD=1: the game's three calls of ZSTD_decompressMultiFrame (main+0xEB380,
+// its asset streaming jobs) become svc 0xF0-0xF2, and the host's libzstd decompresses instead of
+// the game's own zstd under the JIT (core/hle/kernel/svc/svc_nx2_zstd.cpp, which needs exactly
+// these sites and runs the game's function when it cannot give the same bytes).
+[[nodiscard]] bool NativeZstdEnabled() {
+    static const bool enabled = UpSwitch("EDEN_UP_OOT_NATIVE_ZSTD");
+    return enabled;
+}
