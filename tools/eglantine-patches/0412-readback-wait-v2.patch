+// SPDX-FileCopyrightText: Copyright 2026 Eden Emulator Project
+// SPDX-License-Identifier: GPL-3.0-or-later
+
+#pragma once
+
+#include <atomic>
+#include <cstdlib>
+
+#include "common/common_types.h"
+#include "common/logging.h"
+#include "common/pe_switch.h"
+
+/// State shared by EDEN_NX2_READBACK_WAIT (fence manager, query cache, compute engine, buffer
+/// cache) and EDEN_NX2_OVERWRITE_CHECK (nx2:vi2 present, buffer cache, Vulkan rasterizer).
+namespace VideoCore::Readback {
+
+/// EDEN_NX2_READBACK_WAIT (unset or 0: off, exactly T65's off path). The guest's syncpoint
+/// increments are made when the GPU thread records them, while GPU writes to ranges the CPU has
+/// read back before land in guest memory only when the host GPU ran them and the fencing thread
+/// popped their fence. While a fence with downloads is in flight (committed, not landed):
+///   1: syncpoint increments wait until every download committed up to them landed.
+///   2: as 1, and guest-visible semaphore/query release words (fence-flagged reports, payload
+///      semaphore releases, compute QMD releases) wait for their own fence to pop, which runs
+///      after the downloads (buffer cache pops come first on the fencing thread).
+///   3: as 2, and every syncpoint fence counts as a download (each increment waits for its own
+///      fence: the most waiting, a diagnostic).
+inline int Mode() {
+    static const int mode = [] {
+        const char* value = std::getenv("EDEN_NX2_READBACK_WAIT");
+        const int parsed = value != nullptr && value[0] >= '1' && value[0] <= '3' &&
+                                   value[1] == '\0'
+                               ? value[0] - '0'
+                               : 0;
+        if (parsed != 0) {
+            LOG_INFO(HW_GPU,
+                     "EDEN_NX2_READBACK_WAIT={} (v2): increments{} wait while downloads are in "
+                     "flight",
+                     parsed, parsed >= 2 ? " and semaphore/query releases" : "");
+        }
+        return parsed;
+    }();
+    return mode;
+}
+
+/// Fences with downloads committed and not yet landed (raised when the fence is made, lowered
+/// by the fencing thread after the downloads). Kept only while Mode() is not 0.
+inline std::atomic<u64> g_downloads_in_flight{};
+/// Guest-visible semaphore/query releases signalled while downloads were in flight, and how many
+/// of them waited for their fence (Mode() 2 and up). For the 5 s line.
+inline std::atomic<u64> g_releases_during_downloads{};
+inline std::atomic<u64> g_releases_held{};
+/// Download ranges a newer GPU write was recorded over before they landed, and that still landed
+/// (their bytes are what a guest waiting for that fence must read). For the 5 s line.
+inline std::atomic<u64> g_superseded_landed{};
+
+/// Mode() 2 and up: held releases whose operation has not run yet (raised by HoldRelease, lowered
+/// by the fencing thread right after the release's operation). While above 0 every later release
+/// is held too: release words then keep their order. Otherwise a plain or max release written at
+/// once (downloads landed meanwhile) was overwritten by an older held one landing after it, and
+/// the word moved backwards (GEQ acquires waiting forever, see the QMD max release).
+inline std::atomic<u64> g_held_releases_pending{};
+/// Set by the caller (this thread only) around the SignalFence of a release HoldRelease held: the
+/// fence manager then queues the matching decrement right after the release's operation.
+inline thread_local bool g_signaling_held_release = false;
+
+/// Called just before a guest-visible semaphore/query release is signalled: whether it must wait
+/// for its fence to pop (the caller then signals it as a delayed, never skipped fence, with
+/// g_signaling_held_release set).
+inline bool HoldRelease() {
+    if (Mode() == 0) {
+        return false;
+    }
+    const bool in_flight = g_downloads_in_flight.load(std::memory_order_acquire) != 0;
+    if (!in_flight && g_held_releases_pending.load(std::memory_order_acquire) == 0) {
+        return false;
+    }
+    if (in_flight) {
+        g_releases_during_downloads.fetch_add(1, std::memory_order_relaxed);
+    }
+    if (Mode() < 2) {
+        return false;
+    }
+    g_releases_held.fetch_add(1, std::memory_order_relaxed);
+    g_held_releases_pending.fetch_add(1, std::memory_order_acq_rel);
+    return true;
+}
+
+/// EDEN_NX2_OVERWRITE_CHECK=1: a log that tells the two flash theories apart in one run (run it
+/// with EDEN_NX2_READBACK_WAIT unset: held increments would make the back look behind).
+///  - overwrite: guest CPU writes made after the CPU presented frame P, applied while the GPU
+///    thread had not reached P's present fence yet ("ahead" writes), and the GPU thread then
+///    reading those bytes for frame P's remaining work ("ahead reads": P drawn with P+1's data);
+///  - readback: guest CPU writes over GPU-written ranges whose fence download has not landed
+///    ("early writes": the CPU acted on a readback before the GPU's result reached it, e.g. the
+///    exposure meter's read-the-sum-then-store-0).
+/// One line per CPU frame (present) with either count above 0, with the wall clock in ms for
+/// lining up with video flash times, and a 5 s summary.
+inline bool OverwriteCheck() {
+    static const bool on = [] {
+        const bool value = Common::PeSwitch("EDEN_NX2_OVERWRITE_CHECK");
+        if (value) {
+            LOG_INFO(HW_GPU, "EDEN_NX2_OVERWRITE_CHECK=1: per-frame ahead reads and early writes "
+                             "are logged as 'OverwriteCheck'");
+        }
+        return value;
+    }();
+    return on;
+}
+
+/// The latest present's fence, (id << 32) | value (~0: none), and its number. Set by nx2:vi2
+/// PresentClientBuffer before it waits, only with OverwriteCheck().
+inline std::atomic<u64> g_present_fence{~u64{0}};
+inline std::atomic<u64> g_present_number{};
