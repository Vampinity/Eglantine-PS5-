+namespace {
+/// EDEN_NX2_OVERWRITE_CHECK: the thread that applies gathered guest CPU writes (the GPU thread or
+/// the split's back) only.
+struct OverwriteWindow {
+    u64 previous_fence = ~u64{0};  ///< Latest present's fence at the previous gather
+    u64 watched_fence = ~u64{0};   ///< Present whose fence the ahead writes wait for
+    u64 window_number = ~u64{0};   ///< CPU frame (present number) the counters belong to
+};
+OverwriteWindow overwrite_window;
+
+bool PresentFenceReached(Tegra::Host1x::SyncpointManager& syncpoints, u64 fence) {
+    const u32 id = static_cast<u32>(fence >> 32);
+    return fence == ~u64{0} || id >= Tegra::Host1x::SyncpointManager::NUM_MAX_SYNCPOINTS ||
+           syncpoints.IsReadyGuest(id, static_cast<u32>(fence));
+}
