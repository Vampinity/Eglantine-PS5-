+template <class P>
+void BufferCache<P>::OverwriteNoteCpuWrites(std::span<const std::pair<DAddr, u64>> ranges,
+                                            bool ahead) {
+    for (const auto& [device_addr, size] : ranges) {
+        if (size == 0) {
+            continue;
+        }
+        // Early write: the GPU's result for these bytes is queued for a fence download or in
+        // one that has not landed, and the CPU writes them already.
+        bool not_landed = uncommitted_gpu_modified_ranges.Intersects(device_addr, size);
+        for (const auto& range_set : committed_gpu_modified_ranges) {
+            not_landed = not_landed || range_set.Intersects(device_addr, size);
+        }
+        for (const auto& range_set : pending_download_ranges) {
+            not_landed = not_landed || range_set.Intersects(device_addr, size);
+        }
+        if (not_landed) {
+            if (overwrite_counts.early_writes == 0) {
+                overwrite_counts.first_early_write = device_addr;
+            }
+            ++overwrite_counts.early_writes;
+            overwrite_counts.early_write_bytes += size;
+        }
+        if (ahead) {
+            overwrite_ahead_ranges.Add(device_addr, size);
+            overwrite_ahead_active = true;
+            ++overwrite_counts.ahead_writes;
+            overwrite_counts.ahead_write_bytes += size;
+        }
+    }
+}
+
+template <class P>
+void BufferCache<P>::OverwriteClearAhead() {
+    overwrite_ahead_ranges.Clear();
+    overwrite_ahead_active = false;
+}
+
+template <class P>
+void BufferCache<P>::OverwriteCloseWindow(u64 present_number) {
+    const OverwriteCounts counts = overwrite_counts;
+    overwrite_counts = {};
+    OverwriteSummary& summary = overwrite_summary;
+    const auto now = std::chrono::steady_clock::now();
+    if (summary.frames == 0 && summary.start == std::chrono::steady_clock::time_point{}) {
+        summary.start = now;
+    }
+    if (present_number != ~u64{0}) {
+        ++summary.frames;
+        summary.frames_ahead_writes += counts.ahead_writes != 0 ? 1 : 0;
+        summary.frames_ahead_reads += counts.ahead_reads != 0 ? 1 : 0;
+        summary.frames_early_writes += counts.early_writes != 0 ? 1 : 0;
+        summary.frames_both += counts.ahead_reads != 0 && counts.early_writes != 0 ? 1 : 0;
+    }
+    if (present_number != ~u64{0} && (counts.ahead_reads != 0 || counts.early_writes != 0) &&
+        summary.lines < 20000) {
+        ++summary.lines;
+        // Wall clock: the video's flash times are lined up by it (the frame file names and the
+        // recording start are wall clock).
+        const s64 wall_ms = std::chrono::duration_cast<std::chrono::milliseconds>(
+                                std::chrono::system_clock::now().time_since_epoch())
+                                .count();
+        LOG_INFO(HW_GPU,
+                 "OverwriteCheck present #{} wall {}: ahead writes {} ({} B), ahead reads {} ({} "
+                 "B, first {:#x}); early writes {} ({} B, first {:#x})",
+                 present_number, wall_ms, counts.ahead_writes, counts.ahead_write_bytes,
+                 counts.ahead_reads, counts.ahead_read_bytes, counts.first_ahead_read,
+                 counts.early_writes, counts.early_write_bytes, counts.first_early_write);
+    }
+    if (now - summary.start >= std::chrono::seconds{5}) {
+        LOG_INFO(HW_GPU,
+                 "OverwriteCheck 5 s: {} frames, {} with ahead writes, {} with ahead reads, {} "
+                 "with early writes, {} with both",
+                 summary.frames, summary.frames_ahead_writes, summary.frames_ahead_reads,
+                 summary.frames_early_writes, summary.frames_both);
+        const u64 lines = summary.lines;
+        summary = {};
+        summary.start = now;
+        summary.lines = lines;
+    }
+}
