+/// EDEN_NX2_READBACK_WAIT=2 and up: around the SignalFence of a semaphore release, makes it wait
+/// for its fence (after downloads in flight) as the query cache's reports do. Off: does nothing.
+class ReleaseHoldScope {
+public:
+    ReleaseHoldScope() : hold{VideoCore::Readback::HoldRelease()} {
+        if (hold) {
+            VideoCore::g_signaling_query_report_fence = true;
+            VideoCore::Readback::g_signaling_held_release = true;
+        }
+    }
+    ~ReleaseHoldScope() {
+        if (hold) {
+            VideoCore::g_signaling_query_report_fence = false;
+            VideoCore::Readback::g_signaling_held_release = false;
+        }
+    }
+    ReleaseHoldScope(const ReleaseHoldScope&) = delete;
+    ReleaseHoldScope& operator=(const ReleaseHoldScope&) = delete;
+
+private:
+    bool hold;
+};
