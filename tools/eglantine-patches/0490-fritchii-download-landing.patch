+
+template <class P>
+void BufferCache<P>::NoteLandingLook(bool full_look) {
+    if (!VideoCore::LandingPort::StatsEnabled()) {
+        return;
+    }
+    if (full_look) {
+        // The download writes over none of the writes collected by now: nothing can be lost.
+        landing_stats_seen.Clear();
+        return;
+    }
+    landing_stats_seen = CollectedCpuWriteRanges();
+}
+
+template <class P>
+u64 BufferCache<P>::NotLandedBytes(DAddr device_addr, u64 size) {
+    Common::RangeSet<DAddr> not_landed;
+    const auto add = [&](DAddr start, DAddr end) { not_landed.Add(start, end - start); };
+    uncommitted_gpu_modified_ranges.ForEachInRange(device_addr, size, add);
+    for (const auto& range_set : committed_gpu_modified_ranges) {
+        range_set.ForEachInRange(device_addr, size, add);
+    }
+    for (const auto& range_set : pending_download_ranges) {
+        range_set.ForEachInRange(device_addr, size, add);
+    }
+    u64 bytes = 0;
+    not_landed.ForEach([&](DAddr start, DAddr end) { bytes += end - start; });
+    return bytes;
+}
+
+template <class P>
+void BufferCache<P>::EndLandingStats(VideoCore::LandingPort::Site site) {
+    if (!VideoCore::LandingPort::StatsEnabled()) {
+        return;
+    }
+    if (landing_stats_bytes == 0) {
+        landing_stats_seen.Clear();
+        return;
+    }
+    namespace LandingPort = VideoCore::LandingPort;
+    auto& counters = LandingPort::g_counters;
+    LandingPort::Add(counters.landings[static_cast<size_t>(site)], 1);
+    LandingPort::Add(counters.bytes[static_cast<size_t>(site)], landing_stats_bytes);
+    if (landing_stats_kept != 0) {
+        LandingPort::Add(counters.kept_landings, 1);
+        LandingPort::Add(counters.kept_bytes, landing_stats_kept);
+    }
+    // Lost: bytes written over a guest CPU write already collected when the download wrote
+    // (NoteLandingLook) that its look did not keep off (empty or guarded): the guest stored its
+    // bytes first, the GPU's older ones replaced them.
+    u64 lost_bytes = 0;
+    landing_stats_lost.ForEach([&](DAddr start, DAddr end) { lost_bytes += end - start; });
+    if (lost_bytes != 0) {
+        LandingPort::Add(counters.lost_landings, 1);
+        LandingPort::Add(counters.lost_bytes, lost_bytes);
+    }
+    // Raced: bytes written under a guest CPU write collected now, whatever EDEN_NX2_DOWNLOAD_GUARDS
+    // says, but not yet when the download wrote: collected while it wrote (in a landing's range
+    // such a write waited for it; without one its bytes are lost if stored before the download's)
+    // or after it (safe either way): an upper bound.
+    if (pending_cpu_writes) {
+        Common::RangeSet<DAddr> raced;
+        pending_cpu_writes([&](DAddr device_addr, size_t size) {
+            landing_stats_written.ForEachInRange(
+                device_addr, size, [&](DAddr start, DAddr end) { raced.Add(start, end - start); });
+        });
+        landing_stats_lost.ForEach(
+            [&](DAddr start, DAddr end) { raced.Subtract(start, end - start); });
+        u64 raced_bytes = 0;
+        raced.ForEach([&](DAddr start, DAddr end) { raced_bytes += end - start; });
+        if (raced_bytes != 0) {
+            LandingPort::Add(counters.raced_landings, 1);
+            LandingPort::Add(counters.raced_bytes, raced_bytes);
+        }
+    }
+    landing_stats_written.Clear();
+    landing_stats_seen.Clear();
+    landing_stats_lost.Clear();
+    landing_stats_bytes = 0;
+    landing_stats_kept = 0;
+    LandingPort::MaybeReport(DownloadGuards());
+}
