+template <class P>
+Common::RangeSet<DAddr> BufferCache<P>::LandingCpuWriteRanges() {
+    // EDEN_UP_FRITCHII_DOWNLOAD_LANDING (Frizti/Fritchii 8f09b0fd90, whose downloads always look):
+    // every collected CPU write, whatever EDEN_NX2_DOWNLOAD_GUARDS says. Off:
+    // GuardedCpuWriteRanges, as before.
+    return VideoCore::LandingPort::Enabled() ? CollectedCpuWriteRanges() : GuardedCpuWriteRanges();
+}
+
+template <class P>
+Common::RangeSet<DAddr> BufferCache<P>::LandingLookRanges() {
+    // EDEN_UP_FRITCHII_DOWNLOAD_LANDING: as LandingCpuWriteRanges. Off: PendingCpuWriteRanges, as
+    // before (empty at EDEN_NX2_DOWNLOAD_GUARDS=0).
+    return VideoCore::LandingPort::Enabled() ? CollectedCpuWriteRanges() : PendingCpuWriteRanges();
