--- /dev/null
+++ b/src/video_core/nx2_download_landing.h
@@ -0,0 +1,179 @@
+// SPDX-FileCopyrightText: Copyright 2026 Eden Emulator Project
+// SPDX-License-Identifier: GPL-3.0-or-later
+
+#pragma once
+
+#include <array>
+#include <atomic>
+#include <cstdlib>
+
+#include "common/common_types.h"
+#include "common/logging.h"
+#include "common/pe_switch.h"
+#include "video_core/nx2_async_readback.h"
+#include "video_core/rasterizer_download_area.h"
+
+// Port of Frizti/Fritchii 8f09b0fd90 (Frizti; "core, video_core: let guest writes wait for a
+// download landing under them", itself a port of zortos293/Lichii #805 4942eb8a39 by jpkto).
+// T85 has that commit's protocol already (0486, Lichii #1028's df0b5f6bde), but only inside
+// EDEN_UP_L1028_ASYNC_READBACK. Off unless exactly "1" (Common::PeSwitch, read once):
+// - EDEN_UP_FRITCHII_DOWNLOAD_LANDING: the same protocol without the async read-back: every buffer
+//   cache download writes guest memory inside a VideoCore::DownloadLanding and looks at the
+//   collected guest CPU writes inside it, after any host GPU wait; a guest CPU write collected in a
+//   landing's range stores its bytes once it ended (core/memory.cpp); writes being applied stay
+//   pending (GPU::GatherAndApply). Fritchii's own parts: a fence's downloads land per copy (copies
+//   within a page of each other together) instead of in one landing over their hull, and every
+//   look keeps every collected guest CPU write, whatever EDEN_NX2_DOWNLOAD_GUARDS says (Fritchii
+//   has no such switch; without this one the looks find nothing at 0, play env v2.4's level).
+//   The looks keep whole 64-byte blocks: GPU bytes sharing a block with a newer guest write are
+//   not written.
+// - EDEN_UP_FRITCHII_DOWNLOAD_LANDING_STATS: one line every 10 s, no behaviour change (give it to
+//   the control arm too): what the buffer cache's downloads did to guest memory and what the guest
+//   did to them before they landed. Late: a download came after a newer guest CPU write: kept off
+//   by its look, lost (written over one collected before the download wrote) or raced (written
+//   under one collected since). Early: the guest looked up an area, or wrote over bytes, whose
+//   fence download had not landed yet. Without either landing switch, writes gathered and not yet
+//   applied are not seen (GPU::ForEachPendingCpuWrite): lost and raced are lower there.
+namespace VideoCore::LandingPort {
+
+/// EDEN_UP_FRITCHII_DOWNLOAD_LANDING=1
+[[nodiscard]] inline bool Enabled() {
+    static const bool on = [] {
+        const bool value = Common::PeSwitch("EDEN_UP_FRITCHII_DOWNLOAD_LANDING");
+        if (value) {
+            const char* const guards = std::getenv("EDEN_NX2_DOWNLOAD_GUARDS");
+            LOG_INFO(HW_GPU,
+                     "EDEN_UP_FRITCHII_DOWNLOAD_LANDING=1: buffer downloads land inside a "
+                     "DownloadLanding (fence downloads per copy group) and keep every collected "
+                     "guest CPU write, whatever EDEN_NX2_DOWNLOAD_GUARDS (={}) says; guest CPU "
+                     "writes collected under a landing wait for it",
+                     guards != nullptr ? guards : "unset");
+        }
+        return value;
+    }();
+    return on;
+}
+
+/// Downloads land inside a DownloadLanding and guest CPU writes await it: with this port's switch
+/// or with EDEN_UP_L1028_ASYNC_READBACK (which has the protocol since 0486).
+[[nodiscard]] inline bool Active() {
+    static const bool on = Enabled() || AsyncReadback::Enabled();
+    return on;
+}
+
+/// EDEN_UP_FRITCHII_DOWNLOAD_LANDING_STATS=1
+[[nodiscard]] inline bool StatsEnabled() {
+    static const bool on = Common::PeSwitch("EDEN_UP_FRITCHII_DOWNLOAD_LANDING_STATS");
+    return on;
+}
+
+/// Where a buffer cache download wrote guest memory.
+enum class Site : u8 {
+    Fence, ///< PopAsyncBuffers: a fence's downloads, on the fencing thread
+    Sync,  ///< DownloadBufferMemory, DownloadBuffersMemory, DownloadRangesMemory, pieces
+    Read,  ///< EDEN_UP_L1028_ASYNC_READBACK's read downloads (WriteReadDownloads)
+    Count,
+};
+
+/// Totals for the 10 s line, from every thread (the buffer cache's under its lock).
+struct Counters {
+    /// Download calls that wrote guest memory, and the bytes they brought
+    std::array<std::atomic<u64>, static_cast<size_t>(Site::Count)> landings{};
+    std::array<std::atomic<u64>, static_cast<size_t>(Site::Count)> bytes{};
+    /// EDEN_UP_FRITCHII_DOWNLOAD_LANDING: the per copy group landings PopAsyncBuffers made
+    std::atomic<u64> fence_groups{};
+    /// Late, kept off: downloads whose look (or EDEN_UP_HELD_VS_DOWNLOAD) kept bytes of a newer
+    /// guest CPU write out of their write, and those bytes
+    std::atomic<u64> kept_landings{};
+    std::atomic<u64> kept_bytes{};
+    /// Late, lost: downloads that wrote over a guest CPU write collected before they wrote (their
+    /// look was empty or guarded), and those bytes: the guest's bytes were replaced by older ones
+    std::atomic<u64> lost_landings{};
+    std::atomic<u64> lost_bytes{};
+    /// Late, raced: downloads that wrote under a guest CPU write collected after they looked and
+    /// still collected when they ended, and those bytes. In a landing's range such a write waited;
+    /// without one its bytes are lost if stored before the download's. An upper bound: writes
+    /// collected after the download wrote count too.
+    std::atomic<u64> raced_landings{};
+    std::atomic<u64> raced_bytes{};
+    /// Early, a lower bound: Preflushable area lookups (GetFlushArea) answered from guest memory
+    /// while a fence download of their bytes had not landed, and those bytes. Reads inside an area
+    /// the core keeps do not look it up again.
+    std::atomic<u64> early_reads{};
+    std::atomic<u64> early_read_bytes{};
+    /// Early: guest CPU writes applied (ClaimCpuWrites) over bytes whose fence download had not
+    /// landed, and the bytes of fence downloads they dropped
+    std::atomic<u64> early_writes{};
+    std::atomic<u64> dropped_bytes{};
+    /// DownloadLanding's totals at the last line
+    std::atomic<u64> waits_reported{};
+    std::atomic<u64> wait_ns_reported{};
+    std::atomic<u64> window_start{};
+};
+
+inline Counters g_counters;
+
+inline void Add(std::atomic<u64>& counter, u64 amount) {
+    counter.fetch_add(amount, std::memory_order_relaxed);
+}
+
+/// Logs the totals every 10 s and resets them, on whichever thread counts first after that.
+/// `guards`: the buffer cache's EDEN_NX2_DOWNLOAD_GUARDS level (below 0: unset).
+inline void MaybeReport(int guards) {
+    auto& c = g_counters;
+    const u64 now = AsyncReadback::Now();
+    u64 start = c.window_start.load(std::memory_order_relaxed);
+    if (start == 0) {
+        c.window_start.compare_exchange_strong(start, now, std::memory_order_relaxed);
+        return;
+    }
+    if (now - start < 10'000'000'000ULL ||
+        !c.window_start.compare_exchange_strong(start, now, std::memory_order_relaxed)) {
+        return;
+    }
+    const auto take = [](std::atomic<u64>& counter) {
+        return counter.exchange(0, std::memory_order_relaxed);
+    };
+    const auto kib = [](u64 bytes) { return static_cast<double>(bytes) / 1024.0; };
+    constexpr auto fence = static_cast<size_t>(Site::Fence);
+    constexpr auto sync = static_cast<size_t>(Site::Sync);
+    constexpr auto read = static_cast<size_t>(Site::Read);
+    const u64 fence_landings = take(c.landings[fence]);
+    const u64 sync_landings = take(c.landings[sync]);
+    const u64 read_landings = take(c.landings[read]);
+    const u64 landed_bytes = take(c.bytes[fence]) + take(c.bytes[sync]) + take(c.bytes[read]);
+    const u64 fence_groups = take(c.fence_groups);
+    const u64 kept_landings = take(c.kept_landings);
+    const u64 kept_bytes = take(c.kept_bytes);
+    const u64 lost_landings = take(c.lost_landings);
+    const u64 lost_bytes = take(c.lost_bytes);
+    const u64 raced_landings = take(c.raced_landings);
+    const u64 raced_bytes = take(c.raced_bytes);
+    const u64 early_reads = take(c.early_reads);
+    const u64 early_read_bytes = take(c.early_read_bytes);
+    const u64 early_writes = take(c.early_writes);
+    const u64 dropped_bytes = take(c.dropped_bytes);
+    const u64 waits_total = DownloadLanding::Waits();
+    const u64 wait_ns_total = DownloadLanding::WaitNs();
+    const u64 waits =
+        waits_total - c.waits_reported.exchange(waits_total, std::memory_order_relaxed);
+    const u64 wait_ns =
+        wait_ns_total - c.wait_ns_reported.exchange(wait_ns_total, std::memory_order_relaxed);
+    LOG_INFO(HW_GPU,
+             "Download landing ({:.1f} s; landing {}, L1028 {}, guards {}): landed {} fence "
+             "downloads ({} copy group landings), {} synchronous, {} read downloads, {:.1f} KiB "
+             "| late, kept off a newer guest CPU write: {} downloads, {:.1f} KiB skipped | late, "
+             "lost, written over a guest CPU write collected before: {} downloads, {:.1f} KiB | "
+             "late, raced, written under one collected since (upper bound): {} downloads, {:.1f} "
+             "KiB | guest CPU writes held by a landing: {}, {:.2f} ms | early (lower bound): {} "
+             "area lookups of bytes whose fence download had not landed ({:.1f} KiB), {} guest "
+             "CPU writes over such bytes ({:.1f} KiB of fence downloads dropped)",
+             static_cast<double>(now - start) / 1e9, Enabled() ? "on" : "off",
+             AsyncReadback::Enabled() ? "on" : "off", guards, fence_landings, fence_groups,
