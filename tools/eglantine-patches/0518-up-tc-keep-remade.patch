     ClearStale(cpu_addr, size);
@@ -4597,11 +4718,85 @@ ImageId TextureCache<P>::InsertImage(const ImageInfo& info, GPUVAddr gpu_addr,
                  gpu_addr, info.size.width, info.size.height, info.size.depth, info.resources.levels,
                  static_cast<u32>(info.format), info.block.width, info.block.height, info.block.depth);
     }
+    // EDEN_UP_TC_TRACE: JoinImages' time for the "TCTRACE create" line.
+    const auto trace_start =
+        TcTrace() ? std::chrono::steady_clock::now() : std::chrono::steady_clock::time_point{};
     const ImageId image_id = JoinImages(storage_info, gpu_addr, *cpu_addr);
     if (!image_id) {
+        if (TcTrace() && CalculateGuestSizeInBytes(info) >= TcTraceMinBytes()) {
+            LOG_WARNING(HW_GPU,
+                        "TCTRACE refused gpu={:#x} type={} fmt={} {}x{}x{} lv={} ly={} guest={}KiB "
+                        "frame={}",
+                        gpu_addr, static_cast<u32>(info.type), static_cast<u32>(info.format),
+                        info.size.width, info.size.height, info.size.depth, info.resources.levels,
+                        info.resources.layers, CalculateGuestSizeInBytes(info) / 1024, frame_tick);
+        }
         return ImageId{}; // Refused (JoinImages): nothing was made.
     }
     const Image& image = slot_images[image_id];
+    if (TcTrace() && image.guest_size_bytes >= TcTraceMinBytes()) {
+        const double ms = std::chrono::duration<double, std::milli>(
+                              std::chrono::steady_clock::now() - trace_start)
+                              .count();
+        LOG_WARNING(HW_GPU,
+                    "TCTRACE create id={} gpu={:#x} type={} fmt={} {}x{}x{} lv={} ly={} guest={}KiB "
+                    "joined={} found={} ms={:.2f} frame={}",
+                    image_id.index, image.gpu_addr, static_cast<u32>(info.type),
+                    static_cast<u32>(info.format), info.size.width, info.size.height,
+                    info.size.depth, image.info.resources.levels, image.info.resources.layers,
+                    image.guest_size_bytes / 1024, join_overlap_ids.size(),
+                    join_overlaps_found.size(), ms, frame_tick);
+    }
+    if (KeepRemadeCandidate(image)) {
+        // EDEN_UP_TC_KEEP_REMADE: large from the start, or made again after a collector's delete.
+        const u64 decode = AstcDecodeBytes(image.info);
+        const u64 held = ImageMemoryBytes(image);
+        const u64 large = KeepRemadeLargeBytes();
+        const u64 remade = KeepRemadeMinBytes();
+        u64 since = ~u64{0};
+        if (held <= 256_MiB && !(large != 0 && decode > large) && remade != 0 && decode >= remade) {
+            const auto it = keep_remade_deleted.find(image.gpu_addr);
+            if (it != keep_remade_deleted.end()) {
+                const KeepRemadeDeleted& gone = it->second;
+                if (frame_tick - gone.frame <= KeepRemadeWindow &&
+                    gone.format == static_cast<u32>(image.info.format) &&
+                    gone.width == image.info.size.width && gone.height == image.info.size.height &&
