+/// EDEN_UP_TC_KEEP_REMADE=1 (Common::PeSwitch, exact 1; off unless set): converted ASTC that a
+/// collector would delete and the game would make again is left alone the way
+/// EDEN_NX2_TC_KEEP_ASYNC leaves AsynchronousDecode images. Every collector skips it
+/// (RunGarbageCollector, CollectForBuffer, AreaEvict, RefusalEvict, RefusalDownloadEvict) until it
+/// has gone unused for EDEN_NX2_TC_OLD_AGE frames (the collector's old pass, under pressure);
+/// unmaps and joins delete it as before, and guest writes upload it again as before. Lichii #1129's
+/// alternative, from its PR text (liomaroliveira: exempt CostlyLoad images the collector evicted
+/// and the game re-created within N frames), not its code. Why here: EDEN_NX2_GPU_TRANSCODE_MIB=256
+/// sends Ocarina of Time's 6144x6144 ground texture (192 MiB decode image) to the GPU transcode, so
+/// it loses AsynchronousDecode and with it KEEP_ASYNC; the pool-pressure collector then deletes it,
+/// and each new copy needs the 192 MiB decode image and a 48 MiB BC3 output again (t85-f run704:
+/// four refusals of it in 20 s, runs 739/742/743: made 3 times each). A candidate is ASTC the host
+/// does not sample as ASTC (Converted), CostlyLoad, not AsynchronousDecode (those stay KEEP_ASYNC's,
+/// whatever it is set to), backed whole (not Unbacked, UnwrittenSparse, SparseLayers or SparseTiles)
+/// and holding at most 256 MiB of device memory. It is kept
+///  - from its creation when its RGBA8 decode (every level and layer) is over
+///    EDEN_UP_TC_KEEP_REMADE_MIB (default 128, the default GPU transcode limit: what KEEP_ASYNC
+///    covered before the limit was raised; 0: none this way), or
+///  - when a collector deleted a candidate at the same address with the same format, size, levels
+///    and layers at most 600 frames before, and its decode is at least
+///    EDEN_UP_TC_KEEP_REMADE_MIN_MIB (default 32: Ocarina's 3072x3072 ASTC, 48 MiB; 0: none).
+/// Sizes are digits, 0..4096, read once; anything else means the default. HW_GPU lines:
+/// "EDEN_UP_TC_KEEP_REMADE: keeping ..." and "EDEN_UP_TC_KEEP_REMADE: kept ... deleted (reason)",
+/// the first 64 of each, then each power of two.
+[[nodiscard]] inline bool KeepRemade() {
+    static const bool enabled = Common::PeSwitch("EDEN_UP_TC_KEEP_REMADE");
+    return enabled;
+}
+
+/// A size in MiB from `name`: digits only, 0..4096; unset, empty or anything else: `fallback`.
+[[nodiscard]] inline u64 KeepRemadeEnvBytes(const char* name, u64 fallback) {
+    const char* const value = std::getenv(name);
+    if (value == nullptr || *value == '\0') {
+        return fallback << 20;
+    }
+    u64 mib = 0;
+    for (const char* c = value; *c != '\0'; ++c) {
+        if (*c < '0' || *c > '9') {
+            return fallback << 20;
+        }
+        mib = mib * 10 + static_cast<u64>(*c - '0');
+        if (mib > 4096) {
+            return fallback << 20;
+        }
+    }
+    return mib << 20;
+}
+
+[[nodiscard]] inline u64 KeepRemadeLargeBytes() {
+    static const u64 bytes = KeepRemadeEnvBytes("EDEN_UP_TC_KEEP_REMADE_MIB", 128);
+    return bytes;
+}
+
+[[nodiscard]] inline u64 KeepRemadeMinBytes() {
+    static const u64 bytes = KeepRemadeEnvBytes("EDEN_UP_TC_KEEP_REMADE_MIN_MIB", 32);
+    return bytes;
+}
+
+/// How long EDEN_UP_TC_KEEP_REMADE remembers a collector's delete, in frames.
+constexpr u64 KeepRemadeWindow = 600;
+
+/// What ASTC decodes to as RGBA8, every level and layer: TranscodeAstcToBcn's decode image
+/// (vk_texture_cache.cpp TranscodeScratchTooLarge sums the same).
+[[nodiscard]] inline u64 AstcDecodeBytes(const ImageInfo& info) {
+    u64 bytes = 0;
+    for (s32 level = 0; level < info.resources.levels; ++level) {
+        bytes += u64{(std::max)(info.size.width >> level, 1U)} *
+                 (std::max)(info.size.height >> level, 1U) * 4;
+    }
+    return bytes * static_cast<u64>(info.resources.layers);
+}
+
+/// Whether EDEN_UP_TC_KEEP_REMADE looks at the image at all (sizes aside). False with it off.
+[[nodiscard]] inline bool KeepRemadeCandidate(const ImageBase& image) {
+    return KeepRemade() && VideoCore::Surface::IsPixelFormatASTC(image.info.format) &&
+           True(image.flags & ImageFlagBits::Converted) &&
+           True(image.flags & ImageFlagBits::CostlyLoad) &&
+           False(image.flags & (ImageFlagBits::AsynchronousDecode | ImageFlagBits::Unbacked |
+                                ImageFlagBits::UnwrittenSparse | ImageFlagBits::SparseLayers |
+                                ImageFlagBits::SparseTiles));
+}
+
+/// Kept by EDEN_UP_TC_KEEP_REMADE: the collectors skip it as they skip AsynchronousDecode images
+/// with EDEN_NX2_TC_KEEP_ASYNC. Only ever true with the switch on (InsertImage sets it).
+[[nodiscard]] inline bool KeptRemade(const ImageBase& image) {
+    return image.tc_keep_remade;
+}
+
+/// EDEN_UP_TC_TRACE=1 (Common::PeSwitch, exact 1; off unless set): Lichii #1130 by liomaroliveira
+/// (upstream EDEN_NX2_TC_TRACE). One HW_GPU line per image the cache makes ("TCTRACE create": id,
+/// GPU address, type, format, size, levels and layers of the image made, guest KiB, overlaps joined
+/// and found, JoinImages ms, frame) and per image it deletes ("TCTRACE delete", with the reason:
+/// gc, gc-high-priority, gc-aggressive, gc-old (unused for EDEN_NX2_TC_OLD_AGE frames), gc-buffer
+/// (CollectForBuffer), gc-area (AreaEvict), gc-refusal (RefusalEvict), gc-refusal-copied
+/// (RefusalDownloadEvict), cold (EDEN_UP_FRITCHII_COLD), unmap, join, join-ignored, other). Ours
+/// also: "TCTRACE refused" when JoinImages makes nothing. EDEN_UP_TC_TRACE_MIB=<N> (digits,
+/// 0..4096; unset or 0: every image, as upstream): only images of at least N MiB of guest memory.
+[[nodiscard]] inline bool TcTrace() {
+    static const bool enabled = Common::PeSwitch("EDEN_UP_TC_TRACE");
+    return enabled;
+}
+
+[[nodiscard]] inline u64 TcTraceMinBytes() {
+    static const u64 bytes = TcTrace() ? KeepRemadeEnvBytes("EDEN_UP_TC_TRACE_MIB", 0) : 0;
+    return bytes;
+}
+
