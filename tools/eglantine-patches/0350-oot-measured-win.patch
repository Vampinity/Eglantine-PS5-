From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: EglantinePS5 <noreply@eglantineps5.local>
Date: Sun, 8 Nov 2026 00:00:00 +0000
Subject: [PATCH] buffer_cache: reuse longer contiguous walks for OoT

Measured source: zortos293/Lichii PR #580 reports Ocarina's alternating-size
storage binds consumed 4.2% of the GPU back thread. Cache a single contiguous
range for shorter prefixes, while split ranges still require an exact match.

Break risk: a mistaken prefix reuse could bind a range crossing a mapping hole;
that would show as wrong geometry, corrupted storage-buffer data, or a GPU fault.
The one-segment guard and the accompanying upstream tests keep split mappings on
the old exact-match path.

---
diff --git a/src/video_core/buffer_cache/virtual_range_cache.h b/src/video_core/buffer_cache/virtual_range_cache.h
index f4284d6abb..6ec8a6dab5 100644
--- a/src/video_core/buffer_cache/virtual_range_cache.h
+++ b/src/video_core/buffer_cache/virtual_range_cache.h
@@ -30,7 +30,10 @@ public:
     static constexpr size_t MAX_ENTRIES = 8192;
     static constexpr size_t MAX_DEFERRED = 4096;
 
-    const VirtualSegments* Query(Tegra::MemoryManager& memory, GPUVAddr gpu_addr, u32 size) {
+    /// The segments of a range when it has more than one. Fewer than two means that it needs no
+    /// splitting: one segment may then cover more than the range asked for.
+    template <typename Memory = Tegra::MemoryManager>
+    const VirtualSegments* Query(Memory& memory, GPUVAddr gpu_addr, u32 size) {
         if (has_deferred.load(std::memory_order_acquire)) {
             ApplyDeferred();
         }
@@ -40,9 +43,14 @@ public:
         const size_t as_id = memory.GetID();
         const u64 key = MakeKey(as_id, gpu_addr);
         const auto it = entries.find(key);
-        if (it != entries.end() && it->second.as_id == as_id &&
-            it->second.gpu_addr == gpu_addr && it->second.size == size) {
-            return &it->second.segments;
+        if (it != entries.end() && it->second.as_id == as_id && it->second.gpu_addr == gpu_addr) {
+            const Entry& cached = it->second;
+            // Titles bind one address with several sizes (Ocarina of Time ~2,000 times a second,
+            // half of them over 1 MiB). Keep the page table walk of the longest: its prefixes are
+            // contiguous too.
+            if (cached.size == size || (cached.segments.size() == 1 && size < cached.size)) {
+                return &cached.segments;
+            }
         }
         Entry entry{};
         entry.as_id = as_id;
