+namespace {
+
+// zortos293/Lichii #1016 (zortos293), after Eglantine #538 (pretend7979): the timer thread's wait
+// for the next event. Upstream's Windows wait was a user-mode MWAITX/UMWAIT loop that kept a core
+// busy; #1016 sleeps in the OS instead. Event::WaitFor takes that loop only under _WIN32, and
+// elsewhere it is already a condition-variable wait, which is also what #1016 does off Windows.
+// EDEN_UP_L1016_TIMING_SLEEP=1: wait with Event::WaitUntil, the condition variable on every
+// platform (upstream's high-resolution Windows timer is not ported). Set() still ends the wait at
+// once, so an event scheduled earlier during the wait is picked up by the next Advance().
+// EDEN_UP_L1016_STATS=1: one line every 10 s about these waits (no behaviour change).
+// Both are read once, when the timer thread starts.
+struct L1016Waits {
+    bool sleep = false;
+    bool stats = false;
+    s64 start = 0;
+    s64 cpu_start = -1;
+    s64 waited_ns = 0;
+    u64 waits = 0;
+    u64 set_wakes = 0;
+    u64 timeouts = 0;
+    // How late each timed-out wait returned past its deadline, in 1 us buckets (the last bucket
+    // also holds anything later), plus the exact maximum. A histogram, not a list to sort: at
+    // about 10^5 waits per 10 s a sort would hold up this thread, and its events, for milliseconds.
+    // Allocated once, when STATS is on.
+    static constexpr std::size_t LATE_BUCKETS = 8192;
+    std::vector<u32> late;
+    u64 late_count = 0;
+    s64 late_max_ns = 0;
+
+    static s64 ThreadCpuNs() {
+#if defined(CLOCK_THREAD_CPUTIME_ID)
+        timespec ts{};
+        if (clock_gettime(CLOCK_THREAD_CPUTIME_ID, &ts) == 0) {
+            return static_cast<s64>(ts.tv_sec) * 1'000'000'000 + ts.tv_nsec;
+        }
+#endif
+        return -1;
+    }
+
+    static unsigned long long AffinityMask() {
+        unsigned long long mask = 0;
+#if defined(__PROSPERO__)
+        cpuset_t set{};
+        if (cpuset_getaffinity(CPU_LEVEL_WHICH, CPU_WHICH_TID, -1, sizeof(unsigned long long),
+                               &set) == 0) {
+            for (unsigned cpu = 0; cpu < 64; ++cpu) {
+                if (CPU_ISSET(cpu, &set)) {
+                    mask |= 1ULL << cpu;
+                }
+            }
+        }
+#endif
+        return mask;
+    }
+
+    template <typename Now>
+    void Wait(Common::Event& event, s64 deadline, s64 wait_ns, Now&& now_ns) {
+        const s64 begin = stats ? now_ns() : 0;
+        const bool set =
+            sleep ? event.WaitUntil(std::chrono::steady_clock::now() + std::chrono::nanoseconds(wait_ns))
+                  : event.WaitFor(std::chrono::nanoseconds(wait_ns));
+        if (!stats) {
+            return;
+        }
+        const s64 end = now_ns();
+        ++waits;
+        waited_ns += end - begin;
+        if (set) {
+            ++set_wakes;
+        } else {
+            ++timeouts;
+            const s64 late_ns = std::max<s64>(end - deadline, 0);
+            ++late[std::min<std::size_t>(static_cast<std::size_t>(late_ns / 1000), LATE_BUCKETS - 1)];
+            ++late_count;
+            late_max_ns = std::max(late_max_ns, late_ns);
+        }
+        if (start == 0) {
+            start = end;
+            cpu_start = ThreadCpuNs();
+        } else if (end - start >= 10'000'000'000) {
+            Report(end);
+        }
+    }
 
+    void Report(s64 now) {
+        const f64 seconds = static_cast<f64>(now - start) / 1e9;
+        // The bucket (us) that holds the index-th smallest late value.
+        const auto at = [this](u64 index) {
+            u64 seen = 0;
+            for (std::size_t us = 0; us < late.size(); ++us) {
+                seen += late[us];
+                if (seen > index) {
+                    return static_cast<s64>(us);
+                }
+            }
+            return s64{0};
+        };
+        const s64 cpu = ThreadCpuNs();
+        const f64 cpu_ms = cpu >= 0 && cpu_start >= 0 ? static_cast<f64>(cpu - cpu_start) / 1e6 / seconds
+                                                      : -1.0;
+        LOG_INFO(Core_Timing,
+                 "Lichii #1016 HostTiming in {:.1f} s (EDEN_UP_L1016_TIMING_SLEEP={}): {} waits, {} "
+                 "woken by Set, {} timed out; timed-out waits late p50/p99/max {}/{}/{} us; in wait "
+                 "{:.1f} ms/s, thread CPU {:.1f} ms/s (-1: no clock); CPUs {:#x}",
+                 seconds, sleep ? 1 : 0, waits, set_wakes, timeouts, at(late_count / 2),
+                 at(late_count * 99 / 100), late_max_ns / 1000,
+                 static_cast<f64>(waited_ns) / 1e6 / seconds, cpu_ms, AffinityMask());
+        start = now;
+        cpu_start = cpu;
+        waited_ns = 0;
+        waits = set_wakes = timeouts = late_count = 0;
+        late_max_ns = 0;
+        std::fill(late.begin(), late.end(), 0u);
+    }
+};
+
+} // Anonymous namespace
+
 std::shared_ptr<EventType> CreateEvent(std::string name, TimedCallback&& callback) {
     return std::make_shared<EventType>(std::move(callback), std::move(name));
 }
