+// SPDX-FileCopyrightText: Copyright 2026 Eden Emulator Project
+// SPDX-License-Identifier: GPL-3.0-or-later
+
+// EDEN_UP_STAGE_CACHE (stage_cache.h): port of Djihads80/Eglantine d1195b7.
+
+#include <algorithm>
+#include <chrono>
+#include <cstdlib>
+#include <cstring>
+#include <new>
+#include <string>
+#include <type_traits>
+#include <utility>
+
+#include "common/cityhash.h"
+#include "common/logging.h"
+#include "common/pe_switch.h"
+#include "common/settings.h"
+#include "shader_recompiler/exception.h"
+#include "video_core/stage_cache.h"
+
+namespace VideoCommon {
+namespace {
+
+/// EDEN_UP_STAGE_CACHE_MIB unset, 0 or not a number. The boot's translations fill it while
+/// every worker compiles, with a few hundred MB free on the PS5, and allocator overhead is not
+/// counted.
+constexpr size_t DefaultMiB = 32;
+/// Translations kept per program and slot (they differ in the answers their reads got).
+constexpr size_t MaxPerSignature = 8;
+/// Emitted stages kept per translation (they differ in runtime info or incoming bindings).
+constexpr size_t MaxEmittedPerTranslation = 8;
+
+[[nodiscard]] size_t CapBytes() {
+    size_t mib = DefaultMiB;
+    if (const char* const text = std::getenv("EDEN_UP_STAGE_CACHE_MIB")) {
+        char* end = nullptr;
+        const unsigned long long asked = std::strtoull(text, &end, 10);
+        if (end != text && asked != 0) {
+            mib = static_cast<size_t>(std::clamp<unsigned long long>(asked, 8, 4096));
+        }
+    }
+    return mib << 20;
+}
+
+class Writer {
+public:
+    template <typename T>
+        requires std::is_trivially_copyable_v<T>
+    void Put(const T& value) {
+        const auto* const begin = reinterpret_cast<const u8*>(&value);
+        bytes.insert(bytes.end(), begin, begin + sizeof(T));
+    }
+
+    std::vector<u8> bytes;
+};
+
+[[nodiscard]] u64 HashBytes(const std::vector<u8>& bytes) {
+    return Common::CityHash64(reinterpret_cast<const char*>(bytes.data()), bytes.size());
+}
+
+/// The program and slot a signature starts with (StageCache::Signature: unique hash, then slot).
+[[nodiscard]] u64 ProgramKey(const std::vector<u8>& signature) {
+    return Common::CityHash64(reinterpret_cast<const char*>(signature.data()),
+                              (std::min)(signature.size(), sizeof(u64) + sizeof(u32)));
+}
+
+[[nodiscard]] u64 EncodeReplacement(const std::optional<Shader::ReplaceConstant>& value) {
+    return value ? (u64{1} << 32) | static_cast<u32>(*value) : 0;
+}
+
+template <typename Container>
+[[nodiscard]] size_t HeapOf(const Container& container) {
+    return container.capacity() * sizeof(typename Container::value_type);
+}
+
+/// What a program summary holds on the heap (a little over: small vectors count their inline
+/// part again).
+[[nodiscard]] size_t ProgramHeapBytes(const Shader::IR::Program& program) {
+    const Shader::Info& info = program.info;
+    size_t size = HeapOf(info.texture_buffer_descriptors) + HeapOf(info.image_buffer_descriptors) +
+                  HeapOf(info.texture_descriptors) + HeapOf(info.image_descriptors) +
+                  HeapOf(info.handle_programs) + HeapOf(info.storage_write_extents) +
+                  info.legacy_stores_mapping.size() * 64;
+    for (const auto& handle_program : info.handle_programs) {
+        size += HeapOf(handle_program);
+    }
+    return size;
+}
+
+[[nodiscard]] size_t EmittedBytes(const StageCache::Emitted& emitted) {
+    return sizeof(StageCache::Emitted) + HeapOf(emitted.runtime_key) + HeapOf(emitted.spirv) +
+           ProgramHeapBytes(emitted.program);
+}
+
+[[nodiscard]] size_t TranslationBytes(const StageCache::Translation& translation) {
+    return sizeof(StageCache::Translation) + HeapOf(translation.signature) +
+           HeapOf(translation.reads) + ProgramHeapBytes(translation.program);
+}
+
+/// What `env` answers to `read` now.
+[[nodiscard]] u64 Answer(Shader::Environment& env, const StageCache::Translation::Read& read) {
+    switch (read.kind) {
+    case StageCache::CbufValue:
+        return env.ReadCbufValue(read.a, read.b);
+    case StageCache::StoragePointer:
+        return env.IsCbufStorageBufferPointer(read.a, read.b) ? 1 : 0;
+    case StageCache::IndirectStoragePointer:
+        return env.IsCbufIndirectStorageBufferPointer(read.a, read.b, read.c) ? 1 : 0;
+    case StageCache::TextureType:
+        return static_cast<u64>(env.ReadTextureType(read.a));
+    case StageCache::TexturePixelFormat:
+        return static_cast<u64>(env.ReadTexturePixelFormat(read.a));
+    case StageCache::TextureInteger:
+        return env.IsTexturePixelFormatInteger(read.a) ? 1 : 0;
+    case StageCache::ViewportTransform:
+        return env.ReadViewportTransformState();
+    case StageCache::Replacement:
+        return EncodeReplacement(env.GetReplaceConstBuffer(read.a, read.b));
+    default:
+        // Never recorded: a value no answer gives.
+        return ~read.value;
+    }
+}
