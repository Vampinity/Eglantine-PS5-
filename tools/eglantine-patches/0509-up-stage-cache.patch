+// SPDX-FileCopyrightText: Copyright 2026 Eden Emulator Project
+// SPDX-License-Identifier: GPL-3.0-or-later
+
+// EDEN_UP_STAGE_CACHE=1 (default off): translated shader stages reused across pipelines.
+//
+// Port of Djihads80/Eglantine d1195b7 (EDEN_NX2_STAGE_CACHE there, on by default; that name is not
+// read here). Pipelines that differ only in fixed state (blending, depth, render targets, vertex
+// input) translate the same programs again: in an Ocarina of Time cold boot 64% of the stages gave
+// SPIR-V the same program had already given, about half of the translation time (upstream's
+// measurement, 0 differences on NVIDIA and RADV). On the PS5 translation is the stall: 8-18 ms a
+// pipeline on the GPU thread, up to 280 ms for a mesh pipeline.
+//
+// A stage's IR depends only on its program, the environment's constant properties and the
+// answers to the reads translation makes (constant buffer values, texture types and formats,
+// storage pointer checks, ...); its SPIR-V also on the runtime info and the bindings the earlier
+// stages took. A translation is reused when those reads, replayed in the order translation made
+// them, give the same answers: translation is deterministic, so every read replayed up to a
+// difference is one it would make too (the live environment ends up holding exactly the answers
+// its own translation would have asked for, which is what goes to the disk cache). Emitted
+// stages are reused when the runtime info and bindings are also byte-for-byte equal.
+//
+// Differences from upstream:
+// - Off unless EDEN_UP_STAGE_CACHE is exactly "1"; unset, the pipeline cache runs as before.
+// - Memory: EDEN_UP_STAGE_CACHE_MIB=<n> caps it (32 MiB; upstream 256 MiB and starts over). Past
+//   the cap the least recently used translations go until a quarter of the cap is free; at most
+//   8 translations per program and slot and 8 emitted variants per translation (the least
+//   recently used goes); two workers that translated the same stage at once keep one copy; a
+//   bad_alloc empties it. The driver's compiler running out of memory is not seen here, so the
+//   cap is the guard: the boot's translations fill it while every worker compiles.
+// - Reads are told apart exactly (upstream keeps a 64-bit hash of each read).
+// - A reuse replays the lowest and highest program address its translation read, so a program
+//   read past its known size still keeps the pipeline out of the disk cache
+//   (has_unbound_instructions; upstream skips this).
+// - The signature also holds the setting downscale and the OoT visual workaround's state, and
+//   EDEN_UP_STAGE_CACHE_VERIFY=1 also compares the shader infos (vk_pipeline_prep.h's
+//   SerializeInfo), not only SPIR-V and bindings.
+// - The log line counts which kind of read made a reuse fail, so a later relaxed match (texture
+//   handle and pointer words, as the shader preparation's AnswersHoldFor does) can be judged. It
+//   also counts lookups that found no translation with the same signature, and of those the ones
+//   whose program is held under another signature: a disk record's environment answers
+//   HasHLEMacroState and IsProprietaryDriver by other rules than a live one, so what the boot
+//   translated from disk records may never match a lookup during play.
+//
+// Thread safe: pipelines are built on the GPU thread and the pipeline workers.
+
+#pragma once
+
+#include <array>
+#include <atomic>
+#include <limits>
+#include <memory>
+#include <mutex>
+#include <optional>
+#include <unordered_map>
+#include <unordered_set>
+#include <vector>
+
+#include "common/common_types.h"
+#include "shader_recompiler/backend/bindings.h"
+#include "shader_recompiler/environment.h"
+#include "shader_recompiler/frontend/ir/program.h"
+#include "shader_recompiler/runtime_info.h"
+
+namespace VideoCommon {
+
+class StageCache {
+public:
+    /// Kinds of reads translation makes through the environment.
+    enum ReadKind : u8 {
+        CbufValue,
+        StoragePointer,
+        IndirectStoragePointer,
+        TextureType,
+        TexturePixelFormat,
+        TextureInteger,
+        ViewportTransform,
+        Replacement,
+        NumReadKinds,
+    };
+
+    /// A stage emitted for one runtime info: what a reused stage stands in for.
+    struct Emitted {
+        std::vector<u8> runtime_key; ///< Serialized runtime info and incoming bindings
+        std::vector<u32> spirv;
+        Shader::IR::Program program; ///< After emission, without IR
+        Shader::Backend::Bindings bindings_out;
+    };
+
+    struct Translation {
+        struct Read {
+            u8 kind{};
+            u32 a{}, b{}, c{};
+            u64 value{};
+
+            [[nodiscard]] bool operator==(const Read& other) const noexcept {
+                return kind == other.kind && a == other.a && b == other.b && c == other.c &&
+                       value == other.value;
+            }
+        };
+
+        std::vector<u8> signature;
+        std::vector<Read> reads;
+        Shader::IR::Program program; ///< After translation (and the OoT edits), without IR
+        /// Lowest and highest program address translation read (low above high: none).
+        u32 instruction_low = (std::numeric_limits<u32>::max)();
+        u32 instruction_high = 0;
+
+        mutable std::mutex emitted_mutex;
+        /// Least recently used first: a full list drops its front.
+        mutable std::vector<std::shared_ptr<const Emitted>> emitted;
+
+        // Guarded by StageCache's mutex.
+        mutable u64 hash{};       ///< Of the signature
+        mutable size_t bytes{};   ///< Counted against the cap, emitted stages included
+        mutable bool cached{};    ///< In the cache (false once evicted)
+        mutable std::atomic<u64> last_use{};
+    };
+
+    /// Records the reads translation makes through it, forwarding everything to `inner`.
+    class Recorder final : public Shader::Environment {
+    public:
+        explicit Recorder(Shader::Environment& inner);
+
+        u64 ReadInstruction(u32 address) override;
+        u32 TranslateProgramAddress(u32 address) const override;
+        bool IsNativeProgram() const override;
+        bool IsCbufStorageBufferPointer(u32 index, u32 offset) override;
+        bool IsCbufIndirectStorageBufferPointer(u32 index, u32 offset, u32 indirect) override;
+        std::vector<std::pair<u32, u32>> NullStoragePointerSlots() const override;
+        u32 ReadCbufValue(u32 index, u32 offset) override;
+        Shader::TextureType ReadTextureType(u32 handle) override;
+        Shader::TexturePixelFormat ReadTexturePixelFormat(u32 handle) override;
+        bool IsTexturePixelFormatInteger(u32 handle) override;
+        u32 ReadViewportTransformState() override;
+        u32 TextureBoundBuffer() const override;
+        u32 LocalMemorySize() const override;
+        u32 SharedMemorySize() const override;
+        std::array<u32, 3> WorkgroupSize() const override;
+        bool HasHLEMacroState() const override;
+        std::optional<Shader::ReplaceConstant> GetReplaceConstBuffer(u32 bank, u32 offset) override;
+        void Dump(u64 pipeline_hash, u64 shader_hash) override;
+
+        [[nodiscard]] std::vector<Translation::Read> TakeReads() {
+            return std::move(reads);
+        }
+
+        [[nodiscard]] u32 InstructionLow() const noexcept {
+            return instruction_low;
+        }
+
+        [[nodiscard]] u32 InstructionHigh() const noexcept {
+            return instruction_high;
+        }
+
+    private:
+        using ReadKey = std::array<u32, 4>;
+        struct ReadKeyHash {
+            size_t operator()(const ReadKey& key) const noexcept;
+        };
+
+        u64 Log(u8 kind, u32 a, u32 b, u32 c, u64 value);
+
+        Shader::Environment& inner;
+        std::vector<Translation::Read> reads;
+        std::unordered_set<ReadKey, ReadKeyHash> logged;
+        u32 instruction_low = (std::numeric_limits<u32>::max)();
+        u32 instruction_high = 0;
+    };
+
+    StageCache();
+
+    /// EDEN_UP_STAGE_CACHE=1.
+    [[nodiscard]] bool Enabled() const noexcept {
+        return enabled;
+    }
+
+    /// EDEN_UP_STAGE_CACHE_VERIFY=1: every reused stage is also built and compared; the fresh
+    /// build is the one used.
+    [[nodiscard]] bool Verify() const noexcept {
+        return verify;
+    }
+
+    /// The bytes translation depends on besides the reads: program, slot, environment constants,
+    /// the settings the recompiler reads and `salt` (the caller's own translation state).
+    [[nodiscard]] static std::vector<u8> Signature(Shader::Environment& env, u64 unique_hash,
+                                                   size_t slot, u64 salt);
+
+    /// A translation of `signature` whose reads `env` answers the same way, or null. On a hit
+    /// `env` has also read the lowest and highest program address the translation read.
+    [[nodiscard]] std::shared_ptr<const Translation> Find(const std::vector<u8>& signature,
+                                                          Shader::Environment& env);
+
+    /// The emitted stage of `translation` for `runtime_key`, or null (a hit becomes the most
+    /// recently used).
+    [[nodiscard]] static std::shared_ptr<const Emitted> FindEmitted(
+        const Translation& translation, const std::vector<u8>& runtime_key);
+
+    /// Makes a translation (from a Recorder) findable, with its first emitted stage. Never throws:
+    /// out of memory, the cache is emptied and the pipeline goes on.
+    void Insert(std::shared_ptr<Translation> translation,
+                std::shared_ptr<const Emitted> emitted) noexcept;
+
+    /// Adds an emitted stage to a translation found earlier (dropped when it was evicted since).
+    void AddEmitted(const Translation& translation, std::shared_ptr<const Emitted> emitted) noexcept;
+
+    /// Drops everything (translations in use by a build stay alive through their pointers).
+    void Clear() noexcept;
+
+    [[nodiscard]] static std::vector<u8> RuntimeKey(const Shader::RuntimeInfo& info,
+                                                    const Shader::Backend::Bindings& bindings);
+
+    /// Program metadata without its IR.
+    [[nodiscard]] static Shader::IR::Program Summary(const Shader::IR::Program& program);
+
+    /// Counts for the periodic log line.
+    void CountReuse(bool emitted);
+    void CountVerifyMismatch(u64 unique_hash, const char* what);
+
+private:
+    using TranslationPtr = std::shared_ptr<const Translation>;
+
+    /// Under `mutex`: drops `translation` from the map and the byte count.
+    void EvictLocked(const Translation& translation);
+    /// Under `mutex`: evicts the least recently used translations while over the cap.
+    void TrimLocked();
+    void Log();
+
+    bool enabled{};
+    bool verify{};
+    size_t max_bytes{};
+
+    std::mutex mutex;
+    std::unordered_map<u64, std::vector<TranslationPtr>> translations;
+    /// Translations held per program and slot (a signature's first bytes): a lookup with no
+    /// signature held is told apart from one whose program is held under another signature.
+    std::unordered_map<u64, u32> held_programs;
+    size_t bytes{};
+    size_t count{};
+
+    std::atomic<u64> tick{};
+    std::atomic<u64> reused_emitted{};
+    std::atomic<u64> reused_translation{};
+    std::atomic<u64> translated{};
+    std::atomic<u64> no_signature{};
+    std::atomic<u64> other_signature{};
+    std::atomic<u64> merged{};
+    std::atomic<u64> evicted{};
+    std::atomic<u64> verify_mismatches{};
+    std::array<std::atomic<u64>, NumReadKinds> misses_by_kind{};
+    std::atomic<s64> last_log{};
+};
+
+} // namespace VideoCommon
