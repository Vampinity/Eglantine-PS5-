+u64 StageCache::Recorder::ReadInstruction(u32 address) {
+    // The range is replayed on a reuse (Find): the environment marks a program read past its
+    // known size as not storable, and a disk environment throws there.
+    instruction_low = (std::min)(instruction_low, address);
+    instruction_high = (std::max)(instruction_high, address);
+    return inner.ReadInstruction(address);
