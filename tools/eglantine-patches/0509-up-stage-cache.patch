+u64 StageCache::Recorder::Log(u8 kind, u32 a, u32 b, u32 c, u64 value) {
+    // Only first reads: within one translation a repeated read is answered from what the first
+    // one gave (the environments keep their first answers), and a replay asks each read once.
+    if (logged.insert(ReadKey{kind, a, b, c}).second) {
+        reads.push_back({kind, a, b, c, value});
+    }
+    return value;
