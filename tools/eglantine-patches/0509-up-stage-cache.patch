+std::vector<u8> StageCache::Signature(Shader::Environment& env, u64 unique_hash, size_t slot,
+                                      u64 salt) {
+    Writer writer;
+    writer.Put(unique_hash);
+    writer.Put(static_cast<u32>(slot));
+    writer.Put(salt);
+    writer.Put(env.ShaderStage());
+    writer.Put(env.StartAddress());
+    writer.Put(env.IsProprietaryDriver());
+    writer.Put(env.IsNativeProgram());
+    writer.Put(env.SPH());
+    writer.Put(env.GpPassthroughMask());
+    writer.Put(env.MeshRegisters());
+    writer.Put(env.MeshPrimitiveHeader());
+    writer.Put(env.TextureBoundBuffer());
+    writer.Put(env.LocalMemorySize());
+    writer.Put(env.SharedMemorySize());
+    writer.Put(env.WorkgroupSize());
+    writer.Put(env.HasHLEMacroState());
+    // What the recompiler reads from the settings (the list the shader preparation's stamp
+    // keeps, vk_pipeline_prep.cpp MakeStamp), which can change during a session.
+    const auto& resolution = Settings::values.resolution_info;
+    writer.Put(resolution.up_scale);
+    writer.Put(resolution.down_shift);
+    writer.Put(resolution.up_factor);
+    writer.Put(resolution.down_factor);
+    writer.Put(resolution.active);
+    writer.Put(resolution.downscale);
+    writer.Put(static_cast<bool>(Settings::values.renderer_debug.GetValue()));
+    writer.Put(static_cast<bool>(Settings::values.disable_shader_loop_safety_checks.GetValue()));
+    writer.Put(static_cast<bool>(Settings::values.fix_bloom_effects.GetValue()));
+    return std::move(writer.bytes);
+}
+
+std::shared_ptr<const StageCache::Translation> StageCache::Find(const std::vector<u8>& signature,
+                                                                Shader::Environment& env) {
+    const u64 hash = HashBytes(signature);
+    std::vector<TranslationPtr> candidates;
+    {
+        std::scoped_lock lock{mutex};
+        if (const auto it = translations.find(hash); it != translations.end()) {
+            for (const TranslationPtr& entry : it->second) {
+                if (entry->signature == signature) {
+                    candidates.push_back(entry);
+                }
+            }
+        }
+        if (candidates.empty()) {
+            // No translation with this signature. Counted apart when the program and slot are
+            // held under another one (a disk record's environment answers HasHLEMacroState and
+            // IsProprietaryDriver by other rules than a live one): those entries never match.
+            no_signature.fetch_add(1, std::memory_order_relaxed);
+            if (held_programs.contains(ProgramKey(signature))) {
+                other_signature.fetch_add(1, std::memory_order_relaxed);
+            }
+            return nullptr;
+        }
+    }
+    // Newest first. Two candidates that both hold are the same translation (the same answers
+    // give the same reads), so the order only changes how soon one is found.
+    for (auto it = candidates.rbegin(); it != candidates.rend(); ++it) {
+        const Translation& candidate = **it;
+        bool same = true;
+        try {
+            // In the order translation read them: up to the first difference, every read is one
+            // translating here would make too.
+            for (const Translation::Read& read : candidate.reads) {
+                if (Answer(env, read) != read.value) {
+                    same = false;
+                    if (read.kind < NumReadKinds) {
+                        misses_by_kind[read.kind].fetch_add(1, std::memory_order_relaxed);
+                    }
+                    break;
+                }
+            }
+            if (same && candidate.instruction_low <= candidate.instruction_high) {
+                // The program words translation read, as translating here would read them: a
+                // read past the program's known size keeps the pipeline out of the disk cache
+                // (has_unbound_instructions), and a disk environment without them throws.
+                static_cast<void>(env.ReadInstruction(candidate.instruction_low));
+                static_cast<void>(env.ReadInstruction(candidate.instruction_high));
+            }
+        } catch (const Shader::Exception&) {
+            // A disk cache environment that never recorded this read: translating with it
+            // would throw at the same read.
+            same = false;
+        }
+        if (same) {
+            candidate.last_use.store(tick.fetch_add(1, std::memory_order_relaxed) + 1,
+                                     std::memory_order_relaxed);
+            return *it;
+        }
+    }
+    return nullptr;
+}
+
+std::shared_ptr<const StageCache::Emitted> StageCache::FindEmitted(
+    const Translation& translation, const std::vector<u8>& runtime_key) {
+    std::scoped_lock lock{translation.emitted_mutex};
+    auto& list = translation.emitted;
+    const auto it = std::ranges::find_if(
+        list, [&runtime_key](const auto& emitted) { return emitted->runtime_key == runtime_key; });
+    if (it == list.end()) {
+        return nullptr;
+    }
+    // Most recently used last: a full list drops its front (Insert, AddEmitted).
+    std::rotate(it, it + 1, list.end());
+    return list.back();
+}
+
+void StageCache::Insert(std::shared_ptr<Translation> translation,
+                        std::shared_ptr<const Emitted> emitted) noexcept {
+    try {
+        translation->hash = HashBytes(translation->signature);
+        const size_t emitted_size = EmittedBytes(*emitted);
+        const size_t size = TranslationBytes(*translation) + emitted_size;
+        std::scoped_lock lock{mutex};
+        translated.fetch_add(1, std::memory_order_relaxed);
+        if (const auto it = translations.find(translation->hash); it != translations.end()) {
+            for (const TranslationPtr& existing : it->second) {
+                if (existing->signature == translation->signature &&
+                    existing->reads == translation->reads) {
+                    // Another worker translated the same stage at the same time: one copy.
+                    merged.fetch_add(1, std::memory_order_relaxed);
+                    std::scoped_lock emitted_lock{existing->emitted_mutex};
+                    for (const auto& known : existing->emitted) {
+                        if (known->runtime_key == emitted->runtime_key) {
+                            return;
+                        }
+                    }
+                    if (existing->emitted.size() >= MaxEmittedPerTranslation) {
+                        const size_t freed = EmittedBytes(*existing->emitted.front());
+                        existing->emitted.erase(existing->emitted.begin());
+                        existing->bytes -= freed;
+                        bytes -= freed;
+                    }
+                    existing->emitted.push_back(std::move(emitted));
+                    existing->bytes += emitted_size;
+                    bytes += emitted_size;
+                    break;
+                }
+            }
+            if (!emitted) {
+                TrimLocked();
+                return;
+            }
+            if (it->second.size() >= MaxPerSignature) {
+                // The least recently used of this program's translations makes room.
+                const Translation* oldest = nullptr;
+                u64 oldest_use = ~u64{0};
+                for (const TranslationPtr& candidate : it->second) {
+                    const u64 use = candidate->last_use.load(std::memory_order_relaxed);
+                    if (oldest == nullptr || use < oldest_use) {
+                        oldest = candidate.get();
+                        oldest_use = use;
+                    }
+                }
+                EvictLocked(*oldest);
+            }
+        }
+        translation->emitted.push_back(std::move(emitted));
+        translation->bytes = size;
+        translation->cached = true;
+        translation->last_use.store(tick.fetch_add(1, std::memory_order_relaxed) + 1,
+                                    std::memory_order_relaxed);
+        ++held_programs[ProgramKey(translation->signature)];
+        translations[translation->hash].push_back(std::move(translation));
+        bytes += size;
+        ++count;
+        TrimLocked();
+    } catch (const std::bad_alloc&) {
+        // No memory: what the cache holds is given back, the pipeline goes on without it.
+        Clear();
+    } catch (const std::exception&) {
+        Clear();
+    }
+    Log();
+}
+
+void StageCache::AddEmitted(const Translation& translation,
+                            std::shared_ptr<const Emitted> emitted) noexcept {
+    try {
+        const size_t size = EmittedBytes(*emitted);
+        std::scoped_lock lock{mutex};
+        if (!translation.cached) {
+            return; // evicted while its pipeline was built
+        }
+        {
+            std::scoped_lock emitted_lock{translation.emitted_mutex};
+            for (const auto& known : translation.emitted) {
+                if (known->runtime_key == emitted->runtime_key) {
+                    return;
+                }
+            }
+            if (translation.emitted.size() >= MaxEmittedPerTranslation) {
+                const size_t freed = EmittedBytes(*translation.emitted.front());
+                translation.emitted.erase(translation.emitted.begin());
+                translation.bytes -= freed;
+                bytes -= freed;
+            }
+            translation.emitted.push_back(std::move(emitted));
+        }
+        translation.bytes += size;
+        bytes += size;
+        TrimLocked();
+    } catch (const std::bad_alloc&) {
+        Clear();
+    } catch (const std::exception&) {
+        Clear();
+    }
+    Log();
+}
+
+void StageCache::EvictLocked(const Translation& translation) {
+    if (!translation.cached) {
+        return;
+    }
+    // Everything read from `translation` before it is dropped: the map may hold its last pointer.
+    const u64 hash = translation.hash;
+    translation.cached = false;
+    bytes -= (std::min)(bytes, translation.bytes);
+    --count;
+    if (const auto held = held_programs.find(ProgramKey(translation.signature));
+        held != held_programs.end() && --held->second == 0) {
+        held_programs.erase(held);
+    }
+    evicted.fetch_add(1, std::memory_order_relaxed);
+    const auto it = translations.find(hash);
+    if (it == translations.end()) {
+        return;
+    }
+    const Translation* const target = &translation;
+    std::erase_if(it->second, [target](const TranslationPtr& entry) { return entry.get() == target; });
+    if (it->second.empty()) {
+        translations.erase(it);
+    }
+}
+
+void StageCache::TrimLocked() {
+    if (bytes <= max_bytes) {
+        return;
+    }
+    // Down to three quarters of the cap, so the next inserts do not each evict again.
+    const size_t target = max_bytes - max_bytes / 4;
+    std::vector<std::pair<u64, const Translation*>> order;
+    order.reserve(count);
+    for (const auto& [hash, list] : translations) {
+        for (const TranslationPtr& entry : list) {
+            order.emplace_back(entry->last_use.load(std::memory_order_relaxed), entry.get());
+        }
+    }
+    std::ranges::sort(order, {}, &std::pair<u64, const Translation*>::first);
+    for (const auto& [use, translation] : order) {
+        if (bytes <= target) {
+            break;
+        }
+        EvictLocked(*translation);
+    }
+}
+
+void StageCache::Clear() noexcept {
+    std::scoped_lock lock{mutex};
+    for (const auto& [hash, list] : translations) {
+        for (const TranslationPtr& entry : list) {
+            entry->cached = false;
+        }
+    }
+    evicted.fetch_add(count, std::memory_order_relaxed);
+    translations.clear();
+    held_programs.clear();
+    bytes = 0;
+    count = 0;
+}
+
+std::vector<u8> StageCache::RuntimeKey(const Shader::RuntimeInfo& info,
+                                       const Shader::Backend::Bindings& bindings) {
+    // Every field of RuntimeInfo: one left out would let different SPIR-V share a key.
+    Writer writer;
+    writer.Put(bindings);
+    writer.Put(info.generic_input_types);
+    for (size_t index = 0; index < info.previous_stage_stores.mask.size(); index += 64) {
+        u64 word{};
+        for (size_t bit = 0; bit < 64 && index + bit < info.previous_stage_stores.mask.size();
+             ++bit) {
+            word |= u64{info.previous_stage_stores.mask[index + bit]} << bit;
+        }
+        writer.Put(word);
+    }
+    writer.Put(static_cast<u64>(info.per_primitive_generics.to_ullong()));
+    writer.Put(static_cast<u64>(info.noperspective_outputs.to_ullong()));
+    writer.Put(info.scaled_noperspective_inputs);
+    writer.Put(info.mesh_as_compute);
+    writer.Put(info.mesh_compute_primitive_id_location.has_value());
+    writer.Put(info.mesh_compute_primitive_id_location.value_or(0));
+    writer.Put(static_cast<u32>(info.previous_stage_legacy_stores_mapping.size()));
+    for (const auto& [from, to] : info.previous_stage_legacy_stores_mapping) {
+        writer.Put(from);
+        writer.Put(to);
+    }
+    writer.Put(info.convert_depth_mode);
+    writer.Put(info.force_early_z);
+    writer.Put(info.tess_primitive);
+    writer.Put(info.tess_spacing);
+    writer.Put(info.tess_clockwise);
+    writer.Put(info.input_topology);
+    writer.Put(info.fixed_state_point_size.has_value());
+    writer.Put(info.fixed_state_point_size.value_or(0.0f));
+    writer.Put(info.alpha_test_func.has_value());
+    writer.Put(info.alpha_test_func.value_or(Shader::CompareFunction{}));
+    writer.Put(info.alpha_test_reference);
+    writer.Put(info.y_negate);
+    writer.Put(info.glasm_use_storage_buffers);
+    writer.Put(info.xfb_count);
+    for (u32 index = 0; index < info.xfb_count && index < info.xfb_varyings.size(); ++index) {
+        const auto& varying = info.xfb_varyings[index];
+        writer.Put(varying.buffer);
+        writer.Put(varying.stream);
+        writer.Put(varying.stride);
+        writer.Put(varying.offset);
+        writer.Put(varying.components);
+    }
+    writer.Put(info.color_output_types);
+    writer.Put(info.dual_source_blend);
+    return std::move(writer.bytes);
+}
+
+Shader::IR::Program StageCache::Summary(const Shader::IR::Program& program) {
+    Shader::IR::Program summary;
+    summary.info = program.info;
+    summary.stage = program.stage;
+    summary.workgroup_size = program.workgroup_size;
+    summary.output_topology = program.output_topology;
+    summary.output_vertices = program.output_vertices;
+    summary.invocations = program.invocations;
+    summary.local_memory_size = program.local_memory_size;
+    summary.shared_memory_size = program.shared_memory_size;
+    summary.is_geometry_passthrough = program.is_geometry_passthrough;
+    summary.mesh = program.mesh;
+    return summary;
+}
+
+void StageCache::CountReuse(bool emitted) {
+    (emitted ? reused_emitted : reused_translation).fetch_add(1, std::memory_order_relaxed);
+    Log();
+}
+
+void StageCache::CountVerifyMismatch(u64 unique_hash, const char* what) {
+    if (verify_mismatches.fetch_add(1, std::memory_order_relaxed) < 32) {
+        LOG_ERROR(Render_Vulkan, "Stage cache: reused stage {:016x} differs from a fresh build ({})",
+                  unique_hash, what);
+    }
+}
+
+void StageCache::Log() {
+    const s64 now = std::chrono::duration_cast<std::chrono::seconds>(
+                        std::chrono::steady_clock::now().time_since_epoch())
+                        .count();
+    s64 last = last_log.load(std::memory_order_relaxed);
+    if (now - last < 10 || !last_log.compare_exchange_strong(last, now)) {
+        return;
+    }
+    if (last == 0) {
+        return;
+    }
+    try {
+        size_t held_bytes{}, held{};
+        {
+            std::scoped_lock lock{mutex};
+            held_bytes = bytes;
+            held = count;
+        }
+        const auto miss = [this](ReadKind kind) {
+            return misses_by_kind[kind].load(std::memory_order_relaxed);
+        };
+        LOG_INFO(Render_Vulkan,
+                 "Stage cache: {} stages reused whole, {} translations reused, {} translated ({} "
+                 "kept once for two workers), {} held in {:.1f} of {} MiB, {} evicted; no "
+                 "signature held {} ({} with the program held under another); reads that "
+                 "missed: cbuf {}, pointer {}, pointer table {}, texture type {}, pixel format {}, "
+                 "integer {}, viewport {}, HLE {}{}",
+                 reused_emitted.load(), reused_translation.load(), translated.load(),
+                 merged.load(), held, static_cast<double>(held_bytes) / (1 << 20),
+                 max_bytes >> 20, evicted.load(), no_signature.load(), other_signature.load(),
+                 miss(CbufValue), miss(StoragePointer),
+                 miss(IndirectStoragePointer), miss(TextureType), miss(TexturePixelFormat),
+                 miss(TextureInteger), miss(ViewportTransform), miss(Replacement),
+                 verify ? fmt::format(", {} verify mismatches", verify_mismatches.load())
+                        : std::string{});
+    } catch (const std::exception&) {
+    }
+}
