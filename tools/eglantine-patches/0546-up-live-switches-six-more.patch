index 2b44f62..6834590 100644
--- a/src/common/live_switch.h
+++ b/src/common/live_switch.h
@@ -94,6 +94,25 @@ enum class Id : u8 {
     /// finishes on the host, since the game's DCtx cannot take it over
     /// (core/hle/kernel/svc/svc_nx2_zstd.cpp).
     OotZstdStream,
+    /// EDEN_UP_FRITCHII_USAGE_TRACKER. Each Track call fills its pages either way. The run of
+    /// pages known to be all ones is reset by Reset whatever the switch says and only grows
+    /// with the switch on, so it stays true while the plain loop runs
+    /// (video_core/buffer_cache/usage_tracker.h).
+    UsageTracker,
+    /// EDEN_NX2_QUERY_WAIT_ONCE (unset or starting with '0' is off). Read once per query sync:
+    /// each copy of query results waits in one of two ways that give the same values.
+    QueryWaitOnce,
+    /// EDEN_UP_GPU_PAGE_CACHE. A cached page is checked against the mapping serial at every
+    /// use, so entries made before the switch went off are right or dropped when it is back.
+    GpuPageCache,
+    /// EDEN_UP_UNSWIZZLE_THREADS=<n> (0 to 4). Read at each large unswizzle. Helper threads are
+    /// made the first time a value asks for them and stay; a smaller value uses fewer of them.
+    UnswizzleThreads,
+    /// EDEN_UP_COND_BACK (exact "1", or "2" to verify). Read at each run of the conditional
+    /// render macro, which sets the back's condition in full either way.
+    CondBack,
+    /// EDEN_UP_SWIZZLE_UNITS. Two ways to copy the same bytes, chosen per copy.
+    SwizzleUnits,
     Count,
 };
 
@@ -121,6 +140,24 @@ inline constexpr size_t NumSwitches = static_cast<size_t>(Id::Count);
     return static_cast<s64>((std::max)(asked, 60ULL)); // the same bits as before, read back as u64
 }
 
+/// EDEN_NX2_QUERY_WAIT_ONCE: unset or starting with '0' is 0, anything else 1.
+[[nodiscard]] inline s64 ParseNotZero(const char* text) noexcept {
+    return text != nullptr && text[0] != '0' ? 1 : 0;
+}
+
+/// EDEN_UP_UNSWIZZLE_THREADS: a number of helper threads, at most 4.
+[[nodiscard]] inline s64 ParseHelpers(const char* text) noexcept {
+    const unsigned long asked = text != nullptr ? std::strtoul(text, nullptr, 10) : 0;
+    return static_cast<s64>((std::min)(asked, 4UL));
+}
+
+/// EDEN_UP_COND_BACK: exact "1" is 1, exact "2" is 2 (verify), anything else 0.
+[[nodiscard]] inline s64 ParseOneOrTwo(const char* text) noexcept {
+    return text != nullptr && (text[0] == '1' || text[0] == '2') && text[1] == '\0'
+               ? text[0] - '0'
+               : 0;
+}
+
 struct Def {
     const char* name;
     s64 (*parse)(const char* text);
