+    {"EDEN_UP_FRITCHII_USAGE_TRACKER", ParseExactOne, false, -1},
+    {"EDEN_NX2_QUERY_WAIT_ONCE", ParseNotZero, false, -1},
+    {"EDEN_UP_GPU_PAGE_CACHE", ParseExactOne, false, -1},
+    {"EDEN_UP_UNSWIZZLE_THREADS", ParseHelpers, false, -1},
+    {"EDEN_UP_COND_BACK", ParseOneOrTwo, false, -1},
+    {"EDEN_UP_SWIZZLE_UNITS", ParseExactOne, false, -1},
 }};
 
