diff --git a/src/video_core/renderer_vulkan/vk_pipeline_cache.cpp b/src/video_core/renderer_vulkan/vk_pipeline_cache.cpp
index 63068dd..0b1f335 100644
--- a/src/video_core/renderer_vulkan/vk_pipeline_cache.cpp
+++ b/src/video_core/renderer_vulkan/vk_pipeline_cache.cpp
@@ -504,6 +504,55 @@ void FreeIr(ShaderPools& pools, std::span<Shader::IR::Program> programs, IrFree
     }
 }
 
+// EDEN_UP_ASYNC_TRANSLATION: true on a VkPipelineTranslator thread while it translates a detached
+// pipeline (PipelineCache::TranslateGraphicsPipeline), where the GPU thread's engine is not read.
+thread_local bool translating_detached = false;
+
+// EDEN_UP_ASYNC_TRANSLATION_WAIT_MS / _FRAME_MS: how long the GPU thread waits for a queued
+// translation before it skips the draw, per pipeline and in total per frame. Unset or not a
+// number: the default; 0 or less: never waits.
+std::chrono::microseconds TranslationWaitFromEnv(const char* name, double default_ms) {
+    const char* const value = std::getenv(name);
+    double ms = default_ms;
+    if (value != nullptr) {
+        char* end = nullptr;
+        const double parsed = std::strtod(value, &end);
+        if (end != value) {
+            ms = parsed;
+        }
+    }
+    return std::chrono::microseconds{ms > 0.0 ? static_cast<s64>(ms * 1000.0) : 0};
+}
+
+// EDEN_UP_ASYNC_TRANSLATION_THREADS=<n>: that many translator threads, at most one per builder.
+// Unset, 0 or not a number: half the builders, at least 1 and at most 4 (each translation holds
+// its shader pools and the copied constant buffers while it runs).
+size_t TranslationThreads(size_t builders) {
+    if (const char* const value = std::getenv("EDEN_UP_ASYNC_TRANSLATION_THREADS");
+        value != nullptr) {
+        const size_t asked = static_cast<size_t>(std::strtoul(value, nullptr, 10));
+        if (asked != 0) {
+            return std::min(asked, std::max<size_t>(builders, 1));
+        }
+    }
+    return std::clamp<size_t>(builders / 2, 1, 4);
+}
+
+// EDEN_UP_ASYNC_TRANSLATION_PENDING_MIB=<n> (1 to 1024): the constant buffer copies the queued
+// translations may hold together; past it, new pipelines are not queued (TranslationQueueFull).
+// Unset, 0 or not a number: 16.
+size_t TranslationPendingBytes() {
+    size_t mib = 16;
+    if (const char* const value = std::getenv("EDEN_UP_ASYNC_TRANSLATION_PENDING_MIB");
+        value != nullptr) {
+        const size_t asked = static_cast<size_t>(std::strtoul(value, nullptr, 10));
+        if (asked != 0) {
+            mib = std::min<size_t>(asked, 1024);
+        }
+    }
+    return mib << 20;
+}
+
 } // Anonymous namespace
 
