+// EDEN_UP_ASYNC_TRANSLATION. Runs on the GPU thread, before the environment goes to a
+// VkPipelineTranslator thread (port of Djihads80/Eglantine 0f1ae99, GraphicsEnvironment::Detach).
+// - Enabled constant buffers are copied whole: translation folds some of their values into the
+//   shader (bindless handles, storage pointers, branch tables), and uniform memory is reused once
+//   the GPU is past the draw. The copy reads as Read<u32> does (ReadWordsUnsafe: no flush, the
+//   Switch 2 syncpoint shim included), at the moment the GPU thread would have read them.
+// - The texture pool is located, not copied, and its descriptors are read on the worker with
+//   ReadBlockUnsafe. A pool the GPU wrote is not detached (its entries would need a flush, which
+//   only the GPU thread may do). An entry the CPU rewrites meanwhile gives the newer descriptor:
+//   accepted, as upstream, since pools hold long-lived descriptors.
+// - The viewport transform flag and the HLE replacements are copied.
+// What stays on the worker as on the GPU thread: storage pointer checks read the GPU page table
+// (and, for indirect ones, the guest word they point at) through gpu_memory, as before.
+bool GraphicsEnvironment::Detach() {
+    if (detached) {
+        return true;
+    }
+    // A handle indexes at most 2^20 descriptors; a larger limit is not a real pool, and the
+    // dirty check below would walk gigabytes of page table.
+    constexpr u32 MaxTexturePoolLimit = (1U << 20) - 1;
+    const auto& regs{maxwell3d->regs};
+    if (regs.tex_header.limit > MaxTexturePoolLimit) {
+        return false;
+    }
+    const GPUVAddr pool_address{regs.tex_header.Address()};
+    const size_t pool_size{(size_t{regs.tex_header.limit} + 1) *
+                           sizeof(Tegra::Texture::TICEntry)};
+    if (gpu_memory->IsMemoryDirty(pool_address, pool_size)) {
+        return false;
+    }
+    const auto& live_buffers{maxwell3d->state.shader_stages[stage_index].const_buffers};
+    for (const auto& live : live_buffers) {
+        // A read past MaxConstBufferSize would need guest memory the copy lacks: not detached.
+        if (live.enabled && live.size > Maxwell::MaxConstBufferSize) {
+            return false;
+        }
+    }
+    auto copy{std::make_shared<EngineSnapshot>()};
+    for (size_t index = 0; index < live_buffers.size(); ++index) {
+        const auto& live{live_buffers[index]};
+        auto& copied{copy->const_buffers[index]};
+        copied.enabled = live.enabled;
+        if (!live.enabled || live.size == 0) {
+            continue;
+        }
+        copied.size = live.size;
+        const size_t words{(size_t{live.size} + sizeof(u32) - 1) / sizeof(u32)};
+        copied.words.resize(words + 1);
+        gpu_memory->ReadWordsUnsafe(live.address, copied.words.data(), words);
+    }
+    copy->tic_address = pool_address;
+    copy->tic_limit = regs.tex_header.limit;
+    copy->via_header_index = regs.sampler_binding == Maxwell::SamplerBinding::ViaHeaderBinding;
+    copy->viewport_scale_offset_enabled = regs.viewport_scale_offset_enabled;
+    if (has_hle_engine_state) {
+        copy->replace_table = maxwell3d->replace_table;
+    }
+    snapshot = std::move(copy);
+    detached = true;
+    maxwell3d = nullptr;
+    return true;
+}
+
+size_t GraphicsEnvironment::SnapshotSizeBytes() const noexcept {
+    if (!snapshot) {
+        return 0;
+    }
+    size_t total{};
+    for (const auto& cbuf : snapshot->const_buffers) {
+        total += cbuf.words.size() * sizeof(u32);
+    }
+    return total;
+}
+
+void GraphicsEnvironment::ReleaseSnapshot() noexcept {
+    snapshot.reset();
+}
