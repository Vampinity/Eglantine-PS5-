+// EDEN_UP_ASYNC_TRANSLATION=1: new native graphics pipelines translated on worker threads. Port
+// of Djihads80/Eglantine 0f1ae99 (fix/oot-map-change; "OoT cold-cache boot and walk: ~3.4 s of
+// GPU-thread pipeline time before, ~0.9 s after"), itself based on Wael3rd/Eglantine-MKW
+// 6d8f95f08e and 9a876a744e.
+//
+// A new pipeline was translated (lowered code -> IR -> SPIR-V) on the GPU thread before its draw.
+// With the switch, CreateGraphicsPipeline() still builds the environments here (the key needs the
+// lowered code) and tries the kept translation first (EDEN_UP_SHADER_PREP, unchanged); without
+// one, the environments are detached from the 3D engine (GraphicsEnvironment::Detach) and the
+// translation is queued on translation_workers, which queue the driver build on the builder
+// workers as the GPU thread does (with EDEN_UP_FAST_CFG, claimed once). The GPU thread waits
+// within translation_wait and what is left of translation_frame_budget; a pipeline not ready by
+// then skips the draw, and a later draw adopts it (TranslatedInTime) and writes it to the disk
+// cache. Draws that can't be skipped (CanSkipDraw) translate here; one that finds its key queued
+// and not started takes the job back (TranslationJob::claimed) and translates it here too, and
+// waits only for a job a worker has started. The queue is capped (TranslationQueueFull: pending
+// jobs and their copies); over the cap a pipeline is not queued, its draws are skipped until
+// there is room (translation_deferred), and nothing is copied. Copying for the queue never ends
+// the session on a full heap: without memory the pipeline is translated here as before. Compute
+// pipelines, Switch 1 programs (their code is read from guest memory while translating) and
+// programs not lowered yet stay on the GPU thread.
+// Unlike upstream it does not need the asynchronous shaders setting (off on the PS5): only the
+// translation is skipped over. Once adopted, a pipeline whose driver build is not done is waited
+// for as before (the scheduler worker waits, the GPU thread does not).
+bool PipelineCache::CanSkipDraw() const noexcept {
+    // As BuiltPipeline decides it: depth in use, or more than a full screen quad.
+    if (maxwell3d->regs.zeta_enable) {
+        return true;
+    }
+    return maxwell3d->draw_manager.draw_state.draw_element_count > 6;
+}
+
+bool PipelineCache::CanTranslateAsynchronously() const {
+    if (!maxwell3d->GetNativeMacroEngine().native_turing || !CanSkipDraw()) {
+        return false;
+    }
+    for (size_t index = 0; index < Maxwell::MaxShaderProgram; ++index) {
+        if (graphics_key.unique_hashes[index] != 0 &&
+            (shader_infos[index] == nullptr || !shader_infos[index]->lowered_native)) {
+            return false;
+        }
+    }
+    return true;
+}
+
+namespace {
+// GPU thread: what the translators did, logged every 10 s when anything happened.
+struct TranslationReport {
+    using Duration = std::chrono::steady_clock::duration;
+    u32 queued{};
+    u32 not_detached{};
+    u32 over_cap{};  ///< Not queued: TranslationQueueFull
+    u32 no_memory{}; ///< Not queued: no memory for the copies, translated on the GPU thread
+    u32 ready_in_time{};
+    u32 skipped{};
+    u32 whole_waits{};
+    u32 taken_back{}; ///< Not started, translated on the GPU thread for a draw that can't skip
+    u32 adopted{};
+    u32 failed{};
+    size_t copied_bytes{};
+    size_t peak_pending{};
+    size_t peak_pending_bytes{};
+    Duration preparation{};
+    Duration waited{};
+    Duration waited_whole{};
+    Duration worker{};
+    std::chrono::steady_clock::time_point window{std::chrono::steady_clock::now()};
+
+    void Log() {
+        const auto now = std::chrono::steady_clock::now();
+        if (now - window < std::chrono::seconds{10}) {
+            return;
+        }
+        const auto ms = [](Duration d) {
+            return std::chrono::duration<double, std::milli>(d).count();
+        };
+        if (queued != 0 || not_detached != 0 || adopted != 0 || skipped != 0 || no_memory != 0 ||
+            taken_back != 0) {
+            LOG_INFO(Render_Vulkan,
+                     "EDEN_UP_ASYNC_TRANSLATION in the last 10 s: {} queued ({} KiB copied, "
+                     "{:.1f} ms preparing, at most {} pending holding {} KiB), {} ready in time, "
+                     "{} draws skipped, {} not detached, {} over the cap, {} without memory; "
+                     "{:.1f} ms waited, {} whole waits ({:.1f} ms), {} taken back; {} adopted "
+                     "({} failed), {:.1f} ms on the workers",
+                     queued, copied_bytes / 1024, ms(preparation), peak_pending,
+                     peak_pending_bytes / 1024, ready_in_time, skipped, not_detached, over_cap,
+                     no_memory, ms(waited), whole_waits, ms(waited_whole), taken_back, adopted,
+                     failed, ms(worker));
+        }
+        *this = TranslationReport{};
+    }
+};
+
+TranslationReport& GetTranslationReport() {
+    static TranslationReport report;
+    return report;
+}
+} // Anonymous namespace
+
+bool PipelineCache::TranslationQueueFull() const noexcept {
+    // At most one job past the byte cap: it is checked before a job's copies are made (a job
+    // copies at most 6 programs x 18 buffers x 64 KiB, under 7 MiB).
+    return translating_graphics.size() >= max_pending_translations ||
+           translation_pending_bytes.load(std::memory_order_relaxed) >= translation_pending_cap;
+}
+
+bool PipelineCache::TranslatedInTime() {
+    if (num_translated.load(std::memory_order_acquire) != 0) {
+        AdoptTranslatedGraphicsPipelines();
+    }
+    if (!translation_deferred.empty()) {
+        if (const auto deferred{translation_deferred.find(graphics_key)};
+            deferred != translation_deferred.end()) {
+            // Not queued, over the cap: skipped while the queue is full, without building its
+            // environments again. With room, or for a draw that can't be skipped, the slow path
+            // makes it from the start (kept check, then queued or translated here).
+            if (CanSkipDraw() && TranslationQueueFull()) {
+                auto& report{GetTranslationReport()};
+                ++report.skipped;
+                report.Log();
+                return false;
+            }
+            translation_deferred.erase(deferred);
+            translation_reported = true;
+        }
+    }
+    const auto pending{translating_graphics.find(graphics_key)};
+    if (pending == translating_graphics.end()) {
+        return true; // made already, or new: the slow path goes on as without the switch
+    }
+    const std::shared_future<void> done{pending->second.done};
+    if (CanSkipDraw()) {
+        if (!WaitForGraphicsTranslation(done)) {
+            return false;
+        }
+    } else if (!pending->second.claimed->exchange(true, std::memory_order_acq_rel)) {
+        // A draw that can't be skipped, and no worker has started the job: the GPU thread takes
+        // it back and translates it now (the slow path goes on as without the switch); the
+        // worker that reaches the job drops it. It does not wait behind the queue.
+        translating_graphics.erase(pending);
+        translation_reported = true;
+        auto& report{GetTranslationReport()};
+        ++report.taken_back;
+        report.Log();
+        return true;
+    } else {
+        // Started on a worker: the draw waits for that one translation.
+        Common::HangSite site{"waiting for a pipeline translation"};
+        auto& report{GetTranslationReport()};
+        const auto begin = std::chrono::steady_clock::now();
+        done.wait();
+        report.waited_whole += std::chrono::steady_clock::now() - begin;
+        ++report.whole_waits;
+    }
+    // Done: its job is in translated_graphics (handed over before the promise was kept).
+    AdoptTranslatedGraphicsPipelines();
+    return true;
+}
+
+PipelineCache::Translation PipelineCache::TranslateOnWorker(
+    const GraphicsEnvironments& environments, std::list<TranslationJob>& translated) {
+    const auto begin = std::chrono::steady_clock::now();
+    auto& report{GetTranslationReport()};
+    if (TranslationQueueFull()) {
+        // Over the cap: nothing is copied or queued, and the draw is skipped. The key waits in
+        // translation_deferred, so its later draws are skipped without building its
+        // environments again until there is room (TranslatedInTime).
+        ++report.over_cap;
+        ++report.skipped;
+        try {
+            translation_deferred.insert(graphics_key);
+        } catch (const std::bad_alloc&) {
+            // Not remembered: its next draw comes here again.
+        }
+        report.Log();
+        translation_left = true;
+        return Translation::Deferred;
+    }
+    // Everything the queue needs is made in this block, before the job is queued; without
+    // memory for it the pipeline is translated here as before (which has its own guard), and
+    // nothing is left queued or pending.
+    std::shared_future<void> done;
+    size_t copied{};
+    bool pending{};
+    try {
+        // One node, made here: the worker hands it over with a splice, which cannot fail.
+        std::list<TranslationJob> job(1);
+        TranslationJob& work{job.front()};
+        work.key = graphics_key;
+        for (size_t index = 0; index < Maxwell::MaxShaderProgram; ++index) {
+            if (graphics_key.unique_hashes[index] == 0) {
+                continue;
+            }
+            // A copy: the environments here stay attached if one of them can't be detached.
+            work.envs[index] = environments.envs[index];
+            if (!work.envs[index].Detach()) {
+                ++report.not_detached;
+                report.Log();
+                return Translation::Here;
+            }
+            work.copied_bytes += work.envs[index].SnapshotSizeBytes();
+        }
+        work.claimed = std::make_shared<std::atomic<bool>>(false);
+        std::promise<void> promise;
+        done = promise.get_future().share();
+        // Pending before it is queued (only this thread adopts or takes jobs back), so a
+        // QueueWork without memory leaves nothing behind but this entry, erased below.
+        translating_graphics.emplace(graphics_key, PendingTranslation{done, work.claimed});
+        pending = true;
+        copied = work.copied_bytes;
+        translation_pending_bytes.fetch_add(copied, std::memory_order_relaxed);
+        translation_workers->QueueWork(
+            [this, job = std::move(job), promise = std::move(promise)]() mutable {
+                TranslateGraphicsPipeline(std::move(job), std::move(promise));
+            });
+    } catch (const std::bad_alloc&) {
+        // Nothing was queued: a QueueWork that throws has destroyed the job with its copies.
+        if (pending) {
+            translating_graphics.erase(graphics_key);
+            translation_pending_bytes.fetch_sub(copied, std::memory_order_relaxed);
+        }
+        if (BadAllocEnds()) {
+            throw;
+        }
+        ++report.no_memory;
+        report.Log();
+        return Translation::Here;
+    }
+    report.peak_pending = std::max(report.peak_pending, translating_graphics.size());
+    report.peak_pending_bytes = std::max(report.peak_pending_bytes,
+                                         translation_pending_bytes.load(std::memory_order_relaxed));
+    ++report.queued;
+    report.copied_bytes += copied;
+    report.preparation += std::chrono::steady_clock::now() - begin;
+    if (!WaitForGraphicsTranslation(done)) {
+        translation_left = true;
+        return Translation::Left;
+    }
+    // Only this key's job: adopting the others would insert into graphics_cache, whose entry
+    // for this key the slow path holds across CreateGraphicsPipeline().
+    {
+        std::scoped_lock lock{translated_mutex};
+        for (auto it = translated_graphics.begin(); it != translated_graphics.end(); ++it) {
+            if (it->key == graphics_key) {
+                translated.splice(translated.end(), translated_graphics, it);
+                num_translated.fetch_sub(1, std::memory_order_relaxed);
+                break;
+            }
+        }
+    }
+    translating_graphics.erase(graphics_key);
+    if (translated.empty()) {
+        // Unreachable: the promise is kept after the hand-over.
+        LOG_ERROR(Render_Vulkan, "EDEN_UP_ASYNC_TRANSLATION: pipeline {:016x} done but missing",
+                  graphics_key.Hash());
+        return Translation::Failed;
+    }
+    // The job stays in `translated` for CreateGraphicsPipeline(): its pipeline, and the copies
+    // its disk cache entry is written from (they hold the answers the translation got; nothing
+    // is copied back here).
+    const TranslationJob& result{translated.front()};
+    ++report.adopted;
+    report.worker += result.time;
+    if (!result.pipeline) {
+        ++report.failed;
+        report.Log();
+        return Translation::Failed;
+    }
+    report.Log();
+    return Translation::Done;
+}
+
+bool PipelineCache::WaitForGraphicsTranslation(const std::shared_future<void>& done) {
+    auto& report{GetTranslationReport()};
+    if (translation_frame != frame_count) {
+        // The budget is reset at the frame's first wait.
+        translation_frame = frame_count;
+        translation_frame_left = translation_frame_budget;
+    }
+    const auto wait{std::min(translation_wait, translation_frame_left)};
+    bool ready{done.wait_for(std::chrono::seconds{0}) == std::future_status::ready};
+    // Behind a backlog, waiting would spend the budget without getting the pipeline.
+    if (!ready && wait.count() > 0 && translating_graphics.size() <= num_translation_threads) {
+        const auto begin = std::chrono::steady_clock::now();
+        ready = done.wait_for(wait) == std::future_status::ready;
+        const auto spent{std::chrono::steady_clock::now() - begin};
+        translation_frame_left -= std::min(
+            translation_frame_left, std::chrono::duration_cast<std::chrono::microseconds>(spent));
+        report.waited += spent;
+        report.ready_in_time += ready ? 1 : 0;
+    }
+    report.skipped += ready ? 0 : 1;
+    report.Log();
+    return ready;
+}
+
+void PipelineCache::TranslateGraphicsPipeline(std::list<TranslationJob> job,
+                                              std::promise<void> done) {
+    TranslationJob& work{job.front()};
+    if (work.claimed->exchange(true, std::memory_order_acq_rel)) {
+        // Taken back by the GPU thread for a draw that couldn't be skipped (TranslatedInTime),
+        // which no longer waits for it: dropped, with its copies.
+        for (auto& env : work.envs) {
+            env.ReleaseSnapshot();
+        }
+        translation_pending_bytes.fetch_sub(work.copied_bytes, std::memory_order_relaxed);
+        done.set_value();
+        return;
+    }
+    const auto begin = std::chrono::steady_clock::now();
+    translating_detached = true;
+    try {
+        ShaderPools pools;
+        std::array<Shader::Environment*, Maxwell::MaxShaderProgram> env_ptrs{};
+        size_t num_envs{};
+        for (size_t index = 0; index < Maxwell::MaxShaderProgram; ++index) {
+            if (work.key.unique_hashes[index] != 0) {
+                env_ptrs[num_envs++] = &work.envs[index];
+            }
+        }
+        // Shader errors and its own allocations are handled inside, as on the GPU thread; the
+        // driver build is queued on the builder workers, never run here.
+        work.pipeline = CreateGraphicsPipeline(
+            pools, work.key, std::span<Shader::Environment* const>(env_ptrs.data(), num_envs),
+            nullptr, true);
+    } catch (const std::bad_alloc&) {
+        // The pools': EDEN_NX2_BAD_ALLOC_ENDS=1 ends the session, as on the GPU thread.
+        translating_detached = false;
+        SurviveBadAlloc("a graphics pipeline translation");
+    } catch (const std::exception& exception) {
+        // Nothing else may end the worker thread.
+        LOG_ERROR(Render_Vulkan, "EDEN_UP_ASYNC_TRANSLATION: pipeline {:016x} failed: {}",
+                  work.key.Hash(), exception.what());
+    }
+    translating_detached = false;
+    for (auto& env : work.envs) {
+        env.ReleaseSnapshot();
+    }
+    translation_pending_bytes.fetch_sub(work.copied_bytes, std::memory_order_relaxed);
+    work.time = std::chrono::steady_clock::now() - begin;
+    {
+        std::scoped_lock lock{translated_mutex};
+        translated_graphics.splice(translated_graphics.end(), job);
+        num_translated.fetch_add(1, std::memory_order_release);
+    }
+    done.set_value();
+}
+
+void PipelineCache::AdoptTranslatedGraphicsPipelines() {
+    std::list<TranslationJob> finished;
+    {
+        std::scoped_lock lock{translated_mutex};
+        finished.splice(finished.end(), translated_graphics);
+        num_translated.store(0, std::memory_order_relaxed);
+    }
+    auto& report{GetTranslationReport()};
+    while (!finished.empty()) {
+        // One node at a time: a built job goes on, node and all, to the disk cache writer.
+        std::list<TranslationJob> one;
+        one.splice(one.end(), finished, finished.begin());
+        TranslationJob& job{one.front()};
+        translating_graphics.erase(job.key);
+        ++report.adopted;
+        report.worker += job.time;
+        const bool built{job.pipeline != nullptr};
+        const bool is_mesh{built && job.pipeline->IsMeshPipeline()};
+        report.failed += built ? 0 : 1;
+        const auto [slot, inserted]{graphics_cache.try_emplace(job.key)};
+        if (!inserted) {
+            // Unreachable: a key being translated is never made elsewhere. Its driver build may
+            // still be queued, so it is not destroyed.
+            LOG_ERROR(Render_Vulkan, "EDEN_UP_ASYNC_TRANSLATION: pipeline {:016x} made twice",
+                      job.key.Hash());
+            static_cast<void>(job.pipeline.release());
+            continue;
+        }
+        slot->second = std::move(job.pipeline);
+        if (built) {
+            // Counted as used from now: the eviction pass (EvictUnusedPipelines) must not take
+            // it as unused since frame 0 before its first draw.
+            slot->second->MarkUsed(frame_count);
+            StoreTranslatedGraphicsPipeline(std::move(one), is_mesh);
+        }
+    }
+    if (translating_graphics.empty()) {
+        // Nothing pending: keys put off over the cap that came back were made already; the
+        // others are forgotten (a later draw starts them from the beginning).
+        translation_deferred.clear();
+    }
+    report.Log();
+}
+
+void PipelineCache::StoreTranslatedGraphicsPipeline(std::list<TranslationJob> job, bool is_mesh) {
+    // As CreateGraphicsPipeline() stores a new pipeline.
+    if (pipeline_cache_filename.empty()) {
+        return;
+    }
+    const u64 hash{job.front().key.Hash()};
+    if (disk_pipelines.contains(hash)) {
+        // In the disk cache already, only not built at boot.
+        QueueVulkanPipelineCacheFlush();
+        return;
+    }
+    disk_pipelines.insert(hash);
+    SerializeTranslatedGraphicsPipeline(std::move(job), is_mesh);
+    QueueVulkanPipelineCacheFlush();
+}
+
+void PipelineCache::SerializeTranslatedGraphicsPipeline(std::list<TranslationJob> job,
+                                                        bool is_mesh) {
+    // The job's node moves to the writer whole, environments and all: nothing is copied here.
+    const u64 hash{job.front().key.Hash()};
+    try {
+        serialization_thread.QueueWork([this, job = std::move(job), is_mesh] {
+            try {
+                const TranslationJob& work{job.front()};
+                boost::container::static_vector<const GenericEnvironment*,
+                                                Maxwell::MaxShaderProgram>
+                    env_ptrs;
+                for (size_t index = 0; index < Maxwell::MaxShaderProgram; ++index) {
+                    if (work.key.unique_hashes[index] != 0) {
+                        env_ptrs.push_back(&work.envs[index]);
+                    }
+                }
+                SerializePipeline(work.key, env_ptrs,
+                                  is_mesh ? mesh_pipeline_cache_filename : pipeline_cache_filename,
+                                  CACHE_VERSION, is_mesh);
+            } catch (const std::bad_alloc&) {
+                SurviveBadAlloc("a graphics pipeline's disk cache entry");
+            }
+        });
+    } catch (const std::bad_alloc&) {
+        // Not written: made again (and written) at the next start, as when the writer has no
+        // memory.
+        disk_pipelines.erase(hash);
+        SurviveBadAlloc("a graphics pipeline's disk cache entry");
+    }
+}
