     dynamic_state.Refresh3(regs, features);
+    // The logic operation counts only while logic op is on. Without a dynamic logic-op enable the key
+    // holds the register even with logic op off, so two draws differing only in that unread value key
+    // two pipelines (Fritchii 9ea66c827). EDEN_NX2_LOGIC_OP_KEY=0 restores the old key.
+    if (!features.has_dynamic_state3_logic_op_enable && !dynamic_state.logic_op_enable) {
+        static const bool canonicalize = [] {
+            const char* const value = std::getenv("EDEN_NX2_LOGIC_OP_KEY");
+            return value == nullptr || value[0] != '0';
+        }();
+        if (canonicalize) {
+            dynamic_state.logic_op.Assign(0);
+        }
+    }
     if (xfb_enabled) {
         RefreshXfbState(xfb_state, regs);
     }
