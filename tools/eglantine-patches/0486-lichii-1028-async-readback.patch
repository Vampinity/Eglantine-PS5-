+// EDEN_UP_L1028_ASYNC_READBACK (zortos293/Lichii #1028): only pages the GPU wrote through the
+// caches can hold a read download (Switch 2 titles mark them, Tegra::Nx2MarkGpuWritten); a range
+// past the page table, or any range of other titles, may.
+bool MayHoldGpuWrites(DAddr addr, u64 size) {
+    if (!Tegra::g_nx2_ampere.load(std::memory_order_relaxed) || size == 0) {
+        return true;
+    }
+    const u64 table_pages = u64{Tegra::g_nx2_gpu_written_pages.size()} * 64;
+    const u64 first = addr >> Tegra::Nx2WrittenPageBits;
+    const u64 last = (addr + size - 1) >> Tegra::Nx2WrittenPageBits;
+    if (last < first || last >= table_pages) {
+        return true;
+    }
+    for (u64 page = first; page <= last; ++page) {
+        if (Tegra::Nx2IsGpuWritten(page << Tegra::Nx2WrittenPageBits)) {
+            return true;
+        }
+    }
+    return false;
+}
