diff --git a/src/video_core/nx2_async_readback.h b/src/video_core/nx2_async_readback.h
new file mode 100644
--- /dev/null
+++ b/src/video_core/nx2_async_readback.h
@@ -0,0 +1,304 @@
+// SPDX-FileCopyrightText: Copyright 2026 Eden Emulator Project
+// SPDX-License-Identifier: GPL-3.0-or-later
+
+#pragma once
+
+#include <array>
+#include <atomic>
+#include <chrono>
+
+#include "common/common_types.h"
+#include "common/logging.h"
+#include "common/pe_switch.h"
+
+// Port of zortos293/Lichii #1028 (merged into nx2 as 0b83798bf6; jpkto and zortos293, a port of
+// #805's read-back). Every part is off unless its switch is exactly "1" (Common::PeSwitch, read
+// once):
+// - EDEN_UP_L1028_ASYNC_READBACK: a guest CPU read of GPU-written buffer memory (GPU::OnCPURead)
+//   has the GPU thread submit the buffer downloads and go on (BufferCache::DownloadMemoryForRead)
+//   instead of waiting for the host GPU (Scheduler::Finish) with the buffer cache's lock held.
+//   The reading thread waits for that submission and writes the bytes to guest memory
+//   (BufferCache::FinishReadDownloads). Writes to guest memory from the GPU's side land the read
+//   downloads under them first (MemoryManager, query results, ClearDownload).
+// - EDEN_UP_L1028_EARLY (with ASYNC_READBACK): pages the guest reads after each GPU write get
+//   their download right behind the write (BufferCache::RecordEarlyDownloads). Only pages that
+//   are not Preflushable learn this, so it acts with EDEN_NX2_PREFLUSH=0 (upstream's mode).
+// - EDEN_UP_L1028_VERIFY (with ASYNC_READBACK): every read download is compared, as it lands, with
+//   a synchronous copy taken in the same submission (a reduced EDEN_NX2_READ_CHECK).
+// - EDEN_UP_L1028_DMA_WAIT: a macro DMA read EDEN_NX2_DMA_SNAPSHOT can't answer waits only for
+//   the queued work that may write its words, and drains only if the caches hold them then
+//   (upstream's FrontDmaRead/GpuSplit::WaitForWrites on our snapshot misses).
+//   EDEN_UP_L1028_DMA_WAIT_VERIFY: such reads drain anyway and are compared.
+// - EDEN_UP_L1028_STATS: the counters below, one line every 10 s. No behaviour change: control
+//   arms carry it to count the synchronous reads and the back's host GPU waits for them.
+namespace VideoCore::AsyncReadback {
+
+/// EDEN_UP_L1028_ASYNC_READBACK=1
+[[nodiscard]] inline bool Enabled() {
+    static const bool on = Common::PeSwitch("EDEN_UP_L1028_ASYNC_READBACK");
+    return on;
+}
+
+/// EDEN_UP_L1028_EARLY=1, only with ASYNC_READBACK
+[[nodiscard]] inline bool EarlyEnabled() {
+    static const bool on = Enabled() && Common::PeSwitch("EDEN_UP_L1028_EARLY");
+    return on;
+}
+
+/// EDEN_UP_L1028_VERIFY=1, only with ASYNC_READBACK
+[[nodiscard]] inline bool VerifyEnabled() {
+    static const bool on = Enabled() && Common::PeSwitch("EDEN_UP_L1028_VERIFY");
+    return on;
+}
+
+/// EDEN_UP_L1028_DMA_WAIT=1
+[[nodiscard]] inline bool DmaWaitEnabled() {
+    static const bool on = Common::PeSwitch("EDEN_UP_L1028_DMA_WAIT");
+    return on;
+}
+
+/// EDEN_UP_L1028_DMA_WAIT_VERIFY=1, only with DMA_WAIT
+[[nodiscard]] inline bool DmaWaitVerify() {
+    static const bool on = DmaWaitEnabled() && Common::PeSwitch("EDEN_UP_L1028_DMA_WAIT_VERIFY");
+    return on;
+}
+
+/// EDEN_UP_L1028_STATS=1
+[[nodiscard]] inline bool StatsEnabled() {
+    static const bool on = Common::PeSwitch("EDEN_UP_L1028_STATS");
+    return on;
+}
+
+/// Who wrote a read download to guest memory (EDEN_UP_L1028_VERIFY's differences).
+enum class Landing : u8 {
+    Reader,       ///< The guest thread whose read waited for it (GPU::OnCPURead)
+    GpuSideWrite, ///< A write to guest memory from the GPU's side over its bytes
+    Completed,    ///< Whichever thread found the host GPU had run it, before a read waited
+    Count,
+};
+
+/// Set on a guest thread while GPU::OnCPURead writes its downloads to guest memory.
+inline thread_local bool t_reading{};
+/// Set on the thread running a read's flush request (GPU::OnCPURead), for the stats only.
+inline thread_local bool t_read_flush{};
+
+[[nodiscard]] inline u64 Now() {
+    return static_cast<u64>(std::chrono::duration_cast<std::chrono::nanoseconds>(
+                                std::chrono::steady_clock::now().time_since_epoch())
+                                .count());
+}
+
+enum class Read : u8 {
+    Sync,     ///< ASYNC_READBACK off: the GPU thread flushed and waited, as before
+    Async,    ///< The GPU thread submitted the downloads, the reading thread waited for them
+    InFlight, ///< An earlier read's or an early download covered it: no flush, only the wait
+    Count,
+};
+
+enum class HostWait : u8 {
+    ReadFlush, ///< The buffer cache's synchronous download for a read's flush (GPU::OnCPURead)
+    Other,     ///< Its other synchronous downloads (CPU writes on GPU-written pages, macro DMA)
+    Count,
+};
+
+/// Totals for the 10 s line, from every thread.
+struct Counters {
+    std::array<std::atomic<u64>, static_cast<size_t>(Read::Count)> reads{};
+    /// From the read's request to its bytes in guest memory
+    std::array<std::atomic<u64>, static_cast<size_t>(Read::Count)> read_ns{};
+    std::atomic<u64> read_max_ns{};
+    /// The GPU thread's time in the reads' flush requests, and in their buffer cache part
+    std::atomic<u64> flush_ns{};
+    std::atomic<u64> flush_buffer_ns{};
+    /// The buffer cache waiting for the host GPU under its lock (Scheduler::Finish), by caller
+    std::array<std::atomic<u64>, static_cast<size_t>(HostWait::Count)> host_waits{};
+    std::array<std::atomic<u64>, static_cast<size_t>(HostWait::Count)> host_wait_ns{};
+    /// Read downloads recorded (read ones, early ones), their copies and bytes, and those that
+    /// fell back to the synchronous path (no staging buffer)
+    std::atomic<u64> read_downloads{};
+    std::atomic<u64> early_downloads{};
+    std::atomic<u64> download_bytes{};
+    std::atomic<u64> download_fallbacks{};
+    /// Reading threads whose download the host GPU had not run yet
+    std::atomic<u64> reader_waits{};
+    std::atomic<u64> reader_wait_ns{};
+    /// Writes from the GPU's side that landed read downloads, and those that waited for the host GPU
+    std::atomic<u64> gpu_side_landings{};
+    std::atomic<u64> gpu_side_waits{};
+    std::atomic<u64> gpu_side_wait_ns{};
+    /// Landings ClearDownload forced before a write guest memory doesn't hold yet (a DMA copy, a
+    /// clear, a discarded or inline write), those that waited, and the time
+    std::atomic<u64> clear_landings{};
+    std::atomic<u64> clear_waits{};
+    std::atomic<u64> clear_wait_ns{};
+    /// EDEN_UP_L1028_DMA_WAIT: snapshot misses, those answered after a narrower wait (and its
+    /// time), those drained (and their time), and verify differences
+    std::atomic<u64> dma_misses{};
+    std::atomic<u64> dma_narrow{};
+    std::atomic<u64> dma_narrow_ns{};
+    std::atomic<u64> dma_drained{};
+    std::atomic<u64> dma_drained_ns{};
+    std::atomic<u64> dma_verify_differences{};
+    /// EDEN_UP_L1028_VERIFY
+    std::atomic<u64> verify_checked{};
+    std::atomic<u64> verify_bytes{};
+    std::array<std::atomic<u64>, static_cast<size_t>(Landing::Count)> verify_differing{};
+    std::atomic<u64> verify_uncovered{};
+    std::atomic<u64> verify_not_compared{};
+    std::atomic<u64> window_start{};
+};
+
+inline Counters g_counters;
+
+inline void Add(std::atomic<u64>& counter, u64 amount) {
+    counter.fetch_add(amount, std::memory_order_relaxed);
+}
+
+inline void Max(std::atomic<u64>& counter, u64 value) {
+    u64 max = counter.load(std::memory_order_relaxed);
+    while (value > max &&
+           !counter.compare_exchange_weak(max, value, std::memory_order_relaxed)) {
+    }
+}
+
+inline void CountRead(Read kind, u64 ns) {
+    Add(g_counters.reads[static_cast<size_t>(kind)], 1);
+    Add(g_counters.read_ns[static_cast<size_t>(kind)], ns);
+    Max(g_counters.read_max_ns, ns);
+}
+
+/// The buffer cache waited ns for the host GPU under its lock (synchronous downloads).
+inline void CountHostWait(u64 ns) {
+    const auto site = static_cast<size_t>(t_read_flush ? HostWait::ReadFlush : HostWait::Other);
+    Add(g_counters.host_waits[site], 1);
+    Add(g_counters.host_wait_ns[site], ns);
+}
+
+/// BufferCache::FinishReadDownloads landed downloads after waiting ns for the host GPU (0: no
+/// wait), for a reading thread or for a write from the GPU's side.
+inline void CountLanding(u64 ns) {
+    if (t_reading) {
+        Add(g_counters.reader_waits, ns != 0 ? 1 : 0);
+        Add(g_counters.reader_wait_ns, ns);
+        return;
+    }
+    Add(g_counters.gpu_side_landings, 1);
+    Add(g_counters.gpu_side_waits, ns != 0 ? 1 : 0);
+    Add(g_counters.gpu_side_wait_ns, ns);
+}
+
+/// BufferCache::ClearDownload landed read downloads, waiting ns for the host GPU (0: none).
+inline void CountClearLanding(u64 ns) {
+    Add(g_counters.clear_landings, 1);
+    Add(g_counters.clear_waits, ns != 0 ? 1 : 0);
+    Add(g_counters.clear_wait_ns, ns);
+}
+
+/// Logs the totals every 10 s and resets them, on whichever thread counts first after that.
+inline void MaybeReport() {
+    auto& c = g_counters;
+    const u64 now = Now();
+    u64 start = c.window_start.load(std::memory_order_relaxed);
+    if (start == 0) {
+        c.window_start.compare_exchange_strong(start, now, std::memory_order_relaxed);
+        return;
+    }
+    if (now - start < 10'000'000'000ULL ||
+        !c.window_start.compare_exchange_strong(start, now, std::memory_order_relaxed)) {
+        return;
+    }
+    const double window = static_cast<double>(now - start);
+    const auto take = [](std::atomic<u64>& counter) {
+        return counter.exchange(0, std::memory_order_relaxed);
+    };
+    const auto per_second = [window](u64 value) {
+        return static_cast<double>(value) * 1e9 / window;
+    };
+    const auto ms_per_second = [window](u64 ns) { return static_cast<double>(ns) * 1e3 / window; };
+    constexpr auto sync = static_cast<size_t>(Read::Sync);
+    constexpr auto async = static_cast<size_t>(Read::Async);
+    constexpr auto in_flight = static_cast<size_t>(Read::InFlight);
+    constexpr auto read_flush = static_cast<size_t>(HostWait::ReadFlush);
+    constexpr auto other = static_cast<size_t>(HostWait::Other);
+    std::array<u64, static_cast<size_t>(Read::Count)> reads{};
+    std::array<u64, static_cast<size_t>(Read::Count)> read_ns{};
+    for (size_t i = 0; i < reads.size(); ++i) {
+        reads[i] = take(c.reads[i]);
+        read_ns[i] = take(c.read_ns[i]);
+    }
+    std::array<u64, static_cast<size_t>(HostWait::Count)> host_waits{};
+    std::array<u64, static_cast<size_t>(HostWait::Count)> host_wait_ns{};
+    for (size_t i = 0; i < host_waits.size(); ++i) {
+        host_waits[i] = take(c.host_waits[i]);
+        host_wait_ns[i] = take(c.host_wait_ns[i]);
+    }
+    std::array<u64, static_cast<size_t>(Landing::Count)> differing{};
+    for (size_t i = 0; i < differing.size(); ++i) {
+        differing[i] = take(c.verify_differing[i]);
+    }
+    const u64 read_max_ns = take(c.read_max_ns);
+    const u64 flush_ns = take(c.flush_ns);
+    const u64 flush_buffer_ns = take(c.flush_buffer_ns);
+    const u64 read_downloads = take(c.read_downloads);
+    const u64 early_downloads = take(c.early_downloads);
+    const u64 download_bytes = take(c.download_bytes);
+    const u64 download_fallbacks = take(c.download_fallbacks);
+    const u64 reader_waits = take(c.reader_waits);
+    const u64 reader_wait_ns = take(c.reader_wait_ns);
+    const u64 gpu_side_landings = take(c.gpu_side_landings);
+    const u64 gpu_side_waits = take(c.gpu_side_waits);
+    const u64 gpu_side_wait_ns = take(c.gpu_side_wait_ns);
+    const u64 clear_landings = take(c.clear_landings);
+    const u64 clear_waits = take(c.clear_waits);
+    const u64 clear_wait_ns = take(c.clear_wait_ns);
+    const u64 dma_misses = take(c.dma_misses);
+    const u64 dma_narrow = take(c.dma_narrow);
+    const u64 dma_narrow_ns = take(c.dma_narrow_ns);
+    const u64 dma_drained = take(c.dma_drained);
+    const u64 dma_drained_ns = take(c.dma_drained_ns);
+    const u64 dma_verify_differences = take(c.dma_verify_differences);
+    const u64 verify_checked = take(c.verify_checked);
+    const u64 verify_bytes = take(c.verify_bytes);
+    const u64 verify_uncovered = take(c.verify_uncovered);
+    const u64 verify_not_compared = take(c.verify_not_compared);
+    LOG_INFO(HW_GPU,
+             "Lichii #1028 read-back per second ({:.1f} s; async {}, early {}, dma wait {}): guest "
+             "reads of GPU-written memory {:.1f} synced on the GPU thread ({:.1f} ms), {:.1f} "
+             "async ({:.1f} ms), {:.1f} only waited for a download on its way ({:.1f} ms), "
+             "longest {:.2f} ms | GPU thread in their flushes {:.1f} ms, buffer cache part {:.1f} "
+             "ms | buffer cache host GPU waits under its lock: {:.1f} for reads ({:.1f} ms), {:.1f} "
+             "other ({:.1f} ms) | read downloads {:.1f}, early {:.1f}, {:.0f} KiB, {:.1f} fell "
+             "back to a synchronous flush | readers waited on the host GPU {:.1f} times ({:.1f} "
+             "ms) | GPU-side writes landed downloads {:.1f} times, {:.1f} waited ({:.1f} ms) | "
+             "landings before writes guest memory doesn't hold {:.1f}, {:.1f} waited ({:.1f} ms) | "
+             "DMA snapshot misses {:.1f}: {:.1f} after a narrower wait ({:.1f} ms), {:.1f} drained "
+             "({:.1f} ms), {} verify differences | verify: {} downloads, {} bytes compared, {} "
+             "differ (reader {}, GPU-side write {}, completed {}), {} GPU-modified bytes no "
+             "download brought, {} kept bytes not compared",
+             window / 1e9, Enabled() ? "on" : "off", EarlyEnabled() ? "on" : "off",
+             DmaWaitEnabled() ? "on" : "off", per_second(reads[sync]), ms_per_second(read_ns[sync]),
+             per_second(reads[async]), ms_per_second(read_ns[async]), per_second(reads[in_flight]),
+             ms_per_second(read_ns[in_flight]), static_cast<double>(read_max_ns) / 1e6,
+             ms_per_second(flush_ns), ms_per_second(flush_buffer_ns),
+             per_second(host_waits[read_flush]), ms_per_second(host_wait_ns[read_flush]),
+             per_second(host_waits[other]), ms_per_second(host_wait_ns[other]),
+             per_second(read_downloads), per_second(early_downloads),
+             per_second(download_bytes) / 1024.0, per_second(download_fallbacks),
+             per_second(reader_waits), ms_per_second(reader_wait_ns),
+             per_second(gpu_side_landings), per_second(gpu_side_waits),
+             ms_per_second(gpu_side_wait_ns), per_second(clear_landings), per_second(clear_waits),
+             ms_per_second(clear_wait_ns), per_second(dma_misses), per_second(dma_narrow),
+             ms_per_second(dma_narrow_ns), per_second(dma_drained), ms_per_second(dma_drained_ns),
+             dma_verify_differences, verify_checked, verify_bytes,
+             differing[0] + differing[1] + differing[2], differing[0], differing[1], differing[2],
+             verify_uncovered, verify_not_compared);
+}
+
+/// Counting sites call this after counting: with EDEN_UP_L1028_STATS, logs every 10 s.
+inline void MaybeReportIfEnabled() {
+    if (StatsEnabled()) {
+        MaybeReport();
