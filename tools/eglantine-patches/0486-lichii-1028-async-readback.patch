+            ++pending_early_downloads;
+            early_bytes_this_frame += total_size_bytes;
+        }
+        read_downloads.push_back(std::move(download));
+        VideoCore::g_read_downloads.fetch_add(1, std::memory_order_release);
+        return true;
+    }
+}
