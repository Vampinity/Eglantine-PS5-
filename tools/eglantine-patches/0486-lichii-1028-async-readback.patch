+template <class P>
+std::optional<u64> BufferCache<P>::FinishReadDownloads(DAddr device_addr, u64 size) {
+    if constexpr (IS_OPENGL) {
+        return std::nullopt;
+    } else {
+        std::unique_lock lock{mutex};
+        // The newest one over the range: those before it are written first. Only a reading
+        // thread waits for an early download not submitted yet (the back submits it when asked).
+        // A write from the GPU's side leaves its range instead, which then stays GPU-modified, as
+        // without early downloads: on the thread that records (the split's back) the wait would
+        // need a submission in the middle of whatever it records, and the fencing thread may hold
+        // up a back that waits for it.
+        const bool reading = VideoCore::AsyncReadback::t_reading;
+        bool dropped = false;
+        std::optional<u64> tick;
+        for (ReadDownload& download : read_downloads) {
+            const bool over = download.write_ranges.Intersects(device_addr, size) ||
+                              (download.check && download.check->alone &&
+                               download.check->read_begin < device_addr + size &&
+                               device_addr < download.check->read_end);
+            if (!over) {
+                continue;
+            }
+            if (!reading && download.early && !runtime.IsSubmittedForHostRead(download.tick)) {
+                download.write_ranges.Subtract(device_addr, size);
+                download.clean_ranges.Subtract(device_addr, size);
+                read_download_ranges.Subtract(device_addr, size);
+                dropped = true;
+                continue;
+            }
+            tick = download.tick;
+        }
+        if (dropped) {
+            // EDEN_UP_L1028_VERIFY: the caller writes guest memory there next.
+            for (ReadDownload& download : read_downloads) {
+                if (download.check) {
+                    download.check->changed.Add(device_addr, size);
+                }
+            }
+        }
+        if (!tick) {
+            return std::nullopt;
+        }
+        u64 waited = 0;
+        if (!runtime.IsFree(*tick)) {
+            lock.unlock();
+            const u64 wait_start = VideoCore::AsyncReadback::Now();
+            runtime.WaitForHostRead(*tick);
+            waited = (std::max)(VideoCore::AsyncReadback::Now() - wait_start, u64{1});
+            lock.lock();
+        }
+        WriteReadDownloads(*tick, VideoCore::AsyncReadback::t_reading
+                                      ? VideoCore::AsyncReadback::Landing::Reader
+                                      : VideoCore::AsyncReadback::Landing::GpuSideWrite);
+        return waited;
+    }
+}
+
+template <class P>
+void BufferCache<P>::OutdateReadDownloads(DAddr device_addr, u64 size) {
+    // The bytes stay GPU-modified when the downloads land, so a later read downloads them.
+    if (!read_downloads.empty()) {
+        for (ReadDownload& download : read_downloads) {
+            download.clean_ranges.Subtract(device_addr, size);
+        }
+        read_download_ranges.Subtract(device_addr, size);
+    }
+}
+
+template <class P>
+bool BufferCache<P>::WriteFinishedReadDownloads(DAddr device_addr, u64 size) {
+    if constexpr (!IS_OPENGL) {
+        std::optional<u64> tick;
+        for (const ReadDownload& download : read_downloads) {
+            if (download.write_ranges.Intersects(device_addr, size)) {
+                tick = download.tick;
+            }
+        }
+        if (!tick || !runtime.IsFreeNow(*tick)) {
+            return false;
+        }
+        WriteReadDownloads(*tick);
+        return true;
+    } else {
+        return false;
+    }
+}
