+                        VideoCore::AsyncReadback::g_counters.verify_uncovered, upper - lower);
+                });
+            }
+        }
+        // EDEN_UP_L1028_VERIFY: a check whose read's bytes other downloads bring is a download of
+        // its own, which its read waits for.
+        const bool check_alone = check && copies.empty() && !check_copies.empty();
+        std::optional<Async_Buffer> staging;
+        if (!copies.empty()) {
+            staging = runtime.TryDownloadStagingBuffer(total_size_bytes, true);
+            if (!staging) {
+                return false; // Nothing changed: the caller flushes synchronously.
+            }
+        }
+        std::optional<Async_Buffer> check_staging;
+        if (check && !check_copies.empty()) {
+            check_staging = runtime.TryDownloadStagingBuffer(check_size, true);
+        }
