+template <class P>
+bool BufferCache<P>::RecordReadDownload(std::span<const std::pair<DAddr, u64>> ranges,
+                                        std::span<const std::pair<DAddr, u64>> own, bool early) {
+    if constexpr (IS_OPENGL || !USE_MEMORY_MAPS) {
+        return false;
+    } else {
+        struct Copy {
+            BufferId buffer_id;
+            BufferCopy copy; ///< src_offset in the buffer, dst_offset in the staging buffer
+        };
+        boost::container::small_vector<Copy, 16> copies;
+        u64 total_size_bytes = 0;
+        // The bytes this download brings, and the download runs it looked at: older fence
+        // downloads must not land over them.
+        Common::RangeSet<DAddr> taken;
+        boost::container::small_vector<std::pair<DAddr, u64>, 16> runs;
+        for (const auto& [range_addr, range_size] : ranges) {
+            ForEachBufferInRange(range_addr, range_size, [&](BufferId buffer_id, Buffer& buffer) {
+                const DAddr buffer_addr = buffer.CpuAddr();
+                const DAddr begin = (std::max)(range_addr, buffer_addr);
+                const DAddr end =
+                    (std::min)(range_addr + range_size, buffer_addr + buffer.SizeBytes());
+                if (begin >= end) {
+                    return;
+                }
+                // The bytes DownloadRangesMemory takes, but they stay GPU-modified until they
+                // are in guest memory (WriteReadDownloads).
+                Common::RangeSet<DAddr> wanted;
+                memory_tracker.ForEachDownloadRange(
+                    begin, end - begin, false, [&](u64 run_addr, u64 run_size) {
+                        runs.emplace_back(run_addr, run_size);
+                        gpu_modified_ranges.ForEachInRange(
+                            run_addr, run_size,
+                            [&](DAddr start, DAddr stop) { wanted.Add(start, stop - start); });
+                    });
+                // Without the bytes a read download already brings (an earlier one, or this one:
+                // the ranges can overlap).
+                read_download_ranges.ForEachInRange(begin, end - begin, [&](DAddr lower, DAddr upper) {
+                    wanted.Subtract(lower, upper - lower);
+                });
+                taken.ForEachInRange(begin, end - begin, [&](DAddr lower, DAddr upper) {
+                    wanted.Subtract(lower, upper - lower);
+                });
+                wanted.ForEach([&](DAddr start, DAddr stop) {
+                    copies.push_back({buffer_id, BufferCopy{
+                                                     .src_offset = start - buffer_addr,
+                                                     .dst_offset = total_size_bytes,
+                                                     .size = stop - start,
+                                                 }});
+                    total_size_bytes += Common::AlignUp(stop - start, 64);
+                    taken.Add(start, stop - start);
+                });
+            });
+        }
+        // EDEN_UP_L1028_VERIFY: what a synchronous flush (DownloadRangesMemory) copies for the
+        // read itself, and where each of those bytes comes from.
+        std::unique_ptr<ReadCheck> check;
+        boost::container::small_vector<Copy, 16> check_copies;
+        u64 check_size = 0;
+        if (!early && VideoCore::AsyncReadback::VerifyEnabled()) {
+            check = std::make_unique<ReadCheck>();
+            check->read_begin = ~DAddr{0};
+            for (const auto& [own_addr, own_size] : own) {
+                check->read_begin = (std::min)(check->read_begin, own_addr);
+                check->read_end = (std::max)(check->read_end, own_addr + own_size);
+                ForEachBufferInRange(own_addr, own_size, [&](BufferId buffer_id, Buffer& buffer) {
+                    const DAddr buffer_addr = buffer.CpuAddr();
+                    const DAddr begin = (std::max)(own_addr, buffer_addr);
+                    const DAddr end =
+                        (std::min)(own_addr + own_size, buffer_addr + buffer.SizeBytes());
+                    if (begin >= end) {
+                        return;
+                    }
+                    memory_tracker.ForEachDownloadRange(
+                        begin, end - begin, false, [&](u64 run_addr, u64 run_size) {
+                            gpu_modified_ranges.ForEachInRange(
+                                run_addr, run_size, [&](DAddr start, DAddr stop) {
+                                    check_copies.push_back(
+                                        {buffer_id, BufferCopy{
+                                                        .src_offset = start - buffer_addr,
+                                                        .dst_offset = check_size,
+                                                        .size = stop - start,
+                                                    }});
+                                    check_size += Common::AlignUp(stop - start, 64);
+                                });
+                        });
+                });
+            }
+            for (const Copy& entry : check_copies) {
+                const DAddr start = slot_buffers[entry.buffer_id].CpuAddr() + entry.copy.src_offset;
+                Common::RangeSet<DAddr> rest;
+                rest.Add(start, entry.copy.size);
+                taken.ForEachInRange(start, entry.copy.size, [&](DAddr lower, DAddr upper) {
+                    rest.Subtract(lower, upper - lower);
+                });
+                // The read download whose clean bytes they are brings them (clean_ranges don't
+                // overlap, and are what read_download_ranges left out of this one).
+                for (const ReadDownload& earlier : read_downloads) {
+                    earlier.clean_ranges.ForEachInRange(
+                        start, entry.copy.size, [&](DAddr lower, DAddr upper) {
+                            rest.ForEachInRange(lower, upper - lower, [&](DAddr from, DAddr to) {
+                                check->kept.push_back({earlier.sequence, {from, to}});
+                            });
