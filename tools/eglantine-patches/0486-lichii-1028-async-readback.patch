+/// What DownloadLanding publishes.
+struct DownloadLandingState {
+    /// Odd while a landing is published.
+    std::atomic<u64> sequence{};
+    std::atomic<DAddr> begin{};
+    std::atomic<DAddr> end{};
+    std::atomic<u64> waits{};
