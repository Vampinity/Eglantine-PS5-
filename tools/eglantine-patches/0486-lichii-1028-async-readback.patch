+    /// EDEN_UP_L1028_DMA_WAIT (zortos293/Lichii #1028's GpuSplit::WaitForWrites, on these notes):
+    /// waits until the back executed every entry sent so far that may write device bytes
+    /// [begin, begin + size) by the notes above (compute and copies, unranged writers, noted
+    /// writes over the range), not the ones after it. All of them when more writes were noted
+    /// since than are remembered. Returns whether one was still queued.
+    bool WaitForNotedWriters(u64 begin, u64 size) {
+        CloseRegs();
+        u64 target = (std::max)(last_writer_position, last_unranged_position);
+        if (last_memory_writer_position > target) {
+            const u64 end = begin + size;
+            const u64 remembered = (std::min<u64>)(pending_write_count, pending_writes.size());
+            bool settled = false;
+            for (u64 scanned = 0; scanned < remembered; ++scanned) {
+                const PendingWrite& write =
+                    pending_writes[(pending_write_count - 1 - scanned) % pending_writes.size()];
+                if (write.position <= target) {
+                    settled = true; // Older ones are waited for anyway.
+                    break;
+                }
+                if (write.begin < end && begin < write.end) {
+                    target = write.position;
+                    settled = true;
+                    break;
+                }
+            }
+            if (!settled && remembered == pending_writes.size()) {
+                target = write_position;
+            }
+        }
+        return WaitFor((std::min)(target, write_position), DrainSite::DmaSnapshotWrites);
+    }
 
