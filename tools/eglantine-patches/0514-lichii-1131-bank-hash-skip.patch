+template <class P>
+bool BufferCache<P>::Nx2BankHashSkip() {
+    static const bool on = [] {
+        const bool enabled = Common::PeSwitch("EDEN_UP_BANK_HASH_SKIP");
+        if (enabled) {
+            LOG_INFO(HW_GPU, "EDEN_UP_BANK_HASH_SKIP on: a native bank's once-per-frame upload "
+                             "is skipped while its bytes match its last upload");
+        }
+        return enabled;
+    }();
+    return on;
+}
+
+template <class P>
+std::optional<u64> BufferCache<P>::Nx2BankHashOf(DAddr device_addr, u64 size) {
+    u64 hash = 0;
+    for (u64 done = 0; done < size;) {
+        const DAddr at = device_addr + done;
+        const u64 piece =
+            (std::min<u64>)(Core::DEVICE_PAGESIZE - (at & Core::DEVICE_PAGEMASK), size - done);
+        const u8* const bytes = device_memory.template GetPointer<u8>(at);
+        if (bytes == nullptr) {
+            // Unmapped since the caller's walk: uploaded as before, no entry.
+            return std::nullopt;
+        }
+        hash = Common::CityHash64WithSeed(reinterpret_cast<const char*>(bytes), piece, hash);
+        done += piece;
+    }
+    return hash;
+}
+
+template <class P>
+void BufferCache<P>::Nx2BankHashKeep(DAddr device_addr, u64 hash, u64 size, BufferId buffer_id) {
+    // A page copied for the frame in flight since the hash: the upload may have read the copy.
+    if (VideoCommon::AheadGuard::CopyMode() &&
+        VideoCommon::AheadGuard::HasCopy(device_addr, size)) {
+        Nx2BankHashForget(device_addr, size);
+        ++nx2_bank_hash_stats.copied;
+        return;
+    }
+    // A guest write landed between the hash and now: the upload may hold either bytes.
+    const std::optional<u64> now = Nx2BankHashOf(device_addr, size);
+    if (!now || *now != hash) {
+        Nx2BankHashForget(device_addr, size);
+        ++nx2_bank_hash_stats.moved;
+        return;
+    }
+    if (!nx2_bank_hash_regions) {
+        nx2_bank_hash_regions.reset(new u64[NX2_BANK_HASH_REGIONS / 64]());
+    }
+    if (nx2_bank_hashes.size() >= 16384) {
+        // Banks long unused keep their entries until their range is written: start over (an
+        // entry less only costs an upload).
+        nx2_bank_hashes.clear();
+        std::fill_n(nx2_bank_hash_regions.get(), NX2_BANK_HASH_REGIONS / 64, u64{0});
+    }
+    nx2_bank_hashes.insert_or_assign(device_addr, Nx2BankHash{hash, size, buffer_id});
+    const u64 last = (device_addr + size - 1) >> NX2_BANK_HASH_REGION_BITS;
+    for (u64 region = device_addr >> NX2_BANK_HASH_REGION_BITS; region <= last; ++region) {
+        const u64 bit = region & (NX2_BANK_HASH_REGIONS - 1);
+        nx2_bank_hash_regions[bit / 64] |= u64{1} << (bit % 64);
+    }
+}
+
+template <class P>
+void BufferCache<P>::Nx2BankHashForget(DAddr device_addr, u64 size) {
+    if (nx2_bank_hashes.empty() || size == 0) {
+        return;
+    }
+    const DAddr end = device_addr + size;
+    const u64 last = (end - 1) >> NX2_BANK_HASH_REGION_BITS;
+    if (last - (device_addr >> NX2_BANK_HASH_REGION_BITS) < 64) {
+        // An entry that overlaps the range set the bit of a region the range covers.
+        bool kept_here = false;
+        for (u64 region = device_addr >> NX2_BANK_HASH_REGION_BITS; region <= last && !kept_here;
+             ++region) {
+            const u64 bit = region & (NX2_BANK_HASH_REGIONS - 1);
+            kept_here = ((nx2_bank_hash_regions[bit / 64] >> (bit % 64)) & 1) != 0;
+        }
+        if (!kept_here) {
+            return;
+        }
+    }
+    // Entries are at most 64 KiB long: those that can reach into the range start after
+    // device_addr - 64 KiB.
+    constexpr DAddr longest = 0x10000;
+    auto it = device_addr > longest ? nx2_bank_hashes.upper_bound(device_addr - longest)
+                                    : nx2_bank_hashes.begin();
+    while (it != nx2_bank_hashes.end() && it->first < end) {
+        if (it->first + it->second.size > device_addr) {
+            it = nx2_bank_hashes.erase(it);
+            ++nx2_bank_hash_stats.forgotten;
+        } else {
+            ++it;
+        }
+    }
+    if (nx2_bank_hashes.empty()) {
+        std::fill_n(nx2_bank_hash_regions.get(), NX2_BANK_HASH_REGIONS / 64, u64{0});
+    }
+}
