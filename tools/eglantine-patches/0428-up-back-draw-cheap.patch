             UntrackImage(overlap, copy_object.id);
@@ -5090,13 +5090,22 @@ void TextureCache<P>::RemoveFramebuffers(std::span<const ImageViewId> removed_vi
 template <class P>
 void TextureCache<P>::MarkModification(ImageBase& image) noexcept {
     image.flags |= ImageFlagBits::GpuModified;
-    image.modification_tick = ++modification_tick;
+    SetModificationTick(slot_images, image, ++modification_tick);
 }
 
 template <class P>
 void TextureCache<P>::SynchronizeAliases(ImageId image_id) {
     boost::container::small_vector<const AliasedImage*, 8> aliased_images;
     Image& image = slot_images[image_id];
+    const bool cheap = UpBackDrawCheap();
+    // EDEN_UP_BACK_DRAW_CHEAP: nothing aliased was modified after this image, skip walking its
+    // (possibly long) alias list for every draw that samples it.
+    if (cheap && image.newest_alias_tick <= image.modification_tick) {
+        DEBUG_ASSERT(std::ranges::none_of(image.aliased_images, [&](const AliasedImage& alias) {
+            return slot_images[alias.id].modification_tick > image.modification_tick;
+        }));
+        return;
+    }
     bool any_rescaled = True(image.flags & ImageFlagBits::Rescaled);
     bool any_modified = True(image.flags & ImageFlagBits::GpuModified);
     u64 most_recent_tick = image.modification_tick;
@@ -5110,6 +5119,10 @@ void TextureCache<P>::SynchronizeAliases(ImageId image_id) {
         }
     }
     if (aliased_images.empty()) {
+        if (cheap) {
+            // Newer aliases were deleted since: skip the walk until one is modified again.
+            image.newest_alias_tick = image.modification_tick;
+        }
         return;
     }
     const bool can_rescale = ImageCanRescale(image);
@@ -5120,7 +5133,10 @@ void TextureCache<P>::SynchronizeAliases(ImageId image_id) {
             ScaleDown(image);
         }
     }
-    image.modification_tick = most_recent_tick;
+    SetModificationTick(slot_images, image, most_recent_tick);
+    if (cheap) {
+        image.newest_alias_tick = most_recent_tick;
+    }
     if (any_modified) {
         image.flags |= ImageFlagBits::GpuModified;
     }
