Subject: [PATCH] EDEN_UP_BACK_DRAW_CHEAP: part of Lichii #858 (c7e807d617): skip alias sync when no aliased image changed, drop empty direct draws before pipeline work; off by default

diff --git a/src/video_core/renderer_vulkan/vk_rasterizer.cpp b/src/video_core/renderer_vulkan/vk_rasterizer.cpp
index 7302c76..f1b1699 100644
--- a/src/video_core/renderer_vulkan/vk_rasterizer.cpp
+++ b/src/video_core/renderer_vulkan/vk_rasterizer.cpp
@@ -1079,6 +1079,22 @@ void RasterizerVulkan::Draw(bool is_indexed, u32 instance_count) {
                      regs.blend.enable[0], seen.size());
         }
     }
+    // EDEN_UP_BACK_DRAW_CHEAP (Lichii PR 858): a direct draw with no vertices, or no instances
+    // outside task/mesh pipelines, records nothing. Skip it before the pipeline, buffer and
+    // descriptor work: dirty state, deferred clears and query counter toggles stay pending for the
+    // next recorded draw, clear or render pass end, which apply them before anything can observe
+    // them. With transform feedback on the draw goes through, since its counters are begun and
+    // closed around draws.
+    if (VideoCommon::UpBackDrawCheap() && maxwell3d->regs.transform_feedback_enabled == 0 &&
+        (MakeDrawParams(maxwell3d->draw_manager.draw_state, instance_count, is_indexed)
+                 .num_vertices == 0 ||
+         (instance_count == 0 && [this] {
+             const GraphicsPipeline* const pipeline = pipeline_cache.CurrentGraphicsPipeline();
+             return pipeline != nullptr && !pipeline->IsMeshPipeline();
+         }()))) {
+        gpu.TickWork();
+        return;
+    }
     PrepareDraw(is_indexed, [this, is_indexed, instance_count] {
         const auto& draw_state = maxwell3d->draw_manager.draw_state;
         const u32 num_instances{instance_count};
diff --git a/src/video_core/texture_cache/image_base.cpp b/src/video_core/texture_cache/image_base.cpp
index 3185dd8..ebed5cf 100644
--- a/src/video_core/texture_cache/image_base.cpp
+++ b/src/video_core/texture_cache/image_base.cpp
@@ -253,6 +253,10 @@ bool AddImageAlias(ImageBase& lhs, ImageBase& rhs, ImageId lhs_id, ImageId rhs_i
     }
     lhs.aliased_images.push_back(std::move(lhs_alias));
     rhs.aliased_images.push_back(std::move(rhs_alias));
+    if (UpBackDrawCheap()) {
+        lhs.newest_alias_tick = (std::max)(lhs.newest_alias_tick, rhs.modification_tick);
+        rhs.newest_alias_tick = (std::max)(rhs.newest_alias_tick, lhs.modification_tick);
+    }
     lhs.flags &= ~ImageFlagBits::IsRescalable;
     rhs.flags &= ~ImageFlagBits::IsRescalable;
     return true;
diff --git a/src/video_core/texture_cache/image_base.h b/src/video_core/texture_cache/image_base.h
index 878c229..0f79c54 100644
--- a/src/video_core/texture_cache/image_base.h
+++ b/src/video_core/texture_cache/image_base.h
@@ -6,6 +6,7 @@
 
 #pragma once
 
+#include <algorithm>
 #include <array>
 #include <optional>
 #include <vector>
@@ -13,6 +14,7 @@
 
 #include "common/common_funcs.h"
 #include "common/common_types.h"
+#include "common/pe_switch.h"
 #include "video_core/texture_cache/image_info.h"
 #include "video_core/texture_cache/image_view_info.h"
 #include "video_core/texture_cache/types.h"
@@ -126,7 +128,12 @@ struct ImageBase {
     VAddr cpu_addr = 0;
     VAddr cpu_addr_end = 0;
 
+    /// Set through SetModificationTick.
     u64 modification_tick = 0;
+    /// EDEN_UP_BACK_DRAW_CHEAP: at least the newest modification_tick among aliased_images
+    /// (raised when an alias's tick is set or an alias is added): SynchronizeAliases has nothing
+    /// to do while it is not newer. Never read with the switch off.
+    u64 newest_alias_tick = 0;
     size_t lru_index = SIZE_MAX;
 
     std::array<u32, MAX_MIP_LEVELS> mip_level_offsets{};
@@ -170,4 +177,26 @@ struct ImageAllocBase {
 
 bool AddImageAlias(ImageBase& lhs, ImageBase& rhs, ImageId lhs_id, ImageId rhs_id);
 
+/// EDEN_UP_BACK_DRAW_CHEAP=1, from Lichii PR 858 (zortos293/Lichii c7e807d617): skip texture
+/// alias sync when no alias changed, and skip empty direct draws before any pipeline, buffer or
+/// descriptor work. Read once.
+inline bool UpBackDrawCheap() {
+    static const bool enabled = Common::PeSwitch("EDEN_UP_BACK_DRAW_CHEAP");
+    return enabled;
+}
+
+/// Sets an image's modification tick; with EDEN_UP_BACK_DRAW_CHEAP also raises its aliases'
+/// newest_alias_tick to it.
+template <typename Images>
+void SetModificationTick(Images& images, ImageBase& image, u64 tick) {
+    image.modification_tick = tick;
+    if (!UpBackDrawCheap()) {
+        return;
+    }
+    for (const AliasedImage& alias : image.aliased_images) {
+        u64& newest = images[alias.id].newest_alias_tick;
+        newest = (std::max)(newest, tick);
+    }
+}
+
 } // namespace VideoCommon
