From 74e4c537a3d5ead0cc85100bff6afbd0eb544339 Mon Sep 17 00:00:00 2001
From: EglantinePS5 <noreply@eglantineps5.local>
Date: Sun, 8 Nov 2026 05:00:52 +0100
Subject: [PATCH] pe: no-empty-submits

---
 src/video_core/renderer_vulkan/vk_rasterizer.cpp | 6 ++++++
 src/video_core/renderer_vulkan/vk_rasterizer.h   | 1 +
 2 files changed, 7 insertions(+)

diff --git a/src/video_core/renderer_vulkan/vk_rasterizer.cpp b/src/video_core/renderer_vulkan/vk_rasterizer.cpp
index e5f9a02..f3ab65c 100644
--- a/src/video_core/renderer_vulkan/vk_rasterizer.cpp
+++ b/src/video_core/renderer_vulkan/vk_rasterizer.cpp
@@ -2095,6 +2095,10 @@ void RasterizerVulkan::FlushCommands() {
         return;
     }
     draw_counter = 0;
+    static const bool no_empty = Common::PeSwitch("EDEN_PE_NO_EMPTY_SUBMITS");
+    if (no_empty && scheduler.CurrentTick() != pe_recorded_tick) {
+        return;
+    }
     // Fences with downloads or queries come here right after queueing: ~9,400 a second in
     // Hyrule Warriors: Age of Imprisonment fights. Batched like the fences themselves.
     VideoCommon::ZpassCut::SiteScope site{VideoCommon::ZpassCut::Site::FenceFlush};
@@ -2287,6 +2291,8 @@ void RasterizerVulkan::LoadDiskResources(u64 title_id, std::stop_token stop_load
 }
 
 void RasterizerVulkan::FlushWork() {
+    static const bool no_empty = Common::PeSwitch("EDEN_PE_NO_EMPTY_SUBMITS");
+    if (no_empty) pe_recorded_tick = scheduler.CurrentTick();
 #ifdef __ANDROID__
     static constexpr u32 DRAWS_TO_DISPATCH = 512;
     static constexpr u32 CHECK_MASK = 3;
diff --git a/src/video_core/renderer_vulkan/vk_rasterizer.h b/src/video_core/renderer_vulkan/vk_rasterizer.h
index ffa1ada..1b3d02d 100644
--- a/src/video_core/renderer_vulkan/vk_rasterizer.h
+++ b/src/video_core/renderer_vulkan/vk_rasterizer.h
@@ -266,6 +266,7 @@ private:
     boost::container::static_vector<VkSampler, MAX_TEXTURES> sampler_handles;
 
     u32 draw_counter = 0;
+    u64 pe_recorded_tick{};
     bool mesh_draw{}; ///< the draw being prepared uses a task/mesh pipeline
     /// EDEN_NX2_OOT_SKIP_AA (oot_network.h): the tonemapped image and whether the output pass of
     /// Ocarina of Time's network was replaced.
-- 
