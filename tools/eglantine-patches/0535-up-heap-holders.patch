                 astc_scan_buffer.resize(scan_bytes);
                 gpu_memory->ReadBlockUnsafe(gpu_addr, astc_scan_buffer.data(), scan_bytes);
                 new_info.astc_opaque = AstcDataLooksOpaque(astc_scan_buffer);
