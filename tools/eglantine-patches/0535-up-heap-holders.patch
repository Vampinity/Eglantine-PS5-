 #include <variant>
 #include <boost/container/static_vector.hpp>
 
 #include "common/assert.h"
 #include "common/logging.h"
+#include "common/pe_switch.h"
 #include "video_core/renderer_vulkan/vk_scheduler.h"
 #include "video_core/renderer_vulkan/vk_update_descriptor.h"
 #include "video_core/vulkan_common/vulkan_device.h"
@@ -18,10 +21,11 @@ namespace Vulkan {
 
 UpdateDescriptorQueue::UpdateDescriptorQueue(const Device& device_, size_t frame_payload_size_,
                                              bool supports_descriptor_buffer_)
-    : device{device_}, frame_payload_size{frame_payload_size_},
+    : device{device_}, frame_payload_size{Common::PeSwitch("EDEN_UP_HEAP_HOLDERS") ? frame_payload_size_ / 2 : frame_payload_size_},
       supports_descriptor_buffer{supports_descriptor_buffer_},
-      payload(std::make_unique_for_overwrite<DescriptorUpdateEntry[]>(frame_payload_size_ * FRAMES_IN_FLIGHT))
+      payload(std::make_unique_for_overwrite<DescriptorUpdateEntry[]>(frame_payload_size * FRAMES_IN_FLIGHT))
 {
+    initial_frame_payload_size = frame_payload_size;
     payload_start = payload.get();
     payload_cursor = payload.get();
 }
@@ -41,6 +45,40 @@ void UpdateDescriptorQueue::Acquire(Scheduler& scheduler, size_t required_entrie
     use_descriptor_buffer = supports_descriptor_buffer && use_descriptor_buffer_;
     static constexpr size_t DEFAULT_REQUIRED_ENTRIES = 0x400;
     const size_t reserve = required_entries > 0 ? required_entries : DEFAULT_REQUIRED_ENTRIES;
+    static const bool trim = Common::PeSwitch("EDEN_UP_HEAP_HOLDERS");
+    if (trim && !growth_refused) {
+        const size_t used = static_cast<size_t>(std::distance(payload_start, payload_cursor));
+        // EDEN_UP_HEAP_HOLDERS: grow back to 0107's size at most (2x the halved start), never
+        // past it: a frame that needs more waits for the worker as before (below).
+        const size_t ceiling = initial_frame_payload_size * 2;
+        size_t grown = frame_payload_size;
+        while (used + reserve >= grown && grown < ceiling) {
+            grown = (std::min)(grown * 2, ceiling);
+        }
+        if (grown != frame_payload_size) {
+            std::unique_ptr<DescriptorUpdateEntry[]> replacement;
+            try {
+                replacement = std::make_unique_for_overwrite<DescriptorUpdateEntry[]>(
+                    grown * FRAMES_IN_FLIGHT);
+            } catch (const std::bad_alloc&) {
+                // Refused: keep the smaller payload for the session; overflow waits as before.
+                growth_refused = true;
+            }
+            if (replacement) {
+                // The worker reads the queued draws' entries: drain it before the old array goes.
+                scheduler.WaitWorker();
+                LOG_INFO(Render_Vulkan, "Descriptor payload grew: {} -> {} entries",
+                         frame_payload_size, grown);
+                payload = std::move(replacement);
+                frame_payload_size = grown;
+                payload_start = payload.get() + frame_index * frame_payload_size;
+                payload_cursor = payload_start;
+            } else {
+                LOG_WARNING(Render_Vulkan, "Descriptor payload growth to {} entries refused",
+                            grown);
+            }
+        }
+    }
     ASSERT_MSG(reserve < frame_payload_size, "Descriptor reservation {} >= frame capacity {}",
                reserve, frame_payload_size);
     const size_t used = static_cast<size_t>(std::distance(payload_start, payload_cursor));
