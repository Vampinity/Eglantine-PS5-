+// EDEN_UP_FAST_DRAW texture memo counts, logged every 10 s with EDEN_NX2_GPU_PROFILE or
+// EDEN_UP_FAST_DRAW_VERIFY (which also resolves memo draws in full and compares).
+std::atomic<u64> g_memo_hits{};
+std::atomic<u64> g_memo_misses{};
+std::atomic<u64> g_memo_mismatches{};
