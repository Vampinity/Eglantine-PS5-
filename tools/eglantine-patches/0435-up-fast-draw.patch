+    // tools/prepare-vulkan-port.py anchors its cost marks there, and each anchor must stay unique.
+    BufferCache& buffers = buffer_cache;
+    TextureCache& textures = texture_cache;
+    buffers.SetUniformBuffersState(enabled_uniform_buffer_masks, &uniform_buffer_sizes);
+    {
+        Profile::Scope scope{Profile::Zone::ReadHandles};
+        for (size_t stage = 0; stage < NUM_STAGES; ++stage) {
+            if (!configured_stages[stage]) {
+                continue;
+            }
+            buffers.UnbindGraphicsStorageBuffers(stage);
+            size_t ssbo_index{};
+            for (const auto& desc : stage_infos[stage].storage_buffers_descriptors) {
+                ASSERT(desc.count == 1);
+                buffers.BindGraphicsStorageBuffer(stage, ssbo_index, desc.cbuf_index,
+                                                  desc.cbuf_offset, desc.is_written,
+                                                  desc.indirect_offset);
+                ++ssbo_index;
+            }
+        }
+    }
+    u64 geometry_tick = scheduler.CurrentTick();
+    {
+        Profile::Scope scope{Profile::Zone::UpdateBuffers};
+        buffers.UpdateGraphicsBuffers(is_indexed);
+        buffers.BindHostGeometryBuffers(is_indexed);
+    }
+    {
+        Profile::Scope scope{Profile::Zone::DescriptorAcquire};
+        guest_descriptor_queue.Acquire(scheduler, num_descriptor_entries, uses_descriptor_buffer);
+    }
+    const auto& regs{maxwell3d->regs};
+    RescalingPushConstant rescaling;
+    RenderAreaPushConstant render_area;
+    const VideoCommon::SamplerId* samplers_it{delta_samplers.data()};
+    const VideoCommon::ImageViewInOut* views_it{delta_views.data()};
+    for (size_t stage = 0; stage < NUM_STAGES; ++stage) {
+        if (!configured_stages[stage]) {
+            continue;
+        }
+        {
+            Profile::Scope scope{Profile::Zone::BindStageBuffers};
+            buffers.BindHostStageBuffers(stage);
+        }
+        {
