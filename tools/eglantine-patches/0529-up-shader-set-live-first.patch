-            PrepareShaderSet(outputs.records, stop);
+            // The records of programs that are live get prepared before the rest of the file:
+            // first those an earlier session noted (prep_shader_set.live), then the file in its
+            // own order up to the cap, then, for as long as the game runs, the records of
+            // whatever goes live (a load makes its programs before it draws with them). T108 and
+            // T110: 511 of 541 live programs of Link's house were in the set and 0 of 430
+            // pipelines hit, because a start prepared the first 5,000 of 113,054 records.
+            std::unordered_set<u64> earlier;
+            for (const u64 hash :
+                 VideoCommon::ShaderSet::ReadPrograms(output_dir / "prep_shader_set.live")) {
+                earlier.insert(hash);
+            }
+            {
+                std::scoped_lock lock{shader_set_mutex};
+                shader_set_saved_live = earlier;
+                for (const u64 hash : audit_pending) {
+                    if (shader_set_programs->contains(hash) &&
+                        shader_set_live.insert(hash).second) {
+                        shader_set_live_serial.fetch_add(1, std::memory_order_relaxed);
+                    }
+                }
+            }
+            if (!earlier.empty()) {
+                LOG_INFO(Render_Vulkan,
+                         "Shader set: {} programs were live in earlier sessions; their records "
+                         "are prepared first", earlier.size());
+                (void)PrepareShaderSet(outputs.records, stop, &earlier);
+            }
+            (void)PrepareShaderSet(outputs.records, stop);
+            u64 seen = 0;
+            auto nap = std::chrono::milliseconds{500};
+            while (Common::StoppableTimedWait(stop, nap)) {
+                nap = std::chrono::milliseconds{500};
+                if (shader_set_live_serial.load(std::memory_order_relaxed) == seen) {
+                    continue;
+                }
+                // A load makes its programs close together: gather them, then one pass.
+                if (!Common::StoppableTimedWait(stop, std::chrono::milliseconds{250})) {
+                    break;
+                }
+                std::unordered_set<u64> live;
+                {
+                    std::scoped_lock lock{shader_set_mutex};
+                    live = shader_set_live;
+                    seen = shader_set_live_serial.load(std::memory_order_relaxed);
+                }
+                const bool paused = PrepareShaderSet(outputs.records, stop, &live);
+                nap = std::chrono::milliseconds{paused ? 30000 : 2000};
+            }
         } catch (const std::exception& e) {
             LOG_WARNING(Render_Vulkan, "Shader set: the background work ended: {}", e.what());
         }
     });
 }
 
