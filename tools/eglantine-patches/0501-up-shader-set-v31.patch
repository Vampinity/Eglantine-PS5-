+std::vector<u64> ReadPrograms(const std::filesystem::path& programs) {
+    try {
+        const auto bytes = ReadWhole(programs, 64 * 1024 * 1024);
+        if (bytes.size() % sizeof(u64) != 0) return {};
+        std::vector<u64> hashes(bytes.size() / sizeof(u64));
+        std::memcpy(hashes.data(), bytes.data(), bytes.size());
+        return hashes;
+    } catch (const std::exception&) {
+        return {};
+    }
+}
