+Outputs Prepare(u64 title, const std::filesystem::path& title_dir,
+                const std::filesystem::path& output_dir, const Identity& identity,
+                const MapState& map_state, std::stop_token stop) {
+    Outputs out;
+    if (!Common::PeSwitch("EDEN_UP_SHADER_SET")) return out;
+    std::error_code ec;
+    // A temporary left by a kill is never a file to use.
+    for (const char* name : {RecordsName, ProgramsName, StampName}) {
+        auto leftover = output_dir / name;
+        leftover += ".tmp";
+        std::filesystem::remove(leftover, ec);
+    }
+    const auto source = FileSys::ShaderSetSource::Snapshot();
+    // Snapshot owns the VFS roots throughout extraction; no borrowed loader callback.
+    try {
+        std::vector<std::filesystem::path> paths;
+        for (std::filesystem::directory_iterator it{title_dir, ec}, end; !ec && it != end; it.increment(ec))
+            if (it->is_regular_file() && it->path().extension() == ".nx2recipe") paths.push_back(it->path());
+        std::ranges::sort(paths);
+        std::vector<u8> wrapped, body;
+        std::optional<Recipe> recipe;
+        std::string recipe_name;
+        size_t recipes_read = 0;
+        std::string expected, why;
+        for (const auto& path : paths) {
+            try {
+                auto candidate_wrapped = ReadWhole(path, 128 * 1024 * 1024);
+                ++recipes_read;
+                // The stamp is checked on the wrapped bytes first: a recipe whose generated
+                // file is reused is not inflated and parsed (~70 MB) at every boot. The stamp
+                // names the game version the loader registered (the recipe's must equal it).
+                std::string candidate_expected, candidate_why;
+                if (source.title == title) {
+                    candidate_expected =
+                        StampText(identity, title, source.version, path.filename().string(),
+                                  candidate_wrapped.size(), Sha256Hex(candidate_wrapped));
+                    if (StampHolds(output_dir, candidate_expected, out.record_count,
+                                   out.program_count, candidate_why)) {
+                        out.records = output_dir / RecordsName;
+                        out.programs = output_dir / ProgramsName;
+                        out.reused = true;
+                        LOG_INFO(Render_Vulkan, "Shader set: reusing {} ({} records, {} MB, {} "
+                                 "programs); its stamp holds, nothing is extracted",
+                                 RecordsName, out.record_count,
+                                 std::filesystem::file_size(out.records, ec) >> 20,
+                                 out.program_count);
+                        return out;
+                    }
+                }
+                auto candidate = Unwrap(candidate_wrapped);
+                auto parsed = ReadBody(candidate);
+                if (parsed.title != title) continue;
+                if (source.title == title && parsed.game_version != source.version) continue;
+                wrapped = std::move(candidate_wrapped);
+                body = std::move(candidate); // vector move preserves the parsed spans
+                recipe = std::move(parsed);
+                recipe_name = path.filename().string();
+                expected = std::move(candidate_expected);
+                why = std::move(candidate_why);
+                break;
+            } catch (const std::exception& e) {
+                LOG_WARNING(Render_Vulkan, "Shader set: rejected {}: {}", path.filename().string(), e.what());
+            }
+        }
+        LOG_INFO(Render_Vulkan, "Shader set: recipes read {}, selected {}", recipes_read, recipe ? 1 : 0);
+        if (!recipe || stop.stop_requested()) return out;
+        auto& r = *recipe;
+        if (source.title != title || source.roots.empty()) {
+            LOG_WARNING(Render_Vulkan, "Shader set: fingerprints found 0, not found 0, unresolved {} "
+                        "(game-files provider unavailable); converted 0, dropped provider-unavailable {}",
+                        r.programs.size(), r.records.size());
+            return out;
+        }
+        // The stamp: what the generated file was made from. While it holds, nothing is read
+        // again (above); a changed game version, recipe, cache version, lowering, build, switch
+        // or device makes a new one.
+        LOG_INFO(Render_Vulkan, "Shader set: converting the recipe ({})", why);
+        // The game's files are read through the NUP container: without lazy decoding every
+        // read, even a 64 KiB peek, decodes the whole member into the cache the game shares,
+        // and a member over half the cap is written whole to a temporary file that lasts the
+        // session (a failed spill leaves it unreadable for the game). Refused rather than risked.
+        if (!Common::PeSwitch("EDEN_UP_NUP_LAZY_DECODE") || NupCacheCapMiB() > 128) {
+            LOG_WARNING(Render_Vulkan, "Shader set: extraction needs EDEN_UP_NUP_LAZY_DECODE=1 and "
+                        "EDEN_NUP_CACHE_MIB of 128 or less (now {} MiB, lazy decode {}): the game's "
+                        "files would fill the shared NUP cache and spill to disk; nothing extracted",
+                        NupCacheCapMiB(), Common::PeSwitch("EDEN_UP_NUP_LAZY_DECODE") ? "on" : "off");
+            return out;
+        }
+        // The output duplicates environments per record (Fritchii measured 1.17 GB for Ocarina
+        // of Time); a full disk must not end with half a file beside the pipeline cache.
+        const u64 disk_floor = MinimumFreeDiskBytes();
+        if (const auto space = std::filesystem::space(output_dir, ec);
+            !ec && space.available < disk_floor) {
+            LOG_WARNING(Render_Vulkan, "Shader set: {} MB free beside the pipeline cache, under "
+                        "the {} MB floor (EDEN_UP_SHADER_SET_MIN_FREE_DISK_MB); nothing converted",
+                        space.available >> 20, disk_floor >> 20);
+            return out;
+        }
+        // Extraction holds one container inflated (up to EDEN_UP_SHADER_SET_MAX_MB) plus the
+        // wanted programs: it waits for memory rather than taking the game's. Where free memory
+        // cannot be read, nothing runs (the floor is the only guard), unless waived.
+        const u64 floor = MinimumFreeBytes();
+        const bool memory_known = FreeMemoryBytes() != 0;
+        if (!memory_known && !MemoryCheckWaived()) {
+            LOG_WARNING(Render_Vulkan, "Shader set: free memory is unknown on this platform; "
+                        "nothing extracted (EDEN_UP_SHADER_SET_NO_MEMORY_CHECK=1 extracts anyway)");
+            return out;
+        }
+        if (memory_known) {
+            bool said = false;
+            for (int waited = 0; FreeMemoryBytes() < floor; ++waited) {
+                if (stop.stop_requested() || waited >= 120) {
+                    LOG_WARNING(Render_Vulkan, "Shader set: {} MB free, under the {} MB floor "
+                                "(EDEN_UP_SHADER_SET_MIN_FREE_MB) for 10 minutes; nothing extracted "
+                                "this boot", FreeMemoryBytes() >> 20, floor >> 20);
+                    return out;
+                }
+                if (!said) {
+                    LOG_INFO(Render_Vulkan, "Shader set: {} MB free, under the {} MB floor; "
+                             "extraction waits", FreeMemoryBytes() >> 20, floor >> 20);
+                    said = true;
+                }
+                if (!Rest(stop, std::chrono::seconds{5})) return out;
+            }
+        } else {
+            LOG_INFO(Render_Vulkan, "Shader set: free memory unknown on this platform; the "
+                     "memory floor is not checked (EDEN_UP_SHADER_SET_NO_MEMORY_CHECK=1)");
+        }
+        const auto begin = std::chrono::steady_clock::now();
+        const auto seconds = [&begin] {
+            return std::chrono::duration<double>(std::chrono::steady_clock::now() - begin).count();
+        };
+        // Exact upstream decoder/fingerprint/dedup rules. One worker (EDEN_UP_SHADER_SET_THREADS,
+        // 1-4) bounds concurrent blobs and makes first-file payload retention deterministic.
+        // Only the recipe's fingerprints are kept in memory (v2): the rest are counted.
+        std::unordered_set<u64> wanted;
+        for (auto program : r.programs) wanted.insert(program.fingerprint);
+        const unsigned threads =
+            static_cast<unsigned>(std::clamp<size_t>(SwitchNumber("EDEN_UP_SHADER_SET_THREADS", 1), 1, 4));
+        FileSys::Nx2ShaderExtract::Progress progress;
+        progress.low_priority = true;
+        progress.every = std::chrono::seconds{10};
+        progress.on_progress = [&](const FileSys::Nx2ShaderExtract::Progress& p) {
+            LOG_INFO(Render_Vulkan, "Shader set: extracting: {} of {} files scanned, {} of {} "
+                     "fingerprints found, {} MB read, {:.0f} s elapsed",
+                     p.files_done.load(std::memory_order_relaxed), p.files_total,
+                     p.wanted_found.load(std::memory_order_relaxed), wanted.size(),
+                     p.bytes_read.load(std::memory_order_relaxed) >> 20, seconds());
+        };
+        // Thread priorities do nothing for the console's SCHED_OTHER threads: the workers rest
+        // after each file for the duty cycle, wait under the memory floor (up to 10 minutes,
+        // then the extraction is cancelled), and end it when the disk fills.
+        const unsigned duty = DutyPercent();
+        std::atomic<const char*> cancelled{nullptr};
+        std::atomic<bool> said_memory{false};
+        progress.after_file = [&](std::chrono::steady_clock::duration took) {
+            const auto rest = took * static_cast<s64>(100 - duty) / static_cast<s64>(duty);
+            if (!Rest(stop, std::min<std::chrono::steady_clock::duration>(rest, std::chrono::seconds{10}))) return;
+            if (memory_known) {
+                for (int waited = 0; FreeMemoryBytes() < floor; ++waited) {
+                    if (stop.stop_requested()) return;
+                    if (waited >= 120) {
+                        cancelled.store("under the memory floor for 10 minutes");
+                        progress.cancel.store(true);
+                        return;
+                    }
+                    if (!said_memory.exchange(true)) {
+                        LOG_INFO(Render_Vulkan, "Shader set: {} MB free, under the {} MB floor; "
+                                 "extraction waits between files", FreeMemoryBytes() >> 20, floor >> 20);
+                    }
+                    if (!Rest(stop, std::chrono::seconds{5})) return;
+                }
+            }
+            std::error_code space_ec;
+            if (const auto space = std::filesystem::space(output_dir, space_ec);
+                !space_ec && space.available < disk_floor) {
+                cancelled.store("under the disk floor");
+                progress.cancel.store(true);
+            }
+        };
+        LOG_INFO(Render_Vulkan, "Shader set: extracting {} wanted programs from the game's files "
+                 "on {} thread(s), duty {}%", wanted.size(), threads, duty);
+        auto extracted = FileSys::Nx2ShaderExtract::Extract(source.roots, threads, &progress, stop, &wanted);
+        if (stop.stop_requested()) return out;
+        if (const char* const reason = cancelled.load()) {
+            LOG_WARNING(Render_Vulkan, "Shader set: extraction cancelled ({}) after {} of {} files; "
+                        "nothing converted this boot", reason,
+                        progress.files_done.load(std::memory_order_relaxed), progress.files_total);
+            return out;
+        }
+        const size_t errors = extracted.errors.size();
+        const auto candidates = extracted.stats.occurrences;
+        const auto extracted_stats = extracted.stats;
+        for (const auto& error : extracted.errors) LOG_WARNING(Render_Vulkan, "Shader set: {}", error);
+        std::unordered_map<u64, Guest> guests;
+        for (auto& program : extracted.programs) {
+            guests.emplace(program.fingerprint, Guest{Stage(program.stage),
+                std::move(program.code), std::move(program.control)});
+        }
+        extracted = {}; // release variation metadata before lowering
+        LOG_INFO(Render_Vulkan, "Shader set: extraction read {} files ({} MB, {} MB inflated, {} "
+                 "containers, {} peeked only) in {:.1f} s", extracted_stats.files,
+                 extracted_stats.file_bytes >> 20, extracted_stats.inflated_bytes >> 20,
+                 extracted_stats.containers, extracted_stats.peeked_only, seconds());
+        std::vector<std::optional<Lowered>> lowered(r.programs.size());
+        std::unordered_set<u64> have;
+        size_t found = 0, missing = 0, failed = 0;
+        auto chunk_began = std::chrono::steady_clock::now();
+        for (size_t i = 0; i < r.programs.size(); ++i) {
+            if (stop.stop_requested()) return out;
+            if (i % 64 == 63) {
+                // The duty cycle, and memory: the lowered vectors grow while the guests shrink.
+                const auto took = std::chrono::steady_clock::now() - chunk_began;
+                if (!Rest(stop, took * static_cast<s64>(100 - duty) / static_cast<s64>(duty))) return out;
+                if (memory_known && FreeMemoryBytes() < floor) {
+                    LOG_WARNING(Render_Vulkan, "Shader set: {} MB free, under the {} MB floor while "
+                                "lowering; nothing converted this boot", FreeMemoryBytes() >> 20, floor >> 20);
+                    return out;
+                }
+                chunk_began = std::chrono::steady_clock::now();
+            }
+            const auto& p = r.programs[i];
+            const auto it = guests.find(p.fingerprint);
+            if (it == guests.end()) { ++missing; continue; }
+            ++found;
+            have.insert(p.fingerprint);
+            if (it->second.stage == p.stage) lowered[i] = Lower(it->second, stop);
+            if (!lowered[i]) ++failed;
+            guests.erase(it); // one fingerprint per recipe program: its guest code is done with
+        }
+        guests.clear(); // the guest code is lowered or rejected; only the lowered vectors stay
+        LOG_INFO(Render_Vulkan, "Shader set: candidates {}, archive errors {}, fingerprints found {}, "
+                 "not found {} (search incomplete if archive errors), not lowered {}; {:.1f} s so far",
+                 candidates, errors, found, missing, failed, seconds());
+        // Stream duplicate environments per record, as ReadPipelines expects. Do not hold a GB output in RAM.
+        AtomicFile file{output_dir / RecordsName};
+        file.Write(Bytes{reinterpret_cast<const u8*>("yuzucach"), 8});
+        file.Write(PipelineCacheVersion);
+        std::map<std::string, size_t> dropped;
+        std::vector<u64> used_programs; // lowered hashes with at least one converted record
+        std::unordered_set<u64> used_seen;
+        size_t converted = 0;
+        for (const auto& p : r.records) {
+            if (stop.stop_requested()) return out; // the temporary is removed with `file`
+            if (p.kind == 1) { ++dropped["compute-predicted-unsupported"]; continue; }
+            bool mesh = false, absent = false, lower_failed = false;
+            for (auto id : p.facts) {
+                const auto pi = r.facts[id].program;
+                mesh |= r.programs[pi].stage == 7 || r.programs[pi].stage == 8;
+                absent |= !have.contains(r.programs[pi].fingerprint);
+                lower_failed |= !lowered[pi].has_value();
+            }
+            if (mesh) { ++dropped["mesh-predicted-unsupported"]; continue; }
+            if (absent) { ++dropped["fingerprint-not-found"]; continue; }
+            if (lower_failed) { ++dropped["stage-or-lowering"]; continue; }
+            if (std::ranges::any_of(p.xors, [](u64 x) { return x != 0; })) {
+                ++dropped["unexpected-hash-xor"]; continue;
+            }
+            std::vector<std::vector<u8>> envs;
+            std::array<u64, 6> hashes{};
+            bool valid = true;
+            for (auto id : p.facts) {
+                const auto& f = r.facts[id];
+                envs.push_back(Hydrate(f, *lowered[f.program]));
+                valid &= !envs.back().empty();
+            }
+            if (!valid) { ++dropped["incompatible-facts"]; continue; }
+            u32 read_mask = ~0U;
+            for (size_t s = 0; s < 6; ++s) {
+                if (p.slots[s] == 0xff) continue;
+                const auto& program = *lowered[r.facts[p.facts[p.slots[s]]].program];
+                hashes[s] = program.hash;
+                if (s == 1) read_mask = program.read_mask; // the vertex B slot
+            }
+            std::vector<u8> key;
+            if (!map_state(r.states[p.state], hashes, read_mask, key)) { ++dropped["device-or-key-state"]; continue; }
+            const auto count = static_cast<u32>(envs.size());
+            file.Write(count);
+            for (const auto& env : envs) file.Write(Bytes{env});
+            file.Write(Bytes{key});
+            ++converted;
+            for (size_t s = 0; s < 6; ++s) {
+                if (hashes[s] != 0 && used_seen.insert(hashes[s]).second) used_programs.push_back(hashes[s]);
+            }
+        }
+        size_t total_dropped = 0;
+        for (const auto& [reason, count] : dropped) {
+            total_dropped += count;
+            LOG_INFO(Render_Vulkan, "Shader set: dropped {}: {}", reason, count);
+        }
+        LOG_INFO(Render_Vulkan, "Shader set: pipelines read {}, converted {}, dropped {} (exclusive reasons); "
+                 "{:.1f} s in all", r.records.size(), converted, total_dropped, seconds());
+        if (!converted || stop.stop_requested()) return out;
+        // The old stamp goes first (it must never sit beside the new files), then records, then
+        // programs, then the stamp: a stamp is only ever beside whole files.
+        std::filesystem::remove(output_dir / StampName, ec);
+        SyncDirectory(output_dir);
+        file.Commit();
+        AtomicFile programs{output_dir / ProgramsName};
+        programs.Write(Bytes{reinterpret_cast<const u8*>(used_programs.data()), used_programs.size() * sizeof(u64)});
+        programs.Commit();
+        out.records = output_dir / RecordsName;
+        out.programs = output_dir / ProgramsName;
+        out.record_count = converted;
+        out.program_count = used_programs.size();
+        // A partial extraction (an archive error, or over 5% of the recipe's programs not
+        // found) is used this boot but not stamped: the next start converts the recipe again,
+        // so a raised container cap or a repaired game copy is picked up.
+        const bool partial = errors != 0 || missing * 20 > r.programs.size();
+        if (partial) {
+            LOG_WARNING(Render_Vulkan, "Shader set: {} written ({} records, {} MB, {} programs) but "
+                        "NOT stamped: {} archive errors, {} of {} fingerprints not found; it is used "
+                        "this boot and the recipe is converted again at the next start "
+                        "(EDEN_UP_SHADER_SET_MAX_MB raises the container cap)",
+                        RecordsName, converted, file.Written() >> 20, used_programs.size(), errors,
+                        missing, r.programs.size());
+            return out;
+        }
+        AtomicFile stamp{output_dir / StampName};
+        const std::string text = expected + fmt::format("files {} {} {} {}\n", file.Written(), converted,
+                                                        programs.Written(), used_programs.size());
+        stamp.Write(Bytes{reinterpret_cast<const u8*>(text.data()), text.size()});
+        stamp.Commit();
+        LOG_INFO(Render_Vulkan, "Shader set: {} written ({} records, {} MB, {} programs) with its stamp",
+                 RecordsName, converted, file.Written() >> 20, used_programs.size());
+        return out;
+    } catch (const std::exception& e) {
+        LOG_WARNING(Render_Vulkan, "Shader set: no generated records used: {}", e.what());
+        return {};
+    }
+}
+} // namespace VideoCommon::ShaderSet
diff --git a/src/video_core/shader_set.h b/src/video_core/shader_set.h
new file mode 100644
index 0000000..069be4b
--- /dev/null
+++ b/src/video_core/shader_set.h
@@ -0,0 +1,93 @@
+// SPDX-FileCopyrightText: Copyright 2026 Eden Emulator Project
+// SPDX-License-Identifier: GPL-3.0-or-later
+
+// EDEN_UP_SHADER_SET=1 (default off; needs EDEN_UP_CANONICAL_KEYS=1): the whole game's shader
+// pipelines are prepared ahead of play from a public recipe (<title>/<name>.nx2recipe, Fritchii's
+// NX2RCP01 wrapper: format 1, facts v54). The game's own files are read with Fritchii's extractor
+// (core/file_sys/nx2_shader_extract.h), the programs the recipe names are lowered with our lowerer
+// and converted into prep_shader_set.bin, a predicted-records file (cache version 23) the pipeline
+// preparation (vk_pipeline_prep.h) builds from.
+//
+// v3: the conversion runs once. prep_shader_set.stamp beside the file says what it was made from
+// (game title and version, the recipe's digest, our cache version and lowering tag, the device
+// and its dynamic state); while the stamp holds, the file is reused at every boot. Both are
+// written to a temporary name, committed to disk and renamed, so a kill leaves nothing partial
+// under the final names. Extraction runs on the caller's thread (the pipeline cache's background
+// thread, low priority), reporting a progress line about every 10 s.
+
+#pragma once
+
+#include <array>
+#include <chrono>
+#include <filesystem>
+#include <functional>
+#include <span>
+#include <stop_token>
+#include <string>
+#include <vector>
+
+#include "common/common_types.h"
+
+namespace VideoCommon::ShaderSet {
+
+/// Maps one recipe state (1008 bytes, v54) and the lowered hashes of its stages to a key of this
+/// device (the GraphicsPipelineCacheKey bytes); `vertex_read_mask`: the generic attributes the
+/// vertex program's header lists (what the canonical key keeps). False: not for this device.
+using MapState = std::function<bool(std::span<const u8> state, std::array<u64, 6> hashes,
+                                    u32 vertex_read_mask, std::vector<u8>& bytes)>;
+
+struct Outputs {
+    std::filesystem::path records;  ///< prep_shader_set.bin, empty when there is none to use
+    std::filesystem::path programs; ///< prep_shader_set.programs: u64 lowered hashes, in order
+    bool reused{};                  ///< the stamp held: nothing was extracted this boot
+    u64 record_count{};
+    u64 program_count{};
+};
+
+/// What a generated file depends on besides the recipe and the game: the pipeline cache version,
+/// the lowering tag of our shader environments, the device as the pipeline cache describes it
+/// (driver, model, dynamic state, canonical keys), and the prepared store's stamp (the installed
+/// build, the settings and every switch the translation and the lowerer read). Any change makes
+/// a new stamp.
+struct Identity {
+    u32 cache_version{};
+    u64 lowering_tag{};
+    std::string device;
+    std::string translation;
+};
+
+/// Reuses prep_shader_set.bin in `output_dir` when its stamp holds, else extracts, lowers and
+/// converts (minutes on a base PS5), writes the file and its stamp. Empty `records` on
+/// cancellation, failure, no recipe for this title and version, or nothing converted; a stale or
+/// partial file is never returned.
+[[nodiscard]] Outputs Prepare(u64 title, const std::filesystem::path& title_dir,
+                              const std::filesystem::path& output_dir, const Identity& identity,
+                              const MapState& map_state, std::stop_token stop);
+
+/// The lowered program hashes a generated file was made from (its .programs sidecar).
+[[nodiscard]] std::vector<u64> ReadPrograms(const std::filesystem::path& programs);
+
+/// Free physical memory, or 0 when the platform does not say (Linux: sysinfo; FreeBSD: the free
+/// and inactive page counts).
+[[nodiscard]] u64 FreeMemoryBytes();
+
+/// EDEN_UP_SHADER_SET_MIN_FREE_MB (384): below this much free memory the background work waits
+/// (extraction) or stops for this boot (preparation, which resumes at the next start).
+[[nodiscard]] u64 MinimumFreeBytes();
+
+/// EDEN_UP_SHADER_SET_MIN_FREE_DISK_MB (2048): below this much free disk beside the pipeline
+/// cache nothing is converted, extraction ends, and preparation stops for this boot.
+[[nodiscard]] u64 MinimumFreeDiskBytes();
+
+/// EDEN_UP_SHADER_SET_DUTY (50, 1-100): the share of wall time the background work may take.
+/// Extraction, lowering and preparation rest after each piece of work for the remainder.
+[[nodiscard]] unsigned DutyPercent();
+
+/// EDEN_UP_SHADER_SET_NO_MEMORY_CHECK=1: run even where free memory cannot be read. Without it
+/// the work is refused there (the floor is the only guard on a base PS5's few hundred MB).
+[[nodiscard]] bool MemoryCheckWaived();
+
+/// Sleeps `rest` unless the stop token is signalled first; false when it was.
+[[nodiscard]] bool Rest(std::stop_token stop, std::chrono::steady_clock::duration rest);
+
+} // namespace VideoCommon::ShaderSet
diff --git a/src/video_core/shader_set_recipe.cpp b/src/video_core/shader_set_recipe.cpp
new file mode 100644
index 0000000..6a12658
--- /dev/null
+++ b/src/video_core/shader_set_recipe.cpp
@@ -0,0 +1,139 @@
+// SPDX-FileCopyrightText: Copyright 2026 Eden Emulator Project
+// SPDX-License-Identifier: GPL-3.0-or-later
+#include "video_core/shader_set_recipe.h"
+#include <bit>
+#include <cstring>
+#include <stdexcept>
+
+namespace VideoCommon::ShaderSet {
+namespace {
+[[noreturn]] void Bad() { throw std::runtime_error("invalid/unsupported shader-set recipe"); }
+struct Reader {
+    Bytes bytes;
+    size_t at{};
+    Bytes Take(size_t n) {
+        if (n > bytes.size() - at) Bad();
+        auto out = bytes.subspan(at, n);
+        at += n;
+        return out;
+    }
+    template<class T> T Get() {
+        T value;
+        auto p = Take(sizeof(T));
+        std::memcpy(&value, p.data(), sizeof(T));
+        return value;
+    }
+    void Zero(size_t n) { for (u8 b : Take(n)) if (b) Bad(); }
+    u32 Count(size_t minimum) {
+        auto n = Get<u32>();
+        if (n > (bytes.size() - at) / minimum) Bad();
+        return n;
+    }
+};
+}
+Recipe ReadBody(Bytes body) {
+    static_assert(std::endian::native == std::endian::little);
+    if (body.size() > 128U * 1024 * 1024) Bad();
+    Reader r{body};
+    if (r.Get<u32>() != 1) Bad();
+    Recipe out{};
+    out.title = r.Get<u64>();
+    out.game_version = r.Get<u32>();
+    out.cache_version = r.Get<u32>();
+    if (out.cache_version != 54) Bad();
+    const auto np = r.Count(12);
+    out.programs.reserve(np);
+    for (u32 i = 0; i < np; ++i) {
+        Program p{r.Get<u64>(), r.Get<u8>()};
+        r.Zero(3);
+        if (p.stage > 8) Bad();
+        out.programs.push_back(p);
+    }
+    const auto nf = r.Count(12);
+    out.facts.reserve(nf);
+    for (u32 i = 0; i < nf; ++i) {
+        Facts f{};
+        f.program = r.Get<u32>();
+        f.flags = r.Get<u8>();
+        r.Zero(3);
+        f.bytes = r.Take(r.Get<u32>());
+        if (f.program >= np || (f.flags & ~2U)) Bad();
+        Reader e{f.bytes};
+        if (e.Get<u64>() % 8) Bad(); // original code length, not bytes present here
+        std::array<u64, 5> counts;
+        for (auto& n : counts) n = e.Get<u64>();
+        e.Take(24);
+        const auto stage = e.Get<u32>();
+        if (stage != out.programs[f.program].stage || (f.flags && stage != 7 && stage != 8)) Bad();
+        constexpr size_t widths[]{8, 8, 12, 9, 12};
+        for (size_t j = 0; j < counts.size(); ++j) {
+            if (counts[j] > (e.bytes.size() - e.at) / widths[j]) Bad();
+            const auto table = e.Take(static_cast<size_t>(counts[j]) * widths[j]);
+            Reader entries{table};
+            for (u64 k = 0; k < counts[j]; ++k) {
+                if (j == 0 || j == 1) {
+                    entries.Get<u32>();
+                    const auto v = entries.Get<u32>();
+                    // Texture enums are validated by the target translator; preserve raw values.
+                    (void)v;
+                } else {
+                    entries.Get<u64>();
+                    if (j == 3) { if (entries.Get<u8>() > 1) Bad(); }
+                    else entries.Get<u32>();
+                }
+            }
+        }
+        f.tables_end = e.at;
+        const size_t tail = stage == 5 ? 16 : stage == 3 ? 32 :
+                            (stage == 7 || stage == 8) ? 12 + (f.flags ? 0 : 80) : 0;
+        e.Take(tail);
+        if (e.at != e.bytes.size()) Bad();
+        out.facts.push_back(f);
+    }
+    const auto ns = r.Count(1008);
+    out.states.reserve(ns);
+    for (u32 i = 0; i < ns; ++i) out.states.push_back(r.Take(1008));
+    const auto nr = r.Count(8);
+    out.records.reserve(nr);
+    constexpr u8 slot_stage[]{6, 0, 1, 2, 3, 4};
+    for (u32 i = 0; i < nr; ++i) {
+        Record p{};
+        p.kind = r.Get<u8>();
+        const auto n = r.Get<u8>();
+        r.Zero(2);
+        if (p.kind > 1 || n == 0 || n > 6 || (p.kind == 1 && n != 1)) Bad();
+        for (u8 j = 0; j < n; ++j) {
+            const auto id = r.Get<u32>();
+            if (id >= nf) Bad();
+            p.facts.push_back(id);
+        }
+        if (p.kind == 1) {
+            if (out.programs[out.facts[p.facts[0]].program].stage != 5) Bad();
+        } else {
+            p.state = r.Get<u32>();
+            if (p.state >= ns) Bad();
+            for (auto& s : p.slots) s = r.Get<u8>();
+            const auto has_xor = r.Get<u8>();
+            r.Zero(1);
+            if (has_xor > 1) Bad();
+            if (has_xor) for (auto& x : p.xors) x = r.Get<u64>();
+            std::array<bool, 6> used{};
+            size_t expected = 0;
+            for (size_t s = 0; s < 6; ++s) {
+                const auto id = p.slots[s];
+                if (id == 0xff) { if (p.xors[s]) Bad(); continue; }
+                if (id >= n || used[id] || id != expected++) Bad();
+                used[id] = true;
+                const auto stage = out.programs[out.facts[p.facts[id]].program].stage;
+                // Task/mesh reuse vertex-B and tess-eval slots, or vertex-B alone for mesh.
+                if (stage != slot_stage[s] && !(s == 1 && (stage == 7 || stage == 8)) &&
+                    !(s == 3 && stage == 8)) Bad();
+            }
+            if (expected != n) Bad();
+        }
+        out.records.push_back(std::move(p));
+    }
+    if (r.at != body.size()) Bad();
+    return out;
+}
+} // namespace VideoCommon::ShaderSet
