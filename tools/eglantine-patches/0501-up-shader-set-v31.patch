+template<class T> T Load(Bytes b, size_t at) {
+    if (at > b.size() || sizeof(T) > b.size() - at) throw std::runtime_error("short shader data");
+    T v; std::memcpy(&v, b.data() + at, sizeof(T)); return v;
+}
+template<class T> void Patch(std::vector<u8>& b, size_t at, T v) {
+    if (at > b.size() || sizeof(T) > b.size() - at) throw std::runtime_error("short shader data");
+    std::memcpy(b.data() + at, &v, sizeof(T));
+}
+size_t SwitchNumber(const char* name, size_t fallback) {
+    const char* const text = std::getenv(name);
+    const unsigned long long value = text ? std::strtoull(text, nullptr, 10) : 0;
+    return value != 0 ? static_cast<size_t>(value) : fallback;
+}
+std::string Sha256Hex(Bytes bytes) {
+    std::unique_ptr<EVP_MD_CTX, decltype(&EVP_MD_CTX_free)> ctx(EVP_MD_CTX_new(), EVP_MD_CTX_free);
+    std::array<u8, 32> digest{};
+    unsigned length = 0;
+    if (!ctx || EVP_DigestInit_ex(ctx.get(), EVP_sha256(), nullptr) != 1 ||
+        EVP_DigestUpdate(ctx.get(), bytes.data(), bytes.size()) != 1 ||
+        EVP_DigestFinal_ex(ctx.get(), digest.data(), &length) != 1) {
+        throw std::runtime_error("SHA-256 failed");
+    }
+    std::string hex;
+    for (const u8 byte : digest) hex += fmt::format("{:02x}", byte);
+    return hex;
+}
+std::vector<u8> ReadWhole(const std::filesystem::path& p, size_t most) {
+    std::ifstream f{p, std::ios::binary | std::ios::ate};
+    if (!f) throw std::runtime_error("file cannot be opened");
+    const auto n = f.tellg();
+    if (n < 0 || static_cast<u64>(n) > most) throw std::runtime_error("file size");
+    std::vector<u8> b(static_cast<size_t>(n)); f.seekg(0);
+    f.read(reinterpret_cast<char*>(b.data()), static_cast<std::streamsize>(b.size()));
+    if (!f) throw std::runtime_error("file cannot be read");
+    return b;
+}
+/// The recipe's body from its NX2RCP01 wrapper (zstd, one frame).
+std::vector<u8> Unwrap(Bytes b) {
+    if (b.size() < 16 || std::memcmp(b.data(), "NX2RCP01", 8) || Load<u32>(b, 12))
+        throw std::runtime_error("recipe wrapper");
+    const auto size = Load<u32>(b, 8);
+    if (size > 128 * 1024 * 1024) throw std::runtime_error("recipe body size");
+    auto packed = b.subspan(16);
+    const auto frame = ZSTD_findFrameCompressedSize(packed.data(), packed.size());
+    if (ZSTD_isError(frame) || frame != packed.size()) throw std::runtime_error("recipe zstd frame");
+    std::vector<u8> body(size);
+    const auto result = ZSTD_decompress(body.data(), body.size(), packed.data(), packed.size());
+    if (ZSTD_isError(result) || result != size) throw std::runtime_error("recipe decompression");
+    return body;
+}
