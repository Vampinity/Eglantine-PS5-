+std::string StampText(const Identity& identity, u64 title, u32 version,
+                      const std::string& recipe_name, u64 recipe_size,
+                      const std::string& recipe_digest) {
+    // Everything a generated file depends on, one fact a line; the "files" line is added when
+    // it is written. Any other difference is another file. v3.1: the prepared store's stamp
+    // (build, settings, translation and lowering switches) and the extractor's container cap.
+    return fmt::format("shaderset {}\ntitle {:016X} version {}\nrecipe {} {} {}\n"
+                       "cache {} lowering {:016x} state {}\ndevice {}\ntranslation {}\n"
+                       "extractor cap {} MiB\n",
+                       FormatVersion, title, version, recipe_name, recipe_size, recipe_digest,
+                       identity.cache_version, identity.lowering_tag, 1008, identity.device,
+                       identity.translation, ContainerCapMiB());
+}
+
+/// Whether the stamp beside the generated files says they were made from `expected`, and they
+/// are whole (their sizes as the stamp says). `why`: the first reason they cannot be reused.
+bool StampHolds(const std::filesystem::path& dir, const std::string& expected, u64& records,
+                u64& programs, std::string& why) {
+    std::error_code ec;
+    std::ifstream f{dir / StampName, std::ios::binary};
+    if (!f) { why = "no stamp"; return false; }
+    std::string text{std::istreambuf_iterator<char>(f), {}};
+    const auto files = text.find("files ");
+    if (files == std::string::npos || files == 0 || text[files - 1] != '\n') {
+        why = "stamp without its files line"; return false;
+    }
+    if (text.substr(0, files) != expected) {
+        // The first differing line says what changed (game, recipe, build, device).
+        std::string line;
+        size_t a = 0, b = 0;
+        while (a < expected.size() && b < files) {
+            const auto ea = expected.find('\n', a), eb = text.find('\n', b);
+            const auto la = expected.substr(a, ea - a), lb = text.substr(b, eb - b);
+            if (la != lb) { line = "'" + lb + "' is now '" + la + "'"; break; }
+            a = ea + 1; b = eb + 1;
+        }
+        why = "stamp changed: " + (line.empty() ? std::string{"another line count"} : line);
+        return false;
+    }
+    unsigned long long records_bytes = 0, records_count = 0, programs_bytes = 0, programs_count = 0;
+    if (std::sscanf(text.c_str() + files, "files %llu %llu %llu %llu", &records_bytes,
+                    &records_count, &programs_bytes, &programs_count) != 4) {
+        why = "stamp files line unreadable"; return false;
+    }
+    records = records_count;
+    programs = programs_count;
+    const auto size_r = std::filesystem::file_size(dir / RecordsName, ec);
+    if (ec || size_r != records_bytes) { why = "records file size differs from the stamp"; return false; }
+    const auto size_p = std::filesystem::file_size(dir / ProgramsName, ec);
+    if (ec || size_p != programs_bytes) { why = "programs file size differs from the stamp"; return false; }
+    return true;
+}
