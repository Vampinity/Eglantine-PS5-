+#pragma once
+#include <array>
+#include <span>
+#include <vector>
+#include "common/common_types.h"
+
+namespace VideoCommon::ShaderSet {
+using Bytes = std::span<const u8>;
+struct Program { u64 fingerprint; u8 stage; };
+struct Facts { u32 program; u8 flags; Bytes bytes; size_t tables_end; };
+struct Record {
+    u8 kind;
+    std::vector<u32> facts;
+    u32 state{};
+    std::array<u8, 6> slots{};
+    std::array<u64, 6> xors{};
+};
+// All spans borrow the caller's decompressed body. No game bytes are stored in a recipe.
+struct Recipe {
+    u64 title;
+    u32 game_version;
+    u32 cache_version;
+    std::vector<Program> programs;
+    std::vector<Facts> facts;
+    std::vector<Bytes> states;
+    std::vector<Record> records;
+};
+// Strict format-1 / facts-v54 reader. Throws on malformed, oversized or unsupported input.
+Recipe ReadBody(Bytes body);
+} // namespace VideoCommon::ShaderSet
