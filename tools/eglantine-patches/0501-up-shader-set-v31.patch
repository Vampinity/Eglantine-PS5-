+/// Written whole under a temporary name, committed to disk, then renamed over the final name:
+/// a kill at any moment leaves the final name as it was (absent, or the last complete file).
+class AtomicFile {
+public:
+    explicit AtomicFile(std::filesystem::path final_) : final{std::move(final_)}, temporary{final} {
+        temporary += ".tmp";
+        file = Common::FS::IOFile{temporary, Common::FS::FileAccessMode::Write};
+        if (!file.IsOpen()) throw std::runtime_error("cannot create " + temporary.filename().string());
+    }
+    ~AtomicFile() {
+        if (!done) {
+            file.Close();
+            std::error_code ec;
+            std::filesystem::remove(temporary, ec);
+        }
+    }
+    void Write(Bytes b) {
+        if (file.WriteSpan<u8>(b) != b.size()) throw std::runtime_error("short write");
+        bytes += b.size();
+    }
+    template<class T> void Write(const T& v) {
+        Write(Bytes{reinterpret_cast<const u8*>(&v), sizeof(v)});
+    }
+    void Commit() {
+        if (!file.Flush() || !file.Commit()) throw std::runtime_error("cannot commit " + temporary.filename().string());
+        file.Close();
+        std::filesystem::rename(temporary, final); // same directory: atomic
+        SyncDirectory(final.parent_path());
+        done = true;
+    }
+    [[nodiscard]] u64 Written() const noexcept { return bytes; }
+private:
+    std::filesystem::path final;
+    std::filesystem::path temporary;
+    Common::FS::IOFile file;
+    u64 bytes{};
+    bool done{};
+};
