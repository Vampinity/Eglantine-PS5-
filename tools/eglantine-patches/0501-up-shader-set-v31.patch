+// EDEN_UP_CANONICAL_KEYS=1 -----------------------------------------------------------------
+
+void PipelineCache::RestoreRawKey() {
+    if (!canonical_keys) {
+        return;
+    }
+    // Refresh rewrites the attribute types only when the vertex input is dirty: the masked copy
+    // must not carry over. (The attachments are rebuilt by every Refresh with the switch on,
+    // fixed_pipeline_state.cpp, so they are current and need no copy.)
+    graphics_key.state.attribute_types = vertex_attribute_types;
+}
+
+void PipelineCache::CanonicalizeDrawKey() {
+    if (!canonical_keys) {
+        return;
+    }
+    // As Refresh left them (native or not): back in the key before the next Refresh.
+    vertex_attribute_types = graphics_key.state.attribute_types;
+    if (maxwell3d == nullptr || !maxwell3d->GetNativeMacroEngine().native_turing) {
+        return;
+    }
+    if (graphics_key.state.dynamic_vertex_input != 0) {
+        // Types of attributes the programs don't read would split their pipelines by whatever
+        // the game left in those registers (Ocarina of Time: up to 20 keys for the same
+        // shaders, each built again on the GPU thread).
+        graphics_key.state.attribute_types = VideoCommon::KeyedAttributeTypes(
+            vertex_attribute_types, graphics_key.unique_hashes, vertex_attribute_masks);
+    }
+    CanonicalizeKeyState(graphics_key.state, dynamic_features);
+}
+
+void PipelineCache::CanonicalizeLoadedKey(
+    GraphicsPipelineCacheKey& key, std::span<const VideoCommon::FileEnvironment> envs) const {
+    if (!canonical_keys || envs.empty() ||
+        !std::ranges::all_of(envs, [](const VideoCommon::FileEnvironment& env) {
+            return env.IsNativeProgram();
+        })) {
+        return;
+    }
+    if (key.state.dynamic_vertex_input != 0) {
+        MaskKeyedAttributeTypes(key, envs);
+    }
+    CanonicalizeKeyState(key.state, dynamic_features);
+}
+
+u32 PipelineCache::OtherDeviceBits(const GraphicsPipelineCacheKey& key) const {
+    const FixedPipelineState& recorded = key.state;
+    const DynamicFeatures& here = dynamic_features;
+    u32 bits = 0;
+    const auto differs = [&bits](u32 bit, bool was, bool is) {
+        if (was != is) {
+            bits |= 1U << bit;
+        }
+    };
+    differs(OtherMaskComponents, recorded.mask_components != 0,
+            MaskComponentsEnabled() && !here.has_extended_dynamic_state_3_blend);
+    differs(OtherEds1, recorded.extended_dynamic_state != 0, here.has_extended_dynamic_state);
+    differs(OtherEds2, recorded.extended_dynamic_state_2 != 0, here.has_extended_dynamic_state_2);
+    differs(OtherEds2LogicOp, recorded.extended_dynamic_state_2_logic_op != 0,
+            here.has_extended_dynamic_state_2_logic_op);
+    differs(OtherEds3Blend, recorded.extended_dynamic_state_3_blend != 0,
+            here.has_extended_dynamic_state_3_blend);
+    differs(OtherEds3Enables, recorded.extended_dynamic_state_3_enables != 0,
+            here.has_extended_dynamic_state_3_enables);
+    differs(OtherColorWriteEnable, recorded.color_write_enable_dynamic != 0,
+            here.has_color_write_enable);
+    if ((recorded.dynamic_vertex_input != 0) != here.has_dynamic_vertex_input &&
+        !(StaticVertexInputEnabled() && here.has_dynamic_vertex_input &&
+          EdenAttributelessStaticKey(recorded))) {
+        bits |= 1U << OtherVertexInput;
+    }
+    if (recorded.provoking_vertex_last != 0 &&
+        (!here.has_provoking_vertex_last_mode ||
+         (recorded.xfb_enabled != 0 && !here.has_provoking_vertex_tf_preserve))) {
+        bits |= 1U << OtherProvokingVertex;
+    }
+    return bits;
+}
+
+// EDEN_UP_SHADER_SET=1 ---------------------------------------------------------------------
+
+std::string PipelineCache::ShaderSetDeviceIdentity() const {
+    // What a converted key depends on: the driver fields it carries, the device (its driver
+    // cache is what the preparation fills), every dynamic state the key layout and the
+    // mapping look at, and the key policy switches.
+    const DynamicFeatures& f = dynamic_features;
+    return fmt::format(
+        "driver {:x}.{:x} model {} dynamic {}{}{}{}{}{}{}{}{}{}{}{}{}{}{}{} mask {} static {} "
+        "canonical {}",
+        f.driver_id, f.driver_version, device.GetModelName(), u32{f.has_extended_dynamic_state},
+        u32{f.has_extended_dynamic_state_2}, u32{f.has_extended_dynamic_state_2_logic_op},
+        u32{f.has_extended_dynamic_state_2_patch_control_points},
+        u32{f.has_extended_dynamic_state_3_blend}, u32{f.has_extended_dynamic_state_3_enables},
+        u32{f.has_dynamic_state3_depth_clamp_enable}, u32{f.has_dynamic_state3_logic_op_enable},
+        u32{f.has_dynamic_state3_line_stipple_enable}, u32{f.has_dynamic_vertex_input},
+        u32{f.has_static_vertex_repack}, u32{f.has_color_write_enable},
+        u32{f.has_provoking_vertex}, u32{f.has_provoking_vertex_first_mode},
+        u32{f.has_provoking_vertex_last_mode}, u32{f.has_provoking_vertex_tf_preserve},
+        MaskComponentsEnabled() ? 1 : 0, StaticVertexInputEnabled() ? 1 : 0,
+        canonical_keys ? 1 : 0);
+}
+
+bool PipelineCache::MapShaderSetState(std::span<const u8> state, std::array<u64, 6> hashes,
+                                      u32 vertex_read_mask, std::vector<u8>& bytes) const {
+    static_assert(sizeof(FixedPipelineState) == 1008);
+    static_assert(sizeof(GraphicsPipelineCacheKey) == 1056);
+    static_assert(offsetof(GraphicsPipelineCacheKey, state) == 48);
+    static_assert(offsetof(FixedPipelineState, attributes) == 112);
+    static_assert(offsetof(FixedPipelineState, depth_bounds_min) == 992);
+    if (state.size() != sizeof(FixedPipelineState)) {
+        return false;
+    }
+    GraphicsPipelineCacheKey key{};
+    key.unique_hashes = hashes;
+    std::memcpy(&key.state, state.data(), state.size());
+    key.state.driver_id = dynamic_features.driver_id;
+    key.state.driver_version = dynamic_features.driver_version;
+    // Deliberately narrow mapping: no reconstruction of state discarded by EDS3, no mesh XOR
+    // reuse, and no dynamic-to-static logic-op guess.
+    if (!key.state.extended_dynamic_state || !key.state.extended_dynamic_state_2 ||
+        !key.state.extended_dynamic_state_2_logic_op || !key.state.dynamic_vertex_input ||
+        key.state.extended_dynamic_state_3_blend || key.state.extended_dynamic_state_3_enables ||
+        key.state.mask_components || key.state.xfb_enabled || key.unique_hashes[0] ||
+        key.state.app_stage.Value() == Tegra::Engines::Maxwell3D::EngineHint::OnHLEMacro ||
+        OtherDeviceBits(key) != 0) {
+        return false;
+    }
+    // As draws key it here (EDEN_UP_CANONICAL_KEYS=1): the attribute types the vertex program's
+    // header lists (KeyedAttributeTypes' rule) and CanonicalizeKeyState. The recipe's keys are
+    // canonical already (Fritchii v5.5 writes them so); both steps are idempotent.
+    u64 keep = 0;
+    for (size_t index = 0; index < Maxwell::NumVertexAttributes; ++index) {
+        if ((vertex_read_mask >> index) & 1) {
+            keep |= u64{3} << (index * 2);
+        }
+    }
+    key.state.attribute_types &= keep;
+    CanonicalizeKeyState(key.state, dynamic_features);
+    const auto* start = reinterpret_cast<const u8*>(&key);
+    bytes.assign(start, start + sizeof(key));
+    return true;
+}
+
+void PipelineCache::StartShaderSet(const std::filesystem::path& title_dir) {
+    if (shader_set_thread.joinable()) {
+        return;
+    }
+    audit_logged = std::chrono::steady_clock::now();
+    VideoCommon::ShaderSet::Identity identity;
+    identity.cache_version = CACHE_VERSION;
+    identity.lowering_tag = 0x4f554e4345000003ULL; // shader_environment.cpp Analyze
+    identity.device = ShaderSetDeviceIdentity();
+    // The prepared store's own stamp: the installed build (its eboot), the settings and every
+    // switch the translation and the lowerer read (EDEN_UP_SHADOW_REGISTERS,
+    // EDEN_UP_FRITCHII_SHADOWMORE, EDEN_NX2_NET_BARRIER, EDEN_NX2_TENSOR, ...). A new build or a
+    // flipped switch changes the lowered hashes, so the generated file is made again with it.
+    identity.translation =
+        ShaderPrep::MakeStamp(CACHE_VERSION, static_cast<u32>(device.GetDriverID()),
+                              device.GetDriverVersion()) +
+        (canonical_keys ? " canonical1" : "");
+    const auto output_dir = pipeline_cache_filename.parent_path();
+    shader_set_thread = std::jthread([this, title = visual_workaround_title, title_dir, output_dir,
+                                      identity](std::stop_token stop) {
+        Common::SetCurrentThreadName("ShaderSet");
+        Common::SetCurrentThreadPriority(Common::ThreadPriority::Low);
+        Common::SetCurrentThreadToBackgroundWork();
+        try {
+            const auto outputs = VideoCommon::ShaderSet::Prepare(
+                title, title_dir, output_dir, identity,
+                [this](std::span<const u8> state, std::array<u64, 6> hashes, u32 read_mask,
+                       std::vector<u8>& bytes) {
+                    return MapShaderSetState(state, hashes, read_mask, bytes);
+                },
+                stop);
+            if (outputs.records.empty() || stop.stop_requested()) {
+                return;
+            }
+            {
+                auto programs = std::make_shared<std::unordered_set<u64>>();
+                for (const u64 hash : VideoCommon::ShaderSet::ReadPrograms(outputs.programs)) {
+                    programs->insert(hash);
+                }
+                std::scoped_lock lock{shader_set_mutex};
+                shader_set_programs = std::move(programs);
+            }
+            PrepareShaderSet(outputs.records, stop);
+        } catch (const std::exception& e) {
+            LOG_WARNING(Render_Vulkan, "Shader set: the background work ended: {}", e.what());
+        }
+    });
+}
+
+void PipelineCache::PrepareShaderSet(const std::filesystem::path& file, std::stop_token stop) {
+    if (!prep_store.IsOpen() || stop.stop_requested()) {
+        return;
+    }
+    const auto begin = std::chrono::steady_clock::now();
+    const auto seconds = [&begin] {
+        return std::chrono::duration<double>(std::chrono::steady_clock::now() - begin).count();
+    };
+    // EDEN_UP_SHADER_SET_PREP_ALL=1 lifts EDEN_UP_SHADER_PREP_MAX for these records: memory stays
+    // bounded by the few records in flight (each is translated, built once for the driver's
+    // cache, kept as SPIR-V and infos in the store, and dropped), the index is committed at
+    // most once a minute, and the pass stops under the memory or disk floor and resumes at the
+    // next start (the store remembers what is kept or not keepable).
+    // v3.1: one job in flight by default, a duty cycle (EDEN_UP_SHADER_SET_DUTY: the builds'
+    // time over wall time, percent, 50), and the pass yields while the runtime has builds of
+    // its own queued: the workers are shared, and a new area's pipelines must not wait behind
+    // these (thread priorities do nothing for SCHED_OTHER threads on the console).
+    const bool all = Common::PeSwitch("EDEN_UP_SHADER_SET_PREP_ALL");
+    const size_t limit = all ? std::numeric_limits<size_t>::max() : ShaderPrep::MaxPerBoot();
+    const size_t worker_count =
+        device.HasBrokenParallelShaderCompiling() ? size_t{1} : GetTotalPipelineWorkers();
+    const size_t max_in_flight = std::clamp<size_t>(
+        ShaderSetNumber("EDEN_UP_SHADER_SET_PREP_JOBS", 1), 1, std::max<size_t>(worker_count, 1));
+    const u64 floor = VideoCommon::ShaderSet::MinimumFreeBytes();
+    const u64 disk_floor = VideoCommon::ShaderSet::MinimumFreeDiskBytes();
+    const unsigned duty = VideoCommon::ShaderSet::DutyPercent();
+    if (VideoCommon::ShaderSet::FreeMemoryBytes() == 0 &&
+        !VideoCommon::ShaderSet::MemoryCheckWaived()) {
+        // The floor cannot be checked: refused, not skipped (a base PS5 has a few hundred MB).
+        LOG_WARNING(Render_Vulkan,
+                    "Shader set: free memory is unknown on this platform; the records are not "
+                    "prepared (EDEN_UP_SHADER_SET_NO_MEMORY_CHECK=1 prepares them anyway)");
+        return;
+    }
+    // Once every record of this file is known to the store, the pass is skipped: the file is
+    // ~1 GB, and reading it to its end for nothing costs a boot's worth of I/O. The marker names
+    // the file (size and write time) and the store's size then: a store reset under the same
+    // stamp (the translation changed) has fewer records and reads the file again.
+    const auto done_filename = prep_store.Sidecar(".shader_set_done");
+    std::error_code done_error;
+    const auto file_bytes = std::filesystem::file_size(file, done_error);
+    const auto file_written = std::filesystem::last_write_time(file, done_error);
+    const auto file_identity = fmt::format(
+        "records {} {}", file_bytes,
+        static_cast<long long>(file_written.time_since_epoch().count()));
+    {
+        std::ifstream in{done_filename};
+        std::string text{std::istreambuf_iterator<char>(in), {}};
+        unsigned long long done_store = 0;
+        if (text.rfind(file_identity, 0) == 0 &&
+            std::sscanf(text.c_str() + file_identity.size(), " store %llu", &done_store) == 1 &&
+            prep_store.Size() >= done_store) {
+            LOG_INFO(Render_Vulkan,
+                     "Shader set: every record of {} is known to the prepared store already "
+                     "({} kept); nothing to prepare",
+                     file.filename().string(), prep_store.Size());
+            return;
+        }
+    }
+    auto last_commit = std::chrono::steady_clock::now();
+    std::chrono::steady_clock::duration slept{};
+    std::string stopped; // why the reading stopped early (empty: the file was read to its end)
+
+    // Strikes as PrepareKept keeps them (a record whose build took the app down twice is left
+    // to the draw that needs it), with a journal of this pass's own.
+    const auto strikes_filename = prep_store.Sidecar(".strikes");
+    const auto journal_filename = prep_store.Sidecar(".inflight_set");
+    std::unordered_map<u64, u32> strikes;
+    {
+        std::ifstream in{strikes_filename};
+        u64 hash{};
+        u32 count{};
+        while (in >> std::hex >> hash >> std::dec >> count) {
+            strikes.emplace(hash, count);
+        }
+    }
+    {
+        std::ifstream in{journal_filename, std::ios::binary};
+        u64 hash{};
+        bool added = false;
+        while (in.read(reinterpret_cast<char*>(&hash), sizeof(hash))) {
+            if (hash != 0) {
+                ++strikes[hash];
+                added = true;
+            }
+        }
+        if (added) {
+            // Written beside and renamed over: a kill or a full disk leaves the old list, and
+            // the journal (truncated below) is only cleared once the new list is on disk.
+            std::string text;
+            for (const auto& [struck, count] : strikes) {
+                text += fmt::format("{:x} {}\n", struck, count);
+            }
+            auto partial = strikes_filename;
+            partial += ".part";
+            bool written = false;
+            {
+                std::ofstream out{partial, std::ios::trunc};
+                written = static_cast<bool>(out << text) && static_cast<bool>(out.flush());
+            }
+            std::error_code rename_error;
+            if (written) {
+                std::filesystem::rename(partial, strikes_filename, rename_error);
+            }
+            if (!written || rename_error) {
+                std::filesystem::remove(partial, rename_error);
+                LOG_WARNING(Render_Vulkan,
+                            "Shader set: cannot write {}; the records are not prepared this start",
+                            Common::FS::PathToUTF8String(strikes_filename));
+                return;
+            }
+        }
+    }
+    const auto struck_out = [&strikes](u64 hash) {
+        const auto it = strikes.find(hash);
+        return it != strikes.end() && it->second >= 2;
+    };
+    struct {
+        std::mutex mutex;
+        std::condition_variable cv;
+        size_t in_flight{};
+        size_t finished{};
+        size_t failed{};
+        size_t kept{};
+        size_t not_kept{};
+        std::chrono::steady_clock::duration busy{}; ///< time the builds took, for the duty cycle
+        std::vector<u32> free_slots;
+        std::fstream journal;
+    } state;
+    {
+        std::ofstream create{journal_filename, std::ios::binary | std::ios::trunc};
+        const std::vector<char> zeros(max_in_flight * sizeof(u64), 0);
+        create.write(zeros.data(), static_cast<std::streamsize>(zeros.size()));
+    }
+    state.journal.open(journal_filename, std::ios::binary | std::ios::in | std::ios::out);
+    for (u32 slot = 0; slot < max_in_flight; ++slot) {
+        state.free_slots.push_back(slot);
+    }
+    const auto note_slot = [&state](u32 slot, u64 hash) noexcept {
+        try {
+            if (!state.journal.is_open()) {
+                return;
+            }
+            state.journal.clear();
+            state.journal.seekp(static_cast<std::streamoff>(slot * sizeof(u64)));
+            state.journal.write(reinterpret_cast<const char*>(&hash), sizeof(hash));
+            state.journal.flush();
+        } catch (const std::exception&) {
+        }
+    };
+    const auto wait_for_jobs = [&state] {
+        std::unique_lock lock{state.mutex};
+        state.cv.wait(lock, [&] { return state.in_flight == 0; });
+    };
+
+    size_t read = 0, known = 0, left_out = 0, other = 0, struck = 0, queued = 0;
+    bool paused = false;
+    LOG_INFO(Render_Vulkan,
+             "Shader set: preparing the records of {} on the pipeline workers: {} in flight, "
+             "duty {}%, cap {}, memory floor {} MB, disk floor {} MB",
+             file.filename().string(), max_in_flight, duty,
+             all ? std::string{"none (EDEN_UP_SHADER_SET_PREP_ALL=1)"} : fmt::format("{}", limit),
+             floor >> 20, disk_floor >> 20);
+    const auto skip_compute = [](std::ifstream& in, VideoCommon::FileEnvironment) {
+        ComputePipelineCacheKey key;
+        in.read(reinterpret_cast<char*>(&key), sizeof(key));
+    };
+    const bool whole = VideoCommon::ReadPipelines(
+        file, CACHE_VERSION, skip_compute,
+        [&](std::ifstream& in, std::vector<VideoCommon::FileEnvironment> envs) {
+            GraphicsPipelineCacheKey key;
+            in.read(reinterpret_cast<char*>(&key), sizeof(key));
+            if (stop.stop_requested()) {
+                stopped = "stopped at shutdown";
+                throw StopReading{stopped};
+            }
+            ++read;
+            CanonicalizeLoadedKey(key, envs); // idempotent: the mapping made it canonical
+            const u64 hash = key.Hash();
+            const bool mesh =
+                std::ranges::any_of(envs, [](const VideoCommon::FileEnvironment& env) {
+                    return env.ShaderStage() == Shader::Stage::Task ||
+                           env.ShaderStage() == Shader::Stage::Mesh;
+                });
+            if (envs.empty() || envs.size() > ShaderPrep::NumStages ||
+                key.unique_hashes[0] != 0 || mesh ||
+                key.state.driver_id != dynamic_features.driver_id ||
+                key.state.driver_version != dynamic_features.driver_version ||
+                key.state.app_stage.Value() == Tegra::Engines::Maxwell3D::EngineHint::OnHLEMacro) {
+                ++left_out;
+                return;
+            }
+            if (OtherDeviceBits(key) != 0) {
+                ++other;
+                return;
+            }
+            if (prep_store.Contains(hash)) {
+                ++known; // kept by an earlier start, or remembered as not keepable
+                return;
+            }
+            if (struck_out(hash)) {
+                ++struck;
+                return;
+            }
+            if (queued >= limit) {
+                stopped = fmt::format("the cap of {} per start (EDEN_UP_SHADER_PREP_MAX)", limit);
+                throw StopReading{stopped};
+            }
+            // The index is written at most once a minute (it is rebuilt whole under the
+            // store's lock, which the GPU thread's lookups wait on) and at the end.
+            if (prep_store.Uncommitted() != 0 &&
+                std::chrono::steady_clock::now() - last_commit >= std::chrono::seconds{60}) {
+                prep_store.Commit();
+                last_commit = std::chrono::steady_clock::now();
+            }
+            // Before every record: the memory floor; every 64: the disk floor (the store grows
+            // by gigabytes over a full pass, and a full disk ends keeping for the session).
+            if (const u64 free = VideoCommon::ShaderSet::FreeMemoryBytes();
+                free != 0 && free < floor) {
+                paused = true;
+                stopped = fmt::format("{} MB free, under the {} MB memory floor "
+                                      "(EDEN_UP_SHADER_SET_MIN_FREE_MB)",
+                                      free >> 20, floor >> 20);
+                throw StopReading{stopped};
+            }
+            if (queued % 64 == 0) {
+                std::error_code space_error;
+                const auto space = std::filesystem::space(file.parent_path(), space_error);
+                if (!space_error && space.available < disk_floor) {
+                    paused = true;
+                    stopped = fmt::format("{} MB free on disk, under the {} MB floor",
+                                          space.available >> 20, disk_floor >> 20);
+                    throw StopReading{stopped};
+                }
+            }
+            // Yield while the runtime has builds of its own queued on the shared workers, then
+            // rest as the duty cycle asks (busy time over wall time stays under `duty` percent).
+            for (;;) {
+                size_t in_flight{};
+                std::chrono::steady_clock::duration busy{};
+                {
+                    std::scoped_lock lock{state.mutex};
+                    in_flight = state.in_flight;
+                    busy = state.busy;
+                }
+                if (workers.Pending() > in_flight) {
+                    if (!Common::StoppableTimedWait(stop, std::chrono::milliseconds{100})) {
+                        stopped = "stopped at shutdown";
+                        throw StopReading{stopped};
+                    }
+                    continue;
+                }
+                const auto rest = busy * static_cast<s64>(100 - duty) / static_cast<s64>(duty);
+                if (rest <= slept) {
+                    break;
+                }
+                const auto nap = std::min<std::chrono::steady_clock::duration>(
+                    rest - slept, std::chrono::seconds{2});
+                if (!Common::StoppableTimedWait(stop, nap)) {
+                    stopped = "stopped at shutdown";
+                    throw StopReading{stopped};
+                }
+                slept += nap;
+            }
+            u32 slot{};
+            {
+                std::unique_lock lock{state.mutex};
+                state.cv.wait(lock, [&] { return state.in_flight < max_in_flight; });
+                ++state.in_flight;
+                slot = state.free_slots.back();
+                state.free_slots.pop_back();
+                note_slot(slot, hash);
+            }
+            ++queued;
+            constexpr u32 flags =
+                ShaderPrep::KeptStore::FlagPredicted | ShaderPrep::KeptStore::FlagShaderSet;
+            try {
+                workers.QueueWork([this, key, hash, slot, envs_ = std::move(envs), &state,
+                                   &note_slot, &seconds, queued]() mutable {
+                    bool ok = false;
+                    bool kept = false;
+                    const auto started = std::chrono::steady_clock::now();
+                    try {
+                        ShaderPrep::Stages stages;
+                        stages.driver_cache_only = true;
+                        ShaderPools pools;
+                        boost::container::static_vector<Shader::Environment*, 5> env_ptrs;
+                        for (auto& env : envs_) {
+                            env_ptrs.push_back(&env);
+                        }
+                        // Built on this worker, then dropped: the driver keeps what it compiled.
+                        const auto pipeline{CreateGraphicsPipeline(pools, key, MakeSpan(env_ptrs),
+                                                                   nullptr, false, &stages)};
+                        ok = pipeline != nullptr;
+                        if (ok && !stages.unsuitable) {
+                            KeepPrepared(key, stages, envs_, flags);
+                            kept = prep_store.IsKept(hash);
+                        } else {
+                            prep_store.AddNotKeepable(hash);
+                        }
+                    } catch (const std::exception& e) {
+                        LOG_DEBUG(Render_Vulkan, "Shader set: a pipeline failed: {}", e.what());
+                    }
+                    const auto took = std::chrono::steady_clock::now() - started;
+                    std::scoped_lock lock{state.mutex};
+                    state.busy += took;
+                    --state.in_flight;
+                    ++state.finished;
+                    if (!ok) {
+                        ++state.failed;
+                    }
+                    if (kept) {
+                        ++state.kept;
+                    } else if (ok) {
+                        ++state.not_kept;
+                    }
+                    state.free_slots.push_back(slot);
+                    note_slot(slot, 0);
+                    if (state.finished % ShaderPrep::LogEvery() == 0) {
+                        LOG_INFO(Render_Vulkan,
+                                 "Shader set: prepared {} of {} queued, {:.0f} s, {} failed",
+                                 state.finished, queued, seconds(), state.failed);
+                    }
+                    state.cv.notify_all();
+                });
+            } catch (...) {
+                std::scoped_lock lock{state.mutex};
+                --state.in_flight;
+                state.free_slots.push_back(slot);
+                note_slot(slot, 0);
+                state.cv.notify_all();
+                throw;
+            }
+        },
+        false);
+    wait_for_jobs();
+    {
+        std::scoped_lock lock{state.mutex};
+        state.journal.close();
+    }
+    const bool committed = prep_store.Commit();
+    prep_store.Compact();
+    std::error_code error;
+    std::filesystem::remove(journal_filename, error);
+    const double busy_seconds = std::chrono::duration<double>(state.busy).count();
+    LOG_INFO(Render_Vulkan,
+             "Shader set: {} records read: {} prepared ({} kept, {} built but not kept, {} "
+             "failed) in {:.0f} s ({:.0f} s of builds); {} known already, {} struck out, {} left "
+             "out (stages, driver or HLE macro), {} for another dynamic state; {} kept in {} "
+             "MiB{}{}",
+             read, state.finished, state.kept, state.not_kept, state.failed, seconds(),
+             busy_seconds, known, struck, left_out, other, prep_store.Size(),
+             prep_store.DataBytes() >> 20,
+             committed ? std::string{} : std::string{"; the index was NOT written"},
+             !stopped.empty() ? fmt::format("; reading stopped at record {}: {}; the rest is left "
+                                            "for the next start",
+                                            read, stopped)
+             : whole ? std::string{}
+                     : std::string{"; the file could not be read to its end"});
+    if (paused) {
+        LOG_WARNING(Render_Vulkan,
+                    "Shader set: preparation paused ({}); it resumes at the next start", stopped);
+    }
+    if (whole && stopped.empty() && committed && !stop.stop_requested()) {
+        // Everything in the file is known now: the next start skips the pass (see above).
+        std::ofstream out{done_filename, std::ios::trunc};
+        out << file_identity << " store " << prep_store.Size() << '\n';
+    }
+}
+
+void PipelineCache::LogShaderSetAudit(bool final) {
+    const auto now = std::chrono::steady_clock::now();
+    if (!final && now - audit_logged < std::chrono::seconds{60}) {
+        return;
+    }
+    audit_logged = now;
+    {
+        // Programs seen before the set was loaded are counted now.
+        std::scoped_lock lock{shader_set_mutex};
+        if (shader_set_programs && !audit_pending.empty()) {
+            for (const u64 hash : audit_pending) {
+                if (shader_set_programs->contains(hash)) {
+                    audit_programs_in_set.fetch_add(1, std::memory_order_relaxed);
+                }
+            }
+            audit_pending.clear();
+        }
+    }
+    LOG_INFO(Render_Vulkan,
+             "EDEN_UP_SHADER_SET audit: programs {} of {} live in set, pipelines {} of {} live "
+             "hit prepared{}",
+             audit_programs_in_set.load(std::memory_order_relaxed),
+             audit_programs_total.load(std::memory_order_relaxed),
+             audit_keys_hit.load(std::memory_order_relaxed),
+             audit_keys_total.load(std::memory_order_relaxed), final ? " (shutdown)" : "");
+}
+
 } // namespace Vulkan
