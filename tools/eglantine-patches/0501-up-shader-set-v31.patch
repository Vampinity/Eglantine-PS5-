+u64 FreeMemoryBytes() {
+#if defined(__linux__)
+    struct sysinfo info {};
+    if (sysinfo(&info) == 0) {
+        return (u64{info.freeram} + info.bufferram) * info.mem_unit;
+    }
+#elif defined(__FreeBSD__)
+    u32 free_pages = 0, inactive_pages = 0;
+    size_t length = sizeof(u32);
+    if (sysctlbyname("vm.stats.vm.v_free_count", &free_pages, &length, nullptr, 0) == 0) {
+        length = sizeof(u32);
+        (void)sysctlbyname("vm.stats.vm.v_inactive_count", &inactive_pages, &length, nullptr, 0);
+        return (u64{free_pages} + inactive_pages) * static_cast<u64>(getpagesize());
+    }
+#endif
+    return 0;
+}
