+// SPDX-FileCopyrightText: Copyright 2026 Eden Emulator Project
+// SPDX-License-Identifier: GPL-3.0-or-later
+#pragma once
+
+#include <mutex>
+#include <utility>
+#include <vector>
+#include "common/common_types.h"
+#include "core/file_sys/vfs/vfs_types.h"
+
+namespace FileSys::ShaderSetSource {
+struct Source {
+    const void* owner{}; // identity only; never dereferenced
+    u64 title{};
+    u32 version{};
+    std::vector<VirtualDir> roots;
+};
+// Inline storage shares one registry across the loader and video_core. Snapshots own
+// their VFS references, including the NUP backing files, independently of the loader.
+inline std::mutex mutex;
+inline Source current;
+inline void Install(const void* owner, u64 title, u32 version, std::vector<VirtualDir> roots) {
+    std::scoped_lock lock{mutex};
+    current = {owner, title, version, std::move(roots)};
+}
+inline Source Snapshot() {
+    std::scoped_lock lock{mutex};
+    return current;
+}
+inline void Clear(const void* owner) {
+    std::scoped_lock lock{mutex};
+    if (current.owner == owner) current = {};
+}
+} // namespace FileSys::ShaderSetSource
