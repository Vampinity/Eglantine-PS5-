+struct Guest { u8 stage; std::vector<u8> code, control; };
+u8 Stage(FileSys::Nx2ShaderExtract::Stage s) {
+    const auto stage = static_cast<u8>(s);
+    return stage >= 6 ? stage + 1 : stage; // Shader::Stage reserves 6 for compute's end marker
+}
+struct Lowered { std::vector<u64> code; u64 hash; u32 bound; u32 read_mask; };
+std::optional<Lowered> Lower(const Guest& p, std::stop_token stop) {
+    using namespace Shader::Ampere;
+    // This first port feeds only ordinary graphics into PrepareKept. No compute/mesh guesses.
+    if ((p.stage != 0 && p.stage != 4) || p.code.size() <= 128) return {};
+    Shader::ProgramHeader sph{};
+    static_assert(sizeof(sph) == 80);
+    std::memcpy(&sph, p.code.data(), sizeof(sph));
+    std::vector<Instruction> native;
+    ProgramCaptureState capture;
+    bool complete = false;
+    for (u32 i = 0; i < ProgramCaptureState::MaximumInstructions; ++i) {
+        if (stop.stop_requested()) return {};
+        const size_t at = 128 + size_t{i} * sizeof(Instruction);
+        if (at > p.code.size() || sizeof(Instruction) > p.code.size() - at) break;
+        const auto instruction = Load<Instruction>(p.code, at);
+        // v2: a trap (0x95c) is lowered as the live path lowers it (lower_to_maxwell.h:1558,
+        // the same words from the same instruction, no live data); rejecting it here only lost records.
+        native.push_back(instruction);
+        const auto status = capture.Observe(instruction, i);
+        if (status == ProgramCaptureState::Result::InvalidTarget) return {};
+        if (status == ProgramCaptureState::Result::Complete) { complete = true; break; }
+    }
+    if (!complete) return {};
+    // Matches our GraphicsEnvironment (native_tensor defaults false); LEPC/geometry excluded.
+    const auto lowered = LowerToMaxwell(native, {.geometry = false, .tensor = false,
+                                                .native_code_address = 0});
+    if (!lowered) return {};
+    Lowered out{};
+    out.bound = lowered.required_texture_buffer;
+    // v3: the canonical key keeps only the attribute types the vertex program's header lists
+    // (VideoCommon::GenericReadMask, as the live key is masked).
+    out.read_mask = p.stage == 0 ? VideoCommon::GenericReadMask(sph) : ~0U;
+    out.code.resize(sizeof(sph) / 8);
+    std::memcpy(out.code.data(), &sph, sizeof(sph));
+    for (u64 instruction : lowered.instructions) {
+        if ((out.code.size() * 8) % 32 == 0) out.code.push_back(0);
+        out.code.push_back(instruction);
+    }
+    out.code.push_back(0);
+    AppendNativeAddressMap(out.code, lowered.source_instruction_offsets);
+    out.hash = Common::CityHash64(reinterpret_cast<const char*>(out.code.data()), out.code.size() * 8) ^
+               0x4f554e4345000003ULL;
+    return out;
+}
+std::vector<u8> Hydrate(const Facts& f, const Lowered& p) {
+    // Facts are cached answers. Read addresses belong to the *target* lowered vector.
+    if (Load<u32>(f.bytes, 56) != 0 || Load<u32>(f.bytes, 60) != 0) return {};
+    if (p.bound != ~0U && Load<u32>(f.bytes, 52) != p.bound) return {};
+    std::vector<u8> out(f.bytes.begin(), f.bytes.begin() + 76);
+    Patch(out, 0, u64{p.code.size() * 8});
+    Patch(out, 60, u32{0});
+    Patch(out, 64, static_cast<u32>((p.code.size() - 1) * 8));
+    const auto* code = reinterpret_cast<const u8*>(p.code.data());
+    out.insert(out.end(), code, code + p.code.size() * 8);
+    out.insert(out.end(), f.bytes.begin() + 76, f.bytes.begin() + f.tables_end);
+    out.insert(out.end(), code, code + 80); // graphics ProgramHeader is absent from facts
+    return out;
+}
