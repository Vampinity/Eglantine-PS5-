+/// EDEN_UP_FRITCHII_WRITEMARK: the store extent of each written buffer whose every write was
+/// rebased onto it (`to_replace`); none when any write stays global, since a global write can land
+/// in any bound buffer (native programs pick theirs at run time among all of them).
+std::map<StorageBufferAddr, StorageWriteExtent> StoreExtents(const IR::Program& program,
+                                                             const StorageInfo& info) {
+    std::map<StorageBufferAddr, StorageWriteExtent> extents;
+    std::unordered_set<const IR::Inst*> replaced;
+    for (const StorageInst& storage_inst : info.to_replace) {
+        replaced.insert(storage_inst.inst);
+    }
+    for (const IR::Block* const block : program.post_order_blocks) {
+        for (const IR::Inst& inst : block->Instructions()) {
+            if (IsGlobalMemoryWrite(inst) && !replaced.contains(&inst)) {
+                return extents;
+            }
+        }
+    }
+    std::map<StorageBufferAddr, StoreExtentAnalysis> analyses;
+    for (const StorageInst& storage_inst : info.to_replace) {
+        if (!IsGlobalMemoryWrite(*storage_inst.inst)) {
+            continue;
+        }
+        auto analysis{analyses.find(storage_inst.storage_buffer)};
+        if (analysis == analyses.end()) {
+            analysis = analyses
+                           .emplace(storage_inst.storage_buffer,
+                                    StoreExtentAnalysis{storage_inst.storage_buffer,
+                                                        program.workgroup_size})
+                           .first;
+            // An empty bounded extent, widened by every store
+            extents.emplace(storage_inst.storage_buffer, StorageWriteExtent{.bounded = true});
+        }
+        analysis->second.AddStore(*storage_inst.inst, extents[storage_inst.storage_buffer]);
+    }
+    return extents;
+}
