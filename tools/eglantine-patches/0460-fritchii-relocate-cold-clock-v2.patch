+    /// tick), its latest bump was exact (video_core/nx2.h: not a late flip, not past its value)
+    /// and the clock was never lost (relocate review, 2026-11-09).
+    [[nodiscard]] bool RelocationBoundary(u64& render_frame) const noexcept {
+        if (!render_clock_live || Tegra::g_nx2_render_clock_lost.load(std::memory_order_relaxed)) {
+            return false;
+        }
+        const u64 raw = Tegra::g_nx2_render_frame.load(std::memory_order_acquire);
+        const u64 count = raw >> 1;
+        if ((raw & 1) != 0 || count <= render_clock_source_base) {
+            return false;
+        }
+        render_frame = render_clock_base + (count - render_clock_source_base);
+        return true;
+    }
