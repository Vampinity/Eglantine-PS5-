+// Render-frame clock (EDEN_UP_FRITCHII_RELOCATE=1, or EDEN_UP_FRITCHII_COLD=1 with
+// EDEN_UP_FRITCHII_CLOCK=1; Fritchii e722284eec, a3f5cb27d4, ddc5e2585c; fable_answer_16 1b and
+// 17): one count per guest frame, bumped where the frame's last GPU work is, so the texture
+// cache's relocation rules can tell frames apart where the host present tick (mid-stream) cannot.
+// Sources:
+// - by default the flip's frame fence (Nx2FrameFenceClock, video_core/nx2_frame_fence.h): the
+//   nx2:syncpt TIPC 201 arms and the nx2:vi2 229 flips (core/hle/service/nx2_gsv.h), bumped on
+//   the split's back in stream order (FenceManager::SignalSyncPoint);
+// - EDEN_UP_FRITCHII_CLOCK_SYNCPT=<id>: every back signal of that syncpoint (manual override).
+// Upstream's third source (a write to the OoT present poll's learned word, EDEN_NX2_RENDER_CLOCK=2,
+// "never fires") is not ported: this tree has no svc_nx2_oot_present. Nothing counts while the
+// texture cache does not want the clock (TextureCache::TickRenderClock sets the flag).
+//
+// Exact and inexact bumps (relocate review, 2026-11-09): a bump made on the back at the signal
+// that reaches the frame's end is exact. One made later can split the next frame, so images that
+// frame wrote before it look a frame old: at a signal past a boundary nobody bumped on (it is in
+// the next frame), and at a flip that came after the back passed its value (harmless only if the
+// back ran none of the next frame's work before the flip, which nothing here proves: other
+// queues, a render thread that runs ahead). Relocation only runs while the latest bump was exact
+// (TextureCache::RelocationBoundary); an inexact one holds it until the next exact one.
+inline std::atomic<bool> g_nx2_render_clock_wanted{false};
+/// (bumps << 1) | (1 while the latest bump was inexact). Read with Nx2RenderFrameCount.
+inline std::atomic<u64> g_nx2_render_frame{};
+/// Inexact bumps and the inexact marks after an early bump (logged with the clock).
+inline std::atomic<u32> g_nx2_render_frame_inexact{};
+/// Set for the session when a frame-syncpoint signal's stream position was unknown (off the
+/// back while EDEN_NX2_READBACK_WAIT held increments): boundaries can no longer be trusted, and
+/// relocation stops.
+inline std::atomic<bool> g_nx2_render_clock_lost{false};
+inline u64 Nx2RenderFrameCount() {
+    return g_nx2_render_frame.load(std::memory_order_acquire) >> 1;
+}
+inline void Nx2BumpRenderFrame(bool exact) {
+    u64 seen = g_nx2_render_frame.load(std::memory_order_relaxed);
+    u64 next;
+    do {
+        next = (((seen >> 1) + 1) << 1) | (exact ? 0 : 1);
+    } while (!g_nx2_render_frame.compare_exchange_weak(seen, next, std::memory_order_acq_rel,
+                                                       std::memory_order_relaxed));
+    if (!exact) {
+        g_nx2_render_frame_inexact.fetch_add(1, std::memory_order_relaxed);
+    }
+}
+/// The current frame may not have started at its real boundary (an early bump found later).
+inline void Nx2MarkRenderFrameInexact() {
+    g_nx2_render_frame.fetch_or(1, std::memory_order_acq_rel);
+    g_nx2_render_frame_inexact.fetch_add(1, std::memory_order_relaxed);
+}
+// Read on first use (a3f5cb27d4: static initialization runs before the switches are applied).
+inline int Nx2RenderClockSyncpt() {
+    static const int syncpt = [] {
+        const char* value = std::getenv("EDEN_UP_FRITCHII_CLOCK_SYNCPT");
+        return value != nullptr && value[0] != '\0' ? std::atoi(value) : -1;
+    }();
+    return syncpt;
+}
+inline bool Nx2RenderClockFlipSource() {
+    return Nx2RenderClockSyncpt() < 0;
+}
+// Syncpoint signals by id while the clock is wanted (logged with the clock).
+inline constexpr size_t Nx2SyncpointSignalSlots = 192;
+inline std::array<std::atomic<u32>, Nx2SyncpointSignalSlots> g_nx2_syncpoint_signals{};
+// Numbers the nx2:syncpt sessions (the frame fence's slot key is (session << 32) | slot).
+inline std::atomic<u32> g_nx2_syncpt_sessions{};
+
+/// The back signals syncpoint `id`, whose stream position is then `new_value` (the guest value
+/// plus the increments EDEN_NX2_READBACK_WAIT still holds, plus this one; FenceManager::
+/// SignalSyncPoint, before the increment; only called while the clock is wanted). `exact` false:
+/// the position is not known (a signal off the back while increments are held).
+inline void Nx2NoteSyncpointSignal(u32 id, u32 new_value, bool exact = true) {
+    if (!g_nx2_render_clock_wanted.load(std::memory_order_relaxed) ||
+        id >= Nx2SyncpointSignalSlots) {
+        return;
+    }
+    g_nx2_syncpoint_signals[id].fetch_add(1, std::memory_order_relaxed);
+    if (const int override_id = Nx2RenderClockSyncpt(); override_id >= 0) {
+        if (static_cast<int>(id) == override_id) {
+            Nx2BumpRenderFrame(exact);
+        }
+        return;
+    }
+    // Before the syncpoint check (seq_cst both): a flip that learns this syncpoint now either sees
+    // this position or is seen by the check below (NoteFlip).
+    g_nx2_frame_fence.NoteStream(id, new_value);
+    if (id == g_nx2_frame_fence.syncpoint.load(std::memory_order_seq_cst)) {
+        if (!exact) {
+            g_nx2_render_clock_lost.store(true, std::memory_order_relaxed);
+        }
+        if (const auto signal = g_nx2_frame_fence.NoteSignal(new_value); signal.bump) {
+            Nx2BumpRenderFrame(exact && signal.exact);
+        }
+    }
+}
+
 } // namespace Tegra
diff --git a/src/video_core/nx2_frame_fence.h b/src/video_core/nx2_frame_fence.h
new file mode 100644
index 0000000..7fc1007
--- /dev/null
+++ b/src/video_core/nx2_frame_fence.h
@@ -0,0 +1,371 @@
+// SPDX-FileCopyrightText: Copyright 2026 Eden Emulator Project
+// SPDX-License-Identifier: GPL-3.0-or-later
+
+#pragma once
+
+#include <algorithm>
+#include <array>
+#include <atomic>
+#include <cstddef>
+#include <mutex>
+
+#include "common/common_types.h"
+
+namespace Tegra {
+
+/// The flip-fence source (fable_answer_17 2). The flip names the frame's end: guest syncpoint
+/// `id` reaching `value` (the last submit of the frame on the presenting queue). It is known late
+/// (2-3 ms into the next frame), but the guest driver arms a wait on the same (id, value) through
+/// nx2:syncpt TIPC 201 earlier, on one slot it reuses. The first flip whose (id, value) was armed
+/// names that slot; from then on each arm on it is the next boundary, and the back bumps the
+/// clock when it signals the syncpoint up to that value. A flip that comes before the back got
+/// there is a boundary too (exact, it is the frame's own fence). Every flip confirms:
+/// - equal: an armed value bumped (or about to) on exactly the flip's value;
+/// - ahead: the flip came first and the back bumps on its value (no arm needed);
+/// - late: the back passed the flip's value with no bump on it, bumped at the flip (as today, a
+///   late boundary only refuses relocations). Not bumped again when a later armed value already
+///   bumped (that would split the frame the back is in), counted as merged;
+/// - early: an armed value bumped that no flip carried, found when a later flip passes it. That
+///   is the dangerous direction (a frame split in two), so the first one turns the armed source
+///   off for the session and only flips bump from then on. A bump above the flip's value is not
+///   early by itself: the next frame's arm can be reached before this flip arrives, and the next
+///   flip decides.
+/// Guards on an arm: it must be the largest value armed on the syncpoint so far (by any slot),
+/// above the last flip's value, and not reached yet. Locked: arms and flips run on guest threads,
+/// signals on the GPU thread (only those of the frame syncpoint take the lock).
+/// Exact bumps (relocate review, 2026-11-09): a bump at the signal that reaches the value is exact.
+/// One for a value the back passed earlier (it was learned too late) and a late flip's bump are
+/// not: the caller marks them, and relocation waits for the next exact one. The back's position
+/// is its stream value (held EDEN_NX2_READBACK_WAIT increments counted, FenceManager), and a flip
+/// that learns the syncpoint starts from the back's latest position on it (NoteStream), so the
+/// first boundary after a learn is not judged ahead of a value the back already passed.
+class Nx2FrameFenceClock {
+public:
+    struct Window {
+        u32 syncpoint{~0U};
+        u64 slot_key{~0ULL}; ///< (nx2:syncpt session << 32) | slot, ~0 while none
+        bool fault{};
+        u32 flips{}, equal{}, ahead{}, late{}, merged{}, early{}, repeats{};
+        u32 bumps_armed{}, bumps_flip{}, bumps_late{};
+        u32 bumps_passed{}; ///< Bumps at a signal past every value bumped on (inexact)
+        u32 refused_old{}, refused_not_largest{}, refused_reached{}, dropped{}, held{};
+        u32 relearns{};
+    };
+    struct SignalEvents {
+        bool bump{};
+        bool exact{}; ///< A value bumped on is this signal's own (else it was passed earlier)
+    };
+    struct FlipEvents {
+        bool syncpoint_learned{};
+        bool slot_learned{};
+        bool slot_relearned{};
+        bool fault{};
+        bool bump{};
+        u64 slot_key{};
+        u32 early_value{};
+    };
+
+    /// The frame-fence syncpoint (from the flips), ~0 while none: the back's hook reads it
+    /// without the lock.
+    std::atomic<u32> syncpoint{~0U};
+
+    /// The back's stream position of every syncpoint at its latest signal while the clock is
+    /// wanted, bit 32 set once written (Nx2NoteSyncpointSignal, before it reads `syncpoint`).
+    static constexpr size_t StreamSlots = 192;
+    std::array<std::atomic<u64>, StreamSlots> streams{};
+    void NoteStream(u32 id, u32 value) {
+        if (id < StreamSlots) {
+            streams[id].store((u64{1} << 32) | value, std::memory_order_seq_cst);
+        }
+    }
+
+    /// nx2:syncpt TIPC 201: `key` is (session << 32) | slot; `guest_value` the syncpoint's value
+    /// now.
+    void NoteArm(u64 key, u32 id, u32 value, u32 guest_value) {
+        std::scoped_lock lk{mutex};
+        arms[arm_next] = {key, id, value};
+        arm_next = (arm_next + 1) % arms.size();
+        arm_count = (std::min)(arm_count + 1, arms.size());
+        if (!have_syncpoint || id != frame_syncpoint) {
+            return;
+        }
+        See(guest_value);
+        const bool largest = !have_high || !After(high, value);
+        if (!have_high || After(value, high)) {
+            high = value;
+            have_high = true;
+        }
+        if (!have_slot || key != slot_key || fault) {
+            return;
+        }
+        if (have_flip && !After(value, last_flip)) {
+            ++window.refused_old;
+        } else if (!largest) {
+            ++window.refused_not_largest;
+        } else if (!After(value, last_seen)) {
+            ++window.refused_reached;
+        } else if (FindCandidate(value) == candidate_count && candidate_count < candidates.size()) {
+            candidates[candidate_count++] = {value, true, false};
+        }
+    }
+
+    /// The back signals the frame syncpoint up to `new_value`, its stream position (before the
+    /// increment, so a flip woken by it already sees the bump). bump: the clock bumps; exact: on
+    /// this signal's own value. Several values bumped together are one boundary (frames merge,
+    /// the safe direction), exact when one of them is this signal's.
+    [[nodiscard]] SignalEvents NoteSignal(u32 new_value) {
+        SignalEvents events{};
+        {
+            std::scoped_lock lk{mutex};
+            last_seen = new_value;
+            for (size_t i = 0; i < candidate_count;) {
+                const Candidate candidate = candidates[i];
+                if (After(candidate.value, new_value)) {
+                    ++i;
+                    continue;
+                }
+                RemoveCandidate(i);
+                bool bumps = false;
+                if (candidate.carried) {
+                    bumps = true;
+                    ++(candidate.armed ? window.bumps_armed : window.bumps_flip);
+                } else if (!fault && unconfirmed_count < unconfirmed.size() &&
+                           (!have_flip || After(candidate.value, last_flip))) {
+                    unconfirmed[unconfirmed_count++] = candidate.value;
+                    bumps = true;
+                    ++window.bumps_armed;
+                } else {
+                    ++window.held;
+                }
+                if (bumps) {
+                    events.bump = true;
+                    events.exact |= candidate.value == new_value;
+                }
+            }
+            if (events.bump && !events.exact) {
+                ++window.bumps_passed;
+            }
+        }
+        return events;
+    }
+
+    /// The flip (the present), with the guest syncpoint's value now. events.bump: the clock
+    /// bumps now (late).
+    FlipEvents NoteFlip(u32 id, u32 value, u32 guest_value) {
+        FlipEvents events{};
+        bool& bump = events.bump;
+        {
+            std::scoped_lock lk{mutex};
+            if (!have_syncpoint || id != frame_syncpoint) {
+                // First flip, or the game presents from another queue: start over on it.
+                Restart();
+                frame_syncpoint = id;
+                have_syncpoint = true;
+                last_seen = guest_value;
+                syncpoint.store(id, std::memory_order_seq_cst);
+                // The back's position on it (held increments counted): the guest value can lag
+                // it. Read after the store above (see NoteStream).
+                if (id < StreamSlots) {
+                    if (const u64 stream = streams[id].load(std::memory_order_seq_cst);
+                        (stream >> 32) != 0) {
+                        See(static_cast<u32>(stream));
+                    }
+                }
+                events.syncpoint_learned = true;
+            }
+            See(guest_value);
+            // Which slot armed this value, newest first.
+            bool slot_armed = false;
+            bool other_found = false;
+            u64 other_key{};
+            for (size_t n = 0; n < arm_count; ++n) {
+                const Arm& arm = arms[(arm_next + arms.size() - 1 - n) % arms.size()];
+                if (arm.syncpoint != id || arm.value != value) {
+                    continue;
+                }
+                if (have_slot && arm.key == slot_key) {
+                    slot_armed = true;
+                    break;
+                }
+                if (!other_found) {
+                    other_found = true;
+                    other_key = arm.key;
+                }
+            }
+            if (!slot_armed && other_found) {
+                if (have_slot) {
+                    events.slot_relearned = true;
+                    ++window.relearns;
+                    DropArmedCandidates(nullptr);
+                } else {
+                    events.slot_learned = true;
+                }
+                slot_key = other_key;
+                have_slot = true;
+                events.slot_key = other_key;
+            }
+            if (have_flip && !After(value, last_flip)) {
+                ++window.repeats;
+                return events;
+            }
+            ++window.flips;
+            bool later_bumped = false;
+            for (size_t i = 0; i < unconfirmed_count; ++i) {
+                later_bumped |= After(unconfirmed[i], value);
+            }
+            if (const size_t at = FindUnconfirmed(value); at != unconfirmed_count) {
+                RemoveUnconfirmed(at);
+                ++window.equal;
+            } else if (const size_t c = FindCandidate(value); c != candidate_count) {
+                candidates[c].carried = true;
+                ++(candidates[c].armed ? window.equal : window.ahead);
+            } else if (!After(value, last_seen)) {
+                ++window.late;
+                if (later_bumped) {
+                    ++window.merged;
+                } else {
+                    bump = true;
+                    ++window.bumps_late;
+                }
+            } else if (candidate_count < candidates.size()) {
+                candidates[candidate_count++] = {value, false, true};
+                ++window.ahead;
+            } else {
+                ++window.held; // no room: no boundary for it (frames merge, the safe direction)
+            }
+            // Armed bumps below this flip that no flip carried were not frame ends.
+            for (size_t i = 0; i < unconfirmed_count;) {
+                if (After(value, unconfirmed[i])) {
+                    ++window.early;
+                    events.early_value = unconfirmed[i];
+                    RemoveUnconfirmed(i);
+                    if (!fault) {
+                        fault = true;
+                        events.fault = true;
+                    }
+                } else {
+                    ++i;
+                }
+            }
+            // Armed values below this flip are not frame ends either: drop them before they bump.
+            DropArmedCandidates(&value);
+            if (fault) {
+                DropArmedCandidates(nullptr);
+            }
+            last_flip = value;
+            have_flip = true;
+        }
+        return events;
+    }
+
+    /// The clock was off (the hook and the notes stop with it): values pending from before would
+    /// be judged against flips nobody noted, so drop them. The syncpoint and the slot stay.
+    void Resume() {
+        std::scoped_lock lk{mutex};
+        have_flip = have_high = false;
+        candidate_count = unconfirmed_count = 0;
+    }
+
+    /// The counters since the last call (TextureCache::TickRenderClock, every 600 frames).
+    Window TakeWindow() {
+        std::scoped_lock lk{mutex};
+        Window taken = window;
+        taken.syncpoint = have_syncpoint ? frame_syncpoint : ~0U;
+        taken.slot_key = have_slot ? slot_key : ~0ULL;
+        taken.fault = fault;
+        window = {};
+        return taken;
+    }
+
+private:
+    struct Candidate {
+        u32 value;
+        bool armed;   ///< From the learned slot's arm, else from a flip
+        bool carried; ///< A flip carried this value
+    };
+    struct Arm {
+        u64 key;
+        u32 syncpoint;
+        u32 value;
+    };
+
+    /// Wrapping compare: a is after b.
+    static bool After(u32 a, u32 b) {
+        return static_cast<s32>(a - b) > 0;
+    }
+
+    /// The hook keeps last_seen exact while it runs; this catches it up after a stretch without
+    /// it (the clock not wanted, EXP43 switched live). The guest value may lag the hook by one
+    /// increment (the hook runs before it), so it only ever moves last_seen forward.
+    void See(u32 guest_value) {
+        if (After(guest_value, last_seen)) {
+            last_seen = guest_value;
+        }
+    }
+
+    /// Forgets the syncpoint, the slot and the pending values (the counters, the arms seen and
+    /// a fault stay).
+    void Restart() {
+        have_syncpoint = have_slot = have_flip = have_high = false;
+        frame_syncpoint = last_flip = last_seen = high = 0;
+        slot_key = 0;
+        candidate_count = unconfirmed_count = 0;
+    }
+
+    size_t FindCandidate(u32 value) const {
+        size_t i = 0;
+        while (i < candidate_count && candidates[i].value != value) {
+            ++i;
+        }
+        return i;
+    }
+    void RemoveCandidate(size_t i) {
+        candidates[i] = candidates[--candidate_count];
+    }
+    size_t FindUnconfirmed(u32 value) const {
+        size_t i = 0;
+        while (i < unconfirmed_count && unconfirmed[i] != value) {
+            ++i;
+        }
+        return i;
+    }
+    void RemoveUnconfirmed(size_t i) {
+        unconfirmed[i] = unconfirmed[--unconfirmed_count];
+    }
+    /// Drops armed values no flip carried, all of them or those before *below.
+    void DropArmedCandidates(const u32* below) {
+        for (size_t i = 0; i < candidate_count;) {
+            const Candidate& candidate = candidates[i];
+            if (candidate.armed && !candidate.carried &&
+                (below == nullptr || After(*below, candidate.value))) {
+                ++window.dropped;
+                RemoveCandidate(i);
+            } else {
+                ++i;
+            }
+        }
+    }
+
+    std::mutex mutex;
+    u32 frame_syncpoint{};
+    bool have_syncpoint{};
+    u64 slot_key{};
+    bool have_slot{};
+    u32 last_flip{};
+    bool have_flip{};
+    u32 last_seen{}; ///< The back's value of the frame syncpoint, as the hook last saw it
+    u32 high{};      ///< The largest value armed on the frame syncpoint, by any slot
+    bool have_high{};
+    bool fault{};
+    std::array<Candidate, 32> candidates{};
+    size_t candidate_count{};
+    std::array<u32, 16> unconfirmed{}; ///< Armed values bumped that no flip carried yet
+    size_t unconfirmed_count{};
+    std::array<Arm, 64> arms{}; ///< The latest arms on any slot, to find the flip's slot
+    size_t arm_next{};
+    size_t arm_count{};
+    Window window{};
+};
+inline Nx2FrameFenceClock g_nx2_frame_fence;
+
+} // namespace Tegra
