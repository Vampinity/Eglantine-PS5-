+/// EDEN_TEST_DISCARD_SAVE=1 (exact "1"). A TEST switch, never for play: nothing the game saves
+/// in such a session is kept. The game works on a copy of its save: the first time one of the
+/// user's saves (an account or device save of the user space) is opened or created, its folder is
+/// copied to /test-discard<the same path> under the same root, and every open, create and size
+/// file of that save goes to the copy for the rest of the session. The copy is thrown away and
+/// made anew at the next start. So the save a session started from is still there afterwards,
+/// and a test runner need not put it back after every run. The game reads back what it wrote
+/// as usual, which a switch that dropped the writes could not give it.
+bool DiscardSave() {
+    static const bool enabled = Common::PeSwitch("EDEN_TEST_DISCARD_SAVE");
+    return enabled;
+}
+
+/// Where a save's files live this session: `path`, or with EDEN_TEST_DISCARD_SAVE its copy.
+std::string SessionSavePath(const VirtualDir& dir, SaveDataSpaceId space, SaveDataType type,
+                            std::string path) {
+    if (!DiscardSave() || space != SaveDataSpaceId::User ||
+        (type != SaveDataType::Account && type != SaveDataType::Device)) {
+        return path;
+    }
+    static std::mutex mutex;
+    static std::set<std::string> copied; // the saves this session has its copy of
+    std::scoped_lock lock{mutex};
+    std::string copy = "/test-discard" + path;
+    if (!copied.insert(path).second) {
+        return copy;
+    }
+    // Last session's copy goes, then the save as it is now is copied (when there is one).
+    const auto slash = copy.find_last_of('/');
+    if (const auto parent = dir->GetDirectoryRelative(copy.substr(0, slash)); parent != nullptr) {
+        parent->DeleteSubdirectoryRecursive(copy.substr(slash + 1));
+    }
+    const auto original = dir->GetDirectoryRelative(path);
+    bool made = true;
+    if (original != nullptr) {
+        const auto target = dir->CreateDirectoryRelative(copy);
+        made = target != nullptr && VfsRawCopyD(original, target);
+    }
+    // A failed copy still keeps the session off the real save: the game then sees a save that
+    // is missing or incomplete, and the line below says so.
+    LOG_WARNING(Service_FS,
+                "EDEN_TEST_DISCARD_SAVE: this session's save is the copy {} ({}); the save at {} "
+                "is not written to",
+                copy, original == nullptr ? "no save yet" : made ? "copied" : "THE COPY FAILED",
+                path);
+    return copy;
+}
+
 } // Anonymous namespace
 
