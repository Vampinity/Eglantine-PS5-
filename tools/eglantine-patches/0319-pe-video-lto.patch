From e1041c642773b17600509c39c3ac64fd0e6e4ae8 Mon Sep 17 00:00:00 2001
From: EglantinePS5 <noreply@eglantineps5.local>
Date: Sun, 8 Nov 2026 05:00:53 +0100
Subject: [PATCH] pe: video-lto

---
 src/video_core/CMakeLists.txt | 10 ++++++++++
 1 file changed, 10 insertions(+)

diff --git a/src/video_core/CMakeLists.txt b/src/video_core/CMakeLists.txt
index 6a39893..0bebec8 100644
--- a/src/video_core/CMakeLists.txt
+++ b/src/video_core/CMakeLists.txt
@@ -537,3 +537,13 @@ if (ENABLE_NVIDIA_DLSS)
 endif()
 
 create_target_directory_groups(video_core)
+
+# ProsperoEden / heydemoura G3: video_core only; fiber-owning core stays outside LTO.
+if(PS5_NATIVE AND "$ENV{EDEN_PE_VIDEO_LTO}" STREQUAL "1")
+    if(CMAKE_CXX_COMPILER_ID MATCHES "Clang")
+        target_compile_options(video_core PRIVATE -flto=thin -march=znver2)
+        target_link_options(video_core INTERFACE -flto=thin)
+    else()
+        message(FATAL_ERROR "EDEN_PE_VIDEO_LTO requires a Clang thin-LTO toolchain")
+    endif()
+endif()
-- 
