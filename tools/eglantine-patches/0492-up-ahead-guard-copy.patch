+
+/// Consecutive pages of a sorted list as device ranges.
+template <class Keep>
+void RunsOf(const std::vector<u32>& pages, std::vector<State::Run>& runs, Keep&& keep) {
+    runs.clear();
+    for (size_t i = 0; i < pages.size();) {
+        if (!keep(pages[i])) {
+            ++i;
+            continue;
+        }
+        size_t end = i + 1;
+        while (end < pages.size() && pages[end] == pages[end - 1] + 1 && keep(pages[end])) {
+            ++end;
+        }
+        runs.emplace_back(u64{pages[i]} << PageBits, static_cast<size_t>(end - i) << PageBits);
+        i = end;
+    }
+}
+
+inline u32 FindCopy(const State& s, u64 page) {
+    if (s.copies_used == 0 || s.copy_index.empty()) {
+        return NoSlot;
+    }
+    const size_t mask = s.copy_index.size() - 1;
+    for (size_t at = (page * 0x9E3779B97F4A7C15ULL >> 40) & mask;; at = (at + 1) & mask) {
+        const u32 entry = s.copy_index[at];
+        if (entry == 0) {
+            return NoSlot;
+        }
+        if (s.copy_page[entry - 1] == page) {
+            return entry - 1;
+        }
+    }
+}
