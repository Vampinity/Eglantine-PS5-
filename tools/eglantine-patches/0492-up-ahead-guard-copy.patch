+/// Copy mode: a guest thread is about to write guarded pages. Each is copied as it is now, loses
+/// its guard (and its trap: later writes to it are ordinary ones) and the write may go on. False:
+/// the pool is full, the writer must wait instead (HoldWriter).
+template <class DeviceMemory>
+bool CopyBeforeWrite(u64 device_addr, u64 size, DeviceMemory& device_memory) {
+    constexpr u64 limit = u64{1} << AddressBits;
+    if (size == 0 || device_addr >= limit) {
+        return true;
+    }
+    State& s = Get();
+    const u64 last = ((std::min)(device_addr + size, limit) - 1) >> PageBits;
+    std::scoped_lock lk{s.mutex};
+    if (!s.active.load(std::memory_order_relaxed)) {
+        return true;
+    }
+    for (u64 page = device_addr >> PageBits; page <= last; ++page) {
+        if (!Detail::GuardedBit(s, page)) {
+            continue;
+        }
+        const u32 capacity = CopyCapacity();
+        if (s.copies_used == capacity) {
+            ++s.stats.pool_full;
+            return false;
+        }
+        if (!s.copy_bytes) {
+            s.copy_bytes.reset(new u8[u64{capacity} * PageSize]);
+            s.copy_page.assign(capacity, 0U);
+            size_t index_size = 256;
+            while (index_size < size_t{capacity} * 2) {
+                index_size *= 2;
+            }
+            s.copy_index.assign(index_size, 0U);
+        }
+        const u32 slot = s.copies_used++;
+        device_memory.ReadBlockUnsafe(page << PageBits, s.copy_bytes.get() + u64{slot} * PageSize,
+                                      PageSize);
+        s.copy_page[slot] = static_cast<u32>(page);
+        const size_t mask = s.copy_index.size() - 1;
+        size_t at = (page * 0x9E3779B97F4A7C15ULL >> 40) & mask;
+        while (s.copy_index[at] != 0) {
+            at = (at + 1) & mask;
+        }
+        s.copy_index[at] = slot + 1;
+        s.guarded[page / 64].fetch_and(~(u64{1} << (page % 64)), std::memory_order_relaxed);
+        device_memory.UpdatePagesCachedCount(page << PageBits, PageSize, -1);
+        ++s.stats.copies;
+    }
+    return true;
+}
+
+/// Copy mode: the GPU thread's read of guest memory for a buffer. Bytes of a page copied for the
+/// frame in flight come from its copy, the rest through `live(address, out, size)`. Under the
+/// guard's lock, which a guest thread's CopyBeforeWrite takes before its write goes on: a read
+/// sees a page either whole as presented or from its copy. `upload`: the bytes go into a host
+/// buffer that the buffer cache then takes for memory's; what came from a copy is noted, and
+/// handed to a gather as a guest write once the guard is lifted (TakeRedirty).
+template <class Live>
+void Read(u64 device_addr, u8* out, u64 size, bool upload, Live&& live) {
+    State& s = Get();
+    std::scoped_lock lk{s.mutex};
+    if (s.copies_used == 0) {
+        live(device_addr, out, size);
+        return;
+    }
+    const u64 end = device_addr + size;
+    for (u64 at = device_addr; at < end;) {
+        const u64 page = at >> PageBits;
+        u64 piece_end = (std::min)(end, (page + 1) << PageBits);
+        const u32 slot = page < PageLimit ? Detail::FindCopy(s, page) : NoSlot;
+        if (slot != NoSlot) {
+            std::memcpy(out + (at - device_addr),
+                        s.copy_bytes.get() + u64{slot} * PageSize + (at & (PageSize - 1)),
+                        piece_end - at);
+            ++s.stats.copy_reads;
+            s.stats.copy_read_bytes += piece_end - at;
+            if (upload) {
+                s.served.emplace_back(at, static_cast<u32>(piece_end - at));
+            }
+        } else {
+            // On over the pages after it that have no copy either.
+            while (piece_end < end && (piece_end >> PageBits) < PageLimit &&
+                   Detail::FindCopy(s, piece_end >> PageBits) == NoSlot) {
+                piece_end = (std::min)(end, ((piece_end >> PageBits) + 1) << PageBits);
+            }
+            live(at, out + (at - device_addr), piece_end - at);
+        }
+        at = piece_end;
+    }
+}
+
+/// Copy mode: the ranges uploads read from copies in guards lifted since the last call, as guest
+/// writes (`write(device_addr, size)`) for the gather that applies them: a buffer uploaded from
+/// a copy holds the presented frame's bytes, and memory has the newer ones. Only those ranges:
+/// an upload range is the guest's (GPU-written bytes are left out of uploads), a whole page may
+/// not be.
+template <class Write>
+void TakeRedirty(Write&& write) {
+    if (!Enabled()) {
+        return;
+    }
+    State& s = Get();
+    if (!s.redirty_ready.load(std::memory_order_acquire)) {
+        return;
+    }
+    std::vector<std::pair<u64, u32>> ranges;
+    {
+        std::scoped_lock lk{s.mutex};
+        ranges.swap(s.redirty);
+        s.redirty_ready.store(false, std::memory_order_release);
+    }
+    for (const auto& [address, bytes] : ranges) {
+        write(address, static_cast<size_t>(bytes));
+    }
+}
+
