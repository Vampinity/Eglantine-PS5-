+                // =1: the write waits below.
+                const bool copy = VideoCommon::AheadGuard::Mode() == 2;
                 gpu_device_memory->ApplyOpOnPointer(p, scratch_buffers[core], [&](DAddr address) {
-                    if (!guarded && VideoCommon::AheadGuard::Guarded(address, size)) {
