     }
@@ -322,6 +328,7 @@ bool GpuSplit::WritePending(u64 key) {
 
 void GpuSplit::Drain() {
     sync_pending = false;
+    CloseRegs();
     consumed_cache = consumed.load(std::memory_order_acquire);
     if (consumed_cache == write_position && BackQuiet()) {
         return;
@@ -641,6 +648,24 @@ size_t GpuSplit::Execute(const u64* entry, size_t words) {
                                 amount, static_cast<u32>(entry[1]));
         return data + (amount + 1) / 2;
     }
+    case Kind::Regs: {
+        const u32 count = static_cast<u32>((head >> 8) & 0xff);
+        auto* const engine = back_engine;
+        Nx2Profile::Scope method_scope{Nx2Profile::Zone::Method};
+        for (u32 i = 0; i < count; ++i) {
+            engine->method_sink.emplace_back(static_cast<u32>(entry[1 + i]), static_cast<u32>(entry[1 + i] >> 32));
