+void PinCurrentThread(PinnedRole role) {
+#ifdef _WIN32
+    // Ocarina uses six guest workers on the PS5's eight physical Zen 2 cores. Reserve the last
+    // two physical cores for the split GPU front and back; the guest mask never contains them.
+    static const std::vector<KAFFINITY> cores = [] {
+        DWORD length = 0;
+        GetLogicalProcessorInformationEx(RelationProcessorCore, nullptr, &length);
+        std::vector<u8> buffer(length);
+        std::vector<KAFFINITY> result;
+        if (length == 0 ||
+            !GetLogicalProcessorInformationEx(
+                RelationProcessorCore,
+                reinterpret_cast<SYSTEM_LOGICAL_PROCESSOR_INFORMATION_EX*>(buffer.data()), &length)) {
+            return result;
+        }
+        for (DWORD offset = 0; offset + sizeof(SYSTEM_LOGICAL_PROCESSOR_INFORMATION_EX) <= length;) {
+            const auto* const entry = reinterpret_cast<const SYSTEM_LOGICAL_PROCESSOR_INFORMATION_EX*>(
+                buffer.data() + offset);
+            if (entry->Size == 0) {
+                break;
+            }
+            if (entry->Relationship == RelationProcessorCore && entry->Processor.GroupCount != 0 &&
+                entry->Processor.GroupMask[0].Group == 0) {
+                result.push_back(entry->Processor.GroupMask[0].Mask);
+            }
+            offset += entry->Size;
+        }
+        return result;
+    }();
+    const char* const setting = std::getenv("EDEN_NX2_PIN_THREADS");
+    if ((setting != nullptr && setting[0] == '0') || cores.size() < 8) {
+        return;
+    }
+    const size_t split_core = cores.size() - 2;
+    KAFFINITY mask{};
+    switch (role) {
+    case PinnedRole::GpuFront:
+        mask = cores[split_core];
+        break;
+    case PinnedRole::GpuBack:
+        mask = cores[split_core + 1];
+        break;
+    case PinnedRole::GuestCore:
+        for (size_t i = 0; i < split_core; ++i) {
+            mask |= cores[i];
+        }
+        break;
+    }
+    if (mask != 0) {
+        SetThreadAffinityMask(GetCurrentThread(), mask);
+    }
+#else
+    (void)role;
+#endif
+}
+
 void SetCurrentThreadToPerformanceCores() {
 #if defined(__ANDROID__)
     if (ADPF::AddCurrentThread(ADPF::Session::Render)) {
