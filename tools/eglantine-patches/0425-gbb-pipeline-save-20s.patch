     return device.IsMoltenVK() ? UsedPipelinesMaxAgeMoltenVK : UsedPipelinesMaxAge;
 }
 
+// EDEN_GBB_PIPELINE_SAVE_20S=1 (GrowingBlackBeans gist 9998, adapted): the used list is saved
+// at most every 20 s while it grows instead of every 2 minutes, and its last additions also when
+// no new pipeline follows them (TickFrame checks every 30 frames). A session quit from the PS menu
+// has no clean exit, so what it used after its last save was left out: each session built the
+// walk's ~300 pipelines on the GPU thread again (gist runs 43/50: ~390 builds during play, 76
+// with 20 s saves). What counts as a session is unchanged: a save less than 2 minutes after the
+// list loaded (the old first save) keeps the earlier sessions' ages, so a run that ends before
+// then ages nothing, as before. The list is gathered on the GPU thread, which owns graphics_cache
+// and the used sets, as the old save did; the file (8 bytes + 9 per hash, ~30 KB for two sessions
+// of ~1,500) is written on the serialization thread, beside the list and renamed over it, so a
+// kill mid-write keeps the previous list. The exit save stays synchronous.
+bool PipelineSave20s() {
+    static const bool on = Common::PeSwitch("EDEN_GBB_PIPELINE_SAVE_20S");
+    return on;
+}
+constexpr std::chrono::seconds UsedPipelinesSaveInterval{20};
+
+void WriteUsedPipelinesFile(const std::filesystem::path& path, const std::vector<char>& data) try {
+    auto partial = path;
+    partial += ".part";
+    std::error_code error;
+    {
+        std::ofstream file{partial, std::ios::binary | std::ios::trunc};
+        if (!file.write(data.data(), static_cast<std::streamsize>(data.size())) || !file.flush()) {
+            LOG_WARNING(Render_Vulkan, "Failed to write {}", Common::FS::PathToUTF8String(partial));
+            file.close();
+            std::filesystem::remove(partial, error);
+            return;
+        }
+    }
+    std::filesystem::rename(partial, path, error);
+    if (error) {
+        LOG_WARNING(Render_Vulkan, "Failed to replace {}: {}", Common::FS::PathToUTF8String(path),
+                    error.message());
+        std::filesystem::remove(partial, error);
+    }
+} catch (const std::exception& e) {
+    // On the serialization thread an escaped exception would end the emulator: keep the old list.
+    LOG_WARNING(Render_Vulkan, "Used pipeline list not saved: {}", e.what());
+}
+
 std::unordered_map<u64, u8> LoadUsedPipelines(const std::filesystem::path& path, u8 max_age) {
     std::unordered_map<u64, u8> used;
     std::ifstream file{path, std::ios::binary};
