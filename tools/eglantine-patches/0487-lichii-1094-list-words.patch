+void GpuSplit::ReportL1094() {
+    // MaybeStart runs once per GPU thread loop: read the clock every 256th call only.
+    if (++l1094_report_calls % 256 != 0) {
+        return;
+    }
+    const u64 now = WaitClockNs();
+    if (l1094_window_start == 0) {
+        l1094_window_start = now;
+        return;
+    }
+    if (now - l1094_window_start < 10'000'000'000ULL) {
+        return;
+    }
+    l1094_window_start = now;
+    auto& stats = g_l1094_stats;
+    const auto take = [](std::atomic<u64>& counter) {
+        return counter.exchange(0, std::memory_order_relaxed);
+    };
+    const auto ms = [](u64 ns) { return static_cast<double>(ns) / 1e6; };
+    const u64 reads = take(stats.reads);
+    const u64 synced = take(stats.synced);
+    const u64 checked = take(stats.checked);
+    const u64 words = take(stats.words);
+    const u64 skipped = take(stats.skipped);
+    const u64 skip_waits = take(stats.skip_waits);
+    const double skip_wait_ms = ms(take(stats.skip_wait_ns));
+    const u64 skip_unknown = take(stats.skip_unknown);
+    const u64 copied = take(stats.copied);
+    const u64 copy_waits = take(stats.copy_waits);
+    const double copy_wait_ms = ms(take(stats.copy_wait_ns));
+    const u64 unknown = take(stats.unknown);
+    const u64 merged = take(stats.merged);
+    const u64 clears = take(stats.clears);
+    const u64 clears_missed = take(stats.clears_missed);
+    LOG_INFO(HW_GPU,
+             "Lichii #1094 in 10 s (EDEN_UP_L1094_LIST_WORDS={}, EDEN_UP_L1094_DMACLEAR={}): "
+             "lists on GPU-written command list pages {}: {} on pages guest memory holds whole, "
+             "{} checked by word ({} words): {} on no word GPU work wrote ({}: {} waited for "
+             "their copy ({:.1f} ms), {} without a current copy); copy path: {} copies ready, {} "
+             "copy waits ({:.1f} ms), {} without a current copy (drain and flush) or pending, {} "
+             "copy reads merged with guest memory; DMA clears {}: {} registered past the old "
+             "quarter check",
+             L1094ListWords() ? 1 : 0, L1094DmaClear() ? 1 : 0, reads, synced, checked, words,
+             skipped,
+             L1094ListWords() ? "read from guest memory"
+                              : "would read guest memory with LIST_WORDS; on the copy path now",
+             skip_waits, skip_wait_ms, skip_unknown, copied, copy_waits, copy_wait_ms, unknown,
+             merged, clears, clears_missed);
 }
 
