diff --git a/src/video_core/gpu_split_sites.h b/src/video_core/gpu_split_sites.h
new file mode 100644
index 0000000..be50e77
--- /dev/null
+++ b/src/video_core/gpu_split_sites.h
@@ -0,0 +1,50 @@
+// SPDX-FileCopyrightText: Copyright 2026 Eden Emulator Project
+// SPDX-License-Identifier: GPL-3.0-or-later
+
+#pragma once
+
+#include <array>
+#include <cstddef>
+
+#include "common/common_types.h"
+
+namespace VideoCommon {
+
+/// Why the split GPU thread's front waits for its back (gpu_split.h). EDEN_NX2_SPLIT_WAITS=1 logs
+/// the waits per site every 10 s; EDEN_NX2_GPU_PROFILE=1 adds them to the GPU thread's line.
+enum class DrainSite : u32 {
+    Other,
+    RingFull,      ///< The ring is full: over 8 MiB of work is queued
+    Acquire,       ///< Other semaphore acquires (non-Switch 2 acquires, DrainTo)
+    FenceRelease,  ///< The puller's acquires release the pending fences
+    SemExecute,    ///< A SEM_EXECUTE acquire
+    ListWriters,   ///< A command list entry waits for the dispatches and copies sent before it
+    ListFlush,     ///< Command lists on GPU-written pages: drain and flush the pages
+    MacroDmaRead,  ///< The front's macros read memory into the load FIFO (MME_DMA_READ_FIFOED)
+    Map,           ///< GPU memory maps before later command reads
+    FrontStart,    ///< The front takes an engine's macros over
+    FrontVerify,   ///< EDEN_NX2_SPLIT_VERIFY
+    AcquireCheck,  ///< The first read of a Switch 2 acquire's word (ProcessSemaphoreTriggerMethod)
+    AcquireRecheck, ///< Its second read, after the pending fences were released
+    AcquirePoll,   ///< A suspended channel's acquire polled (CanResumeAcquire)
+    ListGpuWritten, ///< A command list on a GPU-written page waits for its writers
+    ListFirstDrain, ///< EDEN_UP_SPLIT_FIRST_DRAIN: a new channel's first entries
+    MacroDmaReadRam, ///< The front's macros read memory into their data RAM (MME_DMA_READ)
+    DmaSnapshotMiss, ///< EDEN_NX2_DMA_SNAPSHOT: a macro read no snapshot covers
+    DmaSnapshotCheck, ///< EDEN_NX2_DMA_SNAPSHOT=2: a covered read checked against a drained one
+    DmaReadAhead,  ///< EDEN_PE_DMA_READ_AHEAD: a macro read that could not run ahead
+    MapOnBack,     ///< EDEN_NX2_MAP_ON_BACK: the map's own drain
+    Count,
+};
+
+inline constexpr std::array<const char*, static_cast<size_t>(DrainSite::Count)> drain_site_names{
+    "other",          "ring full",       "acquire",          "fence release",
+    "sem execute",    "list writers",    "list flush",       "macro dma read",
+    "map",            "front start",     "front verify",     "acquire check",
+    "acquire recheck", "acquire poll",   "list gpu-written", "list first drain",
+    "macro dma read ram", "dma snapshot miss", "dma snapshot check", "dma read ahead",
+    "map on back",
+};
+static_assert(drain_site_names.back() != nullptr, "a drain site without a name");
+
+} // namespace VideoCommon
