+// SPDX-License-Identifier: GPL-3.0-or-later
+#pragma once
+
+#include <cstdlib>
+
+namespace VideoCore::Nx2Debug {
+
+// PS5 port of Fritchii's EXP42/EXP43 switch. Final defaults are set by commit 1735a6fd1.
+inline int Experiment(int number) noexcept {
+    const char* name = number == 42 ? "EDEN_NX2_EXP42" :
+                       number == 43 ? "EDEN_NX2_EXP43" : nullptr;
+    const int default_value = number == 42 || number == 43 ? 0 : 0;
+    if (name == nullptr) {
+        return default_value;
+    }
+    const char* value = std::getenv(name);
+    return value != nullptr ? std::atoi(value) : default_value;
+}
+
+} // namespace VideoCore::Nx2Debug
