 }
 
+// EDEN_NX2_DMA_SNAPSHOT=1 (Frizti/Fritchii 8ac3666f7b, EvilOOT's dma-snapshot fix): macro DMA
+// reads of pages a drained read flushed whole skip the drain while nothing sent since may write
+// them (FrontDmaRead). =2 also drains, reads again and logs the differences (verify). Off unless
+// set. Read once at boot.
+int DmaSnapshotMode() {
+    static const int mode = [] {
+        const char* const value = std::getenv("EDEN_NX2_DMA_SNAPSHOT");
+        if (value == nullptr || value[0] == '0') {
+            return 0;
+        }
+        return value[0] == '2' ? 2 : 1;
+    }();
+    return mode;
+}
+
+// The 3D methods whose work on the back writes guest memory at an address the front can name.
+bool FrontWritesGuestMemory(u32 method) {
+    return method == MAXWELL3D_REG_INDEX(report_semaphore.query) ||
+           method == MAXWELL3D_REG_INDEX(launch_dma) ||
+           method == MAXWELL3D_REG_INDEX(inline_data);
+}
+
