From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: EglantinePS5 <noreply@eglantineps5.local>
Date: Sun, 8 Nov 2026 00:00:00 +0000
Subject: [PATCH] shader: unroll software HMMA K8 groups

Measured source: zortos293/Lichii PR #174 reduced an Ocarina DLSS-menu frame
from about 18 ms to 12.6 ms of GPU time on an RX 7900 XT. Unroll each K=8
group so its subgroup shuffles can overlap, but retain the K=16 loop to avoid
the register pressure regression measured for full unrolling.

Break risk: the software HMMA path defines Ocarina's image-filter arithmetic;
a bad lane or rounding change would show as wrong exposure, a corrupted
upscaled frame, or rejected/failed shader translation. The K=8 rounding point
and product order are retained, and this is limited to the software helper.

---
diff --git a/src/shader_recompiler/backend/spirv/emit_spirv_tensor.cpp b/src/shader_recompiler/backend/spirv/emit_spirv_tensor.cpp
index 16600e58b9..0804a14cdf 100644
--- a/src/shader_recompiler/backend/spirv/emit_spirv_tensor.cpp
+++ b/src/shader_recompiler/backend/spirv/emit_spirv_tensor.cpp
@@ -88,56 +88,56 @@ void DefineSoftwareMatrixFunctions(EmitContext& ctx, const IR::Program& program)
         const Id warp_base = and_(lane, ~31U);
         const Id row_base = and_(lane, 28);
         const Id col_base = ctx.OpShiftLeftLogical(u32ty, and_(lane, 3), imm(3));
-        const Id header = ctx.OpLabel(), body = ctx.OpLabel(), next = ctx.OpLabel(),
-                 end = ctx.OpLabel();
-        ctx.OpBranch(header);
-        ctx.AddLabel(header);
-        const Id pair = ctx.OpLoad(u32ty, counter);
-        const Id more = ctx.OpULessThan(ctx.U1, pair, imm(variant ? 8 : 4));
-        ctx.OpLoopMerge(end, next, spv::LoopControlMask::DontUnroll);
-        ctx.OpBranchConditional(more, body, end);
-        ctx.AddLabel(body);
-        const Id upper = ctx.OpUGreaterThanEqual(ctx.U1, pair, imm(4));
-        const Id component = and_(pair, 3);
-        const Id a_lane = add(warp_base, add(row_base, component));
-        const Id b_lane = add(warp_base, add(col_base, component));
-        const Id b = ctx.OpSelect(u32ty, upper, inputs[5], inputs[4]);
-        std::array<Id, 2> bs;
-        for (u32 col = 0; col < 2; ++col)
-            bs[col] =
-                unpack(ctx.OpGroupNonUniformShuffle(u32ty, imm(3), b, add(b_lane, imm(col * 4))));
-        const Id round_now = ctx.OpIEqual(ctx.U1, component, imm(3));
-        for (u32 row = 0; row < 2; ++row) {
-            const Id a = ctx.OpSelect(u32ty, upper, inputs[row + 2], inputs[row]);
-            const Id as = unpack(ctx.OpGroupNonUniformShuffle(u32ty, imm(3), a, a_lane));
-            for (u32 col = 0; col < 2; ++col) {
-                Id value = ctx.OpLoad(f32ty, accumulators[row * 2 + col]);
-                for (u32 half = 0; half < 2; ++half) {
-                    value = ctx.OpFma(f32ty, ctx.OpCompositeExtract(f32ty, as, half),
-                                      ctx.OpCompositeExtract(f32ty, bs[col], half), value);
-                    ctx.Decorate(value, spv::Decoration::NoContraction);
+        const Id a_base = add(warp_base, row_base);
+        const Id b_base = add(warp_base, col_base);
+        // Unrolling a K=8 group lets its shuffles overlap, which latency-bound small dispatches
+        // need; unrolling all of K=16 raises register pressure and slows large dispatches.
+        const auto emit_group = [&](auto pick) {
+            for (u32 component = 0; component < 4; ++component) {
+                const Id b = pick(inputs[4], inputs[5]);
+                std::array<Id, 2> bs;
+                for (u32 col = 0; col < 2; ++col)
+                    bs[col] = unpack(ctx.OpGroupNonUniformShuffle(
+                        u32ty, imm(3), b, add(b_base, imm(component + col * 4))));
+                for (u32 row = 0; row < 2; ++row) {
+                    const Id as = unpack(ctx.OpGroupNonUniformShuffle(
+                        u32ty, imm(3), pick(inputs[row], inputs[row + 2]),
+                        add(a_base, imm(component))));
+                    for (u32 col = 0; col < 2; ++col) {
+                        Id value = ctx.OpLoad(f32ty, accumulators[row * 2 + col]);
+                        for (u32 half = 0; half < 2; ++half) {
+                            value = ctx.OpFma(f32ty, ctx.OpCompositeExtract(f32ty, as, half),
+                                              ctx.OpCompositeExtract(f32ty, bs[col], half), value);
+                            ctx.Decorate(value, spv::Decoration::NoContraction);
+                        }
+                        ctx.OpStore(accumulators[row * 2 + col], value);
+                    }
                 }
-                ctx.OpStore(accumulators[row * 2 + col], value);
             }
+            // HMMA.F16 rounds after each K=8 group, including the midpoint of K=16.
+            for (const Id accumulator : accumulators)
+                ctx.OpStore(accumulator, round_half(ctx.OpLoad(f32ty, accumulator)));
+        };
+        if (variant == 0) {
+            emit_group([](Id low, Id) { return low; });
+        } else {
+            const Id header = ctx.OpLabel(), body = ctx.OpLabel(), next = ctx.OpLabel(),
+                     end = ctx.OpLabel();
+            ctx.OpBranch(header);
+            ctx.AddLabel(header);
+            const Id group = ctx.OpLoad(u32ty, counter);
+            const Id more = ctx.OpULessThan(ctx.U1, group, imm(2));
+            ctx.OpLoopMerge(end, next, spv::LoopControlMask::DontUnroll);
+            ctx.OpBranchConditional(more, body, end);
+            ctx.AddLabel(body);
+            const Id upper = ctx.OpIEqual(ctx.U1, group, imm(1));
+            emit_group([&](Id low, Id high) { return ctx.OpSelect(u32ty, upper, high, low); });
+            ctx.OpBranch(next);
+            ctx.AddLabel(next);
+            ctx.OpStore(counter, add(group, imm(1)));
+            ctx.OpBranch(header);
+            ctx.AddLabel(end);
         }
-        // HMMA.F16 rounds after each K=8 group, including the midpoint of K=16.
-        // OpSelect evaluates both operands: keep the expensive half conversion in
-        // a branch so the other three pairs do no rounding work. The counter is
-        // identical in every participating lane and all shuffles precede this branch.
-        const Id round_block = ctx.OpLabel(), round_merge = ctx.OpLabel();
-        ctx.OpSelectionMerge(round_merge, spv::SelectionControlMask::DontFlatten);
-        ctx.OpBranchConditional(round_now, round_block, round_merge);
-        ctx.AddLabel(round_block);
-        for (const Id accumulator : accumulators) {
-            ctx.OpStore(accumulator, round_half(ctx.OpLoad(f32ty, accumulator)));
-        }
-        ctx.OpBranch(round_merge);
-        ctx.AddLabel(round_merge);
-        ctx.OpBranch(next);
-        ctx.AddLabel(next);
-        ctx.OpStore(counter, add(pair, imm(1)));
-        ctx.OpBranch(header);
-        ctx.AddLabel(end);
         std::array<Id, 2> packed;
         for (u32 row = 0; row < 2; ++row)
             packed[row] = ctx.OpPackHalf2x16(
