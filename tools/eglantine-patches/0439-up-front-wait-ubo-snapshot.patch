+// EDEN_UP_UBO_SNAPSHOT (ubo_snapshot.h): `bytes` are what [gpu_addr, gpu_addr + bytes.size())
+// holds now. Written in place through an UnsafeReadWrite span, they reach neither WriteBlock nor
+// InvalidateRegion, the paths that copy GPU writes into the frame's constant buffer copies, so
+// they go there from here (a span that was a copy is written back with WriteBlockUnsafe as well,
+// which copies them again). Device memory in one piece goes in one call.
+void NoteInPlaceWriteForUboSnapshot(const Tegra::MemoryManager& gpu_memory, GPUVAddr gpu_addr,
+                                    std::span<const u8> bytes) {
+    DAddr run_device = 0;
+    size_t run_offset = 0;
+    size_t run_size = 0;
+    const auto flush = [&] {
+        if (run_size != 0) {
+            VideoCommon::UboSnapshot::OnGpuWrite(run_device, bytes.data() + run_offset, run_size);
+            run_size = 0;
+        }
+    };
+    for (size_t done = 0; done < bytes.size();) {
+        const GPUVAddr address = gpu_addr + done;
+        const size_t part = (std::min<size_t>)(
+            bytes.size() - done, Core::DEVICE_PAGESIZE - (address & Core::DEVICE_PAGEMASK));
+        const std::optional<DAddr> device = gpu_memory.GpuToCpuAddress(address);
+        if (!device) {
+            flush();
+        } else if (run_size != 0 && *device == run_device + run_size) {
+            run_size += part;
+        } else {
+            flush();
+            run_device = *device;
+            run_offset = done;
+            run_size = part;
+        }
+        done += part;
+    }
+    flush();
+}
