+
+#pragma once
+
+#include <cstddef>
+#include <optional>
+
+#include "common/common_types.h"
+#include "common/pe_switch.h"
+#include "video_core/host1x/gpu_device_memory_manager.h"
+
+// EDEN_UP_UBO_SNAPSHOT=1 (Ocarina, with EDEN_UP_OOT_FRONT_WAIT=1): one copy per frame of the
+// graphics constant buffers the frame binds, taken in the present once the split GPU thread's
+// front has parsed the frame (nx2_gsv.h PresentClientBuffer). The game is blocked there: every
+// write its CPU makes for frame N is done and none for N+1 has started. The back then reads frame
+// N's constant buffers from that copy (BufferCache::BindHostGraphicsUniformBuffer) instead of from
+// guest memory the game already rewrites for N+1 (dark one-frame flashes). Writes the GPU makes in
+// stream order after the copy (constant buffer data, inline uploads, DMA, downloads, reports) are
+// copied into it as well (OnGpuWrite). Ranges the copy lacks are read from guest memory as before.
+//
+// Threads: FrontBind on the front, Take on the present thread, Retire / NoteUsedSize / Probe /
+// Copy on the back, OnGpuWrite on any thread that writes guest memory for the GPU.
+namespace VideoCommon::UboSnapshot {
+
+/// EDEN_UP_UBO_SNAPSHOT=1. Unset: nothing here runs (every hook checks this cached switch first).
+[[nodiscard]] inline bool Enabled() noexcept {
+    static const bool enabled = Common::PeSwitch("EDEN_UP_UBO_SNAPSHOT");
+    return enabled;
+}
+
+/// Front: a 3D bind group write of `engine` (a Maxwell3D), as ProcessCBBind will run it on the
+/// back: slot `slot` of `stage` bound to `device` (empty when unmapped) with `size` bytes, or
+/// unbound when !valid.
+void FrontBind(const void* engine, u32 stage, u32 slot, bool valid, std::optional<u64> device,
+               u32 size);
+
+/// Back: the shader of (stage, slot) reads `size` bytes of its constant buffer. The copy takes
+/// that much of each binding (at most the bound size; 4 KiB while no draw said).
+void NoteUsedSize(size_t stage, u32 slot, u32 size);
+
+/// Present thread, game blocked in present `n`, front past the frame's fence: copies the ranges
+/// bound since the last copy, and those bound then and now. Skipped (counted) when the slot it
+/// would reuse is still read by the back; never waits.
+void Take(u64 n, Tegra::MaxwellDeviceMemoryManager& memory);
+
+/// Back, in order after every command list submitted before present `n` returned: frame n + 1
+/// reads begin, so copy n is done with.
+void Retire(u64 n);
+
+/// What the back read from the copy: which copy, and the last write the GPU made into the range.
+struct Hit {
+    u64 seq{};
+    u64 stamp{};
+};
+/// Back: whether the current frame's copy holds all of [device, device + size); fills `hit`.
+[[nodiscard]] bool Probe(u64 device, u32 size, Hit& hit);
+/// Back: Probe, then copies the bytes to `dest`.
+[[nodiscard]] bool Copy(u64 device, u32 size, void* dest, Hit& hit);
+
+/// Back: counts a bind served from the copy (`large`: streamed whole, `reused`: rebound).
+void NoteServed(bool large, bool reused);
+
+void OnGpuWriteImpl(u64 device, const void* source, size_t size);
+/// The GPU just wrote `size` bytes at `device` (already in guest memory): the live copies that
+/// hold any of them take them too.
+inline void OnGpuWrite(u64 device, const void* source, size_t size) {
+    if (Enabled()) [[unlikely]] {
+        OnGpuWriteImpl(device, source, size);
+    }
+}
+
+void OnGpuWriteInPlaceImpl(u64 device, size_t size, Tegra::MaxwellDeviceMemoryManager& memory);
+/// As OnGpuWrite for a write made in place (a span of guest memory written directly, as
+/// GuestMemoryScoped does): the bytes are read back from guest memory.
+inline void OnGpuWriteInPlace(u64 device, size_t size, Tegra::MaxwellDeviceMemoryManager& memory) {
+    if (Enabled()) [[unlikely]] {
+        OnGpuWriteInPlaceImpl(device, size, memory);
+    }
+}
+
+/// The split stopped: forgets every copy, the bind log and tables, and the back's frame.
+void Reset();
+
+} // namespace VideoCommon::UboSnapshot
