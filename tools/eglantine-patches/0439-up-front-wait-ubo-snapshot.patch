+template <class P>
+bool BufferCache<P>::BindSnapshotUniformBuffer(size_t stage, u32 index, u32 binding_index,
+                                               DAddr device_addr, u32 size) {
+    if constexpr (!IS_OPENGL && VideoCommon::StreamUniformReusable<Runtime>) {
+        using Reuse = VideoCommon::UniformStreamReuse<typename Runtime::StreamUniformRef>;
+        UboSnapshot::Hit hit;
+        if (size <= Reuse::MaxBytes) {
+            if (!UboSnapshot::Copy(device_addr, size, ubo_snapshot_scratch.data(), hit)) {
+                return false;
+            }
+            bool streamed = false;
+            if (VideoCommon::UniformStreamReuseEnabled()) {
+                streamed = VideoCommon::BindSmallUniformFromSource(
+                    runtime, stage, index, binding_index, ubo_snapshot_scratch.data(), size);
+            }
+            if (!streamed) {
+                const std::span<u8> span = runtime.BindMappedUniformBuffer(stage, binding_index, size);
+                std::memcpy(span.data(), ubo_snapshot_scratch.data(), size);
+            }
+            UboSnapshot::NoteServed(false, false);
+            return true;
+        }
+        // The 64 KiB native bank and mid-size buffers: streamed whole from the copy, once per
+        // command buffer while nothing changes, instead of the host buffer synchronized from
+        // guest memory (the bank re-mark and SynchronizeBuffer are skipped; tracking stays).
+        if (stage >= ubo_snapshot_reuse.size() || index >= ubo_snapshot_reuse[stage].size() ||
+            !UboSnapshot::Probe(device_addr, size, hit)) {
+            return false;
+        }
+        UboSnapshotReuse& reuse = ubo_snapshot_reuse[stage][index];
+        if (reuse.size == size && reuse.device_addr == device_addr && reuse.seq == hit.seq &&
+            reuse.stamp == hit.stamp && reuse.tick == runtime.CurrentTick()) {
+            runtime.RebindStreamUniform(reuse.ref, size);
+            UboSnapshot::NoteServed(true, true);
+            return true;
+        }
+        const std::span<u8> span = runtime.BindMappedUniformBuffer(stage, binding_index, size);
+        if (!UboSnapshot::Copy(device_addr, size, span.data(), hit)) {
+            // Only this thread retires copies, so the one Probe found is still there; but bound
+            // is bound: fill it from guest memory as the fast path does.
+            device_memory.ReadBlockUnsafe(device_addr, span.data(), size);
+            reuse.size = 0;
+            return true;
+        }
+        reuse.ref = runtime.LastStreamUniformRef();
+        reuse.device_addr = device_addr;
+        reuse.seq = hit.seq;
+        reuse.stamp = hit.stamp;
+        // After the allocation: the tick its stream region is tagged with.
+        reuse.tick = runtime.CurrentTick();
+        reuse.size = size;
+        UboSnapshot::NoteServed(true, false);
+        return true;
+    } else {
+        return false;
+    }
+}
