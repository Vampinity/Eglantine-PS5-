+    /// EDEN_UP_OOT_FRONT_WAIT: waits for the previous frame's fence (the back stays at most a
+    /// frame behind, as with no wait), then until the split GPU thread's front has parsed and
+    /// sent this frame's fence increments (GpuSplit::FrontReached). Gives up after 3 ms once a
+    /// channel was seen suspended (it may wait on a semaphore this thread releases later), after
+    /// 4 s, or when the split stops, and then waits for the fence itself. Logs per 600 presents.
+    void WaitForFrameFront(u32 fence_id, u32 fence_value) {
+        const auto start = std::chrono::steady_clock::now();
+        WaitForFrame(m_previous_fence_id, m_previous_fence_value);
+        const auto previous_done = std::chrono::steady_clock::now();
+        bool reached = true;
+        if (fence_id < 192) {
+            auto& syncpoints = system.Host1x().GetSyncpointManager();
+            auto& split = VideoCommon::GpuSplit::Get();
+            const auto deadline = previous_done + std::chrono::milliseconds{4000};
+            bool gpu_waited = false;
+            reached = split.WaitFrontReached(syncpoints, fence_id, fence_value, [&] {
+                if (!system.IsPoweredOn() || !split.FrontCountsIncrements()) {
+                    return false;
+                }
+                const auto now = std::chrono::steady_clock::now();
+                if (now >= deadline) {
+                    return false;
+                }
+                gpu_waited |= system.GPU().HasSuspendedChannels();
+                return !(gpu_waited && now - previous_done > std::chrono::milliseconds{3});
+            });
+            if (!reached) {
+                ++m_front_fallbacks;
+                WaitForFrame(fence_id, fence_value);
+            } else if (!syncpoints.IsReadyGuest(fence_id, fence_value)) {
+                ++m_front_ahead;
+            }
+        }
+        const auto returned = std::chrono::steady_clock::now();
+        using us = std::chrono::microseconds;
+        m_front_previous_us += std::chrono::duration_cast<us>(previous_done - start).count();
+        m_front_wait_us += std::chrono::duration_cast<us>(returned - previous_done).count();
+        if (++m_front_presents == 600) {
+            LOG_INFO(Service,
+                     "EDEN_UP_OOT_FRONT_WAIT: last 600 presents waited {} us for the previous "
+                     "frame's fence and {} us for the front; {} returned before the back reached "
+                     "the frame's fence, {} gave up on the front and waited for the fence",
+                     m_front_previous_us / 600, m_front_wait_us / 600, m_front_ahead,
+                     m_front_fallbacks);
+            m_front_presents = 0;
+            m_front_previous_us = 0;
+            m_front_wait_us = 0;
+            m_front_ahead = 0;
+            m_front_fallbacks = 0;
+        }
+    }
