+
+    // Present thread only.
+    std::vector<EngineTable> previous_tables; ///< The tables at the last copy
+    std::vector<EngineTable> current_tables;
+    std::vector<LogEntry> log_scratch;
+    std::vector<Range> ranges;
+    std::vector<Range> merged;
+    std::vector<Range> kept;
+    std::array<u64, BloomWords> next_bloom{};
+    u64 reported_at{};
+
+    Stats stats;
+};
+
+State& Get() {
+    static State state;
+    return state;
+}
+
+class FrontLock {
+public:
+    explicit FrontLock(std::atomic<bool>& flag_) : flag{flag_} {
+        while (flag.exchange(true, std::memory_order_acquire)) {
+            while (flag.load(std::memory_order_relaxed)) {
+                std::this_thread::yield();
+            }
+        }
+    }
+    ~FrontLock() {
+        flag.store(false, std::memory_order_release);
+    }
+    FrontLock(const FrontLock&) = delete;
+    FrontLock& operator=(const FrontLock&) = delete;
+
+private:
+    std::atomic<bool>& flag;
+};
+
+size_t BloomBit(u64 page) {
+    return static_cast<size_t>((page ^ (page >> 16)) & (BloomWords * 64 - 1));
+}
+
+void AddBloom(std::array<u64, BloomWords>& bloom, u64 begin, u64 size) {
+    if (size == 0) {
+        return;
+    }
+    for (u64 page = begin >> PageBits; page <= (begin + size - 1) >> PageBits; ++page) {
+        const size_t bit = BloomBit(page);
+        bloom[bit / 64] |= u64{1} << (bit % 64);
+    }
+}
+
+bool Live(const Snapshot& snapshot, u64 back_frame) {
+    return snapshot.seq != Invalid && snapshot.seq >= back_frame;
+}
+
+/// The span of `snapshot` holding all of [device, device + size), or null.
+const Span* FindSpan(const Snapshot& snapshot, u64 device, u64 size) {
+    const auto it = std::upper_bound(
+        snapshot.spans.begin(), snapshot.spans.end(), device,
+        [](u64 address, const Span& span) { return address < span.device; });
+    if (it == snapshot.spans.begin()) {
+        return nullptr;
+    }
+    const Span& span = *(it - 1);
+    if (device + size > span.device + span.size) {
+        return nullptr;
+    }
+    return &span;
+}
+
+u64 MaxStamp(const Snapshot& snapshot, u64 offset, u64 size) {
+    u64 stamp = 0;
+    for (u64 page = offset >> PageBits; page <= (offset + size - 1) >> PageBits; ++page) {
+        stamp = (std::max)(stamp, snapshot.stamps[page]);
+    }
+    return stamp;
+}
+
+/// The copy the back reads now (under the mutex), or null.
+const Snapshot* Current(State& state) {
+    const u64 back_frame = state.back_frame.load(std::memory_order_acquire);
+    const Snapshot& snapshot = state.snapshots[back_frame % NumCopies];
+    return snapshot.seq == back_frame ? &snapshot : nullptr;
+}
+
+void NoteMax(std::atomic<u64>& max, u64 value) {
+    u64 seen = max.load(std::memory_order_relaxed);
+    while (value > seen && !max.compare_exchange_weak(seen, value, std::memory_order_relaxed)) {
+    }
+}
+
+void Report(State& state, u64 n) {
+    Stats& s = state.stats;
+    const u64 takes = s.takes.exchange(0, std::memory_order_relaxed);
+    const u64 skipped = s.skipped_live.exchange(0, std::memory_order_relaxed);
+    const u64 presents = takes + skipped;
+    LOG_INFO(HW_GPU,
+             "EDEN_UP_UBO_SNAPSHOT: present {}: last {} presents {} copies ({} skipped, slot "
+             "still read), {:.1f} spans / {:.1f} KiB / {:.1f} us a copy (max {} us); {} log "
+             "overflows, {} ranges cut at 4 MiB, {} unmapped pages left out, {} ranges without a "
+             "size hint (4 KiB); back served {} small and {} large binds ({} large rebound), "
+             "missed {} (no copy for the frame) and {} (range not in the copy); {} GPU writes "
+             "copied in",
+             n, presents, takes, skipped,
+             takes ? static_cast<double>(s.spans.exchange(0, std::memory_order_relaxed)) / takes
+                   : 0.0,
+             takes ? static_cast<double>(s.bytes.exchange(0, std::memory_order_relaxed)) / 1024.0 /
+                         takes
+                   : 0.0,
+             takes ? static_cast<double>(s.copy_us.exchange(0, std::memory_order_relaxed)) / takes
+                   : 0.0,
+             s.max_copy_us.exchange(0, std::memory_order_relaxed),
+             s.overflows.exchange(0, std::memory_order_relaxed),
+             s.cut_ranges.exchange(0, std::memory_order_relaxed),
+             s.unmapped_pages.exchange(0, std::memory_order_relaxed),
+             s.unhinted.exchange(0, std::memory_order_relaxed),
+             s.served_small.exchange(0, std::memory_order_relaxed),
+             s.served_large.exchange(0, std::memory_order_relaxed),
+             s.reused_large.exchange(0, std::memory_order_relaxed),
+             s.miss_frame.exchange(0, std::memory_order_relaxed),
+             s.miss_range.exchange(0, std::memory_order_relaxed),
+             s.mirrored.exchange(0, std::memory_order_relaxed));
+}
+
+} // Anonymous namespace
+
+void FrontBind(const void* engine, u32 stage, u32 slot, bool valid, std::optional<u64> device,
+               u32 size) {
+    if (stage >= NumStages || slot >= NumSlots) {
+        return; // ProcessCBBind ignores slots past the 18 it holds
+    }
+    State& state = Get();
+    FrontLock lock{state.front_lock};
+    EngineTable* table = nullptr;
+    for (EngineTable& entry : state.tables) {
+        if (entry.engine == engine) {
+            table = &entry;
+            break;
+        }
+    }
+    if (table == nullptr) {
+        table = &state.tables.emplace_back();
+        table->engine = engine;
+    }
+    Binding& binding = table->table[stage][slot];
+    binding.valid = valid && device.has_value() && *device != 0 && size != 0;
+    binding.device = device.value_or(0);
+    binding.size = size;
+    if (!binding.valid) {
+        return;
+    }
+    if (state.log.size() >= LogEntries) {
+        state.overflow = true;
+        return;
+    }
+    state.log.push_back(LogEntry{binding.device, size, static_cast<u8>(stage),
+                                 static_cast<u8>(slot)});
+}
+
+void NoteUsedSize(size_t stage, u32 slot, u32 size) {
+    if (stage >= NumStages || slot >= NumSlots) {
+        return;
+    }
+    std::atomic<u32>& hint = Get().hints[stage * NumSlots + slot];
+    u32 seen = hint.load(std::memory_order_relaxed);
+    while (size > seen && !hint.compare_exchange_weak(seen, size, std::memory_order_relaxed)) {
+    }
+}
+
+void Take(u64 n, Tegra::MaxwellDeviceMemoryManager& memory) {
+    State& state = Get();
+    Stats& stats = state.stats;
+    const auto start = std::chrono::steady_clock::now();
+    if (n >= state.reported_at + ReportEvery) {
+        if (state.reported_at != 0) {
+            Report(state, n);
+        }
+        state.reported_at = n;
+    }
+    // Held through the copy: a GPU write that finds this copy in the bloom waits here and then
+    // writes into it (Mirror), one that does not was made before the copy read it.
+    std::scoped_lock lock{state.mutex};
+    Snapshot& snapshot = state.snapshots[n % NumCopies];
+    const u64 back_frame = state.back_frame.load(std::memory_order_acquire);
+    if (Live(snapshot, back_frame)) {
+        stats.skipped_live.fetch_add(1, std::memory_order_relaxed);
+        return; // The log keeps growing: the next copy takes what this one would have
+    }
+    snapshot.seq = Invalid;
+    snapshot.spans.clear();
+    bool overflowed;
+    {
+        FrontLock front{state.front_lock};
+        state.log_scratch.clear();
+        state.log_scratch.swap(state.log);
+        overflowed = std::exchange(state.overflow, false);
+        state.current_tables = state.tables;
+    }
+    if (overflowed) {
+        stats.overflows.fetch_add(1, std::memory_order_relaxed);
+    }
+
+    // The bindings at the last copy (what the frame starts with), the binds since, and now.
+    state.ranges.clear();
+    u64 unhinted = 0;
+    const auto add = [&](u64 device, u32 size, size_t stage, size_t slot) {
+        const u32 hint = state.hints[stage * NumSlots + slot].load(std::memory_order_relaxed);
+        unhinted += hint == 0 ? 1 : 0;
+        const u64 length = (std::min<u64>)(size, hint != 0 ? hint : NoHintCap);
+        if (device == 0 || length == 0) {
+            return;
+        }
+        state.ranges.push_back(Range{device, device + length, hint >= BankSize});
+    };
+    const auto add_tables = [&](const std::vector<EngineTable>& tables) {
+        for (const EngineTable& entry : tables) {
+            for (size_t stage = 0; stage < NumStages; ++stage) {
+                for (size_t slot = 0; slot < NumSlots; ++slot) {
+                    const Binding& binding = entry.table[stage][slot];
+                    if (binding.valid) {
+                        add(binding.device, binding.size, stage, slot);
+                    }
+                }
+            }
+        }
+    };
+    add_tables(state.previous_tables);
+    for (const LogEntry& entry : state.log_scratch) {
+        add(entry.device, entry.size, entry.stage, entry.slot);
+    }
+    add_tables(state.current_tables);
+    state.previous_tables.swap(state.current_tables);
+    stats.unhinted.fetch_add(unhinted, std::memory_order_relaxed);
+
+    // Sorted and merged, then split where device pages are unmapped (they read as zeros with an
+    // error each; the guest read keeps them).
+    std::sort(state.ranges.begin(), state.ranges.end(),
+              [](const Range& lhs, const Range& rhs) { return lhs.begin < rhs.begin; });
+    state.merged.clear();
+    for (const Range& range : state.ranges) {
+        if (!state.merged.empty() && range.begin <= state.merged.back().end + MergeGap) {
+            Range& last = state.merged.back();
+            last.end = (std::max)(last.end, range.end);
+            last.bank = last.bank || range.bank;
+        } else {
+            state.merged.push_back(range);
+        }
+    }
+    state.kept.clear();
+    u64 unmapped = 0;
+    for (const Range& range : state.merged) {
+        u64 run_begin = range.begin;
+        for (u64 address = range.begin; address < range.end;) {
+            const u64 next = (std::min)(range.end, (address & ~(PageSize - 1)) + PageSize);
+            if (memory.GetPointer<u8>(address) == nullptr) {
+                if (address > run_begin) {
+                    state.kept.push_back(Range{run_begin, address, range.bank});
+                }
+                run_begin = next;
+                ++unmapped;
+            }
+            address = next;
+        }
+        if (range.end > run_begin) {
+            state.kept.push_back(Range{run_begin, range.end, range.bank});
+        }
+    }
+    stats.unmapped_pages.fetch_add(unmapped, std::memory_order_relaxed);
+
+    // Within 4 MiB: banks first, then the rest, in address order.
+    u64 total = 0;
+    for (const Range& range : state.kept) {
+        total += range.end - range.begin;
+    }
+    std::vector<Range>& spans_in = state.merged; // reused as the list that fits
+    spans_in.clear();
+    if (total <= CopyBytes) {
+        spans_in = state.kept;
+    } else {
+        u64 room = CopyBytes;
+        u64 cut = 0;
+        std::vector<bool> take(state.kept.size());
+        for (const bool banks : {true, false}) {
+            for (size_t i = 0; i < state.kept.size(); ++i) {
+                const Range& range = state.kept[i];
+                if (range.bank != banks) {
+                    continue;
+                }
+                const u64 size = range.end - range.begin;
+                if (size <= room) {
+                    take[i] = true;
+                    room -= size;
+                } else {
+                    ++cut;
+                }
+            }
+        }
+        for (size_t i = 0; i < state.kept.size(); ++i) {
+            if (take[i]) {
+                spans_in.push_back(state.kept[i]);
+            }
+        }
+        stats.cut_ranges.fetch_add(cut, std::memory_order_relaxed);
+    }
+
+    u64 offset = 0;
+    snapshot.spans.reserve(spans_in.size());
+    for (const Range& range : spans_in) {
+        const u64 size = range.end - range.begin;
+        snapshot.spans.push_back(Span{range.begin, size, offset});
+        offset += size;
+    }
+    // Every page of a live copy stays in the bloom: the new bits are the live copies' and this
+    // one's, so each word only drops pages no live copy holds.
+    state.next_bloom.fill(0);
+    for (const Snapshot& other : state.snapshots) {
+        if (&other != &snapshot && Live(other, back_frame)) {
+            for (const Span& span : other.spans) {
+                AddBloom(state.next_bloom, span.device, span.size);
+            }
+        }
+    }
+    for (const Span& span : snapshot.spans) {
+        AddBloom(state.next_bloom, span.device, span.size);
+    }
+    for (size_t i = 0; i < BloomWords; ++i) {
+        state.bloom[i].store(state.next_bloom[i], std::memory_order_relaxed);
+    }
+    state.live.store(true, std::memory_order_relaxed);
+    // Pairs with the fence in Mirror: either the writer sees these bits, or this copy
+    // sees its bytes in guest memory.
+    std::atomic_thread_fence(std::memory_order_seq_cst);
+
+    if (!snapshot.data) {
+        snapshot.data.reset(new u8[CopyBytes]);
+        snapshot.stamps.assign(CopyBytes >> PageBits, 0);
+    }
+    for (const Span& span : snapshot.spans) {
+        memory.ReadBlockUnsafe(span.device, snapshot.data.get() + span.offset, span.size);
+    }
+    std::fill_n(snapshot.stamps.begin(), (offset + PageSize - 1) >> PageBits, u64{0});
+    snapshot.seq = n;
+
+    const u64 us = static_cast<u64>(std::chrono::duration_cast<std::chrono::microseconds>(
+                                        std::chrono::steady_clock::now() - start)
+                                        .count());
+    stats.takes.fetch_add(1, std::memory_order_relaxed);
+    stats.spans.fetch_add(snapshot.spans.size(), std::memory_order_relaxed);
+    stats.bytes.fetch_add(offset, std::memory_order_relaxed);
+    stats.copy_us.fetch_add(us, std::memory_order_relaxed);
+    NoteMax(stats.max_copy_us, us);
+}
+
+void Retire(u64 n) {
+    // Absolute: an entry lost to a split restart heals with the next one.
+    Get().back_frame.store(n + 1, std::memory_order_release);
+}
+
+bool Probe(u64 device, u32 size, Hit& hit) {
+    if (size == 0) {
+        return false;
+    }
+    State& state = Get();
+    std::scoped_lock lock{state.mutex};
+    const Snapshot* const snapshot = Current(state);
+    if (snapshot == nullptr) {
+        state.stats.miss_frame.fetch_add(1, std::memory_order_relaxed);
+        return false;
+    }
+    const Span* const span = FindSpan(*snapshot, device, size);
+    if (span == nullptr) {
+        state.stats.miss_range.fetch_add(1, std::memory_order_relaxed);
+        return false;
+    }
+    hit.seq = snapshot->seq;
+    hit.stamp = MaxStamp(*snapshot, span->offset + (device - span->device), size);
+    return true;
+}
+
+bool Copy(u64 device, u32 size, void* dest, Hit& hit) {
+    if (size == 0) {
+        return false;
+    }
+    State& state = Get();
+    std::scoped_lock lock{state.mutex};
+    const Snapshot* const snapshot = Current(state);
+    if (snapshot == nullptr) {
+        state.stats.miss_frame.fetch_add(1, std::memory_order_relaxed);
+        return false;
+    }
+    const Span* const span = FindSpan(*snapshot, device, size);
+    if (span == nullptr) {
+        state.stats.miss_range.fetch_add(1, std::memory_order_relaxed);
+        return false;
+    }
+    const u64 offset = span->offset + (device - span->device);
+    std::memcpy(dest, snapshot->data.get() + offset, size);
+    hit.seq = snapshot->seq;
+    hit.stamp = MaxStamp(*snapshot, offset, size);
+    return true;
+}
+
+void NoteServed(bool large, bool reused) {
+    Stats& stats = Get().stats;
+    if (!large) {
+        stats.served_small.fetch_add(1, std::memory_order_relaxed);
+    } else if (reused) {
+        stats.reused_large.fetch_add(1, std::memory_order_relaxed);
+    } else {
+        stats.served_large.fetch_add(1, std::memory_order_relaxed);
+    }
+}
+
+namespace {
+
+/// Copies what the GPU wrote to [device, device + size) into every live copy holding any of it:
+/// `copy(dest, address, bytes)` fills `dest` with the written bytes at `address`.
+template <typename CopyFunc>
+void Mirror(u64 device, size_t size, CopyFunc&& copy) {
+    if (size == 0) {
+        return;
+    }
+    State& state = Get();
+    // The write is in guest memory already (see Take).
+    std::atomic_thread_fence(std::memory_order_seq_cst);
+    if (!state.live.load(std::memory_order_relaxed)) {
+        return;
+    }
+    const u64 first_page = device >> PageBits;
+    const u64 last_page = (device + size - 1) >> PageBits;
+    if (last_page - first_page < MaxBloomPages) {
+        bool hit = false;
+        for (u64 page = first_page; page <= last_page && !hit; ++page) {
+            const size_t bit = BloomBit(page);
+            hit = ((state.bloom[bit / 64].load(std::memory_order_relaxed) >> (bit % 64)) & 1) != 0;
+        }
+        if (!hit) {
+            return;
+        }
+    }
+    const u64 end = device + size;
+    std::scoped_lock lock{state.mutex};
+    const u64 back_frame = state.back_frame.load(std::memory_order_acquire);
+    bool copied = false;
+    for (Snapshot& snapshot : state.snapshots) {
+        if (!Live(snapshot, back_frame)) {
+            continue;
+        }
+        auto it = std::upper_bound(
+            snapshot.spans.begin(), snapshot.spans.end(), device,
+            [](u64 address, const Span& span) { return address < span.device; });
+        if (it != snapshot.spans.begin()) {
+            --it;
+        }
+        for (; it != snapshot.spans.end() && it->device < end; ++it) {
+            const u64 lower = (std::max)(device, it->device);
+            const u64 upper = (std::min)(end, it->device + it->size);
+            if (lower >= upper) {
+                continue;
+            }
+            const u64 offset = it->offset + (lower - it->device);
+            copy(snapshot.data.get() + offset, lower, upper - lower);
+            const u64 stamp = ++state.stamp_counter;
+            for (u64 page = offset >> PageBits; page <= (offset + (upper - lower) - 1) >> PageBits;
+                 ++page) {
+                snapshot.stamps[page] = stamp;
+            }
+            copied = true;
+        }
+    }
+    if (copied) {
+        state.stats.mirrored.fetch_add(1, std::memory_order_relaxed);
+    }
+}
+
+} // Anonymous namespace
+
+void OnGpuWriteImpl(u64 device, const void* source, size_t size) {
+    Mirror(device, size, [&](u8* dest, u64 address, u64 bytes) {
+        std::memcpy(dest, static_cast<const u8*>(source) + (address - device), bytes);
+    });
+}
+
+void OnGpuWriteInPlaceImpl(u64 device, size_t size, Tegra::MaxwellDeviceMemoryManager& memory) {
+    Mirror(device, size, [&](u8* dest, u64 address, u64 bytes) {
+        memory.ReadBlockUnsafe(address, dest, bytes);
+    });
+}
+
+void Reset() {
+    State& state = Get();
+    std::scoped_lock lock{state.mutex};
+    {
+        FrontLock front{state.front_lock};
+        state.tables.clear();
+        state.log.clear();
+        state.overflow = false;
+    }
+    for (Snapshot& snapshot : state.snapshots) {
+        snapshot.seq = Invalid;
+        snapshot.spans.clear();
+    }
+    state.previous_tables.clear();
+    state.back_frame.store(0, std::memory_order_release);
+}
+
+} // namespace VideoCommon::UboSnapshot
