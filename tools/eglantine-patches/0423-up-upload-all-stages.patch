 constexpr bool ENABLE_MSAA_COLOR_DISCARD = true;
 constexpr bool ENABLE_MSAA_DEPTH_STENCIL_DISCARD = true;
 
+/// EDEN_UP_UPLOAD_ALL_STAGES=1 (MythosOfs/Orchid cc04f48b3d): texture uploads and image copies
+/// wait for, and are made visible to, every stage that can use the image (vertex and fragment
+/// shaders sampling it, early depth tests loading it), and the TRANSFER_SRC -> GENERAL returns
+/// make the copied data visible. Off: the narrower scopes as before.
+[[nodiscard]] bool UploadAllStages() {
+    static const bool on = Common::PeSwitch("EDEN_UP_UPLOAD_ALL_STAGES");
+    return on;
+}
+
+[[nodiscard]] VkAccessFlags TransferSrcReturnAccess() {
+    return UploadAllStages() ? VkAccessFlags{VK_ACCESS_MEMORY_READ_BIT | VK_ACCESS_MEMORY_WRITE_BIT}
+                             : VkAccessFlags{0};
+}
+
 [[nodiscard]] constexpr bool NeedsExplicitBorderColorFormat(VkFormat format) {
     switch (format) {
     case VK_FORMAT_B4G4R4A4_UNORM_PACK16:
@@ -1036,10 +1050,12 @@ void CopyBufferToImage(vk::CommandBuffer cmdbuf, VkBuffer src_buffer, VkImage im
     }
     const VkImageSubresourceRange subresource_range = range.SubresourceRange(aspect_mask);
 
