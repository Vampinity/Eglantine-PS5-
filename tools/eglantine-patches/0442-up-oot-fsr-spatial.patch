+// EDEN_UP_OOT_FSR_SPATIAL's FSR 1 passes (present/fsr.h: the window filter's EASU and RCAS) at the
+// output's size. FSR::Draw rewrites an image set's descriptors as it records, so the two sets are
+// used in turn and each is reused only once the GPU is past its last use.
+class OotSpatialUpscale {
+public:
+    static constexpr size_t Sets = 2;
+
+    explicit OotSpatialUpscale(const Device& device, MemoryAllocator& memory_allocator,
+                               VkExtent2D extent_)
+        : fsr{device, memory_allocator, Sets, extent_},
+          sampler{device.GetLogical().CreateSampler(VkSamplerCreateInfo{
+              .sType = VK_STRUCTURE_TYPE_SAMPLER_CREATE_INFO,
+              .pNext = nullptr,
+              .flags = 0,
+              .magFilter = VK_FILTER_NEAREST,
+              .minFilter = VK_FILTER_NEAREST,
+              .mipmapMode = VK_SAMPLER_MIPMAP_MODE_NEAREST,
+              .addressModeU = VK_SAMPLER_ADDRESS_MODE_CLAMP_TO_EDGE,
+              .addressModeV = VK_SAMPLER_ADDRESS_MODE_CLAMP_TO_EDGE,
+              .addressModeW = VK_SAMPLER_ADDRESS_MODE_CLAMP_TO_EDGE,
+              .mipLodBias = 0.0f,
+              .anisotropyEnable = VK_FALSE,
+              .maxAnisotropy = 0.0f,
+              .compareEnable = VK_FALSE,
+              .compareOp = VK_COMPARE_OP_NEVER,
+              .minLod = 0.0f,
+              .maxLod = 0.0f,
+              .borderColor = VK_BORDER_COLOR_FLOAT_OPAQUE_BLACK,
+              .unnormalizedCoordinates = VK_FALSE,
+          })},
+          extent{extent_} {}
+
+    FSR fsr;
+    vk::Sampler sampler; ///< reads the RCAS result 1:1
+    VkExtent2D extent;
+    std::array<u64, Sets> ticks{}; ///< each set's last use
+    size_t next{};
+};
+
+bool TextureCacheRuntime::SpatialUpscale(Framebuffer* dst_framebuffer, ImageView& dst,
+                                         ImageView& src, const Region2D& dst_region,
+                                         const Region2D& src_region,
+                                         Tegra::Engines::Fermi2D::Operation operation,
+                                         f32 sharpness) {
+    const s32 dst_width = dst_region.end.x - dst_region.start.x;
+    const s32 dst_height = dst_region.end.y - dst_region.start.y;
+    // A rescaled source has its region scaled but not its view size (crop below): not handled.
+    if (spatial_upscale_failed || src.IsRescaled() || dst_width <= 0 || dst_height <= 0 ||
+        src_region.end.x <= src_region.start.x || src_region.end.y <= src_region.start.y ||
+        src.size.width == 0 || src.size.height == 0) {
+        return false;
+    }
+    const VkExtent2D extent{static_cast<u32>(dst_width), static_cast<u32>(dst_height)};
+    if (!spatial_upscale || spatial_upscale->extent.width != extent.width ||
+        spatial_upscale->extent.height != extent.height) {
+        if (spatial_upscale) {
+            scheduler.Finish(); // the old images may still be in use
+            spatial_upscale.reset();
+        }
+        // Out of device memory, the allocator places images in host memory or leaves them
+        // unbacked (black when sampled) rather than throwing: either counts as a failed start.
+        const u32 refusals = memory_allocator.MemoryRefusalEvents();
+        try {
+            spatial_upscale = std::make_shared<OotSpatialUpscale>(device, memory_allocator, extent);
+        } catch (const vk::Exception& exception) {
+            LOG_ERROR(Render_Vulkan, "EDEN_UP_OOT_FSR_SPATIAL: FSR 1 failed to start ({})",
+                      exception.what());
+            spatial_upscale_failed = true;
+            return false;
+        }
+        if (memory_allocator.MemoryRefusalEvents() != refusals) {
+            LOG_ERROR(Render_Vulkan,
+                      "EDEN_UP_OOT_FSR_SPATIAL: no device memory for FSR 1's images, not used");
+            spatial_upscale.reset();
+            spatial_upscale_failed = true;
+            return false;
+        }
+        LOG_INFO(Render_Vulkan, "EDEN_UP_OOT_FSR_SPATIAL: FSR 1 into {}x{}", extent.width,
+                 extent.height);
+    }
+    OotSpatialUpscale& spatial = *spatial_upscale;
+    const size_t index = spatial.next;
+    spatial.next = (index + 1) % OotSpatialUpscale::Sets;
+    if (spatial.ticks[index] != 0) {
+        scheduler.Wait(spatial.ticks[index]); // the set's last use, normally long done
+    }
+    // What the game drew into the source is visible to EASU (FSR::Draw's own transition covers
+    // colour attachment writes only). Texture cache images stay in the GENERAL layout.
+    const VkImage src_image = src.ImageHandle();
+    scheduler.RequestOutsideRenderPassOperationContext();
+    scheduler.Record([src_image](vk::CommandBuffer cmdbuf) {
+        const VkImageMemoryBarrier barrier{
+            .sType = VK_STRUCTURE_TYPE_IMAGE_MEMORY_BARRIER,
+            .pNext = nullptr,
+            .srcAccessMask = VK_ACCESS_SHADER_WRITE_BIT | VK_ACCESS_COLOR_ATTACHMENT_WRITE_BIT |
+                             VK_ACCESS_TRANSFER_WRITE_BIT,
+            .dstAccessMask = VK_ACCESS_SHADER_READ_BIT,
+            .oldLayout = VK_IMAGE_LAYOUT_GENERAL,
+            .newLayout = VK_IMAGE_LAYOUT_GENERAL,
+            .srcQueueFamilyIndex = VK_QUEUE_FAMILY_IGNORED,
+            .dstQueueFamilyIndex = VK_QUEUE_FAMILY_IGNORED,
+            .image = src_image,
+            .subresourceRange{
+                .aspectMask = VK_IMAGE_ASPECT_COLOR_BIT,
+                .baseMipLevel = 0,
+                .levelCount = VK_REMAINING_MIP_LEVELS,
+                .baseArrayLayer = 0,
+                .layerCount = VK_REMAINING_ARRAY_LAYERS,
+            },
+        };
+        cmdbuf.PipelineBarrier(VK_PIPELINE_STAGE_ALL_COMMANDS_BIT,
+                               VK_PIPELINE_STAGE_FRAGMENT_SHADER_BIT, 0, barrier);
+    });
+    const f32 src_width = static_cast<f32>(src.size.width);
+    const f32 src_height = static_cast<f32>(src.size.height);
+    const Common::Rectangle<f32> crop{static_cast<f32>(src_region.start.x) / src_width,
+                                      static_cast<f32>(src_region.start.y) / src_height,
+                                      static_cast<f32>(src_region.end.x) / src_width,
+                                      static_cast<f32>(src_region.end.y) / src_height};
+    const VkImageView upscaled =
+        spatial.fsr.Draw(device, scheduler, index, src_image,
+                         src.Handle(Shader::TextureType::Color2D),
+                         VkExtent2D{src.size.width, src.size.height}, crop, sharpness);
+    const VkImage upscaled_image = spatial.fsr.OutputImage(index);
+    const Region2D whole{
+        .start = {0, 0},
+        .end = {dst_width, dst_height},
+    };
+    // The blit's own operation (EDEN_UP_OOT_FSR_SPATIAL: the square) on the way into dst.
+    blit_image_helper.BlitColor(dst_framebuffer, upscaled, upscaled_image, *spatial.sampler,
