+// EDEN_UP_OOT_FSR_SPATIAL=1, after exploitizm's spatial stand-in (exploitizm/Eglantine 0c419316e9,
+// "Replace Ocarina neural upscale with captured spatial paths"), itself on ProphetWild's and
+// Lichii's network bypasses. Ocarina of Time's gameplay network is the program whose own handles
+// read the drawn frame (E5B9G9R9, square roots of the light) through cbuf0+0xc0 and store one
+// B10G11R11 image through +0xd0, and which multiplies matrices (first HMMA at 0xc00 with Max
+// Resolution, where it is 1:1; at 0xad0 without). It is not dispatched: FSR 1 draws its output
+// instead, EASU to the output's size and RCAS in the frame's own square-root space (the gamma-2
+// space FSR expects), then the square the network applies. exploitizm's version blits bilinear
+// and sharpens; EASU is FSR 1's own upscale. EDEN_UP_OOT_FSR_SHARPNESS=<stops> sets RCAS (0 is
+// the strongest, 2 mild; unset: the FSR sharpness setting). The rest of the frame's passes run
+// as before. When the images don't fit, the network runs; when FSR 1 can't start, the same
+// blit draws without it (the EDEN_NX2_UPSCALE_SQUARE stand-in) and the network takes over again.
+bool KeplerCompute::OotFsrSpatial() {
+    static bool given_up = false;
+    if (given_up || Settings::GetCurrentProgramID() != VideoCommon::OotNetwork::ProgramId ||
+        !(launch_description.const_buffer_enable_mask & 1)) {
+        return false;
+    }
+    constexpr u32 input_slot = 0xc0;
+    constexpr u32 output_slot = 0xd0;
+    constexpr u32 no_matrix_multiply = ~0U;
+    const GPUVAddr program = regs.code_loc.Address();
+    // Per program: the byte offset of its first HMMA when its handles are the network's.
+    static std::unordered_map<GPUVAddr, u32> first_hmma;
+    auto known = first_hmma.find(program);
+    if (known == first_hmma.end()) {
+        const auto [reads, stores] = NativeImageHandles(program);
+        u32 found = no_matrix_multiply;
+        if (std::find(reads.begin(), reads.end(), input_slot) != reads.end() &&
+            stores.size() == 1 && stores.front() == output_slot) {
+            std::array<u32, 0x400> block{};
+            bool exited = false;
+            for (u64 offset = 0; offset < 0x40000 && !exited && found == no_matrix_multiply;
+                 offset += sizeof(block)) {
+                if (!memory_manager.IsFullyMappedRange(program + offset, sizeof(block))) break;
+                memory_manager.ReadBlock(program + offset, block.data(), sizeof(block));
+                for (size_t word = 0; word < block.size() && !exited; word += 4) {
+                    const u32 opcode = block[word] & 0xfff;
+                    if (opcode == 0x23c) { // HMMA
+                        found = static_cast<u32>(offset + word * sizeof(u32));
+                        break;
+                    }
+                    // EXIT, unconditional when guarded by PT
+                    exited = opcode == 0x94d && ((block[word] >> 12) & 0xf) == 7;
+                }
+            }
+        }
+        known = first_hmma.emplace(program, found).first;
+        if (found != no_matrix_multiply) {
+            LOG_INFO(HW_GPU, "EDEN_UP_OOT_FSR_SPATIAL: gameplay network {:#x}, first HMMA at {:#x}",
+                     program, found);
+        }
+    }
+    if (known->second == no_matrix_multiply) {
+        return false;
+    }
+    const auto input = ConstBuffer0Image(input_slot);
+    const auto output = ConstBuffer0Image(output_slot);
+    if (!input || !output || input->format != Texture::TextureFormat::E5B9G9R9 ||
+        output->format != Texture::TextureFormat::B10G11R11 || input->Address() == 0 ||
+        output->Address() == 0 || input->Address() == output->Address() ||
+        !input->IsBlockLinear() || !output->IsBlockLinear()) {
+        return false;
+    }
+    // 1:1 to 4x with the aspect kept (without Max Resolution the frame follows the game's dynamic
+    // resolution: exploitizm captured 854x480 to 2560x1440).
+    const u64 in_width = input->Width(), in_height = input->Height();
+    const u64 out_width = output->Width(), out_height = output->Height();
+    const u64 cross_a = out_width * in_height, cross_b = out_height * in_width;
+    if (in_width < 64 || in_height < 64 || out_width < in_width || out_height < in_height ||
+        out_width > in_width * 4 || out_height > in_height * 4 ||
+        (cross_a > cross_b ? cross_a - cross_b : cross_b - cross_a) * 32 > cross_a) {
+        return false;
+    }
+    const auto surface = [](const Texture::TICEntry& tic) {
+        Fermi2D::Surface result{};
+        // E5B9G9R9 has no 2D surface format: the input is read as one through
+        // g_blit_source_format below, like the upscale stand-in's.
+        result.format = Tegra::RenderTargetFormat::B10G11R11_FLOAT;
+        result.linear = Fermi2D::MemoryLayout::BlockLinear;
+        result.block_width.Assign(tic.block_width);
+        result.block_height.Assign(tic.block_height);
+        result.block_depth.Assign(tic.block_depth);
+        result.depth = 1;
+        result.width = tic.Width();
+        result.height = tic.Height();
+        result.addr_upper = static_cast<u32>(tic.Address() >> 32);
+        result.addr_lower = static_cast<u32>(tic.Address());
+        return result;
+    };
+    const Fermi2D::Config config{
+        .operation = Fermi2D::Operation::SrcCopySquare,
+        .filter = Fermi2D::Filter::Bilinear,
+        .must_accelerate = true,
+        .dst_x0 = 0,
+        .dst_y0 = 0,
+        .dst_x1 = static_cast<s32>(out_width),
+        .dst_y1 = static_cast<s32>(out_height),
+        .src_x0 = 0,
+        .src_y0 = 0,
+        .src_x1 = static_cast<s32>(in_width),
+        .src_y1 = static_cast<s32>(in_height),
+    };
+    static const std::optional<f32> sharpness_override = []() -> std::optional<f32> {
+        const char* const value = std::getenv("EDEN_UP_OOT_FSR_SHARPNESS");
+        if (value == nullptr || value[0] == '\0') {
+            return std::nullopt;
+        }
+        return static_cast<f32>(std::strtod(value, nullptr));
+    }();
+    const f32 sharpness = sharpness_override.value_or(
+        static_cast<f32>(Settings::values.fsr_sharpening_slider.GetValue()) / 100.0f);
+    // As RasterizerVulkan::DispatchCompute would have before the network.
+    memory_manager.FlushCaching();
+    bool applied = false;
+    const bool done = [&] {
+        VideoCommon::g_blit_source_format = VideoCore::Surface::PixelFormat::E5B9G9R9_FLOAT;
+        VideoCommon::g_blit_spatial_upscale =
+            VideoCommon::BlitSpatialUpscale{.sharpness = sharpness};
+        SCOPE_EXIT {
+            applied = VideoCommon::g_blit_spatial_upscale->applied;
+            VideoCommon::g_blit_spatial_upscale.reset();
+            VideoCommon::g_blit_source_format.reset();
+        };
+        return rasterizer->AccelerateSurfaceCopy(surface(*input), surface(*output), config);
+    }();
+    if (done && !applied) {
+        given_up = true;
+        LOG_WARNING(HW_GPU, "EDEN_UP_OOT_FSR_SPATIAL: FSR 1 did not draw; the network runs from "
+                            "the next frame");
+    }
+    static u32 logged = 0;
+    static std::pair<u64, u64> last_size{};
+    if (logged < 64 && (logged < 4 || last_size != std::pair{in_width, in_height})) {
+        ++logged;
+        last_size = {in_width, in_height};
+        // The network's own size words (Mac check: +0x30 1/source size, +0x60 scale and offset,
+        // +0x70 output size), to see whether a dynamic-resolution frame fills its whole image.
+        const auto& cbuf = launch_description.const_buffer_config[0];
+        const GPUVAddr cbuf_address = (GPUVAddr{cbuf.address_high} << 32) | cbuf.address_low;
+        const auto word = [&](u32 offset) -> std::string {
+            if (cbuf.size.Value() < offset + 4 ||
+                !memory_manager.IsFullyMappedRange(cbuf_address + offset, 4)) {
+                return "-";
+            }
+            const u32 value = memory_manager.Read<u32>(cbuf_address + offset);
+            return fmt::format("{:08x}({:g})", value, std::bit_cast<f32>(value));
+        };
+        LOG_INFO(HW_GPU,
+                 "EDEN_UP_OOT_FSR_SPATIAL: network {:#x} {}: {:#x} {}x{} -> {:#x} {}x{}, RCAS "
+                 "{} stops; cbuf0 +0x30 {} {} +0x60 {} {} {} {} +0x70 {} {}",
+                 program,
+                 !done      ? "kept (2D blit refused)"
+                 : applied ? "replaced by FSR 1"
+                           : "replaced by a plain blit",
+                 input->Address(), in_width, in_height, output->Address(), out_width,
+                 out_height, sharpness, word(0x30), word(0x34), word(0x60), word(0x64),
+                 word(0x68), word(0x6c), word(0x70), word(0x74));
+    }
+    return done;
+}
