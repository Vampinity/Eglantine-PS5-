+[[maybe_unused]] bool IsZeroPage(const u8* page) {
+    const auto* words = reinterpret_cast<const u64*>(page);
+    u64 bits = 0;
+    for (size_t i = 0; i < PageAlignment / sizeof(u64); ++i) {
+        bits |= words[i];
+    }
+    return bits == 0;
+}
