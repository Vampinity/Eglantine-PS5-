+    // Each (slice, line) writes its own bytes of an unswizzled output: lines can go to other
+    // threads (EDEN_UP_UNSWIZZLE_THREADS, LinePool above). index = slice * height + line.
+    const auto lines = [&](u32 first, u32 end) {
+        for (u32 index = first; index < end; ++index) {
+            const u32 slice = index / height;
+            const u32 line = index % height;
+            const u32 z = slice + origin_z;
+            const u32 offset_z = (z >> block_depth) * slice_size +
+                                 ((z & block_depth_mask) << (GOB_SIZE_SHIFT + block_height));
             const u32 y = line + origin_y;
             const u32 swizzled_y = pdep<SWIZZLE_Y_BITS>(y);
 
@@ -93,6 +228,16 @@ void SwizzleImpl(std::span<u8> output, std::span<const u8> input, u32 width, u32
                 std::memcpy(dst, src, BYTES_PER_PIXEL);
             }
         }
+    };
+    const u32 total_lines = depth * height;
+    // From 1 MiB, and only towards plain data: upstream found that splitting medium textures too
+    // (256 KiB) made busy spots drop harder.
+    constexpr u64 min_bytes = u64{1} << 20;
+    if (!TO_LINEAR && height != 0 && u64{pitch} * total_lines >= min_bytes &&
+        LinePool::Get().Enabled()) {
+        LinePool::Get().Run(total_lines, lines);
+    } else {
+        lines(0, total_lines);
     }
 }
 
