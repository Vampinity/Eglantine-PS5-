+/// EDEN_UP_UNSWIZZLE_THREADS=<n> (1 to 4; unset or 0: off, no thread is made). A large unswizzle
+/// (a new texture's block-linear data made plain; 6-9% of the back GPU thread in Ocarina's
+/// fly-over, 377 ms of the 1,040 ms door frame) is split by lines over n helper threads plus the
+/// caller, which waits for all of them: the result is the same, only sooner. From Lichii PR #573
+/// as lethevimlet/oot-bc250 f47ae1e92a has it (there: a quarter of the host threads, at most 4,
+/// always on; more helpers competed with the guest cores). The helpers are named "Unswizzle", so
+/// EDEN_PS5_PLACE can put them on CPUs of their own.
+class LinePool {
+public:
+    static LinePool& Get() {
+        static LinePool pool;
+        return pool;
+    }
+
+    [[nodiscard]] bool Enabled() const {
+        return !workers.empty();
+    }
+
+    /// Calls func(begin, end) over [0, count) in chunks; returns once every chunk is done. A
+    /// second caller while one runs does its own work alone.
+    void Run(u32 count, const std::function<void(u32, u32)>& func) {
+        std::unique_lock busy{run_mutex, std::try_to_lock};
+        if (!busy || workers.empty()) {
+            func(0, count);
+            return;
+        }
+        {
+            std::scoped_lock lock{mutex};
+            job = &func;
+            total = count;
+            chunk = (std::max)(8U, count / static_cast<u32>((workers.size() + 1) * 4));
+            next.store(0, std::memory_order_relaxed);
+            pending = static_cast<u32>(workers.size());
+            ++generation;
+        }
+        work_cv.notify_all();
+        Work(func);
+        std::unique_lock lock{mutex};
+        done_cv.wait(lock, [this] { return pending == 0; });
+        job = nullptr;
+    }
+
+private:
+    LinePool() {
+        u32 count = 0;
+        if (const char* const value = std::getenv("EDEN_UP_UNSWIZZLE_THREADS")) {
+            count = (std::min)(4U, static_cast<u32>(std::strtoul(value, nullptr, 10)));
+        }
+        try {
+            for (u32 i = 0; i < count; ++i) {
+                workers.emplace_back([this](std::stop_token stop) { Loop(stop); });
+            }
+        } catch (const std::exception&) {
+            // Fewer helpers than asked for, or none: the caller then does the rest itself.
+        }
+        if (count != 0) {
+            LOG_INFO(HW_GPU, "EDEN_UP_UNSWIZZLE_THREADS: {} helper thread(s) for unswizzles of 1 MiB "
+                             "and more", workers.size());
+        }
+    }
+
+    ~LinePool() {
+        {
+            // Under the mutex: a worker between its predicate check and its wait would otherwise
+            // miss the notification and never return to be joined.
+            std::scoped_lock lock{mutex};
+            for (auto& worker : workers) {
+                worker.request_stop();
+            }
+        }
+        work_cv.notify_all();
+        workers.clear();
+    }
+
+    void Work(const std::function<void(u32, u32)>& func) {
+        for (;;) {
+            const u32 begin = next.fetch_add(chunk, std::memory_order_relaxed);
+            if (begin >= total) {
+                return;
+            }
+            func(begin, (std::min)(begin + chunk, total));
+        }
+    }
+
+    void Loop(std::stop_token stop) {
+        Common::SetCurrentThreadName("Unswizzle");
+        u64 seen = 0;
+        for (;;) {
+            const std::function<void(u32, u32)>* func;
+            {
+                std::unique_lock lock{mutex};
+                work_cv.wait(lock, [&] { return stop.stop_requested() || generation != seen; });
+                if (stop.stop_requested()) {
+                    return;
+                }
+                seen = generation;
+                func = job;
+            }
+            Work(*func);
+            {
+                std::scoped_lock lock{mutex};
+                --pending;
+            }
+            done_cv.notify_one();
+        }
+    }
+
+    std::mutex run_mutex;
+    std::mutex mutex;
+    std::condition_variable work_cv;
+    std::condition_variable done_cv;
+    const std::function<void(u32, u32)>* job{};
+    u32 total{};
+    u32 chunk{1};
+    std::atomic<u32> next{};
+    u32 pending{};
+    u64 generation{};
+    std::vector<std::jthread> workers;
+};
