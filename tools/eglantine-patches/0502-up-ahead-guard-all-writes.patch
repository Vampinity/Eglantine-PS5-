+/// EDEN_UP_AHEAD_GUARD_ALL_WRITES: a guest thread is about to write pages the caches track that
+/// the guard did not guess. Each page without a copy gets one (while the pool has room); nothing
+/// else changes for it: the cache that tracks the page still collects the write.
+template <class DeviceMemory>
+void CopyOtherBeforeWrite(u64 device_addr, u64 size, DeviceMemory& device_memory) {
+    constexpr u64 limit = u64{1} << AddressBits;
+    if (size == 0 || device_addr >= limit) {
+        return;
+    }
+    State& s = Get();
+    const u64 last = ((std::min)(device_addr + size, limit) - 1) >> PageBits;
+    bool wanted = false;
+    for (u64 page = device_addr >> PageBits; page <= last && !wanted; ++page) {
+        const u64 bit = u64{1} << (page % 64);
+        wanted = ((s.copied[page / 64].load(std::memory_order_relaxed) |
+                   s.guarded[page / 64].load(std::memory_order_relaxed)) &
+                  bit) == 0;
+    }
+    if (!wanted) {
+        return;
+    }
+    std::scoped_lock lk{s.mutex};
+    if (!s.active.load(std::memory_order_relaxed)) {
+        return;
+    }
+    for (u64 page = device_addr >> PageBits; page <= last; ++page) {
+        const u64 bit = u64{1} << (page % 64);
+        if (((s.copied[page / 64].load(std::memory_order_relaxed) |
+              s.guarded[page / 64].load(std::memory_order_relaxed)) &
+             bit) != 0) {
+            continue;
+        }
+        const u32 capacity = CopyCapacity();
+        if (s.copies_used == capacity) {
+            ++s.stats.other_skipped;
+            return;
+        }
+        if (!s.copy_bytes) {
+            s.copy_bytes.reset(new u8[u64{capacity} * PageSize]);
+            s.copy_page.assign(capacity, 0U);
+            size_t index_size = 256;
+            while (index_size < size_t{capacity} * 2) {
+                index_size *= 2;
+            }
+            s.copy_index.assign(index_size, 0U);
+        }
+        const u32 slot = s.copies_used++;
+        device_memory.ReadBlockUnsafe(page << PageBits, s.copy_bytes.get() + u64{slot} * PageSize,
+                                      PageSize);
+        s.copy_page[slot] = static_cast<u32>(page);
+        const size_t mask = s.copy_index.size() - 1;
+        size_t at = (page * 0x9E3779B97F4A7C15ULL >> 40) & mask;
+        while (s.copy_index[at] != 0) {
+            at = (at + 1) & mask;
+        }
+        s.copy_index[at] = slot + 1;
+        s.copied[page / 64].fetch_or(bit, std::memory_order_release);
+        ++s.stats.other_copies;
+    }
+}
+
 /// Copy mode: the GPU thread's read of guest memory for a buffer. Bytes of a page copied for the
 /// frame in flight come from its copy, the rest through `live(address, out, size)`. Under the
 /// guard's lock, which a guest thread's CopyBeforeWrite takes before its write goes on: a read
