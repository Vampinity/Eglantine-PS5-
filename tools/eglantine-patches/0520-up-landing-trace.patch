                 static const bool held_vs_download = Common::PeSwitch("EDEN_UP_HELD_VS_DOWNLOAD");
@@ -3355,6 +3360,10 @@ void TextureCache<P>::PopAsyncFlushes() {
                 const BufferDownload& buffer_info = slot_buffer_downloads[download_info.object_id];
                 std::span<u8> download_span =
                     download_buffer.mapped_span.subspan(download_buffer.offset);
+                if (VideoCommon::LandingTrace::Enabled()) [[unlikely]] {
