+    }
     // EDEN_UP_FRITCHII_DOWNLOAD_LANDING_STATS: what the download brought, wrote and kept off,
     // until EndLandingStats.
     const bool landing_stats = VideoCore::LandingPort::StatsEnabled();
diff --git a/src/video_core/landing_trace.h b/src/video_core/landing_trace.h
new file mode 100644
index 0000000..fe9ce5d
--- /dev/null
+++ b/src/video_core/landing_trace.h
@@ -0,0 +1,94 @@
+// SPDX-FileCopyrightText: Copyright 2026 Eden Emulator Project
+// SPDX-License-Identifier: GPL-3.0-or-later
+
+#pragma once
+
+#include <algorithm>
+#include <atomic>
+#include <string>
+
+#include <fmt/format.h>
+
+#include "common/common_types.h"
+#include "common/logging.h"
+#include "common/pe_switch.h"
+
+/// EDEN_UP_LANDING_TRACE=1 (exact "1"; a diagnostic, off by default, hundreds of log lines a
+/// second): what the GPU's results look like as they reach the game, present by present.
+///
+/// Why: run a frame ahead (EDEN_NX2_FRAMES_AHEAD=1), Ocarina's picture comes out at about twice
+/// its brightness for a second after a cut from black, in 12 of 32 door runs and in 0 of 45 with
+/// the full wait (T91-T100). That is the exposure set from a wrong reading. The game reads what
+/// the GPU measured from its own memory, where a GPU write lands only at the fence of the frame
+/// that made it; which bytes those are, and how late they land next to the game's presents, is
+/// not known. This writes it down:
+///
+///   LandingTrace present <n> ahead=<0|1> big=<count> (<bytes> B) dropped=<lines>
+///       from nx2:vi2 at each present of the game; ahead=1: it returned before its own frame's
+///       fence. big / dropped: landings since the last present that were over 256 bytes, and
+///       lines left out by the cap of 24 a present.
+///   LandingTrace <kind> p=<n> addr=<address> size=<bytes> first=<hex of up to 32 bytes>
+///       one piece that lands while the game's latest present is n. Kinds:
+///       b  a buffer cache download, written to guest memory whole (device address)
+///       k  a buffer cache download of which bytes were kept off, because the guest CPU wrote
+///          there after the GPU did and before this landed: the game never sees those
+///       t  a texture cache buffer download (an image copied into memory; GPU address)
+///       i  a small image download (GPU address)
+/// A value that follows the picture's brightness through the fade to black and the cut is the
+/// meter; a 'k' line on it at the cut is the reading lost.
+namespace VideoCommon::LandingTrace {
+
+[[nodiscard]] inline bool Enabled() {
+    static const bool enabled = Common::PeSwitch("EDEN_UP_LANDING_TRACE");
+    return enabled;
+}
+
+inline constexpr u64 SmallBytes = 256;
+inline constexpr u32 LinesAPresent = 24;
+
+inline std::atomic<u64> g_present{};       ///< the game's latest present
+inline std::atomic<u64> g_lines_present{}; ///< the present g_lines counts for
+inline std::atomic<u32> g_lines{};
+inline std::atomic<u64> g_big_count{};
+inline std::atomic<u64> g_big_bytes{};
+inline std::atomic<u64> g_dropped{};
+
+/// A piece of GPU-written data is about to be written to guest memory (any thread that lands
+/// downloads). Call only with Enabled().
+inline void Note(char kind, u64 address, const u8* data, u64 size) {
+    if (data == nullptr || size == 0) {
+        return;
+    }
+    if (size > SmallBytes && kind != 'k') {
+        g_big_count.fetch_add(1, std::memory_order_relaxed);
+        g_big_bytes.fetch_add(size, std::memory_order_relaxed);
+        return;
+    }
+    const u64 present = g_present.load(std::memory_order_relaxed);
+    if (g_lines_present.exchange(present, std::memory_order_relaxed) != present) {
+        g_lines.store(0, std::memory_order_relaxed);
+    }
+    if (g_lines.fetch_add(1, std::memory_order_relaxed) >= LinesAPresent) {
+        g_dropped.fetch_add(1, std::memory_order_relaxed);
+        return;
+    }
+    std::string hex;
+    const u64 shown = (std::min<u64>)(size, 32);
+    hex.reserve(shown * 2);
+    for (u64 i = 0; i < shown; ++i) {
+        hex += fmt::format("{:02x}", data[i]);
+    }
+    LOG_INFO(HW_GPU, "LandingTrace {} p={} addr={:#x} size={} first={}", kind, present, address,
+             size, hex);
+}
+
+/// From nx2:vi2 PresentClientBuffer at its reply. Call only with Enabled().
+inline void AtPresent(u64 number, bool ahead) {
+    g_present.store(number, std::memory_order_relaxed);
+    LOG_INFO(HW_GPU, "LandingTrace present {} ahead={} big={} ({} B) dropped={}", number,
+             ahead ? 1 : 0, g_big_count.exchange(0, std::memory_order_relaxed),
+             g_big_bytes.exchange(0, std::memory_order_relaxed),
+             g_dropped.exchange(0, std::memory_order_relaxed));
+}
+
+} // namespace VideoCommon::LandingTrace
