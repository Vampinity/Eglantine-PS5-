+
+namespace VideoCommon {
+
+/// EDEN_NX2_CLEAN_BY_TIME=1 (unset: off, as before): the cleanups that count frames also count
+/// time. Every age and window of AreaEvict, the texture collector, the runtime's copy buffers and
+/// scratch images and the staging pool is in frames, and the game streams on wall time: at half
+/// the frame rate the cleanup came twice as late (Ocarina of Time with EDEN_UP_OOT_FRAME_WAIT=1,
+/// forest load, batch t64-x run 353: the pool ran out with ~810 images, ~2 GB, unused for 10
+/// frames or more). With the switch an age of N frames also counts as reached after N frames' time
+/// at 60 fps (N x 16.7 ms), but never under max(3, N/8) frames; per-frame budgets grow with the
+/// frame time, up to 4 times (8 for the runtime's counters).
+[[nodiscard]] inline bool CleanByTime() noexcept {
+    static const bool enabled = Common::PeSwitch("EDEN_NX2_CLEAN_BY_TIME");
+    return enabled;
+}
+
+/// EDEN_NX2_REFUSAL_EVICT=1 (unset: off, as before): a refused image allocation first frees images
+/// unused for 10 frames and 300 ms, then tries once more (TextureCache::RefusalEvict).
+[[nodiscard]] inline bool RefusalEvictEnabled() noexcept {
+    static const bool enabled = Common::PeSwitch("EDEN_NX2_REFUSAL_EVICT");
+    return enabled;
+}
+
+/// A frame count read as time at the reference rate of 60 frames a second.
+[[nodiscard]] constexpr std::chrono::microseconds FramesAsTime(u64 frames) noexcept {
+    return std::chrono::microseconds{static_cast<s64>((std::min)(frames, u64{1} << 40) * 1'000'000 / 60)};
+}
+
+/// When each of the last RingFrames frames ended, by frame number (TextureCache::TickFrame).
+class FrameClock {
+public:
+    using Clock = std::chrono::steady_clock;
+    static constexpr u64 RingFrames = 4096;
+
+    /// Frame `frame` ends now. Frames come in order; a gap starts the ring again.
+    void EndFrame(u64 frame, Clock::time_point now) noexcept {
+        if (count != 0 && frame != last + 1) {
+            count = 0;
+        }
+        last = frame;
+        ends[frame % RingFrames] = now;
+        count = (std::min)(count + 1, RingFrames);
+    }
+
+    /// The last frame that ended at or before `when`; empty when the ring holds none.
+    [[nodiscard]] std::optional<u64> LastEndedBy(Clock::time_point when) const noexcept {
+        if (count == 0) {
+            return std::nullopt;
+        }
+        u64 lo = last + 1 - count;
+        if (ends[lo % RingFrames] > when) {
+            return std::nullopt;
+        }
+        u64 hi = last;
+        while (lo < hi) { // ends[lo] <= when; the ends only grow with the frame number
+            const u64 mid = lo + (hi - lo + 1) / 2;
+            if (ends[mid % RingFrames] <= when) {
+                lo = mid;
+            } else {
+                hi = mid - 1;
+            }
+        }
+        return lo;
+    }
+
+    /// How many 60 fps frames each of the last (up to 8) frames took, rounded, from 1 to `max`.
+    [[nodiscard]] u32 Step(u32 max) const noexcept {
+        if (count < 2) {
+            return 1;
+        }
+        const u64 span = (std::min<u64>)(count - 1, 8);
+        const auto elapsed = ends[last % RingFrames] - ends[(last - span) % RingFrames];
+        const double frames =
+            std::chrono::duration<double>(elapsed).count() * 60.0 / static_cast<double>(span);
+        return static_cast<u32>(std::clamp(frames + 0.5, 1.0, static_cast<double>(max)));
+    }
+
+private:
+    std::array<Clock::time_point, RingFrames> ends{};
+    u64 last = 0;
+    u64 count = 0;
+};
+
+/// For a counter ticked once a frame (copy buffers, scratch images, staging levels): how many
+/// 60 fps frames passed since the last call, from 1 to `max` (a long hitch counts as `max`).
+class FrameSteps {
+public:
+    using Clock = std::chrono::steady_clock;
+
+    [[nodiscard]] u32 Next(u32 max) noexcept {
+        const auto now = Clock::now();
+        const auto previous = std::exchange(last, now);
+        if (previous == Clock::time_point{}) {
+            return 1;
+        }
+        const double frames = std::chrono::duration<double>(now - previous).count() * 60.0;
+        return static_cast<u32>(std::clamp(frames + 0.5, 1.0, static_cast<double>(max)));
+    }
+
+private:
+    Clock::time_point last{};
+};
+
+} // namespace VideoCommon
