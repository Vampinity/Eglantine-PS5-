index 22283f8..714fb4f 100644
--- a/src/video_core/textures/decoders.cpp
+++ b/src/video_core/textures/decoders.cpp
@@ -7,6 +7,7 @@
 #include <algorithm>
 #include <array>
 #include <atomic>
+#include <bit>
 #include <cmath>
 #include <condition_variable>
 #include <cstdlib>
@@ -22,6 +23,7 @@
 #include "common/bit_util.h"
 #include "common/div_ceil.h"
 #include "common/logging.h"
+#include "common/pe_switch.h"
 #include "common/thread.h"
 #include "video_core/gpu.h"
 #include "video_core/textures/decoders.h"
@@ -172,6 +174,35 @@ void incrpdep(u32& value) {
     value = ((value | ~mask) + swizzled_incr) & mask;
 }
 
+// EDEN_UP_SWIZZLE_UNITS=1 (exact "1", off without it; Lichii PR #784 as Frizti/Fritchii
+// db3fdb2927 has it, there always on: 1024x1024 RGBA8 went from 15.8 to 21.8 GB/s on a PC): block
+// linear data is copied in 16-byte units whose place in a GOB comes from a table, instead of
+// working every unit's offset out with two bit deposits.
+bool SwizzleUnits() {
+    static const bool enabled = [] {
+        const bool on = Common::PeSwitch("EDEN_UP_SWIZZLE_UNITS");
+        if (on) {
+            LOG_INFO(HW_GPU, "EDEN_UP_SWIZZLE_UNITS: block-linear data is copied in 16-byte units");
+        }
+        return on;
+    }();
+    return enabled;
+}
+
+// Where each 16-byte unit of a GOB row lies within the GOB, by row (y & 7) and unit (x / 16 & 3).
+// The 16 bytes of a unit are contiguous. A GOB's own offset is a multiple of GOB_SIZE, so the
+// native tiling's swap of bits 5 and 6 only moves units within it.
+std::array<u32, GOB_SIZE_Y * 4> GobUnitOffsets(bool native_tiling) {
+    std::array<u32, GOB_SIZE_Y * 4> offsets;
+    for (u32 row = 0; row < GOB_SIZE_Y; ++row) {
+        for (u32 unit = 0; unit < 4; ++unit) {
+            offsets[row * 4 + unit] = NativeGobOffset(
+                pdep<SWIZZLE_X_BITS>(unit * 16) | pdep<SWIZZLE_Y_BITS>(row), native_tiling);
+        }
+    }
+    return offsets;
+}
+
 template <bool TO_LINEAR, u32 BYTES_PER_PIXEL>
 void SwizzleImpl(std::span<u8> output, std::span<const u8> input, u32 width, u32 height, u32 depth,
                  u32 block_height, u32 block_depth, u32 stride, bool native_tiling) {
@@ -232,13 +263,53 @@ void SwizzleImpl(std::span<u8> output, std::span<const u8> input, u32 width, u32
     const u32 total_lines = depth * height;
     // From 1 MiB, and only towards plain data: upstream found that splitting medium textures too
     // (256 KiB) made busy spots drop harder.
-    constexpr u64 min_bytes = u64{1} << 20;
-    if (!TO_LINEAR && height != 0 && u64{pitch} * total_lines >= min_bytes &&
-        LinePool::Get().Enabled()) {
-        LinePool::Get().Run(total_lines, lines);
-    } else {
-        lines(0, total_lines);
+    const auto run = [&](const auto& body) {
+        constexpr u64 min_bytes = u64{1} << 20;
+        if (!TO_LINEAR && height != 0 && u64{pitch} * total_lines >= min_bytes &&
+            LinePool::Get().Enabled()) {
+            LinePool::Get().Run(total_lines, body);
+        } else {
+            body(0, total_lines);
+        }
+    };
+    if constexpr (BYTES_PER_PIXEL == 16) {
+        if (SwizzleUnits() && height != 0) {
+            // 16-byte units (UnswizzleTexture and SwizzleTexture widen to them when a row allows
+            // it): their offsets in a GOB come from a table. The origins are 0 here.
+            const auto unit_offsets = GobUnitOffsets(native_tiling);
+            const u32 gobs_wide = Common::DivCeil(width, 4U);
+            const auto unit_lines = [&](u32 first, u32 end) {
+                for (u32 index = first; index < end; ++index) {
+                    const u32 slice = index / height;
+                    const u32 line = index % height;
+                    const u32 offset_z = (slice >> block_depth) * slice_size +
+                                         ((slice & block_depth_mask)
+                                          << (GOB_SIZE_SHIFT + block_height));
+                    const u32 block_y = line >> GOB_SIZE_Y_SHIFT;
+                    const u32 offset_y = (block_y >> block_height) * block_size +
+                                         ((block_y & block_height_mask) << GOB_SIZE_SHIFT);
+                    const u32* const row_offsets = &unit_offsets[(line & (GOB_SIZE_Y - 1)) * 4];
+                    const u32 row_linear = slice * pitch * height + line * pitch;
+                    for (u32 gob_x = 0; gob_x < gobs_wide; ++gob_x) {
+                        const u32 gob_offset = offset_z + offset_y + (gob_x << x_shift);
+                        const u32 units = (std::min)(4U, width - gob_x * 4);
+                        for (u32 unit = 0; unit < units; ++unit) {
+                            const u32 swizzled_offset = gob_offset + row_offsets[unit];
+                            const u32 unswizzled_offset = row_linear + (gob_x * 4 + unit) * 16;
+                            u8* const dst =
+                                &output[TO_LINEAR ? swizzled_offset : unswizzled_offset];
+                            const u8* const src =
+                                &input[TO_LINEAR ? unswizzled_offset : swizzled_offset];
+                            std::memcpy(dst, src, 16);
+                        }
+                    }
+                }
+            };
+            run(unit_lines);
+            return;
+        }
     }
+    run(lines);
 }
 
 template <bool TO_LINEAR, u32 BYTES_PER_PIXEL>
@@ -265,6 +336,12 @@ void SwizzleSubrectImpl(std::span<u8> output, std::span<const u8> input, u32 wid
 
     u32 unprocessed_lines = num_lines;
     u32 extent_y = (std::min)(num_lines, height - origin_y);
+    // EDEN_UP_SWIZZLE_UNITS: power of two pixels never straddle a 16-byte unit, so each row is
+    // copied in runs of whole units (and the partial ones at its ends) from the unit table.
+    constexpr bool unit_runs = std::has_single_bit(BYTES_PER_PIXEL);
+    const bool use_units = unit_runs && SwizzleUnits();
+    const auto unit_offsets = use_units ? GobUnitOffsets(native_tiling)
+                                        : std::array<u32, GOB_SIZE_Y * 4>{};
 
     for (u32 slice = 0; slice < depth; ++slice) {
         const u32 z = slice + origin_z;
@@ -279,6 +356,25 @@ void SwizzleSubrectImpl(std::span<u8> output, std::span<const u8> input, u32 wid
             const u32 offset_y = (block_y >> block_height) * block_size +
                                  ((block_y & block_height_mask) << GOB_SIZE_SHIFT);
 
+            if (use_units) {
+                const u32* const row_offsets = &unit_offsets[(y & (GOB_SIZE_Y - 1)) * 4];
+                const u32 x_begin = origin_x * BYTES_PER_PIXEL;
+                const u32 x_end = (origin_x + extent_x) * BYTES_PER_PIXEL;
+                const u32 row_linear = slice * pitch * height + line * pitch;
+                for (u32 x = x_begin; x < x_end;) {
+                    const u32 run = (std::min)(16 - (x & 15), x_end - x);
+                    const u32 swizzled_offset = offset_z + offset_y +
+                                                ((x >> GOB_SIZE_X_SHIFT) << x_shift) +
+                                                row_offsets[(x >> 4) & 3] + (x & 15);
+                    const u32 unswizzled_offset = row_linear + (x - x_begin);
+                    u8* const dst = &output[TO_LINEAR ? swizzled_offset : unswizzled_offset];
+                    const u8* const src = &input[TO_LINEAR ? unswizzled_offset : swizzled_offset];
+                    std::memcpy(dst, src, run);
+                    x += run;
+                }
+                continue;
+            }
+
             u32 swizzled_x = pdep<SWIZZLE_X_BITS>(origin_x * BYTES_PER_PIXEL);
             for (u32 column = 0; column < extent_x;
                  ++column, incrpdep<SWIZZLE_X_BITS, BYTES_PER_PIXEL>(swizzled_x)) {
