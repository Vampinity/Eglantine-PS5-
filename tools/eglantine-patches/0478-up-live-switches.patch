+/// EDEN_UP_LIVE_SWITCHES=1 (exact "1"): a few switches can change while the game runs, so one
+/// start of the game compares a switch on and off at the same spot (A/B/A/B) instead of one
+/// setting per start. Off (the default): every switch below is read from the environment once at
+/// its first use and never changes, as before, and no thread or file is touched.
+///
+/// With it on, a thread ("LiveSwitches") reads a control file every
+/// EDEN_UP_LIVE_SWITCHES_POLL_MS (default 500, 100 to 5000): EDEN_UP_LIVE_SWITCHES_FILE, default
+/// /data/eglantineps5/live-switches.txt. A file whose bytes are the same as at the last read does
+/// nothing. A new one starts its schedule from the top:
+///
+///     # comment
+///     id=run600               optional, logged
+///     period_ms=20000         optional: with it the app steps through the phases by itself
+///     settle_ms=2000          optional: frames in the first 2 s of a phase are not counted
+///     order=A,B,B,A           optional: the phases of one round (default: as written)
+///     repeat=3                optional: rounds, then back to the start values (0: for ever)
+///     [A]
+///     EDEN_UP_FAST_DRAW=1
+///     [B]
+///     EDEN_UP_FAST_DRAW=0
+///     end
+///
+/// - "end" must be the last line: a file read while it is being written is ignored.
+/// - A switch a phase does not name has its start value (what the environment gave at boot).
+/// - Without period_ms the first phase applies and stays (lines before any [name] are a phase of
+///   their own): change a switch by hand by writing a new file.
+/// - A file that is gone for two reads in a row puts every switch back to its start value.
+///
+/// Changes are applied on the presenting thread at a present (AtPresent), or by the poll thread
+/// when the game has not presented for a second. They are not synchronised with the GPU threads:
+/// every switch here is read again at each decision it makes, and each of those decisions is
+/// valid on its own whatever the one before was (the notes at each switch say why). Switches for
+/// which that is not true are not in the table and cannot change.
+///
+/// Log (Common, Info): one "Live switch: NAME old -> new" line per change, a line when a phase
+/// starts, and a line when it ends with the game's presents in it: frames, fps, mean, 1% low
+/// (99th-percentile frame time), worst frame, frames over 100 ms.
+///
+/// A phase is at least a second long. A schedule cannot turn EDEN_UP_OOT_FRAME_WAIT off unless
+/// EDEN_UP_OOT_LOAD_WAIT=1 was set at boot (the change is refused and logged). When a schedule
+/// starts, a warning names every switch its phases turn on that cannot do anything in this run.
+///
+/// Four of the switches have to be on at boot to change at all, because the work that makes
+/// them possible is set up once (marked "armed" below): with them off at boot a phase that
+/// turns them on does nothing, and the change line says so.
+namespace Common::LiveSwitch {
+
+enum class Id : u8 {
+    /// EDEN_UP_FAST_DRAW, armed. Off: draws take the full path and no draw is kept as a
+    /// candidate; the serial, delta and table bookkeeping runs on (video_core/nx2_fast_draw.h).
+    FastDraw,
+    /// EDEN_UP_QUERY_LIGHT. Each "does this end reuse" answer stands alone.
+    QueryLight,
+    /// EDEN_NX2_DMA_SNAPSHOT, armed (the front's write notes). Off: every macro read drains.
+    DmaSnapshot,
+    /// EDEN_UP_OOT_POLL_BACKOFF, armed (the game patch). Off: the SVC returns at once.
+    PollBackoff,
+    /// EDEN_UP_OOT_NATIVE_ZSTD, armed (the game patch). Off: the game's own decoder runs.
+    NativeZstd,
+    /// EDEN_NX2_TC_KEEP_ASYNC=<frames>. The collectors read it for each image they look at.
+    TcKeepAsync,
+    /// EDEN_UP_OOT_FRAME_WAIT. Each present chooses its wait on its own, as it already does
+    /// for EDEN_UP_OOT_LOAD_WAIT, which changes the same choice from one present to the next.
+    /// Off while the game loads is where sessions ended (common/nx2_load_wait.h): keep
+    /// EDEN_UP_OOT_LOAD_WAIT=1 on at boot for any schedule that turns this off.
+    OotFrameWait,
+    Count,
+};
+
+inline constexpr size_t NumSwitches = static_cast<size_t>(Id::Count);
+
+/// Exact "1" is 1, anything else 0 (Common::PeSwitch).
+[[nodiscard]] inline s64 ParseExactOne(const char* text) noexcept {
+    return text != nullptr && text[0] == '1' && text[1] == '\0' ? 1 : 0;
+}
+
+/// EDEN_NX2_DMA_SNAPSHOT: unset or starting with '0' is 0, starting with '2' is 2, else 1.
+[[nodiscard]] inline s64 ParseSnapshotMode(const char* text) noexcept {
+    if (text == nullptr || text[0] == '0') {
+        return 0;
+    }
+    return text[0] == '2' ? 2 : 1;
+}
+
+/// EDEN_NX2_TC_KEEP_ASYNC: frames, 0 or unset is off, at least 60 otherwise.
+[[nodiscard]] inline s64 ParseKeepFrames(const char* text) noexcept {
+    const unsigned long long asked = text != nullptr ? std::strtoull(text, nullptr, 10) : 0;
+    if (asked == 0) {
+        return 0;
+    }
+    return static_cast<s64>((std::max)(asked, 60ULL)); // the same bits as before, read back as u64
+}
+
+struct Def {
+    const char* name;
+    s64 (*parse)(const char* text);
+    bool armed; ///< Only changes anything when it was on at boot
+    int needs;  ///< Index of a switch that has to be on at boot for this one to do anything, or -1
+};
+
+inline constexpr std::array<Def, NumSwitches> kDefs{{
+    {"EDEN_UP_FAST_DRAW", ParseExactOne, true, -1},
+    {"EDEN_UP_QUERY_LIGHT", ParseExactOne, false, 0},
+    {"EDEN_NX2_DMA_SNAPSHOT", ParseSnapshotMode, true, -1},
+    {"EDEN_UP_OOT_POLL_BACKOFF", ParseExactOne, true, -1},
+    {"EDEN_UP_OOT_NATIVE_ZSTD", ParseExactOne, true, -1},
+    {"EDEN_NX2_TC_KEEP_ASYNC", ParseKeepFrames, false, -1},
+    {"EDEN_UP_OOT_FRAME_WAIT", ParseExactOne, false, -1},
+}};
+
+/// EDEN_UP_LIVE_SWITCHES=1 (exact "1"), read once.
+[[nodiscard]] inline bool Mechanism() {
+    static const bool on = PeSwitch("EDEN_UP_LIVE_SWITCHES");
+    return on;
+}
+
+/// What the switches are now. Written under State::mutex, read anywhere.
+inline std::array<std::atomic<s64>, NumSwitches> g_values{};
+
+namespace Detail {
+
+using Clock = std::chrono::steady_clock;
+
+inline constexpr size_t MaxPhases = 16;
+inline constexpr size_t MaxOrder = 256;
+inline constexpr size_t MaxFileBytes = 16384;
+inline constexpr size_t MaxPhaseFrames = 1 << 16;
+
+struct Phase {
+    std::string name;
+    std::array<s64, NumSwitches> value{};
+    std::array<bool, NumSwitches> listed{};
+};
+
+struct Schedule {
+    std::string id;
+    std::vector<Phase> phases;
+    std::vector<u8> order; ///< Indexes into phases: one round
+    s64 period_ms{};       ///< 0: the first phase stays
+    s64 settle_ms{2000};
+    s64 repeat{}; ///< Rounds; 0: for ever
+    std::string unknown; ///< Names that are not live switches, for the log
+};
+
+[[nodiscard]] inline std::string_view Trim(std::string_view text) {
+    const auto blank = [](char c) { return c == ' ' || c == '\t' || c == '\r'; };
+    while (!text.empty() && blank(text.front())) {
+        text.remove_prefix(1);
+    }
+    while (!text.empty() && blank(text.back())) {
+        text.remove_suffix(1);
+    }
+    return text;
+}
+
+[[nodiscard]] inline s64 Number(std::string_view text, s64 low, s64 high) {
+    const std::string copy{text};
+    return (std::clamp)(static_cast<s64>(std::strtoll(copy.c_str(), nullptr, 10)), low, high);
+}
+
+/// False for a file without its "end" line or with something in it that cannot be meant.
+[[nodiscard]] inline bool Parse(std::string_view text, Schedule& out) {
+    out = Schedule{};
+    bool ended = false;
+    std::string order_text;
+    while (!text.empty() && !ended) {
+        const size_t newline = text.find('\n');
+        std::string_view raw = text.substr(0, newline);
+        raw = raw.substr(0, raw.find('#')); // "NAME=1 # why" is NAME=1
+        const std::string_view line = Trim(raw);
+        text = newline == std::string_view::npos ? std::string_view{} : text.substr(newline + 1);
+        if (line.empty()) {
+            continue;
+        }
+        if (line == "end") {
+            ended = true;
+            break;
+        }
+        if (line.front() == '[') {
+            if (line.back() != ']' || line.size() < 3 || line.size() > 26 ||
+                out.phases.size() >= MaxPhases) {
+                return false;
+            }
+            Phase phase;
+            phase.name = std::string{line.substr(1, line.size() - 2)};
+            out.phases.push_back(std::move(phase));
+            continue;
+        }
+        const size_t equals = line.find('=');
+        if (equals == std::string_view::npos || equals == 0) {
+            return false;
+        }
+        const std::string_view key = Trim(line.substr(0, equals));
+        const std::string_view value = Trim(line.substr(equals + 1));
+        // The schedule's own keys count wherever they stand: none is a switch's name.
+        if (key == "id") {
+            out.id = std::string{value.substr(0, 48)};
+            continue;
+        }
+        if (key == "period_ms") {
+            out.period_ms = Number(value, 0, 3'600'000);
+            continue;
+        }
+        if (key == "settle_ms") {
+            out.settle_ms = Number(value, 0, 600'000);
+            continue;
+        }
+        if (key == "repeat") {
+            out.repeat = Number(value, 0, 1'000'000);
+            continue;
+        }
+        if (key == "order") {
+            order_text = std::string{value};
+            continue;
+        }
+        size_t index = 0;
+        while (index < NumSwitches && key != kDefs[index].name) {
+            ++index;
+        }
+        if (index == NumSwitches) {
+            if (out.unknown.size() < 200) {
+                out.unknown += out.unknown.empty() ? "" : " ";
+                out.unknown += key;
+            }
+            continue;
+        }
+        if (out.phases.empty()) {
+            Phase phase;
+            phase.name = "now";
+            out.phases.push_back(std::move(phase));
+        }
+        const std::string copy{value};
+        out.phases.back().value[index] = kDefs[index].parse(copy.c_str());
+        out.phases.back().listed[index] = true;
+    }
+    if (!ended) {
+        return false;
+    }
+    // A phase is a second at least (a slip like period_ms=20 would change every switch and
+    // write two lines at every present), and some of it is counted.
+    if (out.period_ms > 0) {
+        out.period_ms = (std::max)(out.period_ms, s64{1000});
+        out.settle_ms = (std::min)(out.settle_ms, out.period_ms - 500);
+    }
+    const auto find_phase = [&](std::string_view name) -> int {
+        for (size_t i = 0; i < out.phases.size(); ++i) {
+            if (out.phases[i].name == name) {
+                return static_cast<int>(i);
+            }
+        }
+        return -1;
+    };
+    std::string_view rest = Trim(order_text);
+    // "ABBA" with one-letter phases is the same as "A,B,B,A".
+    const bool letters = !rest.empty() && rest.find_first_of(", \t") == std::string_view::npos &&
+                         find_phase(rest) < 0;
+    while (!rest.empty()) {
+        std::string_view token;
+        if (letters) {
+            token = rest.substr(0, 1);
+            rest.remove_prefix(1);
+        } else {
+            const size_t cut = rest.find_first_of(", \t");
+            token = rest.substr(0, cut);
+            rest = cut == std::string_view::npos ? std::string_view{} : Trim(rest.substr(cut + 1));
+            if (token.empty()) {
+                continue;
+            }
+        }
+        const int phase = find_phase(token);
+        if (phase < 0 || out.order.size() >= MaxOrder) {
+            return false;
+        }
+        out.order.push_back(static_cast<u8>(phase));
+    }
+    if (out.order.empty()) {
+        for (size_t i = 0; i < out.phases.size(); ++i) {
+            out.order.push_back(static_cast<u8>(i));
+        }
+    }
+    return true;
+}
+
+struct State {
+    std::mutex mutex;
+    // The switches.
+    std::array<bool, NumSwitches> ready{};    ///< Read from the environment (its first use came)
+    std::array<s64, NumSwitches> boot{};      ///< Its start value
+    std::array<bool, NumSwitches> wanted{};   ///< The running phase names it
+    std::array<s64, NumSwitches> want{};
+    // The schedule.
+    Schedule schedule;
+    bool active{};
+    size_t order_at{};
+    s64 rounds_done{};
+    u32 phase_number{};
+    Clock::time_point phase_start{};
+    Clock::time_point count_from{};
+    // A schedule the poll thread read, for the next present.
+    Schedule pending;
+    bool has_pending{};
+    bool pending_clear{};
+    Clock::time_point pending_since{};
+    // The presents of the running phase.
+    u64 presents{};
+    bool have_present{};
+    Clock::time_point last_present{};
+    std::vector<u32> frames_us;
+    u64 frames_dropped{}; ///< Past MaxPhaseFrames
+    u64 slow_frames{};
+    u64 phase_presents{};
+    bool refusal_logged{}; ///< Per schedule: the frame wait was not turned off
+};
+
+[[nodiscard]] inline State& Get() {
+    // Never destroyed: the poll thread is still running when the app's statics are torn down
+    // at exit, and would lock a mutex that no longer exists.
+    static State* const state = new State;
+    return *state;
+}
+
+/// A log line (or anything that only reports) must never end the app or leave a change half
+/// made: the console's allocator throws when memory is gone.
+template <typename F>
+inline void Quiet(F&& report) noexcept {
+    try {
+        report();
+    } catch (...) {
+    }
+}
+
+/// EDEN_UP_OOT_LOAD_WAIT=1 at boot: only then may a schedule turn the frame wait off, because
+/// without either wait the session ends while the game loads (common/nx2_load_wait.h).
+[[nodiscard]] inline bool LoadWaitAtBoot() {
+    static const bool on = PeSwitch("EDEN_UP_OOT_LOAD_WAIT");
+    return on;
+}
+
+/// Under the mutex. What switch `i` is to be now: the phase's value, else its start value.
+[[nodiscard]] inline s64 Target(State& state, size_t i) {
+    s64 target = state.wanted[i] ? state.want[i] : state.boot[i];
+    if (static_cast<Id>(i) == Id::OotFrameWait && target == 0 && state.boot[i] != 0 &&
+        !LoadWaitAtBoot()) {
+        target = state.boot[i];
+        if (!state.refusal_logged) {
+            state.refusal_logged = true;
+            Quiet([] {
+                LOG_WARNING(Common,
+                            "Live switches: EDEN_UP_OOT_FRAME_WAIT is NOT turned off: that needs "
+                            "EDEN_UP_OOT_LOAD_WAIT=1 at boot, or the session ends at the next load");
+            });
+        }
+    }
+    return target;
+}
+
+/// Under the mutex. Sets what the switches are for `phase` (nullptr: the start values).
+inline void Apply(State& state, const Phase* phase) {
+    for (size_t i = 0; i < NumSwitches; ++i) {
+        state.wanted[i] = phase != nullptr && phase->listed[i];
+        state.want[i] = state.wanted[i] ? phase->value[i] : 0;
+        if (!state.ready[i]) {
+            continue; // First() takes it from want
+        }
+        const s64 target = Target(state, i);
+        const s64 old = g_values[i].exchange(target, std::memory_order_relaxed);
+        if (old != target) {
+            Quiet([&] {
+                LOG_INFO(Common, "Live switch: {} {} -> {}{}", kDefs[i].name, old, target,
+                         kDefs[i].armed && state.boot[i] == 0
+                             ? " (it was off at boot, so this changes nothing in this run)"
+                             : "");
+            });
+        }
+    }
+}
+
+/// Under the mutex, for a schedule that starts: a line for each switch its phases turn on that
+/// cannot do anything in this run. A switch that was off at boot may never be asked for at all
+/// (its code does not run), so Apply's own note would never come.
+inline void WarnOfDeadSwitches(const Schedule& schedule) {
+    for (size_t i = 0; i < NumSwitches; ++i) {
+        bool turned_on = false;
+        for (const Phase& phase : schedule.phases) {
+            turned_on = turned_on || (phase.listed[i] && phase.value[i] != 0);
+        }
+        if (!turned_on) {
+            continue;
+        }
+        const int needs = kDefs[i].needs;
+        if (kDefs[i].armed && kDefs[i].parse(std::getenv(kDefs[i].name)) == 0) {
+            Quiet([&] {
+                LOG_WARNING(Common,
+                            "Live switches: {} was off at boot: a phase that turns it on changes "
+                            "nothing in this run",
+                            kDefs[i].name);
+            });
+        } else if (needs >= 0 && kDefs[needs].parse(std::getenv(kDefs[needs].name)) == 0) {
+            Quiet([&] {
+                LOG_WARNING(Common,
+                            "Live switches: {} needs {} on at boot, which it was not: its phases "
+                            "change nothing in this run",
+                            kDefs[i].name, kDefs[needs].name);
+            });
+        }
+    }
+}
+
+[[nodiscard]] inline std::string Describe(const State& state) {
+    std::string text;
+    for (size_t i = 0; i < NumSwitches; ++i) {
+        if (!state.ready[i] && !state.wanted[i]) {
+            continue;
+        }
+        const s64 value = state.wanted[i] ? state.want[i] : state.boot[i];
+        text += text.empty() ? "" : " ";
+        text += kDefs[i].name;
+        text += '=';
+        text += std::to_string(value);
+        if (!state.ready[i]) {
+            text += "(not used yet)";
+        }
+    }
+    return text.empty() ? std::string{"no live switch in use"} : text;
+}
+
+[[nodiscard]] inline const Phase* Current(const State& state) {
+    if (!state.active || state.schedule.order.empty()) {
+        return nullptr;
+    }
+    return &state.schedule.phases[state.schedule.order[state.order_at]];
+}
+
+/// Under the mutex. The line for the phase that ends now.
+inline void EndPhase(State& state, Clock::time_point now) {
+    if (state.phase_number == 0) {
+        return;
+    }
+    const Phase* const phase = Current(state);
+    auto& frames = state.frames_us;
+    const size_t n = frames.size();
+    const double length =
+        std::chrono::duration<double>(now - state.phase_start).count();
+    if (n == 0) {
+        LOG_INFO(Common,
+                 "Live switches: phase {} '{}' ended after {:.2f} s: no frames counted ({} "
+                 "presents) | {}",
+                 state.phase_number, phase != nullptr ? phase->name : "start values", length,
+                 state.phase_presents, Describe(state));
+        return;
+    }
+    u64 sum = 0;
+    for (const u32 frame : frames) {
+        sum += frame;
+    }
+    const u32 worst = *std::max_element(frames.begin(), frames.end());
+    const size_t p99_index = (std::min)((n * 99) / 100, n - 1);
+    std::nth_element(frames.begin(), frames.begin() + static_cast<std::ptrdiff_t>(p99_index),
+                     frames.end());
+    const u32 p99 = frames[p99_index];
+    const double seconds = static_cast<double>(sum) / 1e6;
+    LOG_INFO(Common,
+             "Live switches: phase {} '{}' ended after {:.2f} s: {} frames in {:.3f} s = {:.3f} "
+             "fps, mean {:.2f} ms, 1% low {:.1f} ms, worst {:.1f} ms, {} over 100 ms ({} more "
+             "not kept) | {}",
+             state.phase_number, phase != nullptr ? phase->name : "start values", length, n,
+             seconds, seconds > 0 ? static_cast<double>(n) / seconds : 0.0,
+             static_cast<double>(sum) / static_cast<double>(n) / 1000.0,
+             static_cast<double>(p99) / 1000.0, static_cast<double>(worst) / 1000.0,
+             state.slow_frames, state.frames_dropped, Describe(state));
+}
+
+/// Under the mutex. Starts counting for the phase at order_at (or the start values).
+inline void BeginPhase(State& state, Clock::time_point now) {
+    const Phase* const phase = Current(state);
+    Apply(state, phase);
+    ++state.phase_number;
+    state.phase_start = now;
+    state.count_from = now + std::chrono::milliseconds{state.active ? state.schedule.settle_ms : 0};
+    state.frames_us.clear();
+    // Once, all it will ever hold: AtPresent never makes it grow.
+    Quiet([&] { state.frames_us.reserve(MaxPhaseFrames); });
+    state.frames_dropped = 0;
+    state.slow_frames = 0;
+    state.phase_presents = 0;
+    Quiet([&] {
+        LOG_INFO(Common, "Live switches: phase {} '{}' started at present #{} (round {} of {}) | {}",
+                 state.phase_number, phase != nullptr ? phase->name : "start values",
+                 state.presents, state.rounds_done + (state.active ? 1 : 0),
+                 state.active ? state.schedule.repeat : 0, Describe(state));
+    });
+}
+
+/// Under the mutex. Takes a schedule the poll thread read, or steps the running one. Nothing in
+/// here throws: what only reports is wrapped, the rest moves or assigns.
+inline void Step(State& state, Clock::time_point now) {
+    if (state.has_pending) {
+        Quiet([&] { EndPhase(state, now); });
+        const bool clear = state.pending_clear || state.pending.phases.empty();
+        if (clear) {
+            state.active = false;
+            state.schedule = Schedule{};
+            Quiet([&] {
+                LOG_INFO(Common, "Live switches: {}, every switch back to its start value",
+                         state.pending_clear ? "the control file is gone" : "an empty schedule");
+            });
+        } else {
+            state.schedule = std::move(state.pending);
+            state.active = true;
+            Quiet([&] {
+                LOG_INFO(Common,
+                         "Live switches: new schedule '{}': {} phases, {} in a round, period {} "
+                         "ms, settle {} ms, {} rounds{}{}",
+                         state.schedule.id, state.schedule.phases.size(),
+                         state.schedule.order.size(), state.schedule.period_ms,
+                         state.schedule.settle_ms, state.schedule.repeat,
+                         state.schedule.unknown.empty() ? "" : "; NOT live switches, ignored: ",
+                         state.schedule.unknown);
+            });
+            WarnOfDeadSwitches(state.schedule);
+        }
+        state.pending = Schedule{};
+        state.pending_clear = false;
+        state.has_pending = false;
+        state.refusal_logged = false;
+        state.order_at = 0;
+        state.rounds_done = 0;
+        BeginPhase(state, now);
+        return;
+    }
+    if (!state.active || state.schedule.period_ms <= 0 ||
+        now - state.phase_start < std::chrono::milliseconds{state.schedule.period_ms}) {
+        return;
+    }
+    Quiet([&] { EndPhase(state, now); });
+    if (++state.order_at >= state.schedule.order.size()) {
+        state.order_at = 0;
+        ++state.rounds_done;
+        if (state.schedule.repeat != 0 && state.rounds_done >= state.schedule.repeat) {
+            Quiet([&] {
+                LOG_INFO(Common,
+                         "Live switches: schedule '{}' done after {} rounds, every switch back "
+                         "to its start value",
+                         state.schedule.id, state.rounds_done);
+            });
+            state.active = false;
+        }
+    }
+    BeginPhase(state, now);
+}
+
+/// One read of the control file by the poll thread.
+inline void PollOnce(const std::string& path, std::chrono::milliseconds pause, std::string& last,
+                     bool& have_last, u32& missing, u32& refused, std::string& buffer) {
+    bool found = false;
+    buffer.clear();
+    if (std::FILE* const file = std::fopen(path.c_str(), "rb")) {
+        buffer.resize(MaxFileBytes);
+        buffer.resize(std::fread(buffer.data(), 1, MaxFileBytes, file));
+        std::fclose(file);
+        found = true;
+    }
+    State& state = Get();
+    const auto now = Clock::now();
+    if (!found) {
+        // Twice in a row: one failed open must not put every switch back.
+        if (have_last && ++missing == 2) {
+            have_last = false;
+            last.clear();
+            std::scoped_lock lock{state.mutex};
+            state.pending = Schedule{};
+            state.pending_clear = true;
+            state.has_pending = true;
+            state.pending_since = now;
+        }
+    } else {
+        missing = 0;
+        if (!have_last || buffer != last) {
+            Schedule schedule;
+            if (Parse(buffer, schedule)) {
+                last = buffer;
+                have_last = true;
+                refused = 0;
+                std::scoped_lock lock{state.mutex};
+                state.pending = std::move(schedule);
+                state.pending_clear = false;
+                state.has_pending = true;
+                state.pending_since = now;
+                } else if (++refused == 4) {
+                // Four reads, two seconds: not a file caught half written.
+                LOG_WARNING(Common,
+                            "Live switches: {} is not a schedule (no \"end\" line, a line "
+                            "without =, an unknown phase in order, or too many phases): "
+                            "ignored",
+                            path);
+            }
+        }
+    }
+    // No present for a second (loading, a menu that does not present): step here.
+    std::scoped_lock lock{state.mutex};
+    if (!state.have_present || now - state.last_present > std::chrono::seconds{1}) {
+        if (!state.has_pending || now - state.pending_since >= pause) {
+            Step(state, now);
+        }
+    }
+}
+
+/// The poll thread: never returns.
+inline void Poll() {
+    Common::SetCurrentThreadName("LiveSwitches");
+    const char* const named = std::getenv("EDEN_UP_LIVE_SWITCHES_FILE");
+    const std::string path{named != nullptr && named[0] != '\0'
+                               ? named
+                               : "/data/eglantineps5/live-switches.txt"};
+    const char* const poll_text = std::getenv("EDEN_UP_LIVE_SWITCHES_POLL_MS");
+    const auto pause = std::chrono::milliseconds{
+        poll_text != nullptr && poll_text[0] != '\0' ? Number(poll_text, 100, 5000) : 500};
+    LOG_INFO(Common, "EDEN_UP_LIVE_SWITCHES=1: reading {} every {} ms", path, pause.count());
+    std::string last;
+    bool have_last = false;
+    u32 missing = 0;
+    u32 refused = 0;
+    std::string buffer;
+    while (true) {
+        std::this_thread::sleep_for(pause);
+        // The console's allocator throws when memory is gone: skip this read, never end the app.
+        try {
+            PollOnce(path, pause, last, have_last, missing, refused, buffer);
+        } catch (const std::bad_alloc&) {
+        }
+    }
+}
+
+/// A switch's first use: reads its start value. Starts the poll thread at the first of them.
+inline void First(Id id) {
+    const size_t index = static_cast<size_t>(id);
+    const s64 boot = kDefs[index].parse(std::getenv(kDefs[index].name));
+    g_values[index].store(boot, std::memory_order_relaxed);
+    if (!Mechanism()) {
+        return;
+    }
+    // Out of memory here (the state, the thread): the switch keeps its start value, as with
+    // live switching off, and the caller goes on.
+    try {
+        State& state = Get();
+        {
+            std::scoped_lock lock{state.mutex};
+            state.boot[index] = boot;
+            state.ready[index] = true;
+            const s64 value = Target(state, index);
+            g_values[index].store(value, std::memory_order_relaxed);
+            if (value != boot) {
+                Quiet([&] {
+                    LOG_INFO(Common,
+                             "Live switch: {} {} -> {} (its first use came during a phase)",
+                             kDefs[index].name, boot, value);
+                });
+            }
+        }
+        static std::once_flag started;
+        std::call_once(started, [] { std::thread{Poll}.detach(); });
+    } catch (const std::exception&) {
+    }
+}
+
+} // namespace Detail
+
+/// What switch `id` is now. Without EDEN_UP_LIVE_SWITCHES=1 that is what the environment gave at
+/// this switch's first use, for ever.
+template <Id id>
+[[nodiscard]] inline s64 Value() {
+    static const bool first = (Detail::First(id), true);
+    static_cast<void>(first);
+    return g_values[static_cast<size_t>(id)].load(std::memory_order_relaxed);
+}
+
+/// The presenting thread, once per present of the game. Off: one cached check.
+inline void AtPresent(std::chrono::steady_clock::time_point now) {
+    if (!Mechanism()) {
+        return;
+    }
+    Detail::State& state = Detail::Get();
+    std::scoped_lock lock{state.mutex};
+    ++state.presents;
+    ++state.phase_presents;
+    if (state.have_present && state.phase_number != 0 && state.last_present >= state.count_from) {
+        const auto frame =
+            std::chrono::duration_cast<std::chrono::microseconds>(now - state.last_present)
+                .count();
+        // Within what BeginPhase reserved: this never allocates.
+        if (state.frames_us.size() < state.frames_us.capacity()) {
+            state.frames_us.push_back(
+                static_cast<u32>((std::clamp<long long>)(frame, 0, 0xffff'ffffLL)));
+        } else {
+            ++state.frames_dropped;
+        }
+        state.slow_frames += frame > 100'000 ? 1 : 0;
+    }
+    state.have_present = true;
+    state.last_present = now;
+    Detail::Step(state, now);
+}
+
+} // namespace Common::LiveSwitch
