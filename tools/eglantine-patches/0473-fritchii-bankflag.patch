+template <class P>
+void BufferCache<P>::Nx2BankFlagPages(DAddr device_addr, u64 size) {
+    // The flags must cover every device address (Frizti/Fritchii 9e8cb73ede).
+    static_assert(Core::DevicePageFlags::AddressBits >=
+                  Tegra::MaxwellDeviceTraits::device_virtual_bits);
+    [[maybe_unused]] static const bool announced = [] {
+        LOG_INFO(HW_GPU, "EDEN_UP_FRITCHII_BANKFLAG on: native bank binds mark pages with "
+                         "collected guest writes");
+        return true;
+    }();
+    const DAddr end = device_addr + size;
+    for (DAddr page = Common::AlignDown(device_addr, Core::DEVICE_PAGESIZE); page < end;
+         page += Core::DEVICE_PAGESIZE) {
+        // The bank size is only an upper limit: stop at the end of the mapped memory.
+        if (device_memory.template GetPointer<u8>(page) == nullptr) {
+            break;
+        }
+        const bool flagged = Core::CollectedWritePages().Take(page);
+        // A flag is set before its write's bytes land, so a page taken at one bind may have been
+        // uploaded without them: it is marked again at the next bind that covers it.
+        bool recheck = false;
+        if (!nx2_bank_flag_recheck.empty()) {
+            const auto it =
+                std::find(nx2_bank_flag_recheck.begin(), nx2_bank_flag_recheck.end(), page);
+            if (it != nx2_bank_flag_recheck.end()) {
+                *it = nx2_bank_flag_recheck.back();
+                nx2_bank_flag_recheck.pop_back();
+                recheck = true;
+            }
+        }
+        if (!flagged && !recheck) {
+            continue;
+        }
+        if (flagged) {
+            // Pages of banks not bound again stay listed: forget them all past a bound.
+            if (nx2_bank_flag_recheck.size() >= 256) {
+                nx2_bank_flag_recheck.clear();
+            }
+            nx2_bank_flag_recheck.push_back(page);
+        }
+        const DAddr begin = (std::max<DAddr>)(page, device_addr);
+        const u64 length = (std::min<DAddr>)(page + Core::DEVICE_PAGESIZE, end) - begin;
+        if (memory_tracker.IsRegionCpuModified(begin, length)) {
+            // Uploaded by this bind anyway.
+            ++nx2_bank_flag_stats.already_modified;
+            continue;
+        }
+        memory_tracker.MarkRegionAsCpuModified(begin, length);
+        if (!flagged) {
+            ++nx2_bank_flag_stats.marked_again;
+            continue;
+        }
+        // A page the tracker held clean although a guest write to it was collected: without the
+        // switch this bind would have drawn with its older bytes.
+        const u64 marked = ++nx2_bank_flag_stats.marked;
+        if ((marked & (marked - 1)) == 0) {
+            LOG_INFO(HW_GPU,
+                     "EDEN_UP_FRITCHII_BANKFLAG: {} bank pages held clean with collected guest "
+                     "writes marked at a bind, {} marked again one bind later, {} flagged pages "
+                     "were CPU-modified already",
+                     marked, nx2_bank_flag_stats.marked_again,
+                     nx2_bank_flag_stats.already_modified);
+        }
+    }
+}
+
 template <class P>
 void BufferCache<P>::Nx2CheckBankPages(DAddr device_addr, u64 size, bool mark, bool stats) {
     // The bank size is only an upper limit: stop at the end of the mapped memory.
