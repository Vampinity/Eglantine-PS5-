 #include <atomic>
 #include <bit>
 #include <cstdlib>
@@ -16,6 +18,64 @@
 
 namespace Core {
 
+/// One bit per 4 KiB device page of the 36-bit device address space (2 MiB), set by writers and
+/// taken by a reader (Frizti/Fritchii 9e8cb73ede).
+class DevicePageFlags {
+public:
+    static constexpr u64 AddressBits = 36;
+
+    void Mark(u64 address, u64 size) noexcept {
+        constexpr u64 limit = u64{1} << AddressBits;
+        if (size == 0 || address >= limit) {
+            return;
+        }
+        u64 page = address >> DEVICE_PAGEBITS;
+        const u64 last = ((std::min)(address + size, limit) - 1) >> DEVICE_PAGEBITS;
+        while (page <= last) {
+            const u64 first_bit = page % 64;
+            const u64 bits = (std::min<u64>)(64 - first_bit, last - page + 1);
+            const u64 mask = (bits == 64 ? ~u64{0} : (u64{1} << bits) - 1) << first_bit;
+            std::atomic<u64>& word = words[page / 64];
+            if ((word.load(std::memory_order_relaxed) & mask) != mask) {
+                word.fetch_or(mask, std::memory_order_seq_cst);
+            }
+            page += bits;
+        }
+    }
+
+    /// Clears the bit of the page holding `address`, returning whether it was set.
+    bool Take(u64 address) noexcept {
+        if (address >= (u64{1} << AddressBits)) {
+            return false;
+        }
+        const u64 page = address >> DEVICE_PAGEBITS;
+        const u64 bit = u64{1} << (page % 64);
+        std::atomic<u64>& word = words[page / 64];
+        if ((word.load(std::memory_order_relaxed) & bit) == 0) {
+            return false;
+        }
+        return (word.fetch_and(~bit, std::memory_order_seq_cst) & bit) != 0;
+    }
+
+private:
+    std::array<std::atomic<u64>, (u64{1} << (AddressBits - DEVICE_PAGEBITS)) / 64> words{};
+};
+
+/// EDEN_UP_FRITCHII_BANKFLAG=1 (Frizti/Fritchii 9e8cb73ede, EXP9's collected-write flags): each
+/// guest CPU write collected for the GPU flags its pages in CollectedWritePages(). The buffer
+/// cache sees such a write only at the next Gather (GPU::InvalidateGPUCache) and holds the page
+/// clean until then; a bind of a native 64 KiB uniform bank takes the flags of its pages and marks
+/// them CPU-modified, so that bind uploads the guest's current bytes.
+[[nodiscard]] inline bool BankFlagPages() {
+    static const bool on = Common::PeSwitch("EDEN_UP_FRITCHII_BANKFLAG");
+    return on;
+}
+/// EDEN_UP_FRITCHII_BANKFLAG only: allocated at the first use, so the 2 MiB exist only with it.
+[[nodiscard]] inline DevicePageFlags& CollectedWritePages() {
+    static DevicePageFlags* const flags = new DevicePageFlags{};
+    return *flags;
+}
+
 class GPUDirtyMemoryManager {
 public:
